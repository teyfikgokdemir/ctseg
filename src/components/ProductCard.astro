---
import { localizedPath, ui, type Locale } from '../data/site';
import ProductMedia from './ProductMedia.astro';
const { product, productId, lang, index, featured=false } = Astro.props as {
  product:any; productId:string; lang:Locale; index:number; featured?:boolean;
};
const label = String(index + 1).padStart(2,'0');
const typographicVariety = ['kaleghouchi-pistachio','fandoghi-pistachio','ahmad-aghaei-pistachio'].includes(productId);
---
<a class:list={['product-card', { featured, 'typographic-card':typographicVariety }]} href={localizedPath(lang,'products',productId)} data-product-card>
  {typographicVariety
    ? <div class="variety-panel"><span>{ui[lang].products}</span><strong>{product.names[lang]}</strong></div>
    : <ProductMedia product={product} lang={lang} />}
  <div class="product-card-copy">
    <span class="section-number">{label}</span>
    <h2>{product.names[lang]}</h2>
    <p>{product.descriptions[lang]}</p>
    <span class="text-link" aria-hidden="true">↗</span>
  </div>
</a>
