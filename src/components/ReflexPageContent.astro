                height="500"
                alt={facilityCaption}
                loading="lazy"
                decoding="async"
              />
              <span class="reflex-evidence-tag">PRODUCTION REFERENCE</span>
            </div>
            <figcaption class="reflex-facility-caption">
              <strong>{facilityCaption}</strong>
              <p>{data.aboutText2}</p>
            </figcaption>
          </div>

          <div class="reflex-role-card">
