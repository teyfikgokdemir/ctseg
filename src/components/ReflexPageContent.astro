<script define:vars={{ success: data.formLabels.successMessage, error: rfqPrivacy.error }}>
  (() => {
    document.querySelectorAll('[data-reflex-form]').forEach((form) => {
      if (form.dataset.enhanced) return;
      form.dataset.enhanced = 'true';
      const started = form.querySelector('[data-rfq-started-at]');
      const pagePath = form.querySelector('[data-rfq-page-path]');
      const status = form.querySelector('[data-rfq-status]');
      const submit = form.querySelector('[type="submit"]');
      const setDefaults = () => { if (started) started.value = String(Date.now()); if (pagePath) pagePath.value = location.pathname; };
      setDefaults();
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        status.textContent = '';
        submit.disabled = true;
        try {
          const response = await fetch(form.action, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.code || 'request_failed');
          status.textContent = success;
          window.ctsegTrack?.('reflex_rfq_success', { form_type: 'reflex_b2b_rfq', product_family: 'reflex_gloves' });
          form.reset();
          setDefaults();
        } catch {
          status.textContent = error;
          window.ctsegTrack?.('reflex_rfq_error', { form_type: 'reflex_b2b_rfq', product_family: 'reflex_gloves' });
        } finally {
          submit.disabled = false;
        }
      });
    });
  })();
</script>

