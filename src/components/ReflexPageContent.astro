  it: 'Intero Portafoglio Guanti REFLEX',
  ru: 'Весь портфель перчаток REFLEX',
  fa: 'سبد کامل دستکش‌های REFLEX'
}[currentLang] || 'REFLEX Full Gloves Portfolio';

const volumePlaceholder = {
  tr: 'Örn. 500 Koli / 10.000 Kutu',
  en: 'e.g. 500 Master Cartons / 10,000 Boxes',
  zh: '例如：500 纸箱 / 10,000 盒 / 1 个 40HQ 集装箱',
  vi: 'Ví dụ: 500 thùng carton / 10.000 hộp / 1 container',
  de: 'z.B. 500 Exportkartons / 10.000 Boxen',
  it: 'es. 500 Scatole Master / 10.000 Confezioni',
  ru: 'напр. 500 коробок / 10 000 упаковок',
  fa: 'مثال: ۵۰۰ کارتن صادراتی / ۱۰,۰۰۰ جعبه'
}[currentLang] || 'e.g. 500 Master Cartons / 10,000 Boxes';

const notesPlaceholder = {
  tr: 'Beden dağılımı, varış limanı, teslim tarihi veya private label taleplerinizi belirtin...',
  en: 'Specify sizes, destination port, target delivery date, or private label requirements...',
  zh: '请注明所需尺码配比、目的港、期望交付期或贴牌定制 (Private Label) 需求...',
  vi: 'Nêu rõ quy cách kích cỡ, cảng đến, ngày giao hàng dự kiến hoặc yêu cầu nhãn hiệu riêng...',
  de: 'Geben Sie Größen, Zielhafen, Liefertermin oder Private-Label-Wünsche an...',
  it: 'Specifica taglie, porto di destinazione, data di consegna o richieste private label...',
  ru: 'Укажите размеры, порт назначения, срок поставки или требования к private label...',
  fa: 'سایزها، بندر مقصد، تاریخ تحویل یا الزامات برند اختصاصی را قید فرمایید...'
}[currentLang] || 'Specify sizes, destination port, target delivery date, or private label requirements...';
---

<div class="reflex-page" dir={isRtl ? 'rtl' : 'ltr'}>
  <!-- 1. Hero Section -->
  <section class="reflex-hero-section">
    <div class="container reflex-hero-grid">
      <div class="reflex-hero-text">
        <nav class="reflex-breadcrumbs" aria-label="Breadcrumbs">
          <a href={currentLang === 'tr' ? '/' : `/${currentLang}/`}>CTSEG</a>
          <span aria-hidden="true">/</span>
          <span class="current">{data.eyebrow}</span>
        </nav>

        <span class="eyebrow reflex-eyebrow-hero">{ui.heroEyebrow}</span>
        <h1 class="reflex-h1">{localizedHeroTitle}</h1>
        <p class="lead reflex-hero-lead">{localizedHeroLead}</p>

        <div class="reflex-hero-badges-grid">
          {heroTrustBadges.map((badge) => (
            <div class="reflex-hero-badge-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e2b96c" stroke-width="2.5">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>{badge}</span>
            </div>
          ))}
        </div>

        <div class="actions reflex-hero-actions">
          <a class="button" href="#rfq-form" data-product-quote={localizedHeroTitle}>
            {data.ctaQuote} →
          </a>
          <a class="button button-secondary" href="/documents/reflex-medical-catalogue.pdf" download="REFLEX-Medical-Catalogue.pdf" data-catalog-download data-catalog-language={currentLang}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            {data.ctaCatalog}
          </a>
          <a class="button button-secondary" href="#product-categories">
            {data.ctaProducts}
          </a>
        </div>
      </div>

      <figure class="reflex-hero-figure">
        <picture>
          <source srcset="/images/reflex/reflex-slider1.webp" type="image/webp" />
          <img
            src="/images/reflex/reflex-slider1.jpg"
            width="1200"
            height="850"
            alt={localizedHeroTitle}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="reflex-hero-media"
          />
        </picture>
        <figcaption class="reflex-media-caption" set:html={mediaCaption} />
      </figure>
    </div>
  </section>

  <!-- 2. Manufacturing Capacity & B2B Supplier Section -->
  <section class="section reflex-about-section">
    <div class="container content-grid">
      <div class="prose">
        <span class="eyebrow">{data.aboutEyebrow}</span>
        <h2>{data.aboutTitle}</h2>
        <p>{data.aboutText1}</p>
        <p>{data.aboutText2}</p>

        <div class="reflex-role-card">
          <h3>{data.aboutRoleTitle}</h3>
          <p>{data.aboutRoleText}</p>
          <div class="reflex-disclaimer-note">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e2b96c" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="16" x2="12" y2="12"/>
              <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <span>{ui.roleScope}</span>
          </div>
        </div>
      </div>

      <aside class="side-panel">
        <div class="reflex-markets-card">
          <div class="reflex-facility-media-box">
            <img
              src="/images/reflex/resizer (1).jpg"
              width="680"
              height="750"
              alt={facilityCaption}
              loading="lazy"
              decoding="async"
            />
            <small>{facilityCaption}</small>
          </div>

          <div class="reflex-capacity-grid">
            {capacityCardsData.map((card) => (
              <div class="reflex-capacity-card">
                <strong>{card.title}</strong>
                <span>{card.desc}</span>
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- 3. Featured Commercial Demonstration Video -->
  <ProductVideoSection
    videoSrc="/videos/Commercial_prompt_for_disposable_gloves.mp4"
    posterSrc="/images/reflex/resizer.jpg"
    kicker={ui.videoKicker}
    heading={ui.videoTitle}
    description={ui.videoDescription}
    lang={currentLang}
    controls={true}
    muted={false}
  />

  <!-- 4. Product Portfolio Cards -->
  <section class="section reflex-categories-section" id="product-categories">
    <div class="container">
      <div class="section-head">
        <h2>{ui.portfolioTitle}</h2>
        <p>{data.categoriesLead}</p>
      </div>

      <div class="reflex-products-grid" data-reflex-product-grid>
        {data.categories.map((cat, index) => (
          <article class:list={['reflex-product-card', { 'reflex-product-card--lead': index === 0 }]} id={cat.id} data-reflex-product-card>
            <figure class="reflex-card-image-box">
              <span class="reflex-card-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <img
                src={cat.image}
                width="640"
                height="450"
                alt={cat.name}
                loading="lazy"
                decoding="async"
              />
            </figure>

            <div class="reflex-card-content">
              <div class="reflex-card-heading">
                <p class="reflex-card-subtitle">{cat.subtitle}</p>
                <h3>{cat.name}</h3>
              </div>
              <p class="reflex-card-desc">{cat.description}</p>

              <div class="reflex-card-badges" aria-label={`${cat.name} product highlights`}>
                {cat.badges.slice(0, 3).map((badge) => (
                  <span class="reflex-card-badge">{badge}</span>
                ))}
              </div>

              <dl class="reflex-spec-list">
                <div>
                  <dt>{ui.material}</dt>
                  <dd>{cat.material}</dd>
                </div>
                <div>
                  <dt>{ui.variants}</dt>
                  <dd>{cat.variants}</dd>
                </div>
                <div>
                  <dt>{ui.packaging}</dt>
                  <dd>{cat.packing}</dd>
                </div>
              </dl>

              {categoryVideoMap[cat.id] && (
                <details class="reflex-card-film">
                  <summary>{ui.videoTitle}</summary>
                  <div class="reflex-card-video-box">
                    <video
                      src={categoryVideoMap[cat.id].video}
                      poster={categoryVideoMap[cat.id].poster}
                      controls
                      playsinline
                      preload="metadata"
                      aria-label={`${cat.name} Product Video`}
                      class="reflex-card-video"
                    ></video>
                  </div>
                </details>
              )}

              <div class="reflex-card-actions">
                <a class="button button-small" href="#rfq-form" data-product-quote={cat.name}>
                  <span>{ui.quote}</span><span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Sector Applications (GEO / AIO / SEO Optimized) -->
  <section class="section reflex-applications-section">
    <div class="container">
      <div class="section-head">
        <h2>{ui.applicationsTitle}</h2>
        <p>{data.applicationsLead}</p>
      </div>

      <div class="reflex-app-grid">
        {data.applications.map((app) => (
          <article class="reflex-app-card">
            <figure class="reflex-app-fig">
              <img
                src={app.image}
                width="600"
                height="420"
                alt={app.title}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="reflex-app-body">
              <h3>{app.title}</h3>
              <p>{app.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Quality Control & International Standards Section -->
  <section class="section reflex-quality-section">
    <div class="container">
      <div class="section-head">
        <h2>{ui.qualityTitle}</h2>
        <p>{ui.qualityLead}</p>
      </div>

      <div class="reflex-quality-grid">
        {qualityCardsData.map((qc) => (
          <div class="reflex-quality-card">
            <div class="reflex-quality-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e2b96c" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <h3>{qc.title}</h3>
            <p>{qc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Product Gallery -->
  <section class="section reflex-gallery-section">
    <div class="container">
      <div class="section-head">
        <h2>{data.galleryTitle}</h2>
        <p>{data.galleryLead}</p>
      </div>

      <aside class="reflex-document-scope" aria-label={ui.documentTitle}>
        <strong>{ui.documentTitle}</strong>
        <p>{ui.documentText}</p>
      </aside>

      <div class="reflex-gallery-grid">
        {data.galleryItems.map((item) => (
          <figure class="reflex-gallery-card">
            <picture>
              {item.imageMobile && (
                <source media="(max-width: 768px)" srcset={item.imageMobile} />
              )}
              <img
                src={item.image}
                width="600"
                height="420"
                alt={item.title}
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption>
              <span class="tag">{item.tag}</span>
              <h4>{item.title}</h4>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Catalogue Download Section -->
  <section class="section reflex-download-banner">
    <div class="container">
      <div class="reflex-download-box">
        <div class="reflex-download-text">
          <h2>{data.downloadTitle}</h2>
          <p>{data.downloadLead}</p>
          <small class="reflex-pdf-notice">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            {data.pdfNotice}
          </small>
        </div>

        <div class="reflex-download-action">
          <a class="button button-large" href="/documents/reflex-medical-catalogue.pdf" download="REFLEX-Medical-Catalogue.pdf" data-catalog-download data-catalog-language={currentLang}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            {data.downloadButton}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Request for Commercial Quotation (RFQ) Section -->
  <section class="section reflex-rfq-section" id="rfq-form">
    <div class="container">
      <div class="reflex-rfq-grid">
        <div class="reflex-rfq-info">
          <span class="eyebrow">{ui.rfqEyebrow}</span>
          <h2>{ui.rfqTitle}</h2>
          <p>{data.rfqLead}</p>

          <div class="reflex-rfq-trust-box">
            <h4 class="reflex-rfq-trust-heading">{ui.rfqTrustTitle}</h4>
            <ul class="reflex-rfq-trust-list">
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#e2b96c" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{ui.trustItems[0]}</span>
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#e2b96c" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{ui.trustItems[1]}</span>
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#e2b96c" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{ui.trustItems[2]}</span>
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#e2b96c" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{ui.trustItems[3]}</span>
              </li>
            </ul>
          </div>

          <div class="reflex-rfq-features">
            <div class="reflex-rfq-feat">
              <strong>{ui.logisticsTitle}</strong>
              <span>{ui.logisticsText}</span>
            </div>
            <div class="reflex-rfq-feat">
              <strong>{ui.documentsTitle}</strong>
              <span>{ui.documentsText}</span>
            </div>
            <div class="reflex-rfq-feat">
              <strong>{ui.verificationTitle}</strong>
              <span>{ui.verificationText}</span>
            </div>
          </div>
        </div>

        <div class="reflex-rfq-form-card">
          <form class="reflex-form" id="reflex-rfq-fields" data-reflex-form action="/api/contact" method="post">
            <input type="hidden" name="locale" value={currentLang} />
            <input type="hidden" name="intent" value="buyer_request" />
            <input type="hidden" name="tradeDirection" value="import_to_turkiye" />
            <input type="hidden" name="productFamily" value="reflex_gloves" />
            <input type="hidden" name="startedAt" value="" data-rfq-started-at />
            <input type="hidden" name="pagePath" value="" data-rfq-page-path />
            <div class="form-honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>

            <div class="form-row">
              <div class="form-group">
                <label for="rfq-name">{data.formLabels.name} *</label>
                <input type="text" id="rfq-name" name="name" required maxlength="120" autocomplete="name" />
              </div>
              <div class="form-group">
                <label for="rfq-email">{data.formLabels.email} *</label>
                <input type="email" id="rfq-email" name="emailOrPhone" required maxlength="254" autocomplete="email" placeholder="company@domain.com" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="rfq-phone">{data.formLabels.phone}</label>
                <input type="tel" id="rfq-phone" name="phone" maxlength="80" autocomplete="tel" placeholder="+1 234 567 890" />
              </div>
              <div class="form-group">
                <label for="rfq-company">{data.formLabels.company} *</label>
                <input type="text" id="rfq-company" name="company" required maxlength="160" autocomplete="organization" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="rfq-country">{data.formLabels.country} *</label>
                <input type="text" id="rfq-country" name="destinationMarket" required maxlength="100" autocomplete="country-name" />
              </div>
              <div class="form-group">
                <label for="rfq-product">{data.formLabels.product}</label>
                <select id="rfq-product" name="product">
                  <option value={allProductsOption}>{allProductsOption}</option>
                  {data.categories.map((c) => (<option value={c.name}>{c.name}</option>))}
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="rfq-volume">{data.formLabels.volume}</label>
              <input type="text" id="rfq-volume" name="quantity" maxlength="120" placeholder={volumePlaceholder} />
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="rfq-incoterm">{rfqExtra.incoterm}</label>
                <input type="text" id="rfq-incoterm" name="incoterm" maxlength="30" placeholder="FOB, CIF or DAP" />
              </div>
              <div class="form-group">
                <label for="rfq-target-date">{rfqExtra.targetDate}</label>
                <input type="date" id="rfq-target-date" name="targetDate" />
              </div>
            </div>

            <div class="form-group">
              <label for="rfq-notes">{data.formLabels.notes}</label>
              <textarea id="rfq-notes" name="message" maxlength="2000" rows="4" placeholder={notesPlaceholder}></textarea>
            </div>

            <label class="reflex-rfq-privacy"><input type="checkbox" name="privacy" value="accepted" required /> <span>{rfqPrivacy.label} <a href={rfqPrivacyHref}>{rfqPrivacy.link}</a></span></label>
            <p class="reflex-rfq-status" data-rfq-status role="status" aria-live="polite"></p>
            <button type="submit" class="button button-large button-block">{data.formLabels.submit}</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</div>

<script define:vars={{ success: data.formLabels.successMessage, error: rfqPrivacy.error }}>
  (() => {
    document.querySelectorAll('[data-reflex-form]').forEach((form) => {
      if (form.dataset.enhanced) return;
      form.dataset.enhanced = 'true';
      const started = form.querySelector('[data-rfq-started-at]');
      const pagePath = form.querySelector('[data-rfq-page-path]');
      const status = form.querySelector('[data-rfq-status]');
      const submit = form.querySelector('[type="submit"]');
      const setDefaults = () => { if (started) started.value = String(Date.now()); if (pagePath) pagePath.value = location.pathname; };
      setDefaults();
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        setDefaults();
        if (submit) submit.disabled = true;
        if (status) { status.textContent = ''; status.className = 'reflex-rfq-status'; }
        try {
          const res = await fetch(form.action || '/api/contact', {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' }
          });
          const json = await res.json().catch(() => null);
          if (res.ok && json?.ok) {
            form.reset();
            if (status) { status.textContent = success; status.classList.add('is-success'); }
          } else {
            if (status) { status.textContent = json?.message || error; status.classList.add('is-error'); }
          }
        } catch {
          if (status) { status.textContent = error; status.classList.add('is-error'); }
        } finally {
          if (submit) submit.disabled = false;
        }
      });
    });
  })();
</script>
