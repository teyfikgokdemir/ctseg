---
import { reflexData, reflexPath, type ReflexLocale } from '../data/reflex-data';
import { reflexUi } from '../data/reflex-ui';
import ProductVideoSection from './ProductVideoSection.astro';

const { lang = 'en' } = Astro.props as { lang?: string };
const currentLang = (['en', 'tr', 'de', 'it', 'ru', 'fa', 'sq', 'mk', 'sr'].includes(lang) ? lang : 'en') as ReflexLocale;
const data = reflexData[currentLang] || reflexData.en;
const ui = reflexUi[currentLang] || reflexUi.en;
const isRtl = currentLang === 'fa';
const reflexUrl = reflexPath(currentLang);
const rfqPrivacyHref = currentLang === 'tr' ? '/tr/gizlilik-politikasi/' : currentLang === 'en' ? '/en/privacy-policy/' : '/en/privacy-policy/';
const rfqExtra = ({
  tr: { incoterm: 'Teslim şekli / Incoterm', targetDate: 'Hedef teslim tarihi' },
  en: { incoterm: 'Delivery basis / Incoterm', targetDate: 'Target delivery date' },
  de: { incoterm: 'Lieferbedingung / Incoterm', targetDate: 'Gewünschtes Lieferdatum' },
  it: { incoterm: 'Resa / Incoterm', targetDate: 'Data di consegna prevista' },
  ru: { incoterm: 'Условия поставки / Incoterm', targetDate: 'Целевая дата поставки' },
  fa: { incoterm: 'شرایط تحویل / Incoterm', targetDate: 'تاریخ هدف تحویل' }
}[currentLang as 'tr' | 'en' | 'de' | 'it' | 'ru' | 'fa'] || { incoterm: 'Delivery basis / Incoterm', targetDate: 'Target delivery date' });
const rfqPrivacy = ({
  tr: { label: 'Bilgilerimin bu teklif talebinin değerlendirilmesi için işlenmesini kabul ediyorum.', link: 'Gizlilik bildirimi', error: 'Talep gönderilemedi. Lütfen tekrar deneyin veya e-posta ile ulaşın.' },
  en: { label: 'I agree that my information may be processed to assess this quotation request.', link: 'Privacy notice', error: 'The request could not be sent. Please try again or contact us by email.' },
  de: { label: 'Ich stimme zu, dass meine Daten zur Bewertung dieser Angebotsanfrage verarbeitet werden.', link: 'Datenschutzhinweis', error: 'Die Anfrage konnte nicht gesendet werden. Bitte versuchen Sie es erneut.' },
  it: { label: 'Accetto che i miei dati siano trattati per valutare questa richiesta di offerta.', link: 'Informativa privacy', error: 'La richiesta non può essere inviata. Riprova o contattaci via e-mail.' },
  ru: { label: 'Я согласен на обработку моих данных для оценки этого запроса предложения.', link: 'Политика конфиденциальности', error: 'Не удалось отправить запрос. Повторите попытку или свяжитесь с нами по электронной почте.' },
  fa: { label: 'با پردازش اطلاعات خود برای ارزیابی این درخواست پیشنهاد موافقم.', link: 'اطلاعیه حریم خصوصی', error: 'ارسال درخواست انجام نشد. دوباره تلاش کنید.' }
}[currentLang as 'tr' | 'en' | 'de' | 'it' | 'ru' | 'fa'] || { label: 'I agree that my information may be processed to assess this quotation request.', link: 'Privacy notice', error: 'The request could not be sent. Please try again or contact us by email.' });

const categoryVideoMap: Record<string, { video: string; poster: string; title: string }> = {
  'flex-hitech': {
    video: '/videos/Commercial_for_Reflex_Glove_Flex.mp4',
    poster: '/images/reflex/reflex-cat3.jpg',
    title: 'FLEX Hi-Tech Commercial Video'
  },
  'medilex-exam': {
    video: '/videos/Medical_commercial_prompt_for_gloves.mp4',
    poster: '/images/reflex/reflex-cat6.jpg',
    title: 'MEDILEX Examination Commercial Video'
  },
  'winlyex-thermo-vinyl': {
    video: '/videos/Commercial_for_Winlyex_Extra_gloves_202608062333.mp4',
    poster: '/images/reflex/reflex-cat5.jpg',
    title: 'WINLYEX Extra Thermo Commercial Video'
  },
  'slimfit-copolymer': {
    video: '/videos/Reflex_Slimfit_Glove_commercial.mp4',
    poster: '/images/reflex/reflex-cat8.jpg',
    title: 'SLIMFIT Copolymer Commercial Video'
  },
  'winlyex-powder-free': {
    video: '/videos/Commercial_for_Winlyex_Extra_gloves_202608062333 (1).mp4',
    poster: '/images/reflex/reflex-cat4.jpg',
    title: 'WINLYEX Powder Free Commercial Video'
  },
  'florex-multipurpose': {
    video: '/videos/extra.mp4',
    poster: '/images/reflex/reflex-cat5.jpg',
    title: 'FLOREX Multipurpose Commercial Video'
  }
};

const localizedHeroTitle = {
  tr: 'Medikal, Endüstriyel ve Gıda Kullanımı için REFLEX Tek Kullanımlık Eldiven Tedariği',
  en: 'REFLEX Disposable Gloves for Medical, Industrial and Food Applications',
  fa: 'تأمین عمده دستکش‌های یک‌بارمصرف REFLEX برای کاربردهای پزشکی، صنعتی و غذایی',
  de: 'REFLEX Einweg-Handschuhe für Medizin, Industrie und Lebensmittelverarbeitung',
  it: 'Guanti Monouso REFLEX per Applicazioni Mediche, Industriali e Alimentari',
  ru: 'Одноразовые Перчатки REFLEX для Медицинских, Промышленных и Пищевых Целей',
  sq: 'Doreza me Një Përdorim REFLEX për Aplikime Mjekësore, Industriale dhe Ushqimore',
  mk: 'REFLEX Ракавици за Еднократна Употреба за Медицинска, Индустриска и Прехранбена Примена',
  sr: 'REFLEX Rukavice za Jednokratnu Upotrebu za Medicinsku, Industrijsku i Prehrambenu Primenu'
}[currentLang] || 'REFLEX Disposable Gloves for Medical, Industrial and Food Applications';

const localizedHeroLead = {
  tr: 'CTSEG; uluslararası distribütörler, sağlık kuruluşları ve kurumsal alıcılar için yüksek üretim kapasiteli nitril muayene eldivenleri, latekssiz TPE, termo vinil ve kopolimer tek kullanımlık eldiven portföyünü toplu ihracat ve kalite dokümantasyonu ile sunar.',
  en: 'CTSEG provides bulk export supply of high-capacity nitrile examination gloves, latex-free TPE, thermo vinyl, and copolymer disposable gloves backed by batch quality documentation for international distributors, healthcare institutions, and industrial procurement buyers.',
  fa: 'CTSEG خدمات تأمین و صادرات عمده دستکش‌های معاینه نیتریل، TPE بدون لاتکس، ترمو وینیل و کدوپلیمر یک‌بارمصرف را همراه با اسناد کیفیت محموله برای توزیع‌کنندگان بین‌المللی، مراکز درمانی و خریداران شرکتی ارائه می‌دهد.',
  de: 'CTSEG bietet Großhandelslieferungen von hochkapazitiven Nitril-Untersuchungshandschuhen, latexfreiem TPE, Thermo-Vinyl und Copolyester-Einweghandschuhen mit chargenbezogener Qualitätsdokumentation für internationale Händler und Industrieunternehmen.',
  it: 'CTSEG fornisce forniture all’ingrosso di guanti da esame in nitrile, TPE senza lattice, termo-vinile e copolimero con documentazione di qualità per distributori internazionali e istituzioni sanitarie.',
  ru: 'CTSEG осуществляет оптовые экспортные поставки нитриловых смотровых перчаток, TPE без латекса, термовинила и кополимерных перчаток с документами качества для международных дистрибьюторов и медицинских учреждений.',
  sq: 'CTSEG ofron furnizim me shumicë të dorezave ekzaminuese nitril, TPE pa lateks, termo vinil dhe kopolimer me dokumentacion cilësie për shpërndarësit ndërkombëtarë.',
  mk: 'CTSEG обезбедува прехранбени и медицински ракавици од нитрил, TPE без латекс, термо винил и кополимер за меѓународни дистрибутери.',
  sr: 'CTSEG obezbeđuje masovno snabdevanje nitrilnim preglednim rukavicama, TPE bez lateksa, termo vinilom i kopolimernim rukavicama sa kvalitetnom dokumentacijom za međunarodne kupce.'
}[currentLang] || data.heroLead;

const heroTrustBadges = {
  tr: ['Ürün bazında doğrulama', 'Parti belge incelemesi', 'Toplu B2B tedarik', 'İhracat koordinasyonu'],
  en: ['Product-specific verification', 'Batch document review', 'Bulk B2B supply', 'Export coordination'],
  fa: ['صادرات و lojistik', 'سفارشات عمده B2B', 'گزینه‌های برند اختصاصی', 'اسناد و COA محموله'],
  de: ['Export-Lieferung', 'Großbestellungen', 'Private-Label-Optionen', 'Qualitätsdokumentation'],
  it: ['Fornitura Export', 'Ordini all’Ingrosso', 'Opzioni Private Label', 'Documentazione di Qualità'],
  ru: ['Экспортные Поставки', 'Оптовые Заказы', 'Private Label', 'Документы Качества'],
  sq: ['Furnizim Eksporti', 'Porosi me Shumicë', 'Opsione Private Label', 'Dokumentacion Cilësie'],
  mk: ['Извозно Снабдување', 'Големи Нарачки', 'Опции за Private Label', 'Документација за Квалитет'],
  sr: ['Izvozno Snabdevanje', 'Velike Narudžbe', 'Opcije Private Label', 'Dokumentacija Kvaliteta']
}[currentLang];

const capacityCardsData = [
  {
    title: { tr: 'Üretim kapasitesi', en: 'Production capacity', fa: 'ظرفیت تولید' }[currentLang] || 'Production capacity',
    desc: { tr: 'Seçilen ürün, üretici ve parti için talep üzerine doğrulanır.', en: 'Verified on request for the selected product, producer and batch.', fa: 'برای محصول و محموله منتخب بر اساس درخواست بررسی می‌شود.' }[currentLang] || 'Verified on request for the selected product, producer and batch.'
  },
  {
    title: { tr: 'Uluslararası Pazarlar', en: 'Global Markets', fa: 'بازارهای بین‌المللی' }[currentLang] || 'Global Markets',
    desc: { tr: 'AB, İngiltere, Balkanlar, Orta Doğu ve Kuzey Afrika ihracat desteği.', en: 'Direct export logistics to EU, UK, Balkans, Middle East & North Africa.', fa: 'صادرات به اروپا، بریتانیا، بالکان، خاورمیانه و شمال آفریقا.' }[currentLang] || 'Direct export logistics to EU, UK, Balkans, Middle East & North Africa.'
  },
  {
    title: { tr: 'Ürün Çeşitliliği', en: 'Product Range', fa: 'سبد کامل محصولات' }[currentLang] || 'Product Range',
    desc: { tr: 'TPE, Nitril hibrit, Termo Vinil, Kopolimer ve Muayene eldivenleri.', en: 'Nitrile-hybrid, TPE, Thermo Vinyl, Copolymer & Medical Examination series.', fa: 'دستکش‌های TPE، هیبرید نیتریل، ترمو وینیل، کدوپلیمر و معاینه.' }[currentLang] || 'Nitrile-hybrid, TPE, Thermo Vinyl, Copolymer & Medical Examination series.'
  },
  {
    title: { tr: 'Ambalaj Seçenekleri', en: 'Packaging Options', fa: 'گزینه‌های بسته‌بندی' }[currentLang] || 'Packaging Options',
    desc: { tr: 'Dispanser kutu, private label üretimi ve ihracat koli standartları.', en: 'Custom dispenser boxes, private-label branding & master carton packaging.', fa: 'جعبه‌های دیسپنسر، برند اختصاصی private label و کارتن‌های صادراتی.' }[currentLang] || 'Custom dispenser boxes, private-label branding & master carton packaging.'
  }
];

const qualityCardsData = [
  {
    title: { tr: 'Kalite Kontrol', en: 'Quality Control', fa: 'کنترل کیفیت محموله' }[currentLang] || 'Quality Control',
    desc: { tr: 'Parti bazlı COA analizi, AQL delik testi ve fiziksel mukavemet kontrolleri.', en: 'Batch-level Certificate of Analysis (COA), AQL pinhole testing and tensile strength checks.', fa: 'ارزیابی COA، تست AQL و مقاومت فیزیکی در سطح هر محموله.' }[currentLang] || 'Batch-level Certificate of Analysis (COA), AQL pinhole testing and tensile strength checks.'
  },
  {
    title: { tr: 'Ürün Tutarlılığı', en: 'Product Consistency', fa: 'ثبات کیفیت تولید' }[currentLang] || 'Product Consistency',
    desc: { tr: 'Otomatik hat üretimi ile standart et kalınlığı ve bariyer performansı.', en: 'Automated line production ensuring uniform wall thickness and reliable barrier performance.', fa: 'خطوط اتوماتیک برای ضخامت یکنواخت و عملکرد bariyer قابل‌اعتماد.' }[currentLang] || 'Automated line production ensuring uniform wall thickness and reliable barrier performance.'
  },
  {
    title: { tr: 'Uluslararası Tedarik Standartları', en: 'International Supply Standards', fa: 'استانداردهای تأمین بین‌المللی' }[currentLang] || 'International Supply Standards',
    desc: { tr: 'AB ve uluslararası ithalatçı gereksinimlerine uygun ihracat ve lojistik dokümantasyonu.', en: 'Full export documentation, Incoterms logistics (FOB, CIF, DAP), and compliance tracking.', fa: 'اسناد کامل صادراتی، Incoterms (FOB, CIF, DAP) و پیگیری انطباق.' }[currentLang] || 'Full export documentation, Incoterms logistics (FOB, CIF, DAP), and compliance tracking.'
  }
];
---

<div class="reflex-page" dir={isRtl ? 'rtl' : 'ltr'}>
  <!-- 1. Hero Section -->
  <section class="reflex-hero-section">
    <div class="container reflex-hero-grid">
      <div class="reflex-hero-text">
        <nav class="reflex-breadcrumbs" aria-label="Breadcrumbs">
          <a href={currentLang === 'tr' ? '/' : `/${currentLang}/`}>CTSEG</a>
          <span aria-hidden="true">/</span>
          <span class="current">{data.eyebrow}</span>
        </nav>

        <span class="eyebrow reflex-eyebrow-hero">{ui.heroEyebrow}</span>
        <h1 class="reflex-h1">{localizedHeroTitle}</h1>
        <p class="lead reflex-hero-lead">{localizedHeroLead}</p>

        <div class="reflex-hero-badges-grid">
          {heroTrustBadges.map((badge) => (
            <div class="reflex-hero-badge-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e2b96c" stroke-width="2.5">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>{badge}</span>
            </div>
          ))}
        </div>

        <div class="actions reflex-hero-actions">
          <a class="button" href="#rfq-form" data-product-quote={localizedHeroTitle}>
            {data.ctaQuote} →
          </a>
          <a class="button button-secondary" href="/documents/reflex-medical-catalogue.pdf" download="REFLEX-Medical-Catalogue.pdf" data-catalog-download data-catalog-language={currentLang}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            {data.ctaCatalog}
          </a>
          <a class="button button-secondary" href="#product-categories">
            {data.ctaProducts}
          </a>
        </div>
      </div>

      <figure class="reflex-hero-figure">
        <img
          src="/images/reflex/reflex-slider1.jpg"
          width="1200"
          height="850"
          alt="REFLEX Disposable Gloves Bulk Supplier Packaging and Production"
          loading="eager"
          decoding="async"
          class="reflex-hero-media"
        />
        <figcaption class="reflex-media-caption">
          <strong>Product-specific documentation</strong> · Bulk export and commercial supply subject to verification
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Manufacturing Capacity & B2B Supplier Section -->
  <section class="section reflex-about-section">
    <div class="container content-grid">
      <div class="prose">
        <span class="eyebrow">{data.aboutEyebrow}</span>
        <h2>{data.aboutTitle}</h2>
        <p>{data.aboutText1}</p>
        <p>{data.aboutText2}</p>

        <div class="reflex-role-card">
          <h3>{data.aboutRoleTitle}</h3>
          <p>{data.aboutRoleText}</p>
          <div class="reflex-disclaimer-note">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e2b96c" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="16" x2="12" y2="12"/>
              <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <span>{ui.roleScope}</span>
          </div>
        </div>
      </div>

      <aside class="side-panel">
        <div class="reflex-markets-card">
          <div class="reflex-facility-media-box">
            <img
              src="/images/reflex/resizer (1).jpg"
              width="680"
              height="750"
              alt="REFLEX Production Facility in Esenyurt, Istanbul"
              loading="lazy"
              decoding="async"
            />
            <small>Automated packaging & production facility in Esenyurt, Istanbul</small>
          </div>

          <div class="reflex-capacity-grid">
            {capacityCardsData.map((card) => (
              <div class="reflex-capacity-card">
                <strong>{card.title}</strong>
                <span>{card.desc}</span>
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- 3. Featured Commercial Demonstration Video -->
  <ProductVideoSection
    videoSrc="/videos/Commercial_prompt_for_disposable_gloves.mp4"
    posterSrc="/images/reflex/resizer.jpg"
    kicker={ui.videoKicker}
    heading={ui.videoTitle}
    description={ui.videoDescription}
    lang={currentLang}
    controls={true}
    muted={false}
  />

  <!-- 4. Product Portfolio Cards -->
  <section class="section reflex-categories-section" id="product-categories">
    <div class="container">
      <div class="section-head">
        <h2>{ui.portfolioTitle}</h2>
        <p>{data.categoriesLead}</p>
      </div>

      <div class="reflex-products-grid" data-reflex-product-grid>
        {data.categories.map((cat, index) => (
          <article class:list={['reflex-product-card', { 'reflex-product-card--lead': index === 0 }]} id={cat.id} data-reflex-product-card>
            <figure class="reflex-card-image-box">
              <span class="reflex-card-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <img
                src={cat.image}
                width="640"
                height="450"
                alt={cat.name}
                loading="lazy"
                decoding="async"
              />
            </figure>

            <div class="reflex-card-content">
              <div class="reflex-card-heading">
                <p class="reflex-card-subtitle">{cat.subtitle}</p>
                <h3>{cat.name}</h3>
              </div>
              <p class="reflex-card-desc">{cat.description}</p>

              <div class="reflex-card-badges" aria-label={`${cat.name} product highlights`}>
                {cat.badges.slice(0, 3).map((badge) => (
                  <span class="reflex-card-badge">{badge}</span>
                ))}
              </div>

              <dl class="reflex-spec-list">
                <div>
                  <dt>{ui.material}</dt>
                  <dd>{cat.material}</dd>
                </div>
                <div>
                  <dt>{ui.variants}</dt>
                  <dd>{cat.variants}</dd>
                </div>
                <div>
                  <dt>{ui.packaging}</dt>
                  <dd>{cat.packing}</dd>
                </div>
              </dl>

              {categoryVideoMap[cat.id] && (
                <details class="reflex-card-film">
                  <summary>{ui.videoTitle}</summary>
                  <div class="reflex-card-video-box">
                    <video
                      src={categoryVideoMap[cat.id].video}
                      poster={categoryVideoMap[cat.id].poster}
                      controls
                      playsinline
                      preload="metadata"
                      aria-label={`${cat.name} Product Video`}
                      class="reflex-card-video"
                    ></video>
                  </div>
                </details>
              )}

              <div class="reflex-card-actions">
                <a class="button button-small" href="#rfq-form" data-product-quote={cat.name}>
                  <span>{ui.quote}</span><span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Sector Applications (GEO / AIO / SEO Optimized) -->
  <section class="section reflex-applications-section">
    <div class="container">
      <div class="section-head">
        <h2>{ui.applicationsTitle}</h2>
        <p>{data.applicationsLead}</p>
      </div>

      <div class="reflex-app-grid">
        {data.applications.map((app) => (
          <article class="reflex-app-card">
            <figure class="reflex-app-fig">
              <img
                src={app.image}
                width="600"
                height="420"
                alt={app.title}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="reflex-app-body">
              <h3>{app.title}</h3>
              <p>{app.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Quality Control & International Standards Section -->
  <section class="section reflex-quality-section">
    <div class="container">
      <div class="section-head">
        <h2>{ui.qualityTitle}</h2>
        <p>{ui.qualityLead}</p>
      </div>

      <div class="reflex-quality-grid">
        {qualityCardsData.map((qc) => (
          <div class="reflex-quality-card">
            <div class="reflex-quality-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e2b96c" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <h3>{qc.title}</h3>
            <p>{qc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Product Gallery -->
  <section class="section reflex-gallery-section">
    <div class="container">
      <div class="section-head">
        <h2>{data.galleryTitle}</h2>
        <p>{data.galleryLead}</p>
      </div>

      <aside class="reflex-document-scope" aria-label={ui.documentTitle}>
        <strong>{ui.documentTitle}</strong>
        <p>{ui.documentText}</p>
      </aside>

      <div class="reflex-gallery-grid">
        {data.galleryItems.map((item) => (
          <figure class="reflex-gallery-card">
            <picture>
              {item.imageMobile && (
                <source media="(max-width: 768px)" srcset={item.imageMobile} />
              )}
              <img
                src={item.image}
                width="600"
                height="420"
                alt={item.title}
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption>
              <span class="tag">{item.tag}</span>
              <h4>{item.title}</h4>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Catalogue Download Section -->
  <section class="section reflex-download-banner">
    <div class="container">
      <div class="reflex-download-box">
        <div class="reflex-download-text">
          <h2>{data.downloadTitle}</h2>
          <p>{data.downloadLead}</p>
          <small class="reflex-pdf-notice">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
