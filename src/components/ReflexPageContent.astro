<script define:vars={{ success: data.formLabels.successMessage, error: rfqPrivacy.error }}>
  (() => {
    document.querySelectorAll('[data-reflex-form]').forEach((form) => {
      if (form.dataset.enhanced) return;
      form.dataset.enhanced = 'true';
      const started = form.querySelector('[data-rfq-started-at]');
      const pagePath = form.querySelector('[data-rfq-page-path]');
      const status = form.querySelector('[data-rfq-status]');
      const submit = form.querySelector('[type="submit"]');
      const setDefaults = () => { if (started) started.value = String(Date.now()); if (pagePath) pagePath.value = location.pathname; };
      setDefaults();
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        setDefaults();
        if (submit) submit.disabled = true;
        if (status) { status.textContent = ''; status.className = 'reflex-rfq-status'; }
        try {
          const res = await fetch(form.action || '/api/contact', {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' }
          });
          const json = await res.json().catch(() => null);
          if (res.ok && json?.ok) {
            form.reset();
            if (status) { status.textContent = success; status.classList.add('is-success'); }
          } else {
            if (status) { status.textContent = json?.message || error; status.classList.add('is-error'); }
          }
        } catch {
          if (status) { status.textContent = error; status.classList.add('is-error'); }
        } finally {
          if (submit) submit.disabled = false;
        }
      });
    });
  })();
</script>
