              <h3>{data.aboutRoleTitle}</h3>
            </div>
            <p>{data.aboutRoleText}</p>
            <div class="reflex-disclaimer-note">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
              </svg>
              <span>{ui.roleScope}</span>
            </div>
          </div>
        </div>

        <div class="reflex-capability-column">
          <div class="reflex-capacity-grid">
            {capacityCardsData.map((card) => (
              <div class="reflex-capacity-card">
                <strong>{card.title}</strong>
                <p>{card.desc}</p>
              </div>
            ))}
          </div>

          <div class="reflex-markets-mandate-card">
            <h4>{data.aboutMarketsTitle}</h4>
            <ul class="reflex-markets-list">
              {data.aboutMarketsList.map((m) => (
                <li>
                  <span class="reflex-market-dot"></span>
                  <span>{m}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
