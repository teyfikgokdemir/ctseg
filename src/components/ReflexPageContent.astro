<script define:vars={{ success: data.formLabels.successMessage, error: rfqPrivacy.error }}>
  (() => {
    document.querySelectorAll('[data-reflex-form]').forEach((form) => {
      if (form.dataset.enhanced) return;
      form.dataset.enhanced = 'true';
      const started = form.querySelector('[data-rfq-started-at]');
      const pagePath = form.querySelector('[data-rfq-page-path]');
      const status = form.querySelector('[data-rfq-status]');
      const submit = form.querySelector('[type="submit"]');
      const setDefaults = () => {
        if (started && !started.value) started.value = String(Date.now());
        if (pagePath) pagePath.value = location.pathname;
      };
      setDefaults();
      form.addEventListener('focusin', () => window.ctsegTrack?.('contact_form_start', { form_type:'medical_rfq', product_family:'reflex_gloves' }), { once:true });
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        setDefaults();
        window.ctsegTrack?.('contact_form_submit_attempt', { form_type:'medical_rfq', product_family:'reflex_gloves' });
        if (submit) submit.disabled = true;
        if (status) { status.textContent = ''; status.className = 'reflex-rfq-status'; }
        try {
          const payload = Object.fromEntries(new FormData(form).entries());
          const res = await fetch(form.action || '/api/contact', {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const json = await res.json().catch(() => null);
          if (res.ok && json?.ok) {
            form.reset();
            if (started) started.value = String(Date.now());
            window.ctsegTrack?.('contact_form_success', { form_type:'medical_rfq', product_family:'reflex_gloves' });
            window.ctsegTrack?.('generate_lead', { form_type:'medical_rfq', product_family:'reflex_gloves' });
            if (status) { status.textContent = success; status.classList.add('is-success'); }
          } else {
            window.ctsegTrack?.('contact_form_error', { form_type:'medical_rfq', product_family:'reflex_gloves', error_code:json?.code || 'request_failed' });
            if (status) { status.textContent = json?.message || error; status.classList.add('is-error'); }
          }
        } catch {
          window.ctsegTrack?.('contact_form_error', { form_type:'medical_rfq', product_family:'reflex_gloves', error_code:'network_error' });
          if (status) { status.textContent = error; status.classList.add('is-error'); }
        } finally {
          if (submit) submit.disabled = false;
        }
      });
    });
  })();
</script>
