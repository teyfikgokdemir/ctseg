<div class="reflex-page" dir={isRtl ? 'rtl' : 'ltr'}>
  <!-- 1. Hero Section -->
  <section class="reflex-hero-section">
    <div class="container reflex-hero-grid">
      <div class="reflex-hero-text">
        <nav class="reflex-breadcrumbs" aria-label="Breadcrumbs">
          <a href={currentLang === 'tr' ? '/' : `/${currentLang}/`}>CTSEG</a>
          <span aria-hidden="true">/</span>
          <span class="current">{data.eyebrow}</span>
        </nav>

        <span class="eyebrow reflex-eyebrow-hero">{ui.heroEyebrow}</span>
        <h1 class="reflex-h1">{localizedHeroTitle}</h1>
        <p class="lead reflex-hero-lead">{localizedHeroLead}</p>

        <div class="reflex-hero-badges-grid">
          {heroTrustBadges.map((badge) => (
            <div class="reflex-hero-badge-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>{badge}</span>
            </div>
          ))}
        </div>

        <div class="actions reflex-hero-actions">
          <a class="button" href="#rfq-form" data-product-quote={localizedHeroTitle}>
            {data.ctaQuote} →
          </a>
          <a class="button button-secondary" href="/documents/reflex-medical-catalogue.pdf" download="REFLEX-Medical-Catalogue.pdf" data-catalog-download data-catalog-language={currentLang}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            {data.ctaCatalog}
          </a>
          <a class="button button-secondary" href="#product-categories">
            {data.ctaProducts}
          </a>
        </div>
      </div>

      <figure class="reflex-hero-figure">
        <div class="reflex-hero-media-wrapper">
          <picture>
            <source srcset="/images/reflex/reflex-slider1.webp" type="image/webp" />
            <img
              src="/images/reflex/reflex-slider1.jpg"
              width="1200"
              height="850"
              alt={localizedHeroTitle}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="reflex-hero-media"
            />
          </picture>
        </div>
        <figcaption class="reflex-media-caption" set:html={mediaCaption} />
