    background-color: #111210;
    color: #f2efe7;
    position: relative;
    overflow-x: hidden;
  }

  /* Global tokens & Typography for Reflex */
  .reflex-page .eyebrow {
    display: inline-block;
    color: #c4f000;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .reflex-page .section {
    padding-block: clamp(64px, 7vw, 112px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .reflex-page .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .reflex-page .section-head h2 {
    font-family: var(--font-serif, 'Source Serif 4', Georgia, serif);
    font-size: clamp(2.2rem, 3.8vw, 3.6rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin: 0;
  }

  .reflex-page .section-head p {
    color: #d1d1cb;
    font-size: clamp(0.95rem, 1.2vw, 1.12rem);
    line-height: 1.6;
    margin: 0;
  }

  /* 1. Hero Section */
  .reflex-hero-section {
    padding-top: clamp(40px, 5vw, 80px);
    padding-bottom: clamp(64px, 7vw, 100px);
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 85% 20%, rgba(196, 240, 0, 0.04), transparent 45%), #111210;
  }

  .reflex-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.85fr);
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }

  .reflex-breadcrumbs {
    display: flex;
    align-items: center;
