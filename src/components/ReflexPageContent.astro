---

<div class="reflex-page" dir={isRtl ? 'rtl' : 'ltr'}>
  <!-- 1. Hero Section -->
  <section class="reflex-hero-section">
    <div class="container reflex-hero-grid">
      <div class="reflex-hero-text">
        <nav class="reflex-breadcrumbs" aria-label="Breadcrumbs">
          <a href={currentLang === 'tr' ? '/' : `/${currentLang}/`}>CTSEG</a>
          <span aria-hidden="true">/</span>
          <span class="current">{data.eyebrow}</span>
        </nav>

        <span class="eyebrow reflex-eyebrow-hero">{ui.heroEyebrow}</span>
        <h1 class="reflex-h1">{localizedHeroTitle}</h1>
        <p class="lead reflex-hero-lead">{localizedHeroLead}</p>

        <div class="reflex-hero-badges-grid">
          {heroTrustBadges.map((badge) => (
            <div class="reflex-hero-badge-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>{badge}</span>
            </div>
          ))}
        </div>

        <div class="actions reflex-hero-actions">
          <a class="button" href="#rfq-form" data-product-quote={localizedHeroTitle}>
            {data.ctaQuote} →
          </a>
          <a class="button button-secondary" href="/documents/reflex-medical-catalogue.pdf" download="REFLEX-Medical-Catalogue.pdf" data-catalog-download data-catalog-language={currentLang}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            {data.ctaCatalog}
          </a>
          <a class="button button-secondary" href="#product-categories">
            {data.ctaProducts}
          </a>
        </div>
      </div>

      <figure class="reflex-hero-figure">
        <div class="reflex-hero-media-wrapper">
          <picture>
            <source srcset="/images/reflex/reflex-slider1.webp" type="image/webp" />
            <img
              src="/images/reflex/reflex-slider1.jpg"
              width="1200"
              height="850"
              alt={localizedHeroTitle}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="reflex-hero-media"
            />
          </picture>
        </div>
        <figcaption class="reflex-media-caption" set:html={mediaCaption} />
      </figure>
    </div>
  </section>

  <!-- 2. Manufacturing & Facility Evidence Section -->
  <section class="section reflex-facility-section" id="facility-evidence">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{data.aboutEyebrow}</span>
          <h2>{data.aboutTitle}</h2>
        </div>
        <p>{data.aboutText1}</p>
      </div>

      <div class="reflex-facility-evidence-grid">
        <div class="reflex-facility-narrative">
          <div class="reflex-facility-media-card">
            <div class="reflex-facility-image-wrap">
              <img
                src="/images/reflex/resizer (1).jpg"
                width="680"
                height="500"
                alt={facilityCaption}
                loading="lazy"
                decoding="async"
              />
              <span class="reflex-evidence-tag">COMMERCIAL EVIDENCE</span>
            </div>
            <figcaption class="reflex-facility-caption">
              <strong>{facilityCaption}</strong>
              <p>{data.aboutText2}</p>
            </figcaption>
          </div>

          <div class="reflex-role-card">
            <div class="reflex-role-header">
              <span class="reflex-role-kicker">INDEPENDENT SOURCING COORDINATION</span>
              <h3>{data.aboutRoleTitle}</h3>
            </div>
            <p>{data.aboutRoleText}</p>
            <div class="reflex-disclaimer-note">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
              </svg>
              <span>{ui.roleScope}</span>
            </div>
          </div>
        </div>

        <div class="reflex-capability-column">
          <div class="reflex-capacity-grid">
            {capacityCardsData.map((card) => (
              <div class="reflex-capacity-card">
                <strong>{card.title}</strong>
                <p>{card.desc}</p>
              </div>
            ))}
          </div>

          <div class="reflex-markets-mandate-card">
            <h4>{data.aboutMarketsTitle}</h4>
            <ul class="reflex-markets-list">
              {data.aboutMarketsList.map((m) => (
                <li>
                  <span class="reflex-market-dot"></span>
                  <span>{m}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Commercial Demonstration Video Panel -->
  <ProductVideoSection
    videoSrc="/videos/Commercial_prompt_for_disposable_gloves.mp4"
    posterSrc="/images/reflex/resizer.jpg"
    kicker={ui.videoKicker}
    heading={ui.videoTitle}
    description={ui.videoDescription}
    lang={currentLang}
    controls={true}
    muted={false}
  />

  <!-- 3. Product Families Section -->
  <section class="section reflex-categories-section" id="product-categories">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{ui.portfolioTitle}</span>
          <h2>{data.categoriesTitle}</h2>
        </div>
        <p>{data.categoriesLead}</p>
      </div>

      <div class="reflex-families-container">
        {productFamilies.map((fam) => {
          const items = data.categories.filter((c) => fam.categoryIds.includes(c.id));
          if (!items.length) return null;
          return (
            <div class="reflex-family-block" id={fam.id}>
              <div class="reflex-family-header">
                <div class="reflex-family-title-wrap">
                  <span class="reflex-family-pill">SERIES / FAMILY</span>
                  <h3>{fam.title}</h3>
                </div>
                <p>{fam.desc}</p>
              </div>

              <div class="reflex-family-grid">
                {items.map((cat, idx) => (
                  <article class="reflex-product-card" id={cat.id} data-reflex-product-card>
                    <figure class="reflex-card-image-box">
                      <span class="reflex-card-index" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span>
                      <img
                        src={cat.image}
                        width="640"
                        height="450"
                        alt={cat.name}
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>

                    <div class="reflex-card-content">
                      <div class="reflex-card-heading">
                        <p class="reflex-card-subtitle">{cat.subtitle}</p>
                        <h4>{cat.name}</h4>
                      </div>
                      <p class="reflex-card-desc">{cat.description}</p>

                      <div class="reflex-card-badges" aria-label={`${cat.name} product highlights`}>
                        {cat.badges.slice(0, 3).map((badge) => (
                          <span class="reflex-card-badge">{badge}</span>
                        ))}
                      </div>

                      <dl class="reflex-spec-list">
                        <div>
                          <dt>{ui.material}</dt>
                          <dd>{cat.material}</dd>
                        </div>
                        <div>
                          <dt>{ui.variants}</dt>
                          <dd>{cat.variants}</dd>
                        </div>
                        <div>
                          <dt>{ui.packaging}</dt>
                          <dd>{cat.packing}</dd>
                        </div>
                      </dl>

                      {categoryVideoMap[cat.id] && (
                        <details class="reflex-card-film">
                          <summary>{ui.videoTitle}</summary>
                          <div class="reflex-card-video-box">
                            <video
                              src={categoryVideoMap[cat.id].video}
                              poster={categoryVideoMap[cat.id].poster}
                              controls
                              playsinline
                              preload="metadata"
                              aria-label={`${cat.name} Product Video`}
                              class="reflex-card-video"
                            ></video>
                          </div>
                        </details>
                      )}

                      <div class="reflex-card-actions">
                        <a class="button button-small" href="#rfq-form" data-product-quote={cat.name}>
                          <span>{ui.quote}</span><span aria-hidden="true">→</span>
                        </a>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 4. Quality Control & International Standards Section -->
  <section class="section reflex-quality-section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">STANDARDS & VERIFICATION</span>
          <h2>{ui.qualityTitle}</h2>
        </div>
        <p>{ui.qualityLead}</p>
      </div>

      <div class="reflex-quality-grid">
        {qualityCardsData.map((qc) => (
          <div class="reflex-quality-card">
            <div class="reflex-quality-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <h3>{qc.title}</h3>
            <p>{qc.desc}</p>
          </div>
        ))}
      </div>

      <aside class="reflex-document-scope" aria-label={ui.documentTitle}>
        <div class="reflex-document-scope-head">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
          <strong>{ui.documentTitle}</strong>
        </div>
        <p>{ui.documentText}</p>
      </aside>
    </div>
  </section>

  <!-- 5. Sector Applications (GEO / AIO / SEO Optimized) -->
  <section class="section reflex-applications-section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">SECTOR FOCUS</span>
          <h2>{ui.applicationsTitle}</h2>
        </div>
        <p>{data.applicationsLead}</p>
      </div>

      <div class="reflex-app-grid">
        {data.applications.map((app) => (
          <article class="reflex-app-card">
            <figure class="reflex-app-fig">
              <img
                src={app.image}
                width="600"
                height="420"
                alt={app.title}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="reflex-app-body">
              <h3>{app.title}</h3>
              <p>{app.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Product Gallery & Technical Catalogue -->
  <section class="section reflex-gallery-section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">MEDIA ARCHIVE</span>
          <h2>{data.galleryTitle}</h2>
        </div>
        <p>{data.galleryLead}</p>
      </div>

      <div class="reflex-gallery-grid">
        {data.galleryItems.map((item) => (
          <figure class="reflex-gallery-card">
            <picture>
              {item.imageMobile && (
                <source media="(max-width: 768px)" srcset={item.imageMobile} />
              )}
              <img
                src={item.image}
                width="600"
                height="420"
                alt={item.title}
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption>
              <span class="tag">{item.tag}</span>
              <h4>{item.title}</h4>
            </figcaption>
          </figure>
        ))}
      </div>

      <!-- Catalogue Download Banner -->
      <div class="reflex-download-box">
        <div class="reflex-download-text">
          <h2>{data.downloadTitle}</h2>
          <p>{data.downloadLead}</p>
          <small class="reflex-pdf-notice">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            {data.pdfNotice}
          </small>
        </div>

        <div class="reflex-download-action">
          <a class="button button-large" href="/documents/reflex-medical-catalogue.pdf" download="REFLEX-Medical-Catalogue.pdf" data-catalog-download data-catalog-language={currentLang}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            {data.downloadButton}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Request for Commercial Quotation (RFQ) Section -->
  <section class="section reflex-rfq-section" id="rfq-form">
    <div class="container">
      <div class="reflex-rfq-grid">
        <div class="reflex-rfq-info">
          <span class="eyebrow">{ui.rfqEyebrow}</span>
          <h2>{ui.rfqTitle}</h2>
          <p class="lead reflex-rfq-lead">{data.rfqLead}</p>

          <div class="reflex-rfq-trust-box">
            <h4 class="reflex-rfq-trust-heading">{ui.rfqTrustTitle}</h4>
            <ul class="reflex-rfq-trust-list">
              {ui.trustItems.map((item) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="reflex-rfq-features">
            <div class="reflex-rfq-feat">
              <strong>{ui.logisticsTitle}</strong>
              <p>{ui.logisticsText}</p>
            </div>
            <div class="reflex-rfq-feat">
              <strong>{ui.documentsTitle}</strong>
              <p>{ui.documentsText}</p>
            </div>
            <div class="reflex-rfq-feat">
              <strong>{ui.verificationTitle}</strong>
              <p>{ui.verificationText}</p>
            </div>
          </div>
        </div>

        <div class="reflex-rfq-form-card">
          <form class="reflex-form" id="reflex-rfq-fields" data-reflex-form data-commercial-form action="/api/contact" method="post">
            <input type="hidden" name="locale" value={currentLang} />
            <input type="hidden" name="intent" value="buyer_request" />
            <input type="hidden" name="tradeDirection" value="import_to_turkiye" />
            <input type="hidden" name="productFamily" value="reflex_gloves" />
            <input type="hidden" name="startedAt" value="" data-rfq-started-at />
            <input type="hidden" name="pagePath" value="" data-rfq-page-path />
            <div class="form-honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>

            <div class="form-row">
              <div class="form-group commercial-field">
                <span><label for="rfq-name">{data.formLabels.name} *</label></span>
                <input type="text" id="rfq-name" name="name" required maxlength="120" autocomplete="name" />
              </div>
              <div class="form-group commercial-field">
                <span><label for="rfq-email">{data.formLabels.email} *</label></span>
                <input type="email" id="rfq-email" name="emailOrPhone" required maxlength="254" autocomplete="email" placeholder="company@domain.com" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group commercial-field">
                <span><label for="rfq-phone">{data.formLabels.phone}</label></span>
                <input type="tel" id="rfq-phone" name="phone" maxlength="80" autocomplete="tel" placeholder="+1 234 567 890" />
              </div>
              <div class="form-group commercial-field">
                <span><label for="rfq-company">{data.formLabels.company} *</label></span>
                <input type="text" id="rfq-company" name="company" required maxlength="160" autocomplete="organization" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group commercial-field">
                <span><label for="rfq-country">{data.formLabels.country} *</label></span>
                <input type="text" id="rfq-country" name="destinationMarket" required maxlength="100" autocomplete="country-name" />
              </div>
              <div class="form-group commercial-field">
                <span><label for="rfq-product">{data.formLabels.product}</label></span>
                <select id="rfq-product" name="product">
                  <option value={allProductsOption}>{allProductsOption}</option>
                  {data.categories.map((c) => (<option value={c.name}>{c.name}</option>))}
                </select>
              </div>
            </div>

            <div class="form-group commercial-field">
              <span><label for="rfq-volume">{data.formLabels.volume}</label></span>
              <input type="text" id="rfq-volume" name="quantity" maxlength="120" placeholder={volumePlaceholder} />
            </div>

            <div class="form-row">
              <div class="form-group commercial-field">
                <span><label for="rfq-incoterm">{rfqExtra.incoterm}</label></span>
                <input type="text" id="rfq-incoterm" name="incoterm" maxlength="30" placeholder="FOB, CIF or DAP" />
              </div>
              <div class="form-group commercial-field">
                <span><label for="rfq-target-date">{rfqExtra.targetDate}</label></span>
                <input type="date" id="rfq-target-date" name="targetDate" />
              </div>
            </div>

            <div class="form-group commercial-field commercial-field--full">
              <span><label for="rfq-notes">{data.formLabels.notes}</label></span>
              <textarea id="rfq-notes" name="message" maxlength="2000" rows="4" placeholder={notesPlaceholder}></textarea>
            </div>

            <label class="reflex-rfq-privacy">
              <input type="checkbox" name="privacy" value="accepted" required />
              <span>{rfqPrivacy.label} <a href={rfqPrivacyHref}>{rfqPrivacy.link}</a></span>
            </label>
            <p class="reflex-rfq-status" data-rfq-status role="status" aria-live="polite"></p>
            <button type="submit" class="button button-large button-block">{data.formLabels.submit}</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</div>

