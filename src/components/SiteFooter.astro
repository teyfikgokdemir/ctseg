---
import { company, companyCopy, legal, legalIds, localizedPath, ui, type Locale } from '../data/site';
import { duzceGlassPath, type DuzceGlassLocale } from '../data/duzce-glass';
import { generatedImageSrc, LOGO_IMAGE } from '../lib/responsive-images';
const { lang, pageKey } = Astro.props as { lang: Locale; pageKey?: string };
const t = ui[lang] || ui.en;
const corporate = companyCopy[lang] || companyCopy.en;
const year = new Date().getFullYear();
const descriptionMap: Record<string, string> = {
  tr:'Türkiye merkezli uluslararası ticaret eşleştirme ve bağımsız ticari koordinasyon.',
  en:'A Türkiye-based two-way global trade and strategic sourcing house connecting companies, manufacturers and buyers across markets.',
  de:'Ein in der Türkei ansässiges, beidseitig arbeitendes Haus für globalen Handel, Nearshoring und strategische Beschaffung.',
  it:'Una trade house con base in Turchia per commercio globale bidirezionale, market entry e sourcing strategico.',
  fr:'Une maison de commerce basée en Turquie pour le sourcing stratégique et les échanges internationaux bidirectionnels.',
  ru:'Торговый дом в Турции для двусторонней международной торговли, выхода на рынки и стратегического сорсинга.',
  fa:'خانه تجارت و تأمین استراتژیک مستقر در ترکیه برای تجارت دوطرفه میان ترکیه و بازارهای جهانی.',
  zh:'立足土耳其、连接中国与土耳其、欧洲及全球市场的双向国际贸易与战略采购服务机构。',
  vi:'Nhà thương mại và sourcing chiến lược hai chiều có trụ sở tại Thổ Nhĩ Kỳ, kết nối doanh nghiệp Việt Nam với Thổ Nhĩ Kỳ, châu Âu và các thị trường toàn cầu.',
  sq:'Shtëpi tregtare me bazë në Turqi për tregti ndërkombëtare dykahëshe dhe sourcing strategjik.',
  mk:'Трговска куќа со седиште во Турција за двонасочна глобална трговија и стратешка набавка.',
  sr:'Trgovinska kuća sa sedištem u Türkiye za dvosmernu globalnu trgovinu i strateški sourcing.',
  ro:'Casă de comerț B2B cu sediul în Türkiye pentru comerț global bidirecțional, sourcing strategic și acces pe piețe.',
  bg:'B2B търговска къща със седалище в Türkiye за двупосочна глобална търговия, стратегическо снабдяване и пазарен достъп.'
};
const description = descriptionMap[lang] || descriptionMap.en;
const copyrightMap: Record<string, string> = {
  tr:`© ${year} CTSEG. Tüm hakları saklıdır.`,
  en:`© ${year} CTSEG. All rights reserved.`,
  de:`© ${year} CTSEG. Alle Rechte vorbehalten.`,
  it:`© ${year} CTSEG. Tutti i diritti riservati.`,
  fr:`© ${year} CTSEG. Tous droits réservés.`,
  ru:`© ${year} CTSEG. Все права защищены.`,
  fa:`© ${year} CTSEG. تمامی حقوق محفوظ است.`,
  zh:`© ${year} CTSEG. 保留所有权利。`,
  vi:`© ${year} CTSEG. Bảo lưu mọi quyền.`,
  sq:`© ${year} CTSEG. Të gjitha të drejtat të rezervuara.`,
  mk:`© ${year} CTSEG. Сите права се задржани.`,
  sr:`© ${year} CTSEG. Sva prava zadržana.`,
  ro:`© ${year} CTSEG. Toate drepturile rezervate.`,
  bg:`© ${year} CTSEG. Всички права запазени.`
};
const copyright = copyrightMap[lang] || copyrightMap.en;
const marketLocales: Array<{ code:string; flagSrc:string; label:string; href:string }> = [
  { code:'tr', flagSrc:'/images/flags/tr.svg', label:'Türkçe', href:'/' },
  { code:'en', flagSrc:'/images/flags/gb.svg', label:'English', href:'/en/' },
  { code:'de', flagSrc:'/images/flags/de.svg', label:'Deutschland', href:'/de/' },
  { code:'it', flagSrc:'/images/flags/it.svg', label:'Italia', href:'/it/' },
  { code:'fa', flagSrc:'/images/flags/ir.svg', label:'ایران', href:'/fa/' },
  { code:'ru', flagSrc:'/images/flags/ru.svg', label:'Россия', href:'/ru/' },
  { code:'zh', flagSrc:'/images/flags/cn.svg', label:'中国', href:'/zh/' },
  { code:'vi', flagSrc:'/images/flags/vn.svg', label:'Việt Nam', href:'/vi/' },
  { code:'ro', flagSrc:'/images/flags/ro.svg', label:'România', href:'/ro/' },
  { code:'bg', flagSrc:'/images/flags/bg.svg', label:'България', href:'/bg/' },
  { code:'sr', flagSrc:'/images/flags/rs.svg', label:'Srbija', href:'/sr/' },
  { code:'uk', flagSrc:'/images/flags/ua.svg', label:'Україна', href:'/uk/' }
];
const marketLabel = ({tr:'Global Pazarlar',en:'Global Markets',de:'Globale Märkte',it:'Mercati globali',fa:'بازارهای جهانی',ru:'Глобальные рынки',zh:'全球市场',vi:'Thị trường toàn cầu',ro:'Piețe globale',bg:'Глобални пазари',sr:'Globalna tržišta'} as Record<string,string>)[lang] || 'Global Markets';
const footerNav = ({
  tr:{portfolio:'Ticaret Portföyü',overview:'Portföyü İnceleyin',sourcing:'Stratejik Tedarik',marketEntry:'İhracat ve Pazara Giriş',intelligence:'Ticaret İçgörüleri'},
  en:{portfolio:'Trade Portfolio',overview:'Explore the Portfolio',sourcing:'Strategic Sourcing',marketEntry:'Export & Market Entry',intelligence:'Trade Intelligence'},
  de:{portfolio:'Handelsportfolio',overview:'Portfolio ansehen',sourcing:'Strategische Beschaffung',marketEntry:'Export & Markteintritt',intelligence:'Handelswissen'},
  it:{portfolio:'Portafoglio Commerciale',overview:'Esplora il portafoglio',sourcing:'Sourcing Strategico',marketEntry:'Export & Market Entry',intelligence:'Intelligence Commerciale'},
  ru:{portfolio:'Торговый портфель',overview:'Смотреть портфель',sourcing:'Стратегический сорсинг',marketEntry:'Экспорт и выход на рынок',intelligence:'Торговая аналитика'},
  fa:{portfolio:'سبد تجاری',overview:'مشاهده سبد تجاری',sourcing:'تأمین استراتژیک',marketEntry:'صادرات و ورود به بازار',intelligence:'بینش تجاری'},
  zh:{portfolio:'贸易组合',overview:'查看贸易组合',sourcing:'战略采购',marketEntry:'出口与市场进入',intelligence:'贸易洞察'},
  vi:{portfolio:'Danh mục thương mại',overview:'Khám phá danh mục',sourcing:'Sourcing chiến lược',marketEntry:'Xuất khẩu & thâm nhập thị trường',intelligence:'Thông tin thương mại'},
  ro:{portfolio:'Portofoliu Comercial',overview:'Vezi portofoliul',sourcing:'Sourcing strategic',marketEntry:'Export și intrare pe piață',intelligence:'Analize comerciale'},
  bg:{portfolio:'Търговско портфолио',overview:'Виж портфолиото',sourcing:'Стратегическо снабдяване',marketEntry:'Износ и навлизане на пазара',intelligence:'Търговски анализи'},
  sr:{portfolio:'Trgovinski portfolio',overview:'Pogledaj portfolio',sourcing:'Strateški sourcing',marketEntry:'Izvoz i ulazak na tržište',intelligence:'Trgovinski uvidi'}
} as Record<string,{portfolio:string;overview:string;sourcing:string;marketEntry:string;intelligence:string}>)[lang] || {portfolio:'Trade Portfolio',overview:'Explore the Portfolio',sourcing:'Strategic Sourcing',marketEntry:'Export & Market Entry',intelligence:'Trade Intelligence'};
const statementMap: Record<string,string> = {
  tr:'SINIRLARIN ÖTESİNDE TİCARET.',
  en:'TRADE WITHOUT BORDERS.',
  de:'HANDEL OHNE GRENZEN.',
  it:'COMMERCIO SENZA CONFINI.',
  ru:'ТОРГОВЛЯ БЕЗ ГРАНИЦ.',
  fa:'تجارت فراتر از مرزها',
  zh:'跨越边界，连接贸易。',
  vi:'THƯƠNG MẠI VƯỢT BIÊN GIỚI.',
  ro:'COMERȚ DINCOLO DE GRANIȚE.',
  bg:'ТЪРГОВИЯ ОТВЪД ГРАНИЦИТЕ.',
  sr:'TRGOVINA BEZ GRANICA.'
};
const footerStatement = statementMap[lang] || statementMap.en;
const focusedCountryHome = pageKey === 'home' && ['de','it','ru','fa','zh','vi'].includes(lang);
const showGenericPortfolio = !focusedCountryHome;
const showGlassLink = !focusedCountryHome || lang === 'fa';
const safeGlassLang = (['tr','en','de','it','ru','fa','zh','vi','ro','bg','sr'].includes(lang) ? lang : 'en') as DuzceGlassLocale;
---
<footer class="site-footer">
  <div class="footer-markets-wrap"><div class="container footer-markets"><div class="footer-markets-label"><span class="footer-markets-kicker">CTSEG</span><strong>{marketLabel}</strong></div><nav class="footer-market-links" aria-label={marketLabel}>{marketLocales.map((item) => (<a href={item.href} class:list={['footer-market-link', item.code === lang && 'is-active']} aria-current={item.code === lang ? 'page' : undefined} data-footer-locale={item.code}><img aria-hidden="true" class="footer-market-flag" src={item.flagSrc} width="24" height="16" alt="" loading="lazy" decoding="async" /><span>{item.label}</span></a>))}</nav></div></div>
  <div class="container footer-statement" aria-hidden="true">
    <span>CTSEG · GLOBAL TRADE HOUSE</span>
    <strong>{footerStatement}</strong>
    <i>Türkiye ↔ Europe ↔ Middle East ↔ Asia</i>
  </div>
  <div class="container footer-main">
    <div class="footer-brand"><a class="brand" href={localizedPath(lang, 'home')}><img src={generatedImageSrc(LOGO_IMAGE,320)} width="320" height="103" alt="CTSEG" loading="lazy" decoding="async" /></a><p>{description}</p><div class="footer-company"><strong>{company.name[lang] || company.name.en}</strong><span>{company.foundingYear} · {corporate.footerLocation}</span></div></div>
    <nav aria-label={footerNav.portfolio}><strong>{focusedCountryHome ? 'CTSEG' : footerNav.portfolio}</strong>{showGenericPortfolio && <a href={localizedPath(lang, 'products')}>{footerNav.overview}</a>}<a href={localizedPath(lang,'services','strategic-sourcing')}>{footerNav.sourcing}</a><a href={localizedPath(lang,'services','market-entry')}>{footerNav.marketEntry}</a>{showGlassLink && <a href={duzceGlassPath(safeGlassLang)}>{({tr:'Düzce Cam Dış Ticaret',en:'Düzce Float Glass Export',de:'Düzce Float Glass Export',it:'Düzce Float Glass Export',fa:'صادرات شیشه Düzce',ru:'Экспорт Düzce Float Glass',zh:'Düzce 浮法玻璃出口',vi:'Xuất khẩu Düzce Float Glass',ro:'Export Düzce Float Glass',bg:'Износ Düzce Float Glass',sr:'Izvoz Düzce Float Glass',sq:'Düzce Float Glass',mk:'Düzce Float Glass'}[lang] || 'Düzce Float Glass Export')}</a>}<a href={localizedPath(lang, 'markets')}>{t.markets}</a><a href={localizedPath(lang, 'insights')}>{footerNav.intelligence}</a></nav>
    <nav aria-label={t.contact}><strong>CTSEG</strong><a href={localizedPath(lang, 'about')}>{t.about}</a>{(lang === 'tr' || lang === 'en' || lang === 'fa' || lang === 'zh' || lang === 'vi' || lang === 'ro' || lang === 'bg' || lang === 'sr') && <a href={localizedPath(lang,'how-we-work')}>{lang === 'tr' ? 'Nasıl çalışıyoruz?' : lang === 'fa' ? 'چگونه کار می‌کنیم؟' : lang === 'zh' ? '运作模式' : lang === 'vi' ? 'Phương thức hoạt động' : lang === 'ro' ? 'Cum lucrăm' : lang === 'bg' ? 'Как работим' : lang === 'sr' ? 'Kako radimo' : 'How we work'}</a>}<a href={localizedPath(lang, 'contact')}>{t.contact}</a><a href={`mailto:${company.email}`}>{company.email}</a><a href="https://t.me/teyfikgokdemir" target="_blank" rel="noopener noreferrer" aria-label="Telegram: @teyfikgokdemir">Telegram (@teyfikgokdemir)</a></nav>
  </div>
  <div class="container footer-bottom"><p>{copyright}</p><nav aria-label="Legal">{legalIds.map((id) => <a href={localizedPath(lang, 'legal', id)}>{legal[id].titles[lang] || legal[id].titles.en}</a>)}</nav></div>
</footer>
<style is:global>
  .footer-markets-wrap{border-bottom:1px solid rgba(255,255,255,.14);border-top:1px solid rgba(255,255,255,.1);background:#111}.footer-markets{display:grid;grid-template-columns:minmax(180px,.8fr) minmax(0,2.7fr);gap:32px;align-items:center;padding-top:28px;padding-bottom:28px}.footer-markets-label{display:flex;align-items:baseline;gap:12px;min-width:0}.footer-markets-kicker{font-size:11px;line-height:1;letter-spacing:.18em;text-transform:uppercase;color:#c4f000;font-weight:800}.footer-markets-label strong{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#fff;white-space:nowrap}.footer-market-links{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;min-width:0}.footer-market-link{display:flex;align-items:center;justify-content:center;gap:7px;min-width:0;padding:11px 8px;border:1px solid rgba(255,255,255,.14);border-radius:999px;color:#d8d8d8;text-decoration:none;font-size:12px;line-height:1;white-space:nowrap;transition:background-color .2s ease,color .2s ease,border-color .2s ease,transform .2s ease}.footer-market-link:hover,.footer-market-link:focus-visible{border-color:#c4f000;color:#fff;transform:translateY(-1px)}.footer-market-link.is-active{background:#c4f000;border-color:#c4f000;color:#0a0a0a;font-weight:800}.footer-market-flag{width:24px;height:16px;display:block;object-fit:cover;border-radius:2px;box-shadow:0 0 0 1px rgba(255,255,255,.12)}
  .footer-statement{position:relative;display:grid;gap:14px;padding-top:clamp(42px,4vw,62px);padding-bottom:clamp(42px,4vw,62px);border-bottom:1px solid rgba(255,255,255,.12);overflow:hidden;text-align:center;justify-items:center}.footer-statement::after{content:"CTSEG";position:absolute;left:50%;bottom:-.12em;transform:translateX(-50%);font-size:clamp(110px,15vw,240px);font-weight:900;line-height:.76;letter-spacing:-.08em;color:rgba(255,255,255,.022);pointer-events:none}.footer-statement>span,.footer-statement>strong,.footer-statement>i{position:relative;z-index:1}.footer-statement>span{color:#c4f000;font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.footer-statement>strong{max-width:none;color:#fff;font-size:clamp(30px,3.6vw,56px);font-weight:760;line-height:1;letter-spacing:-.035em;white-space:nowrap;text-wrap:nowrap;text-align:center}.footer-statement>i{color:#a8a8a1;font-size:11px;font-style:normal;font-weight:750;letter-spacing:.08em;text-transform:uppercase}
  .hero-visual figcaption small,.platform-sector-grid article>div>span,.market-line>div>span,.detailed-process li>span,.scenario-heading>span,.market-role-grid article>span,.card>small,.trust-facts dt{display:none!important}.market-line>div,.detailed-process li,.scenario-heading{grid-template-columns:minmax(0,1fr)!important}
  .card-grid{gap:18px!important;align-items:stretch}.card-grid .card,.market-role-grid article,.answer-grid article,.scenario-list article,.detailed-process li{position:relative!important;border:1px solid #dedcd5!important;border-radius:22px!important;background:linear-gradient(145deg,#fff 0%,#f8f7f3 100%)!important;box-shadow:0 18px 48px rgba(12,12,12,.055)!important;overflow:hidden!important;transition:transform .28s ease,border-color .28s ease,box-shadow .28s ease!important}.card-grid .card{min-height:310px!important;padding:32px 30px!important;display:flex!important;flex-direction:column!important;text-decoration:none!important}.card-grid .card::before,.market-role-grid article::before,.answer-grid article::before,.scenario-list article::before,.detailed-process li::before{content:"";position:absolute;left:0;top:0;width:100%;height:4px;background:#c4f000;transform:scaleX(.18);transform-origin:left center;transition:transform .3s ease}.card-grid .card::after{content:"↗";position:absolute;top:24px;right:26px;font-size:20px;line-height:1;color:#aaa79d;transition:transform .25s ease,color .25s ease}.card-grid .card h2,.card-grid .card h3{margin:22px 0 14px!important;max-width:15ch;font-size:clamp(25px,2.25vw,38px)!important;line-height:1.02!important;letter-spacing:-.035em!important;color:#111!important}.card-grid .card p{margin:0 0 28px!important;max-width:34em;color:#4c4c49!important;line-height:1.6!important}.card-grid .card>strong{margin-top:auto!important;width:max-content;padding:9px 13px;border-radius:999px;background:#151515;color:#fff!important;font-size:12px!important;letter-spacing:.04em;text-transform:uppercase}.card-grid .card:hover,.market-role-grid article:hover,.answer-grid article:hover,.scenario-list article:hover,.detailed-process li:hover{transform:translateY(-5px);border-color:#c4f000!important;box-shadow:0 24px 60px rgba(12,12,12,.09)!important}.card-grid .card:hover::before,.market-role-grid article:hover::before,.answer-grid article:hover::before,.scenario-list article:hover::before,.detailed-process li:hover::before{transform:scaleX(1)}.card-grid .card:hover::after{transform:translate(3px,-3px);color:#111}
  .market-role-grid{gap:18px!important}.market-role-grid article{padding:32px!important;min-height:300px!important}.market-role-grid article h2{font-size:clamp(27px,2.4vw,40px)!important;line-height:1.03!important;letter-spacing:-.035em!important;color:#111!important}.market-role-grid article ul{margin-top:26px!important;padding-left:18px!important}.market-role-grid article li{margin:9px 0!important;color:#42423f!important;line-height:1.5!important}.answer-grid{gap:18px!important}.answer-grid article{padding:30px!important;min-height:210px!important}.answer-grid article h3{font-size:clamp(22px,1.9vw,30px)!important;line-height:1.1!important;letter-spacing:-.025em!important;color:#111!important}.answer-grid article p{color:#4d4d49!important;line-height:1.62!important}.detailed-process{gap:16px!important}.detailed-process li{padding:30px!important;min-height:150px!important;display:flex!important;align-items:flex-end!important}.detailed-process li h2{font-size:clamp(23px,2vw,34px)!important;line-height:1.08!important;letter-spacing:-.03em!important;color:#111!important}.scenario-list{gap:20px!important}.scenario-list article{padding:32px!important}.scenario-list article h2{font-size:clamp(25px,2.2vw,36px)!important;line-height:1.04!important;color:#111!important}
  @media (max-width:1100px){.footer-markets{grid-template-columns:1fr;gap:18px}.footer-market-links{grid-template-columns:repeat(4,minmax(0,1fr))}.footer-markets-label{justify-content:space-between}}
  @media (max-width:720px){.footer-statement{gap:12px;padding-top:42px;padding-bottom:42px}.footer-statement>strong{font-size:clamp(30px,9vw,44px);max-width:100%;white-space:normal;text-wrap:balance}.card-grid .card,.market-role-grid article,.answer-grid article,.scenario-list article,.detailed-process li{border-radius:18px!important;padding:24px!important;min-height:auto!important}.card-grid .card h2,.card-grid .card h3{font-size:28px!important}}
  @media (max-width:620px){.footer-markets{padding-top:22px;padding-bottom:22px}.footer-market-links{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.footer-market-link{justify-content:flex-start;padding:12px 14px;font-size:12px}.footer-statement>i{font-size:10px;line-height:1.5}}
</style>
<script src="/premium-motion.js" defer></script>
