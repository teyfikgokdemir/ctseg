---
import {serviceMap} from '../data/hebrew';
import {getRouteRecords,getMeta} from '../lib/routes';
import {company,legal,legalIds,localizedPath} from '../data/site';
import {globalCopy} from '../data/global-sourcing-locales';
import {globalHome,globalPath} from '../data/global-sourcing';
const {lang}=Astro.props;const c=globalCopy[lang];
const resources=getRouteRecords().filter(record=>record.lang===lang && (['search-landing','markets','insights','scenarios','syria-market','poultry-feed','iran-trade','vietnam-turkiye','china-turkiye','ukraine-turkiye'].includes(record.key) && !record.id || record.key==='services' && record.id || record.key==='search-landing' || record.key==='poultry-feed'));
const resourceLabel=(record:any)=>getMeta(record).title;
const heLegal={privacy:'/he/מדיניות-פרטיות/',cookies:'/he/מדיניות-עוגיות/',terms:'/he/תנאי-שימוש/','data-protection':'/he/הודעת-הגנת-מידע/'};
const heLabels={privacy:'מדיניות פרטיות',cookies:'מדיניות עוגיות',terms:'תנאי שימוש','data-protection':'הודעת פרטיות'};
---
<footer class="gs-footer"><div class="gs-footer-inner"><div><a href={globalHome(lang)}><img src="/images/ctseg-brand-footer.svg" width="190" height="42" alt="CTSEG" loading="lazy" /></a><p>{c.lead}</p><a href={'mailto:'+company.email}>{company.email}</a></div><nav aria-label={c.nav[2]}><a href={globalPath(lang,'solutions')}>{c.nav[2]}</a><a href={globalPath(lang,'industries')}>{c.nav[3]}</a><a href={globalPath(lang,'global-markets')}>{c.nav[4]}</a><a href={lang==='he'?'/he/יצירת-קשר/':localizedPath(lang,'contact')}>{c.nav[6]}</a></nav></div><details class="gs-footer-resources"><summary>{c.explore}</summary><nav>{resources.map(record=><a href={record.path?`/${lang}/${record.path}/`:globalHome(lang)}>{resourceLabel(record)}</a>)}{lang==='he' && <>{Object.values(serviceMap).map(service=><a href={`/he/שירותים/${service.slug}/`}>{service.name}</a>)}<a href="/he/תרחישים-מסחריים/">{c.scope}</a></>}</nav></details><div class="gs-footer-bottom"><span>© {new Date().getFullYear()} CTSEG</span><nav aria-label={c.legalLabel}>{legalIds.map(id=><a href={lang==='he'?heLegal[id]:localizedPath(lang,'legal',id)}>{lang==='he'?heLabels[id]:legal[id].titles[lang]}</a>)}</nav><a href="https://qctcommerce.com/" target="_blank" rel="noopener noreferrer">QCT Commerce</a></div></footer>
<style is:global>
.gs-footer-resources{width:min(1320px,calc(100% - 80px));margin:30px auto 0;font-size:14px}.gs-footer-resources summary{cursor:pointer;min-height:44px}.gs-footer-resources nav{padding:16px 0}.gs-footer-resources a{max-width:100%;overflow-wrap:anywhere}.gs-footer{background:#172019;color:#f5f3eb;padding:64px 0 28px;font-family:'DM Sans',sans-serif}.gs-footer-inner,.gs-footer-bottom{width:min(1320px,calc(100% - 80px));margin-inline:auto;display:flex;justify-content:space-between;gap:40px}.gs-footer-inner>div{max-width:600px}.gs-footer-inner img{display:block;width:190px;height:auto}.gs-footer p{font-size:18px;line-height:1.6;color:#e1e6d9}.gs-footer a{color:inherit;text-decoration:none;min-height:44px;display:inline-flex;align-items:center}.gs-footer a:hover{text-decoration:underline}.gs-footer nav{display:flex;gap:12px 26px;flex-wrap:wrap}.gs-footer-inner>nav{max-width:340px;align-content:start}.gs-footer-bottom{margin-top:48px;padding-top:22px;border-top:1px solid #4d5948;align-items:center;font-size:13px}.gs-footer a:focus-visible{outline:2px solid #c4f000;outline-offset:4px}@media(max-width:760px){.gs-footer{padding-top:44px}.gs-footer-inner,.gs-footer-bottom{width:calc(100% - 36px);flex-direction:column;gap:22px;align-items:start}.gs-footer-bottom{margin-top:30px}.gs-footer nav{gap:4px 20px}}
</style>
