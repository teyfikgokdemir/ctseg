---
import { company, companyCopy, legal, legalIds, localizedPath, ui, type Locale } from '../data/site';
import { reflexPath } from '../data/reflex-data';
import { generatedImageSrc, LOGO_IMAGE } from '../lib/responsive-images';
const { lang } = Astro.props as { lang: Locale };
const t = ui[lang] || ui.en;
const corporate = companyCopy[lang] || companyCopy.en;
const year = new Date().getFullYear();
const descriptionMap: Record<string, string> = {
  tr:'Türkiye merkezli uluslararası ticaret eşleştirme ve bağımsız ticari koordinasyon.',
  en:'A Türkiye-based two-way global trade and strategic sourcing house connecting companies, manufacturers and buyers across markets.',
  de:'Ein in der Türkei ansässiges, beidseitig arbeitendes Haus für globalen Handel, Nearshoring und strategische Beschaffung.',
  it:'Una trade house con base in Turchia per commercio globale bidirezionale, market entry e sourcing strategico.',
  fr:'Une maison de commerce basée en Turquie pour le sourcing stratégique et les échanges internationaux bidirectionnels.',
  ru:'Торговый дом в Турции для двусторонней международной торговли, выхода на рынки и стратегического сорсинга.',
  fa:'خانه تجارت و تأمین استراتژیک مستقر در ترکیه برای تجارت دوطرفه میان ترکیه و بازارهای جهانی.',
  zh:'立足土耳其、连接中国与土耳其、欧洲及全球市场的双向国际贸易与战略采购服务机构。',
  vi:'Nhà thương mại và sourcing chiến lược hai chiều có trụ sở tại Thổ Nhĩ Kỳ, kết nối doanh nghiệp Việt Nam với Thổ Nhĩ Kỳ, châu Âu và các thị trường toàn cầu.',
  sq:'Shtëpi tregtare me bazë në Turqi për tregti ndërkombëtare dykahëshe dhe sourcing strategjik.',
  mk:'Трговска куќа со седиште во Турција за двонасочна глобална трговија и стратешка набавка.',
  sr:'Trgovinska kuća sa sedištem u Turskoj za dvosmernu globalnu trgovinu i stratešku nabavku.'
};
const description = descriptionMap[lang] || descriptionMap.en;
const copyrightMap: Record<string, string> = {
  tr:`© ${year} CTSEG. Tüm hakları saklıdır.`,
  en:`© ${year} CTSEG. All rights reserved.`,
  de:`© ${year} CTSEG. Alle Rechte vorbehalten.`,
  it:`© ${year} CTSEG. Tutti i diritti riservati.`,
  fr:`© ${year} CTSEG. Tous droits réservés.`,
  ru:`© ${year} CTSEG. Все права защищены.`,
  fa:`© ${year} CTSEG. تمامی حقوق محفوظ است.`,
  zh:`© ${year} CTSEG. 保留所有权利。`,
  vi:`© ${year} CTSEG. Bảo lưu mọi quyền.`,
  sq:`© ${year} CTSEG. Të gjitha të drejtat të rezervuara.`,
  mk:`© ${year} CTSEG. Сите права се задржани.`,
  sr:`© ${year} CTSEG. Sva prava zadržana.`
};
const copyright = copyrightMap[lang] || copyrightMap.en;
const marketLocales: Array<{ code: Locale; flag:string; label:string; href:string }> = [
  { code:'tr', flag:'🇹🇷', label:'Türkiye', href:'/' },
  { code:'en', flag:'🇬🇧', label:'English', href:'/en/' },
  { code:'de', flag:'🇩🇪', label:'Deutschland', href:'/de/' },
  { code:'it', flag:'🇮🇹', label:'Italia', href:'/it/' },
  { code:'fa', flag:'🇮🇷', label:'ایران', href:'/fa/' },
  { code:'ru', flag:'🇷🇺', label:'Россия', href:'/ru/' },
  { code:'zh', flag:'🇨🇳', label:'中国', href:'/zh/' },
  { code:'vi', flag:'🇻🇳', label:'Việt Nam', href:'/vi/' }
];
const marketLabel = ({tr:'Global Pazarlar',en:'Global Markets',de:'Globale Märkte',it:'Mercati globali',fa:'بازارهای جهانی',ru:'Глобальные рынки',zh:'全球市场',vi:'Thị trường toàn cầu'} as Record<string,string>)[lang] || 'Global Markets';
---
<link rel="stylesheet" href="/premium-trade-house.css" />
<link rel="stylesheet" href="/premium-responsive-fixes.css" />
<footer class="site-footer">
  <div class="footer-markets-wrap">
    <div class="container footer-markets">
      <div class="footer-markets-label">
        <span class="footer-markets-kicker">CTSEG</span>
        <strong>{marketLabel}</strong>
      </div>
      <nav class="footer-market-links" aria-label={marketLabel}>
        {marketLocales.map((item) => (
          <a
            href={item.href}
            class:list={['footer-market-link', item.code === lang && 'is-active']}
            aria-current={item.code === lang ? 'page' : undefined}
            data-footer-locale={item.code}
          >
            <span aria-hidden="true" class="footer-market-flag">{item.flag}</span>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
    </div>
  </div>
  <div class="container footer-main">
    <div class="footer-brand">
      <a class="brand" href={localizedPath(lang, 'home')}><img src={generatedImageSrc(LOGO_IMAGE,320)} width="320" height="103" alt="CTSEG" loading="lazy" decoding="async" /></a>
      <p>{description}</p>
      <div class="footer-company">
        <strong>{company.name[lang] || company.name.en}</strong>
        <span>{company.foundingYear} · {corporate.footerLocation}</span>
      </div>
    </div>
    <nav aria-label={t.products}>
      <strong>{t.products}</strong>
      <a href={localizedPath(lang, 'products')}>{t.allProducts}</a>
      <a href={reflexPath(lang)}>{({
        tr: 'REFLEX Medikal Eldivenler',
        en: 'REFLEX Medical Gloves',
        de: 'REFLEX Medizinische Handschuhe',
        it: 'Guanti Medici REFLEX',
        fa: 'دستکش‌های پزشکی REFLEX',
        ru: 'Медицинские перчатки REFLEX',
        zh: 'REFLEX 医用与防护手套',
        vi: 'Găng tay y tế REFLEX',
        sq: 'Doreza Mjekësore REFLEX',
        mk: 'REFLEX Медицински Ракавици',
        sr: 'REFLEX Medicinske Rukavice'
      }[lang] || 'REFLEX Medical Gloves')}</a>
      <a href={localizedPath(lang, 'markets')}>{t.markets}</a>
      <a href={localizedPath(lang, 'insights')}>{t.insights}</a>
    </nav>
    <nav aria-label={t.contact}>
      <strong>CTSEG</strong>
      <a href={localizedPath(lang, 'about')}>{t.about}</a>
      {(lang === 'tr' || lang === 'en' || lang === 'fa' || lang === 'zh' || lang === 'vi') && <a href={localizedPath(lang,'how-we-work')}>{lang === 'tr' ? 'Nasıl çalışıyoruz?' : lang === 'fa' ? 'چگونه کار می‌کنیم؟' : lang === 'zh' ? '运作模式' : lang === 'vi' ? 'Phương thức hoạt động' : 'How we work'}</a>}
      <a href={localizedPath(lang, 'contact')}>{t.contact}</a>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href="https://t.me/teyfikgokdemir" target="_blank" rel="noopener noreferrer" aria-label="Telegram: @teyfikgokdemir">Telegram (@teyfikgokdemir)</a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>{copyright}</p>
    <nav aria-label="Legal">
      {legalIds.map((id) => <a href={localizedPath(lang, 'legal', id)}>{legal[id].titles[lang] || legal[id].titles.en}</a>)}
    </nav>
  </div>
</footer>
<style is:global>
  .footer-markets-wrap{border-bottom:1px solid rgba(255,255,255,.14);border-top:1px solid rgba(255,255,255,.1);background:#111}
  .footer-markets{display:grid;grid-template-columns:minmax(180px,.8fr) minmax(0,2.7fr);gap:32px;align-items:center;padding-top:28px;padding-bottom:28px}
  .footer-markets-label{display:flex;align-items:baseline;gap:12px;min-width:0}
  .footer-markets-kicker{font-size:11px;line-height:1;letter-spacing:.18em;text-transform:uppercase;color:#c4f000;font-weight:800}
  .footer-markets-label strong{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#fff;white-space:nowrap}
  .footer-market-links{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:8px;min-width:0}
  .footer-market-link{display:flex;align-items:center;justify-content:center;gap:7px;min-width:0;padding:11px 8px;border:1px solid rgba(255,255,255,.14);border-radius:999px;color:#d8d8d8;text-decoration:none;font-size:12px;line-height:1;white-space:nowrap;transition:background-color .2s ease,color .2s ease,border-color .2s ease,transform .2s ease}
  .footer-market-link:hover,.footer-market-link:focus-visible{border-color:#c4f000;color:#fff;transform:translateY(-1px)}
  .footer-market-link.is-active{background:#c4f000;border-color:#c4f000;color:#0a0a0a;font-weight:800}
  .footer-market-flag{font-size:15px;line-height:1}

  /* Remove decorative sequence numbers across CTSEG cards and editorial lists. */
  .hero-visual figcaption small,
  .platform-sector-grid article>div>span,
  .corridor-list>div>span,
  .market-line>div>span,
  .operational-trust-panel li>span,
  .detailed-process li>span,
  .scenario-heading>span,
  .market-role-grid article>span,
  .card>small,
  .trust-facts dt{display:none!important}

  /* Restore natural layout after removing number columns. */
  .corridor-list>div{grid-template-columns:minmax(0,1fr)!important}
  .market-line>div{grid-template-columns:minmax(0,1fr)!important}
  .detailed-process li,.scenario-heading{grid-template-columns:minmax(0,1fr)!important}

  /* Premium operational-trust cards: airy, editorial and number-free. */
  .operational-trust .content-grid{grid-template-columns:minmax(0,.9fr) minmax(520px,1.1fr)!important;gap:clamp(42px,6vw,96px)!important;align-items:start}
  .operational-trust-panel{background:transparent!important;border:0!important;border-radius:0!important;padding:0!important;box-shadow:none!important}
  .operational-trust-panel ol{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:16px!important;margin:0 0 24px!important;padding:0!important;list-style:none!important}
  .operational-trust-panel li{position:relative!important;display:flex!important;align-items:flex-end!important;min-height:178px!important;padding:28px 26px!important;border:1px solid #dedcd5!important;border-radius:22px!important;background:linear-gradient(145deg,#fff 0%,#f7f6f2 100%)!important;box-shadow:0 16px 45px rgba(12,12,12,.055)!important;overflow:hidden!important;transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease!important}
  .operational-trust-panel li::before{content:"";position:absolute;left:26px;top:24px;width:46px;height:4px;border-radius:999px;background:#c4f000}
  .operational-trust-panel li::after{content:"↗";position:absolute;right:22px;top:17px;font-size:20px;line-height:1;color:#b6b2a6}
  .operational-trust-panel li strong{max-width:18ch;font-size:clamp(19px,1.55vw,25px)!important;line-height:1.22!important;letter-spacing:-.025em!important;color:#181818!important;font-weight:700!important}
  .operational-trust-panel li:hover{transform:translateY(-4px);border-color:#c4f000!important;box-shadow:0 22px 56px rgba(12,12,12,.09)!important}
  .operational-trust-panel .button{width:max-content!important;min-width:0!important;border-radius:999px!important;padding:13px 20px!important;background:#151515!important;color:#fff!important;border-color:#151515!important}

  @media (max-width:1100px){
    .footer-markets{grid-template-columns:1fr;gap:18px}
    .footer-market-links{grid-template-columns:repeat(4,minmax(0,1fr))}
    .footer-markets-label{justify-content:space-between}
    .operational-trust .content-grid{grid-template-columns:1fr!important}
  }
  @media (max-width:720px){
    .operational-trust-panel ol{grid-template-columns:1fr!important;gap:12px!important}
    .operational-trust-panel li{min-height:138px!important;padding:24px 22px!important;border-radius:18px!important}
    .operational-trust-panel li::before{left:22px;top:20px}
  }
  @media (max-width:620px){
    .footer-markets{padding-top:22px;padding-bottom:22px}
    .footer-market-links{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .footer-market-link{justify-content:flex-start;padding:12px 14px;font-size:12px}
  }
</style>
<script src="/premium-motion.js" defer></script>
