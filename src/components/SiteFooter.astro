---
import { company, companyCopy, legal, legalIds, localizedPath, ui, type Locale } from '../data/site';
import { generatedImageSrc, LOGO_IMAGE } from '../lib/responsive-images';
const { lang } = Astro.props as { lang: Locale };
const t = ui[lang];
const corporate = companyCopy[lang];
const description = {
  tr:'Türkiye merkezli stratejik tedarik, doğrulanmış ticari ürünler ve uluslararası ticari karar desteği.',
  en:'Strategic sourcing, verified trade products and international commercial decision support from Türkiye.',
  de:'Strategische Beschaffung, verifizierte Handelsprodukte und internationale kaufmännische Entscheidungsunterstützung aus der Türkei.',
  it:'Sourcing strategico, prodotti commerciali verificati e supporto alle decisioni internazionali dalla Turchia.',
  fr:'Sourcing stratégique, produits commerciaux vérifiés et aide à la décision internationale depuis la Turquie.'
}[lang];
const year = new Date().getFullYear();
const copyright = {
  tr:`© ${year} CTSEG. Tüm hakları saklıdır.`,
  en:`© ${year} CTSEG. All rights reserved.`,
  de:`© ${year} CTSEG. Alle Rechte vorbehalten.`,
  it:`© ${year} CTSEG. Tutti i diritti riservati.`,
  fr:`© ${year} CTSEG. Tous droits réservés.`
}[lang];
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a class="brand" href={localizedPath(lang, 'home')}><img src={generatedImageSrc(LOGO_IMAGE,320)} width="320" height="103" alt="CTSEG" loading="lazy" decoding="async" /></a>
      <p>{description}</p>
      <div class="footer-company">
        <strong>{company.name}</strong>
        <span>{company.foundingYear} · {corporate.footerLocation}</span>
      </div>
    </div>
    <nav aria-label={t.products}>
      <strong>{t.products}</strong>
      <a href={localizedPath(lang, 'products')}>{t.allProducts}</a>
      <a href={localizedPath(lang, 'markets')}>{t.markets}</a>
      <a href={localizedPath(lang, 'insights')}>{t.insights}</a>
    </nav>
    <nav aria-label={t.contact}>
      <strong>CTSEG</strong>
      <a href={localizedPath(lang, 'about')}>{t.about}</a>
      <a href={localizedPath(lang, 'contact')}>{t.contact}</a>
      <a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>{copyright}</p>
    <nav aria-label="Legal">
      {legalIds.map((id) => <a href={localizedPath(lang, 'legal', id)}>{legal[id].titles[lang]}</a>)}
    </nav>
  </div>
</footer>
