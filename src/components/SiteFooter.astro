---
import { company, companyCopy, legal, legalIds, localizedPath, ui, type Locale } from '../data/site';
import { reflexPath } from '../data/reflex-data';
import { generatedImageSrc, LOGO_IMAGE } from '../lib/responsive-images';
const { lang } = Astro.props as { lang: Locale };
const t = ui[lang] || ui.en;
const corporate = companyCopy[lang] || companyCopy.en;
const year = new Date().getFullYear();
const descriptionMap: Record<string, string> = {
  tr:'Türkiye merkezli uluslararası ticaret eşleştirme ve bağımsız ticari koordinasyon.',
  en:'International trade matching and independent commercial coordination from Türkiye.',
  de:'Internationale Geschäftsanbahnung und unabhängige Handelskoordination aus der Türkiye.',
  it:'Matching commerciale internazionale e coordinamento indipendente dalla Türkiye.',
  fr:'Sourcing stratégique, produits commerciaux vérifiés et aide à la décision internationale depuis la Turquie.',
  ru:'Международный сорсинг и независимая коммерческая координация из Турции.',
  fa:'تأمین استراتژیک، محصولات تجاری معتبر و پشتیبانی تصمیم‌گیری تجاری بین‌المللی از ترکیه.',
  sq:'Sourcing strategjik, produkte tregtare të verifikuara dhe mbështetje për vendimmarrje tregtare ndërkombëtare nga Turqia.',
  mk:'Стратешка набавка, верификувани трговски производи и меѓународна поддршка за трговски одлуки од Турција.',
  sr:'Strateška nabavka, verifikovani trgovinski proizvodi i međunarodna podrška za trgovinske odluke iz Turske.'
};
const description = descriptionMap[lang] || descriptionMap.en;
const copyrightMap: Record<string, string> = {
  tr:`© ${year} CTSEG. Tüm hakları saklıdır.`,
  en:`© ${year} CTSEG. All rights reserved.`,
  de:`© ${year} CTSEG. Alle Rechte vorbehalten.`,
  it:`© ${year} CTSEG. Tutti i diritti riservati.`,
  fr:`© ${year} CTSEG. Tous droits réservés.`,
  ru:`© ${year} CTSEG. Все права защищены.`,
  fa:`© ${year} CTSEG. تمامی حقوق محفوظ است.`,
  sq:`© ${year} CTSEG. Të gjitha të drejtat të rezervuara.`,
  mk:`© ${year} CTSEG. Сите права се задржани.`,
  sr:`© ${year} CTSEG. Sva prava zadržana.`
};
const copyright = copyrightMap[lang] || copyrightMap.en;
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a class="brand" href={localizedPath(lang, 'home')}><img src={generatedImageSrc(LOGO_IMAGE,320)} width="320" height="103" alt="CTSEG" loading="lazy" decoding="async" /></a>
      <p>{description}</p>
      <div class="footer-company">
        <strong>{company.name}</strong>
        <span>{company.foundingYear} · {corporate.footerLocation}</span>
      </div>
    </div>
    <nav aria-label={t.products}>
      <strong>{t.products}</strong>
      <a href={lang === 'ru' ? '/ru/#sectors' : localizedPath(lang, 'products')}>{t.allProducts}</a>
      <a href={reflexPath(lang)}>REFLEX Medical Gloves</a>
      <a href={lang === 'ru' ? '/ru/#markets' : localizedPath(lang, 'markets')}>{t.markets}</a>
      {lang !== 'ru' && <a href={localizedPath(lang, 'insights')}>{t.insights}</a>}
    </nav>
    <nav aria-label={t.contact}>
      <strong>CTSEG</strong>
      <a href={lang === 'ru' ? '/ru/#company' : localizedPath(lang, 'about')}>{t.about}</a>
      {(lang === 'tr' || lang === 'en' || lang === 'fa') && <a href={localizedPath(lang,'how-we-work')}>{lang === 'tr' ? 'Nasıl çalışıyoruz?' : lang === 'fa' ? 'چگونه کار می‌کنیم؟' : 'How we work'}</a>}
      <a href={lang === 'ru' ? '/ru/#contact' : localizedPath(lang, 'contact')}>{t.contact}</a>
      <a href={`mailto:${company.email}`}>{company.email}</a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>{copyright}</p>
    <nav aria-label="Legal">
      {lang === 'ru'
        ? <><a href={localizedPath('en','legal','privacy')}>Конфиденциальность</a><a href={localizedPath('en','legal','cookies')}>Политика cookie</a><a href={localizedPath('en','legal','terms')}>Условия использования</a><a href={localizedPath('en','legal','data-protection')}>Защита данных</a></>
        : legalIds.map((id) => <a href={localizedPath(lang, 'legal', id)}>{legal[id].titles[lang]}</a>)}
    </nav>
  </div>
</footer>
