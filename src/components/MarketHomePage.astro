---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobalChrome from './GlobalChrome.astro';
const {lang,title,description,canonical,eyebrow,h1,lead,primaryLabel,secondaryLabel,primaryHref,secondaryHref,highlights=[]}=Astro.props;
const ui={
tr:{live:'Canlı',network:'Tedarikçi ağı',verify:'Doğrulama',active:'Aktif',cost:'Maliyet görünürlüğü',compare:'Karşılaştırma',tracking:'İzleniyor',risk:'Ticari risk',control:'Kontrol',managed:'Yönetiliyor',proof:'Veri, müzakere ve uygulama aynı karar sistemi içinde ilerler.',cap:'Uzmanlık alanları',capTitle:'Tedarikten pazara kadar tek sistem.',process:'Çalışma modeli',processTitle:'Dört adımda daha güçlü ticari karar.',steps:['İhtiyacı netleştir','Pazarı ve tedarikçileri tara','Doğrula ve karşılaştır','Müzakere et ve uygula'],cta:'Bir sonraki ticari kararınızı daha güçlü verin.',ctaCopy:'Tedarik, ticari ürün, pazar girişi veya uluslararası operasyon ihtiyacınızı paylaşın.'},
en:{live:'Live',network:'Supplier network',verify:'Verification',active:'Active',cost:'Cost visibility',compare:'Comparison',tracking:'Tracking',risk:'Commercial risk',control:'Control',managed:'Managed',proof:'Data, negotiation and execution move inside one decision system.',cap:'Capabilities',capTitle:'One system from source to market.',process:'Operating model',processTitle:'Stronger commercial decisions in four steps.',steps:['Clarify the requirement','Scan markets and suppliers','Verify and compare','Negotiate and execute'],cta:'Make your next commercial decision stronger.',ctaCopy:'Share your sourcing, trade product, market entry or international operations requirement.'},
de:{live:'Live',network:'Lieferantennetz',verify:'Prüfung',active:'Aktiv',cost:'Kostentransparenz',compare:'Vergleich',tracking:'Überwacht',risk:'Handelsrisiko',control:'Kontrolle',managed:'Gesteuert',proof:'Daten, Verhandlung und Umsetzung laufen in einem Entscheidungssystem zusammen.',cap:'Kompetenzen',capTitle:'Ein System von der Quelle bis zum Markt.',process:'Arbeitsmodell',processTitle:'Stärkere Handelsentscheidungen in vier Schritten.',steps:['Bedarf klären','Märkte und Lieferanten prüfen','Verifizieren und vergleichen','Verhandeln und umsetzen'],cta:'Treffen Sie Ihre nächste Handelsentscheidung stärker.',ctaCopy:'Teilen Sie Ihren Bedarf an Beschaffung, Handelsprodukten, Markteintritt oder internationalen Abläufen.'},
it:{live:'Live',network:'Rete fornitori',verify:'Verifica',active:'Attiva',cost:'Visibilità costi',compare:'Confronto',tracking:'Monitorata',risk:'Rischio commerciale',control:'Controllo',managed:'Gestito',proof:'Dati, negoziazione ed esecuzione avanzano nello stesso sistema decisionale.',cap:'Competenze',capTitle:'Un unico sistema dalla fonte al mercato.',process:'Modello operativo',processTitle:'Decisioni commerciali più forti in quattro fasi.',steps:['Definire il fabbisogno','Analizzare mercati e fornitori','Verificare e confrontare','Negoziare ed eseguire'],cta:'Rendi più forte la tua prossima decisione commerciale.',ctaCopy:'Condividi le tue esigenze di sourcing, prodotti, ingresso nel mercato o operazioni internazionali.'},
fr:{live:'En direct',network:'Réseau fournisseurs',verify:'Vérification',active:'Actif',cost:'Visibilité des coûts',compare:'Comparaison',tracking:'Suivi',risk:'Risque commercial',control:'Contrôle',managed:'Maîtrisé',proof:'Les données, la négociation et l’exécution avancent dans un même système de décision.',cap:'Expertises',capTitle:'Un seul système, de la source au marché.',process:'Modèle opérationnel',processTitle:'Des décisions commerciales plus solides en quatre étapes.',steps:['Clarifier le besoin','Analyser les marchés et fournisseurs','Vérifier et comparer','Négocier et exécuter'],cta:'Renforcez votre prochaine décision commerciale.',ctaCopy:'Présentez votre besoin en sourcing, produits, entrée de marché ou opérations internationales.'}
};
const t=ui[lang]??ui.en;
---
<BaseLayout {lang} {title} {description} {canonical}>
  <div class:list={['market-home',`market-${lang}`]}>
    <GlobalChrome {lang} mode="header" />
    <main>
      <section class="market-hero">
        <div class="hero-grid market-wrap">
          <div class="hero-copy"><p class="market-eyebrow">{eyebrow}</p><h1>{h1}</h1><p class="market-lead">{lead}</p><div class="market-actions"><a class="market-btn" href={primaryHref}>{primaryLabel}</a><a class="market-btn secondary" href={secondaryHref}>{secondaryLabel}</a></div><div class="hero-trust"><span>B2B</span><span>Türkiye · Europe</span><span>Verified sourcing</span></div></div>
          <aside class="signal-panel"><div class="signal-top"><strong>CTSEG Signal Room</strong><span><i></i>{t.live}</span></div><div class="signal-row"><small>{t.network}</small><b>{t.verify}</b><em>{t.active}</em></div><div class="signal-row"><small>{t.cost}</small><b>{t.compare}</b><em>{t.tracking}</em></div><div class="signal-row"><small>{t.risk}</small><b>{t.control}</b><em>{t.managed}</em></div><p>{t.proof}</p></aside>
        </div>
      </section>
      <section class="market-strip"><div><span>STRATEGIC SOURCING</span><span>PROCUREMENT</span><span>TRADE PRODUCTS</span><span>MARKET ENTRY</span><span>INTERNATIONAL TRADE</span></div></section>
      <section class="market-section"><div class="market-wrap"><div class="section-head"><p class="market-eyebrow">{t.cap}</p><h2>{t.capTitle}</h2></div><div class="market-grid">{highlights.map(([cardTitle,copy,url],i)=><a href={url}><small>0{i+1}</small><h3>{cardTitle}</h3><p>{copy}</p><span>↗</span></a>)}</div></div></section>
      <section class="process-section"><div class="market-wrap"><div class="section-head"><p class="market-eyebrow">{t.process}</p><h2>{t.processTitle}</h2></div><div class="process-grid">{t.steps.map((step,i)=><article><span>0{i+1}</span><h3>{step}</h3></article>)}</div></div></section>
      <section class="home-cta"><div class="market-wrap"><p class="market-eyebrow">CTSEG</p><h2>{t.cta}</h2><p>{t.ctaCopy}</p><a class="market-btn" href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div></section>
    </main>
    <GlobalChrome {lang} mode="footer" />
  </div>
</BaseLayout>
<style>
.market-home{--accent:#e30a17;--accent2:#ff8b91;--glow:rgba(227,10,23,.22);background:#070b11;color:#fff;min-height:100vh}.market-en{--accent:#d7b56d;--accent2:#f3d99a;--glow:rgba(215,181,109,.2)}.market-it{--accent:#169b62;--accent2:#8fe0bc;--glow:rgba(22,155,98,.2)}.market-de{--accent:#ffce00;--accent2:#f5d76d;--glow:rgba(255,206,0,.18)}.market-fr{--accent:#0055a4;--accent2:#8ec5f4;--glow:rgba(0,85,164,.22)}.market-wrap{width:min(1180px,calc(100% - 40px));margin:auto}.market-hero{position:relative;overflow:hidden;padding:110px 0 90px;background:radial-gradient(circle at 82% 18%,var(--glow),transparent 32rem),linear-gradient(145deg,#070b11 0%,#0d1620 62%,#101923 100%)}.market-hero:after{content:"";position:absolute;width:560px;height:560px;border:1px solid color-mix(in srgb,var(--accent) 30%,transparent);border-radius:50%;right:-180px;top:-210px}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(360px,.85fr);gap:70px;align-items:center}.market-eyebrow{margin:0;color:var(--accent2);font-size:12px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.market-hero h1{max-width:850px;margin:20px 0 26px;font-size:clamp(56px,7.2vw,104px);line-height:.94;letter-spacing:-.06em}.market-lead{max-width:760px;color:#b8c3cf;font-size:clamp(18px,1.8vw,24px);line-height:1.65}.market-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px}.market-btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 24px;border-radius:999px;background:var(--accent);color:#fff;font-weight:900}.market-de .market-btn{color:#111}.market-btn.secondary{background:transparent;border:1px solid #394553;color:#fff}.hero-trust{display:flex;flex-wrap:wrap;gap:10px;margin-top:42px}.hero-trust span{padding:8px 12px;border:1px solid #33404d;border-radius:999px;color:#9eabb9;font-size:12px}.signal-panel{padding:30px;border:1px solid color-mix(in srgb,var(--accent) 25%,#35404d);border-radius:28px;background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025));box-shadow:0 28px 80px rgba(0,0,0,.35);backdrop-filter:blur(16px)}.signal-top,.signal-row{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:18px}.signal-top{grid-template-columns:1fr auto;padding-bottom:22px;border-bottom:1px solid #33404d}.signal-top span{display:flex;align-items:center;gap:8px;color:#73e2a7;font-weight:800}.signal-top i{width:8px;height:8px;border-radius:50%;background:#73e2a7;box-shadow:0 0 18px #73e2a7}.signal-row{padding:22px 0;border-bottom:1px solid #2c3642}.signal-row small{color:#9ca8b6}.signal-row b{font-size:18px}.signal-row em{color:var(--accent2);font-style:normal}.signal-panel p{margin:24px 0 0;color:#aeb9c5;line-height:1.65}.market-strip{overflow:hidden;border-top:1px solid #232d38;border-bottom:1px solid #232d38;background:#090f16}.market-strip div{display:flex;gap:54px;width:max-content;padding:18px 0;animation:marquee 24s linear infinite}.market-strip span{color:#7f8b99;font-size:12px;font-weight:900;letter-spacing:.16em}.market-section,.process-section{padding:100px 0}.section-head{max-width:850px;margin-bottom:40px}.section-head h2,.home-cta h2{margin:14px 0 0;font-size:clamp(42px,5vw,72px);line-height:1;letter-spacing:-.05em}.market-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.market-grid a{position:relative;min-height:260px;padding:30px;border:1px solid #2b3541;border-radius:24px;background:linear-gradient(145deg,rgba(255,255,255,.05),rgba(255,255,255,.015));transition:.25s ease}.market-grid a:hover{transform:translateY(-6px);border-color:color-mix(in srgb,var(--accent) 55%,#2b3541)}.market-grid small,.market-grid span{color:var(--accent2);font-weight:900}.market-grid h3{margin:42px 0 12px;font-size:28px}.market-grid p{color:#b7c1cd;line-height:1.7}.market-grid span{position:absolute;right:28px;bottom:26px}.process-section{border-top:1px solid #242e39;background:#0a1118}.process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.process-grid article{padding:28px;border:1px solid #2b3541;border-radius:20px;background:#0d151f}.process-grid span{color:var(--accent2);font-weight:900}.process-grid h3{margin:46px 0 0;font-size:23px}.home-cta{padding:110px 0;text-align:center;border-top:1px solid #242e39;background:radial-gradient(circle at 50% 0,var(--glow),transparent 30rem)}.home-cta h2,.home-cta p{margin-inline:auto}.home-cta p{max-width:720px;color:#b7c1cd;font-size:19px;line-height:1.7}.home-cta .market-btn{margin-top:24px}@keyframes marquee{to{transform:translateX(-50%)}}@media(max-width:980px){.hero-grid{grid-template-columns:1fr}.signal-panel{max-width:680px}.market-grid{grid-template-columns:1fr 1fr}.process-grid{grid-template-columns:1fr 1fr}}@media(max-width:650px){.market-wrap{width:min(1180px,calc(100% - 24px))}.market-hero{padding:82px 0 70px}.market-hero h1{font-size:clamp(48px,15vw,72px)}.market-grid,.process-grid{grid-template-columns:1fr}.market-section,.process-section,.home-cta{padding:72px 0}.signal-row{grid-template-columns:1fr}.signal-row em{justify-self:start}}
</style>