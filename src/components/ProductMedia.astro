---
import type { Locale } from '../data/site';
const { product, lang, eager=false, secondary=false, className='' } = Astro.props as {
  product:any; lang:Locale; eager?:boolean; secondary?:boolean; className?:string;
};
const secondarySrc = product.media.secondary;
const src = secondary ? secondarySrc : product.media.src;
const shouldRender = Boolean(src) && (!secondary || secondarySrc !== product.media.src);
const alt = secondary ? `${product.names[lang]} · 02` : product.names[lang];
const mediaType = product.media.mediaType ?? 'photo';
---
{shouldRender && <figure class:list={['product-media', `product-media--${mediaType}`, className]} data-product-media={secondary ? 'secondary' : 'primary'} data-media-type={mediaType}>
  <img
    src={src}
    width={product.media.width}
    height={product.media.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'sync' : 'async'}
    style={product.media.objectPosition ? `object-position:${product.media.objectPosition}` : undefined}
  />
</figure>}
