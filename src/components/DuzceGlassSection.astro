---
import { duzceGlassData, duzceGlassPath, type DuzceGlassLocale } from '../data/duzce-glass';
import { localizedPath, type Locale } from '../data/site';
import { glassSeoPages } from '../data/glass-seo';

const { lang='en' } = Astro.props as { lang?: string };
const currentLang = (['tr','en','de','it','ru','fa','zh','vi','uk','ro','bg','sr'].includes(lang) ? lang : 'en') as DuzceGlassLocale;
const d = duzceGlassData[currentLang] || duzceGlassData.en;
const href = duzceGlassPath(currentLang);
const contactHref = localizedPath(currentLang as Locale, 'contact');
const isRtl = currentLang === 'fa';
const isGenericGlass = currentLang === 'tr' || currentLang === 'en';
const homeTitle = currentLang === 'tr' ? 'Türkiye’den cam tedariki ve global ihracat koordinasyonu.' : currentLang === 'en' ? 'Glass sourcing from Türkiye for global B2B markets.' : d.title;
const homeLead = currentLang === 'tr'
  ? 'CTSEG; float, temperli, lamine, Low-E, solar control, IGU, extra clear ve işlenmiş cam taleplerinde üretici/işlemeci eşleştirme, RFQ, paketleme ve ihracat sürecini koordine eder. Düzce Cam iş birliği bu daha geniş tedarik ağının üretici kanallarından biridir.'
  : currentLang === 'en'
  ? 'CTSEG coordinates supplier and processor matching, RFQs, packing and export flows for float, tempered, laminated, Low-E, solar-control, IGU, extra-clear and processed glass. The Düzce Glass relationship is one producer channel within this broader sourcing network.'
  : d.lead;
const sectionEyebrow = currentLang === 'tr' ? 'CAM SEKTÖRÜ · TÜRKİYE & GLOBAL' : currentLang === 'en' ? 'GLASS INDUSTRY · TÜRKİYE & GLOBAL' : d.eyebrow;
const primaryHref = currentLang === 'tr' ? '/glass/#glass-rfq' : currentLang === 'en' ? '/en/glass/#glass-rfq' : `${href}#rfq`;
const secondaryHref = currentLang === 'tr' ? '/glass/' : currentLang === 'en' ? '/en/glass/' : href;
const primaryLabel = currentLang === 'tr' ? 'Cam RFQ Gönder' : currentLang === 'en' ? 'Send Glass RFQ' : d.primaryCta;
const secondaryLabel = currentLang === 'tr' ? 'Cam Tedarik Merkezini İncele' : currentLang === 'en' ? 'Explore Glass Sourcing Hub' : d.secondaryCta;
const productList = isGenericGlass ? glassSeoPages.slice(0,5).map((page)=>page[currentLang as 'tr'|'en'].title) : d.products.slice(0,4);
const marketList = isGenericGlass
  ? (currentLang === 'tr' ? ['Avrupa & Balkanlar','Orta Doğu & Körfez','Kafkasya & Orta Asya','Global proje ve distribütör talepleri'] : ['Europe & Balkans','Middle East & Gulf','Caucasus & Central Asia','Global project & distributor demand'])
  : d.markets.slice(0,4);
const panelBrand = isGenericGlass ? (currentLang === 'tr' ? 'CTSEG CAM TEDARİK AĞI' : 'CTSEG GLASS SOURCING NETWORK') : 'DÜZCE FLOAT GLASS';
const exportDeskLabel = currentLang === 'tr' ? 'B2B / RFQ / İHRACAT' : currentLang === 'en' ? 'B2B / RFQ / EXPORT' : currentLang === 'uk' ? 'CTSEG / ЕКСПОРТНИЙ ВІДДІЛ' : currentLang === 'ro' ? 'CTSEG / BIROU EXPORT' : currentLang === 'bg' ? 'CTSEG / ЕКСПОРТЕН ОТДЕЛ' : currentLang === 'sr' ? 'CTSEG / IZVOZNI DESK' : 'CTSEG / EXPORT DESK';
---
<section class="section duzce-glass-feature" id="duzce-glass" dir={isRtl ? 'rtl' : 'ltr'}>
  <div class="container duzce-glass-shell">
    <div class="duzce-glass-copy">
      <span class="eyebrow duzce-glass-eyebrow">{sectionEyebrow}</span>
      <h2>{homeTitle}</h2>
      <p class="lead">{homeLead}</p>

      <div class="duzce-glass-badges" aria-label={sectionEyebrow}>
        {(isGenericGlass ? (currentLang === 'tr' ? ['Üretici & işlemeci eşleştirme','Teknik RFQ','Konteyner & paketleme','İhracat koordinasyonu'] : ['Supplier & processor matching','Technical RFQ','Container & packing','Export coordination']) : d.badges).map((badge) => <span>{badge}</span>)}
      </div>

      <div class="actions duzce-glass-actions">
        <a class="button primary" href={primaryHref}>{primaryLabel}</a>
        <a class="button ghost" href={secondaryHref}>{secondaryLabel}</a>
      </div>
    </div>

    <div class="duzce-glass-panel">
      <div class="duzce-glass-panel-top">
        <span>{panelBrand}</span>
        <strong>{exportDeskLabel}</strong>
      </div>
      <div class="duzce-glass-grid">
        <div>
          <small>{isGenericGlass ? (currentLang === 'tr' ? 'Cam ürün ve işleme grupları' : 'Glass product & processing groups') : d.productsTitle}</small>
          <ul>{productList.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <small>{isGenericGlass ? (currentLang === 'tr' ? 'Ticari pazar kapsamı' : 'Commercial market coverage') : d.marketsTitle}</small>
          <ul>{marketList.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
      <a class="duzce-glass-contact" href={isGenericGlass ? primaryHref : contactHref}>{primaryLabel} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .duzce-glass-feature{position:relative;overflow:hidden;background:#101311;border-block:1px solid rgba(255,255,255,.09);padding:clamp(3.5rem,5.2vw,5.8rem) 0}
  .duzce-glass-feature:before{content:"";position:absolute;inset:0;background:linear-gradient(120deg,rgba(196,240,0,.055),transparent 34%),radial-gradient(circle at 82% 22%,rgba(141,190,176,.10),transparent 28%);pointer-events:none}
  .duzce-glass-shell{position:relative;display:grid;grid-template-columns:minmax(0,1.03fr) minmax(390px,.97fr);gap:clamp(2.4rem,5vw,5.2rem);align-items:center}
  .duzce-glass-copy h2{margin:.7rem 0 0;max-width:17ch;color:#fff;font-family:'DM Sans',system-ui,sans-serif;font-size:clamp(2.55rem,3.7vw,4.35rem);font-weight:650;line-height:1;letter-spacing:-.022em;text-wrap:balance}
  .duzce-glass-copy .lead{max-width:44rem;margin:1.25rem 0 0;color:#d8ddd7!important;font-size:clamp(.98rem,1vw,1.08rem);font-weight:500;line-height:1.66;opacity:1!important}
  .duzce-glass-eyebrow{color:#c4f000!important;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
  .duzce-glass-badges{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.35rem}
  .duzce-glass-badges span{padding:.5rem .68rem;border:1px solid rgba(255,255,255,.16);border-radius:999px;color:#f0f2ed;font-size:.72rem;font-weight:700;background:rgba(255,255,255,.025)}
  .duzce-glass-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.35rem}
  .duzce-glass-actions .button{min-height:44px;padding-inline:1rem}
  .duzce-glass-panel{border:1px solid rgba(255,255,255,.13);background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.018));box-shadow:0 28px 70px rgba(0,0,0,.28)}
  .duzce-glass-panel-top{display:flex;justify-content:space-between;gap:1rem;padding:.85rem 1rem;border-bottom:1px solid rgba(255,255,255,.1);font-size:.63rem;letter-spacing:.12em;color:#dfe4de!important}.duzce-glass-panel-top span{color:#dfe4de!important}
  .duzce-glass-panel-top strong{color:#c4f000}
  .duzce-glass-grid{display:grid;grid-template-columns:1fr 1fr}
  .duzce-glass-grid>div{padding:1rem 1.1rem}
  .duzce-glass-grid>div+div{border-inline-start:1px solid rgba(255,255,255,.1)}
  .duzce-glass-grid small{display:block;margin-bottom:.75rem;color:#c4f000!important;font-size:.65rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .duzce-glass-grid ul{list-style:none;margin:0;padding:0}
  .duzce-glass-grid li{padding:.48rem 0;border-bottom:1px solid rgba(255,255,255,.075);color:#f2f4ef!important;font-size:.84rem}
  .duzce-glass-contact{display:flex;align-items:center;justify-content:space-between;padding:.9rem 1rem;background:#c4f000;color:#0b0d0b;text-decoration:none;font-size:.88rem;font-weight:850}
  @media(max-width:980px){.duzce-glass-shell{grid-template-columns:1fr}.duzce-glass-copy h2{max-width:14ch}.duzce-glass-panel{max-width:760px}}
  @media(max-width:620px){.duzce-glass-feature{padding:3.2rem 0}.duzce-glass-grid li{color:#fff!important;opacity:1!important}.duzce-glass-grid small{color:#c4f000!important;opacity:1!important}.duzce-glass-panel{color:#fff!important}.duzce-glass-copy h2{font-size:clamp(2.45rem,10.5vw,3.8rem);max-width:100%}.duzce-glass-copy .lead{font-size:.96rem}.duzce-glass-grid{grid-template-columns:1fr}.duzce-glass-grid>div+div{border-inline-start:0;border-top:1px solid rgba(255,255,255,.1)}}
</style>
