---
import { duzceGlassData, duzceGlassPath, type DuzceGlassLocale } from '../data/duzce-glass';
import { localizedPath, type Locale } from '../data/site';

const { lang='en' } = Astro.props as { lang?: string };
const currentLang = (['tr','en','de','it','ru','fa','zh','vi'].includes(lang) ? lang : 'en') as DuzceGlassLocale;
const d = duzceGlassData[currentLang] || duzceGlassData.en;
const href = duzceGlassPath(currentLang);
const contactHref = localizedPath(currentLang as Locale, 'contact');
const isRtl = currentLang === 'fa';
---
<section class="section duzce-glass-feature" id="duzce-glass" dir={isRtl ? 'rtl' : 'ltr'}>
  <div class="container duzce-glass-shell">
    <div class="duzce-glass-copy">
      <span class="eyebrow duzce-glass-eyebrow">{d.eyebrow}</span>
      <h2>{d.title}</h2>
      <p class="lead">{d.lead}</p>

      <div class="duzce-glass-badges" aria-label={d.eyebrow}>
        {d.badges.map((badge) => <span>{badge}</span>)}
      </div>

      <div class="actions duzce-glass-actions">
        <a class="button primary" href={`${href}#rfq`}>{d.primaryCta}</a>
        <a class="button ghost" href={href}>{d.secondaryCta}</a>
      </div>
    </div>

    <div class="duzce-glass-panel">
      <div class="duzce-glass-panel-top">
        <span>DÜZCE FLOAT GLASS</span>
        <strong>CTSEG / EXPORT DESK</strong>
      </div>
      <div class="duzce-glass-grid">
        <div>
          <small>{d.productsTitle}</small>
          <ul>{d.products.slice(0,6).map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <small>{d.marketsTitle}</small>
          <ul>{d.markets.slice(0,6).map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
      <a class="duzce-glass-contact" href={contactHref}>{d.primaryCta} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .duzce-glass-feature{position:relative;overflow:hidden;background:#101311;border-block:1px solid rgba(255,255,255,.09);padding:clamp(5rem,8vw,8.5rem) 0}
  .duzce-glass-feature:before{content:"";position:absolute;inset:0;background:linear-gradient(120deg,rgba(196,240,0,.06),transparent 35%),radial-gradient(circle at 82% 24%,rgba(141,190,176,.12),transparent 28%);pointer-events:none}
  .duzce-glass-shell{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,.82fr);gap:clamp(3rem,6vw,7rem);align-items:center}
  .duzce-glass-copy h2{margin:.9rem 0 0;max-width:12ch;color:#fff;font-family:var(--font-heading,'Source Serif 4',Georgia,serif);font-size:clamp(3rem,5vw,6rem);line-height:.96;letter-spacing:-.05em;text-wrap:balance}
  .duzce-glass-copy .lead{max-width:44rem;margin:1.8rem 0 0;color:#d8ddd7!important;font-size:clamp(1rem,1.15vw,1.18rem);line-height:1.72;opacity:1!important}
  .duzce-glass-eyebrow{color:#c4f000!important;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
  .duzce-glass-badges{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:2rem}
  .duzce-glass-badges span{padding:.58rem .78rem;border:1px solid rgba(255,255,255,.16);border-radius:999px;color:#f0f2ed;font-size:.76rem;font-weight:700;background:rgba(255,255,255,.025)}
  .duzce-glass-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}
  .duzce-glass-actions .button{min-height:46px}
  .duzce-glass-panel{border:1px solid rgba(255,255,255,.12);background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.018));box-shadow:0 36px 90px rgba(0,0,0,.3)}
  .duzce-glass-panel-top{display:flex;justify-content:space-between;gap:1rem;padding:1rem 1.2rem;border-bottom:1px solid rgba(255,255,255,.1);font-size:.66rem;letter-spacing:.12em;color:#dfe4de!important}.duzce-glass-panel-top span{color:#dfe4de!important}
  .duzce-glass-panel-top strong{color:#c4f000}
  .duzce-glass-grid{display:grid;grid-template-columns:1fr 1fr}
  .duzce-glass-grid>div{padding:1.45rem}
  .duzce-glass-grid>div+div{border-inline-start:1px solid rgba(255,255,255,.1)}
  .duzce-glass-grid small{display:block;margin-bottom:1rem;color:#c4f000!important;font-size:.68rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .duzce-glass-grid ul{list-style:none;margin:0;padding:0}
  .duzce-glass-grid li{padding:.62rem 0;border-bottom:1px solid rgba(255,255,255,.075);color:#f2f4ef!important;font-size:.9rem}
  .duzce-glass-contact{display:flex;align-items:center;justify-content:space-between;padding:1.05rem 1.25rem;background:#c4f000;color:#0b0d0b;text-decoration:none;font-weight:850}
  @media(max-width:980px){.duzce-glass-shell{grid-template-columns:1fr}.duzce-glass-copy h2{max-width:15ch}.duzce-glass-panel{max-width:780px}}
  @media(max-width:620px){.duzce-glass-feature{padding:4rem 0}.duzce-glass-grid li{color:#fff!important;opacity:1!important}.duzce-glass-grid small{color:#c4f000!important;opacity:1!important}.duzce-glass-panel{color:#fff!important}.duzce-glass-copy h2{font-size:clamp(2.55rem,11vw,4rem);max-width:100%}.duzce-glass-grid{grid-template-columns:1fr}.duzce-glass-grid>div+div{border-inline-start:0;border-top:1px solid rgba(255,255,255,.1)}}
</style>
