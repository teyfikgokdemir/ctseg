---
import { reflexData, reflexPath, type ReflexLocale } from '../data/reflex-data';

const { lang = 'en' } = Astro.props as { lang?: string };
const currentLang = (['en', 'tr', 'fa', 'sq', 'mk', 'sr'].includes(lang) ? lang : 'en') as ReflexLocale;
const data = reflexData[currentLang] || reflexData.en;
const reflexUrl = reflexPath(currentLang);
const isRtl = currentLang === 'fa';
---

<section class="section reflex-featured-section" id="featured-medical-brand" dir={isRtl ? 'rtl' : 'ltr'}>
  <div class="container">
    <div class="reflex-featured-grid">
      <div class="reflex-featured-copy">
        <span class="eyebrow reflex-eyebrow">
          <svg class="reflex-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
          Featured Medical Brand
        </span>
        <h2 class="reflex-title">REFLEX Disposable Gloves</h2>
        <p class="lead reflex-lead">
          CTSEG supplies the REFLEX product portfolio to international importers, distributors and institutional buyers, providing sourcing, export documentation, quality coordination and international logistics support.
        </p>
        
        <div class="reflex-badges">
          <span class="reflex-chip">{data.heroBadges[0]}</span>
          <span class="reflex-chip">{data.heroBadges[1]}</span>
          <span class="reflex-chip">{data.heroBadges[2]}</span>
        </div>

        <div class="actions reflex-actions">
          <a class="button" href={reflexUrl} data-reflex-view-products>
            View Products →
          </a>
          <a class="button button-secondary" href="/documents/reflex-medical-catalogue.pdf" download="REFLEX-Medical-Catalogue.pdf" data-catalog-download data-catalog-language={currentLang}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download Catalogue
          </a>
          <a class="button button-secondary" href={`${reflexUrl}#rfq-form`} data-product-quote="REFLEX Disposable Gloves">
            Request a Quote
          </a>
        </div>
      </div>

      <figure class="reflex-featured-visual">
        <img
          src="/images/reflex-tpe-gloves-hero.webp"
          width="1200"
          height="850"
          alt="REFLEX Disposable Gloves Medical Portfolio"
          loading="lazy"
          decoding="async"
          class="reflex-hero-img"
        />
        <figcaption class="reflex-visual-caption">
          <span><strong>CE 2841 & ISO 9001</strong> · Premium Medical & Hygiene Disposable Gloves</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .reflex-featured-section {
    background: linear-gradient(180deg, rgba(39, 41, 35, 0.4) 0%, rgba(20, 22, 18, 0.8) 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4.5rem 0;
  }
  .reflex-featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  .reflex-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #e2b96c;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }
  .reflex-icon {
    color: #e2b96c;
  }
  .reflex-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-family: var(--font-heading, 'Source Serif 4', Georgia, serif);
    line-height: 1.2;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }
  .reflex-lead {
    font-size: 1.125rem;
    line-height: 1.65;
    color: #d1d5db;
    margin-bottom: 1.75rem;
  }
  .reflex-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-bottom: 2rem;
  }
  .reflex-chip {
    background: rgba(226, 185, 108, 0.12);
    border: 1px solid rgba(226, 185, 108, 0.3);
    color: #f3e5c8;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .reflex-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .reflex-actions .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .reflex-featured-visual {
    margin: 0;
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #141612;
  }
  .reflex-hero-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .reflex-featured-visual:hover .reflex-hero-img {
    transform: scale(1.02);
  }
  .reflex-visual-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.875rem 1.25rem;
    background: rgba(15, 17, 13, 0.88);
    backdrop-filter: blur(8px);
    color: #e5e7eb;
    font-size: 0.8125rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 960px) {
    .reflex-featured-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
