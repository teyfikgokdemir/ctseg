---
import { reflexData, reflexPath, type ReflexLocale } from '../data/reflex-data';

const { lang = 'en' } = Astro.props as { lang?: string };
const currentLang = (['en', 'tr', 'de', 'it', 'ru', 'fa', 'zh', 'vi', 'sq', 'mk', 'sr'].includes(lang) ? lang : 'en') as ReflexLocale;
const data = reflexData[currentLang] || reflexData.en;
const reflexUrl = reflexPath(currentLang);
const isRtl = currentLang === 'fa';

const videoCaption = {
  tr: '<span><strong>CE 2841 & ISO 9001</strong> · Medikal ve Hijyenik Tek Kullanımlık Eldivenler</span>',
  en: '<span><strong>CE 2841 & ISO 9001</strong> · Premium Medical & Hygiene Disposable Gloves</span>',
  de: '<span><strong>CE 2841 & ISO 9001</strong> · Premium Einweghandschuhe für Medizin & Hygiene</span>',
  it: '<span><strong>CE 2841 & ISO 9001</strong> · Guanti Monouso Premium per Uso Medico e Igienico</span>',
  ru: '<span><strong>CE 2841 & ISO 9001</strong> · Одноразовые перчатки премиум-класса для медицины и гигиены</span>',
  fa: '<span><strong>CE 2841 & ISO 9001</strong> · دستکش‌های یک‌بارمصرف ممتاز پزشکی و بهداشتی</span>',
  zh: '<span><strong>CE 2841 & ISO 9001</strong> · 医用与卫生防护级高品质一次性手套</span>',
  vi: '<span><strong>CE 2841 & ISO 9001</strong> · Găng tay dùng một lần cao cấp cho y tế & vệ sinh</span>',
  sq: '<span><strong>CE 2841 & ISO 9001</strong> · Doreza Premium me Një Përdorim për Mjekësi dhe Higjienë</span>',
  mk: '<span><strong>CE 2841 & ISO 9001</strong> · Премиум ракавици за еднократна употреба за медицина и хигиена</span>',
  sr: '<span><strong>CE 2841 & ISO 9001</strong> · Premium jednokratne rukavice za medicinu i higijenu</span>'
}[currentLang] || '<span><strong>CE 2841 & ISO 9001</strong> · Premium Medical & Hygiene Disposable Gloves</span>';
const evidenceLabel = ({
  tr:'Ürün standardı',en:'Product standard',de:'Produktstandard',it:'Standard di prodotto',ru:'Стандарт продукта',fa:'استاندارد محصول',zh:'产品标准',vi:'Tiêu chuẩn sản phẩm',
  sq:'Standardi i produktit',mk:'Стандард на производот',sr:'Standard proizvoda'
} as Record<string,string>)[currentLang] || 'Product standard';
---

<section class="section reflex-featured-section" id="featured-medical-brand" dir={isRtl ? 'rtl' : 'ltr'}>
  <div class="container reflex-shell">
    <div class="reflex-featured-copy">
      <span class="eyebrow reflex-eyebrow">
        <span class="reflex-eyebrow-mark" aria-hidden="true"></span>
        {data.eyebrow}
      </span>
      <h2 class="reflex-title">{data.heroTitle}</h2>
      <p class="lead reflex-lead">{data.heroLead}</p>

      <dl class="reflex-credentials" aria-label={data.eyebrow}>
        {data.heroBadges.slice(0,3).map((badge) => (
          <div>
            <dt>{evidenceLabel}</dt>
            <dd>{badge}</dd>
          </div>
        ))}
      </dl>

      <div class="actions reflex-actions">
        <a class="reflex-primary-link" href={reflexUrl} data-reflex-view-products>{data.ctaProducts}<span aria-hidden="true">↗</span></a>
        <a class="reflex-text-link" href="/documents/reflex-medical-catalogue.pdf" download="REFLEX-Medical-Catalogue.pdf" data-catalog-download data-catalog-language={currentLang}>{data.ctaCatalog}</a>
        <a class="reflex-text-link" href={`${reflexUrl}#rfq-form`} data-product-quote={data.heroTitle}>{data.ctaQuote}</a>
      </div>
    </div>

    <figure class="reflex-featured-visual">
      <div class="reflex-media-frame">
        <video
          src="/videos/Commercial_for_Reflex_Glove_Flex.mp4"
          poster="/images/reflex/reflex-slider1.jpg"
          width="1200"
          height="850"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={`${data.heroTitle} - Featured Commercial Video`}
          class="reflex-hero-video"
        ></video>
        <span class="reflex-visual-tag" aria-hidden="true">REFLEX / CTSEG</span>
      </div>
      <figcaption class="reflex-visual-caption" set:html={videoCaption} />
    </figure>
  </div>
</section>

<style>
  .reflex-featured-section{position:relative;overflow:hidden;background:#151515;border-block:1px solid rgba(255,255,255,.08);padding:clamp(5rem,8vw,9rem) 0}
  .reflex-featured-section::before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(112deg,rgba(196,240,0,.035),transparent 31%),radial-gradient(circle at 82% 18%,rgba(255,255,255,.045),transparent 23%)}
  .reflex-shell{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,.82fr) minmax(460px,1.18fr);gap:clamp(3.5rem,7vw,8rem);align-items:center}
  .reflex-featured-copy{min-width:0}
  .reflex-eyebrow{display:inline-flex;align-items:center;gap:.7rem;margin:0 0 1.25rem;color:#c4f000!important;font-size:.78rem;line-height:1.2;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .reflex-eyebrow-mark{width:2.2rem;height:3px;border-radius:999px;background:#c4f000;flex:0 0 auto}
  .reflex-title{margin:0;max-width:11ch;color:#fff;font-family:var(--font-heading,'Source Serif 4',Georgia,serif);font-size:clamp(3.25rem,5.25vw,6.5rem);line-height:.95;letter-spacing:-.055em;text-wrap:balance}
  .reflex-lead{margin:2rem 0 0;max-width:40rem;color:#d6d6d0!important;font-size:clamp(1rem,1.12vw,1.18rem);line-height:1.72;font-weight:520!important;opacity:1!important}
  .reflex-credentials{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:2.4rem 0 0;padding:0;border-block:1px solid rgba(255,255,255,.14)}
  .reflex-credentials div{min-width:0;padding:1rem 1rem 1rem 0;border-inline-end:1px solid rgba(255,255,255,.1)}
  .reflex-credentials div:last-child{border-inline-end:0;padding-inline-end:0;padding-inline-start:1rem}
  .reflex-credentials div:not(:first-child){padding-inline-start:1rem}
  .reflex-credentials dt{margin:0 0 .45rem;color:#77776f;font-size:.62rem;font-weight:760;letter-spacing:.1em;text-transform:uppercase}
  .reflex-credentials dd{margin:0;color:#f3f3ee;font-size:.8rem;line-height:1.4;font-weight:700}
  .reflex-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.45rem;margin-top:2.35rem}
  .reflex-primary-link,.reflex-text-link{display:inline-flex;align-items:center;gap:.6rem;text-decoration:none;font-size:.82rem;font-weight:780;transition:color .25s ease,border-color .25s ease,transform .25s ease}
  .reflex-primary-link{min-height:44px;padding:.72rem 1rem;border:1px solid #c4f000;color:#0a0a0a;background:#c4f000}
  .reflex-primary-link span{font-size:1rem;transition:transform .25s ease}
  .reflex-primary-link:hover span,.reflex-primary-link:focus-visible span{transform:translate(3px,-3px)}
  .reflex-text-link{min-height:36px;color:#d7d7d1;border-bottom:1px solid rgba(255,255,255,.22)}
  .reflex-text-link:hover,.reflex-text-link:focus-visible{color:#c4f000;border-color:#c4f000}
  .reflex-featured-visual{position:relative;margin:0;min-width:0}
  .reflex-media-frame{position:relative;overflow:hidden;aspect-ratio:1200/850;background:#0d0d0d;border:1px solid rgba(255,255,255,.11);box-shadow:0 38px 90px rgba(0,0,0,.34)}
  .reflex-media-frame::after{content:"";position:absolute;inset:0;pointer-events:none;box-shadow:inset 0 0 0 1px rgba(255,255,255,.025)}
  .reflex-hero-video{width:100%;height:100%;display:block;object-fit:cover;transform:scale(1.01);transition:transform .8s cubic-bezier(.2,.7,.2,1)}
  .reflex-featured-visual:hover .reflex-hero-video{transform:scale(1.035)}
  .reflex-visual-caption{min-height:58px;display:flex;align-items:center;padding:1rem 0;border-bottom:1px solid rgba(255,255,255,.12);color:#b7b7b1;font-size:.76rem;line-height:1.45}
  .reflex-visual-caption :global(strong){color:#c4f000}
  .reflex-visual-tag{position:absolute;inset-block-start:18px;inset-inline-end:18px;padding:.48rem .68rem;background:rgba(10,10,10,.82);border:1px solid rgba(196,240,0,.45);color:#c4f000;font-size:.65rem;font-weight:850;letter-spacing:.09em;backdrop-filter:blur(8px)}
  [dir="rtl"] .reflex-eyebrow,[dir="rtl"] .reflex-credentials dt{letter-spacing:0;text-transform:none}
  [dir="rtl"] .reflex-primary-link span{transform:scaleX(-1)}
  [dir="rtl"] .reflex-primary-link:hover span,[dir="rtl"] .reflex-primary-link:focus-visible span{transform:scaleX(-1) translate(3px,-3px)}
  @media(max-width:1050px){.reflex-shell{grid-template-columns:1fr}.reflex-title{max-width:14ch}.reflex-featured-copy{max-width:760px}.reflex-featured-visual{max-width:900px}}
  @media(max-width:640px){.reflex-featured-section{padding:4rem 0}.reflex-title{font-size:clamp(2.5rem,11vw,4rem);max-width:100%}.reflex-lead{margin-top:1.35rem;font-size:1rem}.reflex-credentials{grid-template-columns:1fr;margin-top:1.8rem}.reflex-credentials div,.reflex-credentials div:not(:first-child),.reflex-credentials div:last-child{padding:.85rem 0;border-inline-end:0;border-bottom:1px solid rgba(255,255,255,.09)}.reflex-credentials div:last-child{border-bottom:0}.reflex-actions{align-items:flex-start;gap:.8rem 1.2rem}.reflex-primary-link{width:100%;justify-content:space-between}.reflex-visual-tag{inset-block-start:12px;inset-inline-end:12px}.reflex-visual-caption{font-size:.7rem}}
  @media(prefers-reduced-motion:reduce){.reflex-hero-video,.reflex-primary-link,.reflex-primary-link span,.reflex-text-link{transition:none}}
</style>
