---
import { reflexData, reflexPath, type ReflexLocale } from '../data/reflex-data';

const { lang = 'en' } = Astro.props as { lang?: string };
const currentLang = (['en', 'tr', 'de', 'it', 'ru', 'fa', 'zh', 'vi', 'sq', 'mk', 'sr'].includes(lang) ? lang : 'en') as ReflexLocale;
const data = reflexData[currentLang] || reflexData.en;
const reflexUrl = reflexPath(currentLang);
const isRtl = currentLang === 'fa';

const videoCaption = {
  tr: '<span><strong>CE 2841 & ISO 9001</strong> · Medikal ve Hijyenik Tek Kullanımlık Eldivenler</span>',
  en: '<span><strong>CE 2841 & ISO 9001</strong> · Premium Medical & Hygiene Disposable Gloves</span>',
  de: '<span><strong>CE 2841 & ISO 9001</strong> · Premium Einweghandschuhe für Medizin & Hygiene</span>',
  it: '<span><strong>CE 2841 & ISO 9001</strong> · Guanti Monouso Premium per Uso Medico e Igienico</span>',
  ru: '<span><strong>CE 2841 & ISO 9001</strong> · Одноразовые перчатки премиум-класса для медицины и гигиены</span>',
  fa: '<span><strong>CE 2841 & ISO 9001</strong> · دستکش‌های یک‌بارمصرف ممتاز پزشکی و بهداشتی</span>',
  zh: '<span><strong>CE 2841 & ISO 9001</strong> · 医用与卫生防护级高品质一次性手套</span>',
  vi: '<span><strong>CE 2841 & ISO 9001</strong> · Găng tay dùng một lần cao cấp cho y tế & vệ sinh</span>',
  sq: '<span><strong>CE 2841 & ISO 9001</strong> · Doreza Premium me Një Përdorim për Mjekësi dhe Higjienë</span>',
  mk: '<span><strong>CE 2841 & ISO 9001</strong> · Премиум ракавици за еднократна употреба за медицина и хигиена</span>',
  sr: '<span><strong>CE 2841 & ISO 9001</strong> · Premium jednokratne rukavice za medicinu i higijenu</span>'
}[currentLang] || '<span><strong>CE 2841 & ISO 9001</strong> · Premium Medical & Hygiene Disposable Gloves</span>';
---

<section class="section reflex-featured-section" id="featured-medical-brand" dir={isRtl ? 'rtl' : 'ltr'}>
  <div class="container reflex-shell">
    <div class="reflex-featured-copy">
      <span class="eyebrow reflex-eyebrow">
        <span class="reflex-eyebrow-mark" aria-hidden="true"></span>
        {data.eyebrow}
      </span>
      <h2 class="reflex-title">{data.heroTitle}</h2>
      <p class="lead reflex-lead">{data.heroLead}</p>

      <div class="reflex-badges" aria-label={data.eyebrow}>
        <span class="reflex-chip">{data.heroBadges[0]}</span>
        <span class="reflex-chip">{data.heroBadges[1]}</span>
        <span class="reflex-chip">{data.heroBadges[2]}</span>
      </div>

      <div class="actions reflex-actions">
        <a class="button reflex-primary" href={reflexUrl} data-reflex-view-products>{data.ctaProducts} →</a>
        <a class="button button-secondary" href="/documents/reflex-medical-catalogue.pdf" download="REFLEX-Medical-Catalogue.pdf" data-catalog-download data-catalog-language={currentLang}>{data.ctaCatalog}</a>
        <a class="button button-secondary" href={`${reflexUrl}#rfq-form`} data-product-quote={data.heroTitle}>{data.ctaQuote}</a>
      </div>
    </div>

    <figure class="reflex-featured-visual">
      <div class="reflex-media-frame">
        <video
          src="/videos/Commercial_for_Reflex_Glove_Flex.mp4"
          poster="/images/reflex/reflex-slider1.jpg"
          width="1200"
          height="850"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={`${data.heroTitle} - Featured Commercial Video`}
          class="reflex-hero-video"
        ></video>
      </div>
      <figcaption class="reflex-visual-caption" set:html={videoCaption} />
      <span class="reflex-visual-tag" aria-hidden="true">REFLEX / CTSEG</span>
    </figure>
  </div>
</section>

<style>
  .reflex-featured-section {
    position: relative;
    overflow: hidden;
    background: #151515;
    border-top: 1px solid rgba(255,255,255,.08);
    border-bottom: 1px solid rgba(255,255,255,.08);
    padding: clamp(5rem,8vw,9rem) 0;
  }
  .reflex-featured-section::before {
    content: "REFLEX";
    position: absolute;
    right: -1vw;
    top: -1.5rem;
    font: 900 clamp(7rem,18vw,18rem)/.8 var(--font-sans,Arial,sans-serif);
    letter-spacing: -.08em;
    color: rgba(255,255,255,.025);
    pointer-events: none;
    white-space: nowrap;
  }
  .reflex-shell {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0,.88fr) minmax(440px,1.12fr);
    gap: clamp(3rem,6vw,7rem);
    align-items: center;
  }
  .reflex-featured-copy { min-width: 0; }
  .reflex-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    margin: 0 0 1.25rem;
    color: #c4f000!important;
    font-size: .78rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .reflex-eyebrow-mark {
    width: 2.2rem;
    height: 3px;
    border-radius: 999px;
    background: #c4f000;
    flex: 0 0 auto;
  }
  .reflex-title {
    margin: 0;
    max-width: 11ch;
    color: #fff;
    font-family: var(--font-heading,'Source Serif 4',Georgia,serif);
    font-size: clamp(3.25rem,5.25vw,6.5rem);
    line-height: .95;
    letter-spacing: -.055em;
    text-wrap: balance;
  }
  .reflex-lead {
    margin: 2rem 0 0;
    max-width: 43rem;
    color: #c4f000!important;
    font-size: clamp(1rem,1.15vw,1.2rem);
    line-height: 1.7;
    font-weight: 600!important;
    opacity: 1!important;
  }
  .reflex-badges {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    margin: 2rem 0 0;
  }
  .reflex-chip {
    padding: .6rem .9rem;
    border: 1px solid rgba(196,240,0,.34);
    border-radius: 999px;
    background: rgba(196,240,0,.055);
    color: #f2f2ed;
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .02em;
  }
  .reflex-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem;
    margin-top: 2.15rem;
  }
  .reflex-actions .button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding-inline: 1.1rem;
  }
  .reflex-primary {
    background: #c4f000!important;
    border-color: #c4f000!important;
    color: #0a0a0a!important;
  }
  .reflex-featured-section .button-secondary {
    border-color: rgba(255,255,255,.2)!important;
    background: rgba(255,255,255,.02)!important;
    color: #fff!important;
  }
  .reflex-featured-section .button-secondary:hover,
  .reflex-featured-section .button-secondary:focus-visible {
    border-color: #c4f000!important;
    color: #c4f000!important;
  }
  .reflex-featured-visual {
    position: relative;
    margin: 0;
    padding: 18px 18px 0;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 28px;
    background: #1c1c1c;
    box-shadow: 0 40px 90px rgba(0,0,0,.32);
  }
  .reflex-media-frame {
    overflow: hidden;
    border-radius: 18px;
    aspect-ratio: 1200/850;
    background: #0d0d0d;
  }
  .reflex-hero-video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1.015);
    transition: transform .7s cubic-bezier(.2,.7,.2,1);
  }
  .reflex-featured-visual:hover .reflex-hero-video { transform: scale(1.045); }
  .reflex-visual-caption {
    min-height: 58px;
    display: flex;
    align-items: center;
    padding: 1rem .25rem;
    color: #d8d8d2;
    font-size: .76rem;
    line-height: 1.35;
  }
  .reflex-visual-caption :global(strong) { color: #c4f000; }
  .reflex-visual-tag {
    position: absolute;
    top: 34px;
    right: 34px;
    padding: .48rem .7rem;
    border-radius: 999px;
    background: #c4f000;
    color: #0a0a0a;
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .08em;
  }
  [dir="rtl"] .reflex-visual-tag { right: auto; left: 34px; }

  @media (max-width: 1050px) {
    .reflex-shell { grid-template-columns: 1fr; }
    .reflex-title { max-width: 14ch; }
    .reflex-featured-visual { max-width: 860px; }
  }
  @media (max-width: 640px) {
    .reflex-featured-section { padding: 4rem 0; }
    .reflex-title { font-size: clamp(2.5rem,11vw,4rem); max-width: 100%; }
    .reflex-lead { margin-top: 1.35rem; font-size: 1rem; }
    .reflex-featured-visual { padding: 10px 10px 0; border-radius: 20px; }
    .reflex-media-frame { border-radius: 13px; }
    .reflex-visual-tag { top: 20px; right: 20px; }
    [dir="rtl"] .reflex-visual-tag { right: auto; left: 20px; }
    .reflex-actions { align-items: stretch; }
    .reflex-actions .button { width: 100%; }
  }
</style>
