{key === 'contact' && (
  <>
    <PageHero lang={lang} eyebrow={t.contact} title={contact.title} lead={contact.intro} compact={true} />
    <section class="section commercial-form-section"><div class="container"><CommercialRequestForm lang={lang} /></div></section>
    {<section class="section compact-link-section"><div class="container"><a class="text-link" href={workHref} data-how-we-work-cta>{processPage?.title} →</a></div></section>}
  </>
)}

{key === 'how-we-work' && processPage && (
  <>
    <PageHero lang={lang} eyebrow="CTSEG" title={processPage.title} lead={processPage.description} />
    <section class="section"><div class="container">
      <ol class="detailed-process">{processPage.steps.map((step,index)=><li><span>{indexLabel(index)}</span><h2>{step}</h2></li>)}</ol>
      <div class="role-boundary"><strong>{processLabels.boundary}</strong><p>{processPage.role}</p></div>
    </div></section>
    <section class="section answer-section"><div class="container">
      <div class="section-head"><h2>{processLabels.answers}</h2><p>{processLabels.answerLead}</p></div>
      <div class="answer-grid">{processPage.faq.map(([question,answer])=><article><h3>{question}</h3><p>{answer}</p></article>)}</div>
      <div class="actions"><a class="button" href={sectionHref('contact')}>{completionHome.commercialCta}</a></div>
    </div></section>
  </>
)}

{key === 'scenarios' && scenarioPage && (
  <>
    <PageHero lang={lang} eyebrow="CTSEG" title={scenarioPage.title} lead={scenarioPage.description} />
    <section class="section"><div class="container">
      <div class="scenario-disclaimer">{scenarioPage.disclaimer}</div>
      <div class="scenario-list">{scenarioPage.items.map((item,index)=><article>
        <div class="scenario-heading"><span>{indexLabel(index)}</span><h2>{item[0]}</h2></div>
        <dl>{scenarioPage.labels.map((label,valueIndex)=><div><dt>{label}</dt><dd>{item[valueIndex+1]}</dd></div>)}</dl>
        <a class="text-link" href={sectionHref('contact')} data-case-scenario-cta>{completionHome.commercialCta} →</a>
      </article>)}</div>
    </div></section>
  </>
)}

{key === 'guides' && guide && (
  <>
    <PageHero lang={lang} eyebrow={lang === 'tr' ? 'Satın alma rehberi' : lang === 'zh' ? '大宗采购指南' : lang === 'vi' ? 'Hướng dẫn thu mua' : 'Sourcing guide'} title={guide.title} lead={guide.description} />
    <section class="section"><article class="container guide-article">
      <div class="guide-meta"><span>{lang === 'tr' ? 'Yazar' : lang === 'zh' ? '作者' : lang === 'vi' ? 'Tác giả' : 'Author'}: Teyfik Gökdemir</span><span>{t.updated}: {updatedDate}</span></div>
      <p class="article-answer">{guide.intro}</p>
      <section class="content-block"><h2>{lang === 'tr' ? 'Kontrol listesi' : lang === 'zh' ? '必备核查清单' : lang === 'vi' ? 'Danh mục kiểm tra' : 'Checklist'}</h2><ul class="check-list">{guide.checklist.map((item)=><li>{item}</li>)}</ul></section>
      <section class="content-block"><h2>{lang === 'tr' ? 'Karşılaştırma tablosu' : lang === 'zh' ? '核心比价维度表' : lang === 'vi' ? 'Bảng so sánh' : 'Comparison table'}</h2>
        <div class="guide-table-wrap"><table><thead><tr>{guide.table[0].map((cell)=><th>{cell}</th>)}</tr></thead><tbody>{guide.table.slice(1).map((row)=><tr>{row.map((cell)=><td>{cell}</td>)}</tr>)}</tbody></table></div>
      </section>
      <div class="cta-statement"><h2>{guide.cta}</h2><a class="button" href={sectionHref('contact')}>{completionHome.commercialCta}</a></div>
    </article></section>
  </>
)}

{legalPage && (
  <>
    <PageHero lang={lang} eyebrow={`CTSEG · ${legalLabel}`} title={legalPage.titles[lang]} lead={copy.legalIntro} />
    <section class="section"><article class="container prose"><p class="eyebrow">{t.updated}: {updatedDate}</p>{copy.legalSections.map((section:string[]) => <section class="content-block"><h2>{section[0]}</h2><p>{section[1]}</p></section>)}</article></section>
  </>
)}
