  tr:['Menşe','Ürün tipi / çeşit','Olası ambalaj','MOQ','Kalite ve analiz belgeleri','Numune','Private label','Teslim ve Incoterm','Termin','Depolama','Hedef kullanım','Teklif için gerekli bilgiler'],
  en:['Origin','Product type / variety','Potential packaging','MOQ','Quality and analysis documents','Sample','Private label','Delivery and Incoterm','Lead time','Storage','Intended use','Information required for quotation'],
  de:['Herkunft','Produkttyp / Sorte','Mögliche Verpackung','MOQ','Qualitäts- und Analysedokumente','Muster','Eigenmarke','Lieferung und Incoterm','Lieferzeit','Lagerung','Zielanwendung','Angaben für ein Angebot'],
  it:['Origine','Tipo / varietà','Possibile imballaggio','MOQ','Documenti qualità e analisi','Campione','Private label','Consegna e Incoterm','Tempi','Stoccaggio','Uso previsto','Dati necessari per l’offerta'],
  ru:['Происхождение','Тип / сорт','Возможная упаковка','MOQ','Документы качества и анализов','Образец','Собственная торговая марка','Доставка и Incoterms','Срок поставки','Хранение','Целевое применение','Информация для коммерческого предложения'],
  fa:['مبدأ','نوع / واریته محصول','بسته‌بندی احتمالی','حداقل سفارش MOQ','اسناد کیفیت و آزمایشگاهی','نمونه','برند اختصاصی','تحویل و Incoterms','زمان تحویل','شرایط نگهداری','کاربرد هدف','اطلاعات مورد نیاز برای استعلام'],
  zh:['真实原产地','产品品类 / 品种','常规包装形式','最低起订量 (MOQ)','质量认证与 COA 质检单证','样品调样政策','OEM / 贴牌定制 (Private Label)','交货方式与 Incoterms','生产交期排程','仓储与温湿度要求','目标工业/食用用途','发起正式报价所需信息'],
  vi:['Xuất xứ','Chủng loại / giống','Bao bì khả thi','Số lượng đặt hàng tối thiểu (MOQ)','Chứng từ chất lượng và phân tích','Mẫu thử','Thương hiệu riêng (Private Label)','Giao hàng và Incoterms','Thời gian giao hàng','Bảo quản','Mục đích sử dụng','Thông tin cần thiết để báo giá']
}[lang];
const verifiedLater = {
  tr:['Üretici ve sipariş yapısına göre doğrulanır','Teklif aşamasında teyit edilir','Parti bazında belge kontrolü yapılır','Talebe göre değerlendirilir','Üretici ve hedef pazara göre değerlendirilir'],
  en:['Verified according to producer and order structure','Confirmed at quotation stage','Documents checked at batch level','Assessed on request','Assessed by producer and target market'],
  de:['Nach Hersteller und Auftragsstruktur zu prüfen','In der Angebotsphase zu bestätigen','Dokumentenprüfung je Charge','Auf Anfrage zu bewerten','Nach Hersteller und Zielmarkt zu bewerten'],
  it:['Da verificare secondo produttore e ordine','Da confermare in fase di offerta','Documenti verificati per lotto','Valutato su richiesta','Valutato per produttore e mercato target'],
  ru:['Проверяется в зависимости от производителя и структуры заказа','Подтверждается на этапе коммерческого предложения','Документы проверяются по партии','Оценивается по запросу','Оценивается в зависимости от производителя и целевого рынка'],
  fa:['بر اساس تولیدکننده و ساختار سفارش ارزیابی می‌شود','در مرحله استعلام قیمت تأیید می‌شود','بررسی اسناد در سطح محموله انجام می‌شود','بر اساس درخواست بررسی می‌شود','بر اساس تولیدکننده و بازار هدف ارزیابی می‌شود'],
  zh:['依据生产企业资质与具体订单结构核实','在正式询价报价阶段书面确认','逐批次核验第三方检测单证','根据具体业务需求专项评估','依据生产工厂与目标市场准入综合评估'],
  vi:['Được xác minh theo nhà sản xuất và cấu trúc đơn hàng','Được xác nhận ở giai đoạn báo giá','Chứng từ được kiểm tra theo từng lô hàng','Được đánh giá theo yêu cầu','Được đánh giá theo nhà sản xuất và thị trường mục tiêu']
}[lang];
---
{key === 'home' && (
  <>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{platform.eyebrow}</p><h1>{platform.title}</h1><p class="lead">{platform.lead}</p>
          <div class="actions trade-intent-actions"><a class="button" href={contactWithIntent('buyer_request')} data-trade-intent="buyer_request">{platform.buyerCta}</a><a class="button button-secondary" href={contactWithIntent('supplier_market_entry')} data-trade-intent="supplier_market_entry">{platform.producerCta}</a></div>
        </div>
        <figure class="hero-visual">
          <ResponsiveImage
            src={homepageHero.source}
            widths={FEATURE_IMAGE_WIDTHS}
            sizes="(max-width:620px) calc(100vw - 26px), (max-width:860px) calc(100vw - 36px), min(53vw,700px)"
            width={homepageHero.width}
            height={homepageHero.height}
            alt={homepageHero.altText}
            focalPosition={homepageHero.focalPosition}
            visualKey={homepageHero.key}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>{h.trust.map((item:string,index:number) => <span><small>{indexLabel(index)}</small>{item}</span>)}</figcaption>
        </figure>
        <div class="trade-gateway-banner" style="grid-column: 1 / -1; margin-top: 24px;">
          <div class="trade-funnel-card">
            <div>
              <span class="trade-funnel-kicker">{gateway.outbound.kicker}</span>
              <h3 class="trade-funnel-title">{gateway.outbound.title}</h3>
              <p class="trade-funnel-desc">{gateway.outbound.description}</p>
            </div>
            <a class="button" href={contactWithIntent('supplier_market_entry')} data-trade-intent="supplier_market_entry">{platform.producerCta} →</a>
          </div>
          <div class="trade-funnel-card">
            <div>
              <span class="trade-funnel-kicker">{gateway.inbound.kicker}</span>
              <h3 class="trade-funnel-title">{gateway.inbound.title}</h3>
              <p class="trade-funnel-desc">{gateway.inbound.description}</p>
            </div>
            <a class="button button-secondary" href={contactWithIntent('buyer_request')} data-trade-intent="buyer_request">{platform.buyerCta} →</a>
          </div>
        </div>
      </div>
    </section>
    <section class="section trade-paths-section" id="trade-paths"><div class="container">
      <div class="section-head"><h2>{platform.pathsTitle}</h2><p>{platform.pathsLead}</p></div>
      <div class="trade-paths-grid">
        <article id="for-buyers"><span>01</span><h3>{platform.buyerTitle}</h3><p>{platform.buyerText}</p><a class="text-link" href={contactWithIntent('buyer_request')}>{platform.buyerCta} ↗</a></article>
        <article id="for-producers"><span>02</span><h3>{platform.producerTitle}</h3><p>{platform.producerText}</p><a class="text-link" href={contactWithIntent('supplier_market_entry')}>{platform.producerCta} ↗</a></article>
      </div>
    </div></section>
    <section class="section platform-sectors" id="sectors" data-platform-sectors><div class="container">
      <div class="section-head"><h2>{platform.sectorsTitle}</h2><p>{platform.sectorsLead}</p></div>
      <div class="platform-sector-grid">
        {platform.sectors.map((sector,index) => {
          const visual=homepageSectorVisuals[index];
          return <article data-sector-visual={visual.key}>
            <ResponsiveImage src={visual.source} widths={FEATURE_IMAGE_WIDTHS} sizes="(max-width:620px) calc(100vw - 26px), (max-width:860px) 46vw, 25vw" width={visual.width} height={visual.height} alt={visual.altText} focalPosition={visual.focalPosition} visualKey={visual.key} loading="lazy" decoding="async" />
            <div><span>{indexLabel(index)}</span><h3>{sector.title}</h3><p>{sector.text}</p></div>
          </article>;
        })}
      </div>
      <div class="specialist-routes"><a href={pathForSector(lang,'iranian-carpets')}>{tradeCopy[lang]['iranian-carpets'].scopeTitle} ↗</a><a href={pathForSector(lang,'silk-carpets')}>{tradeCopy[lang]['silk-carpets'].scopeTitle} ↗</a><a href={pathForSector(lang,'wholesale-textiles')}>{tradeCopy[lang]['wholesale-textiles'].scopeTitle} ↗</a></div>
    </div></section>
    <section class="section trade-corridors"><div class="container">
      <div class="section-head"><h2>{platform.corridorsTitle}</h2><p>{platform.corridorsLead}</p></div>
      <div class="corridor-list">{platform.corridors.map((corridor,index) => <div><span>{indexLabel(index)}</span><strong>{corridor}</strong></div>)}</div>
    </div></section>
    <ReflexSection lang={lang} />
    <ProcessRail title={platform.processTitle} steps={platform.process} />
    {<div class="container process-detail-link"><a class="text-link" href={workHref} data-how-we-work-cta>{processPage?.title} →</a></div>}
    <section class="markets-editorial section" id="markets"><div class="container">
      <p class="eyebrow">{editorial.marketsKicker}</p>
      <div class="section-head"><h2>{h.marketsTitle}</h2><p>{h.marketsLead}</p></div>
      <div class="market-line">{marketNames.map((market,index) => <div><span>{indexLabel(index)}</span><strong>{market}</strong></div>)}</div>
    </div></section>
    {<section class="section scenario-teaser"><div class="container content-grid">
      <div><p class="eyebrow">CTSEG · {scenarioKicker}</p><h2>{completionHome.scenarioTitle}</h2><p>{completionHome.scenarioLead}</p></div>
      <aside class="side-panel"><a class="button button-secondary" href={scenarioHref} data-case-scenario-cta>{completionHome.scenarioCta}</a></aside>
    </div></section>}
    <section class="section operational-trust" aria-labelledby="operational-trust-title"><div class="container content-grid">
      <div><p class="eyebrow">CTSEG · {scenarioKicker}</p><h2 id="operational-trust-title">{operationalTrust.title}</h2><p>{operationalTrust.lead}</p></div>
      <div class="operational-trust-panel"><ol>{operationalTrust.steps.map((step,index)=><li><span>{indexLabel(index)}</span><strong>{step}</strong></li>)}</ol><a class="button button-secondary" href={workHref} data-how-we-work-cta>{operationalTrust.cta} →</a></div>
    </div></section>
    <section class="section company-trust-band" id="company"><div class="container">
      <div class="company-trust-heading"><h2>{completionHome.trustTitle}</h2><p>{company.name[lang] || company.name.en}</p></div>
      <dl class="trust-facts">
        <div><dt>01</dt><dd>{completionHome.established}</dd></div>
        <div><dt>02</dt><dd>{completionHome.founder}</dd></div>
        <div><dt>03</dt><dd>{completionHome.headquarters}</dd></div>
      </dl>
    </div></section>
    <section class="section"><div class="container"><div class="cta-statement"><p class="eyebrow">CTSEG</p><h2>{platform.pathsTitle}</h2><div class="actions"><a class="button" href={contactWithIntent('buyer_request')}>{platform.buyerCta}</a><a class="button button-secondary" href={contactWithIntent('supplier_market_entry')}>{platform.producerCta}</a></div></div></div></section>
    <section class="section commercial-form-section" id="contact"><div class="container"><CommercialRequestForm lang={lang} /></div></section>
  </>
)}

{key === 'services' && !id && (
  <>
    <PageHero lang={lang} eyebrow={t.services} title={copy.servicesTitle} lead={copy.servicesLead} />
    <section class="section"><div class="container card-grid">{serviceIds.map((serviceId,index) => <a class="card" href={localizedPath(lang,'services',serviceId)}><small>{indexLabel(index)}</small><h2>{services[serviceId].names[lang]}</h2><p>{services[serviceId].descriptions[lang]}</p><strong>{t.readMore} →</strong></a>)}</div></section>
    <section class="section solution-directory"><div class="container">
      <div class="section-head"><h2>{searchLandingIndexCopy[lang].title}</h2><p>{searchLandingIndexCopy[lang].lead}</p></div>
      <div class="card-grid">{searchLandingIds.map((landingId,index) => {
        const landing=searchLandings[landingId].content[lang];
        return <a class="card" href={searchLandingPath(lang,landingId)}><small>{indexLabel(index)}</small><h3>{landing.title}</h3><p>{landing.description}</p><strong>{t.readMore} →</strong></a>;
      })}</div>
    </div></section>
    <Framework lang={lang} />
    {<section class="section compact-link-section"><div class="container cta-statement"><h2>{processPage?.title}</h2><a class="button" href={workHref} data-how-we-work-cta>{processPage.title}</a></div></section>}
  </>
)}

{service && (
  <>
    <PageHero lang={lang} eyebrow={t.services} title={service.names[lang]} lead={service.descriptions[lang]} parentHref={sectionHref('services')} parentLabel={t.services} />
    <section class="section"><div class="container content-grid">
      <div class="prose">
        {detailedService ? (
          <>
            <div class="content-block"><h2>{detailedService.scopeTitle}</h2><p>{detailedService.scope}</p></div>
            <div class="content-block"><h2>{detailedService.problemTitle}</h2><p>{detailedService.problem}</p></div>
            <div class="content-block"><h2>{detailedService.audienceTitle}</h2><p>{detailedService.audience}</p></div>
            <div class="content-block"><h2>{detailedService.processTitle}</h2><ol class="check-list">{detailedService.process.map((item) => <li>{item}</li>)}</ol></div>
            <div class="content-block"><h2>{detailedService.outcomesTitle}</h2><ul class="check-list">{detailedService.outcomes.map((item) => <li>{item}</li>)}</ul></div>
            <div class="content-block faq"><h2>{t.faq}</h2>{detailedService.faq.map((item,index) => <details open={index === 0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
            <div class="content-block">
              <h2>{lang === 'tr' ? 'İlgili kaynaklar' : 'Related resources'}</h2>
              <p><a class="text-link" href={sectionHref('services')}>{t.allServices} →</a></p>
              <p><a class="text-link" href={sectionHref('insights')}>{lang === 'tr' ? 'Satın alma içgörülerini inceleyin' : 'Explore sourcing insights'} →</a></p>
              <p><a class="text-link" href={sectionHref('contact')}>{t.contact} →</a></p>
            </div>
          </>
        ) : (
          <>
            <div class="content-block"><h2>{copy.framework[0]}</h2><p>{service.descriptions[lang]} {copy.aboutLead}</p><ul class="check-list">{copy.framework.map((item:string) => <li>{item}</li>)}</ul></div>
            <div class="content-block faq"><h2>{t.faq}</h2><details open><summary>{copy.serviceFaq[0]}</summary><p>{copy.serviceFaq[1]}</p></details><details><summary>{copy.serviceFaq[2]}</summary><p>{copy.serviceFaq[3]}</p></details></div>
          </>
        )}
      </div>
      <aside class="side-panel"><p class="eyebrow">CTSEG</p><h2>{t.quote}</h2><p>{t.contactLead}</p><a class="button" href={sectionHref('contact')}>{t.contact}</a></aside>
    </div></section>
  </>
)}

{searchLanding && id && (
  <>
    <PageHero lang={lang} eyebrow={searchLanding.eyebrow} title={searchLanding.title} lead={searchLanding.description} parentHref={sectionHref('services')} parentLabel={t.services} />
    <section class="section"><div class="container content-grid">
      <div class="prose">
        <div class="content-block direct-answer"><h2>{searchLanding.answerTitle}</h2><p>{searchLanding.directAnswer}</p></div>
        <div class="content-block"><h2>{searchLanding.audienceTitle}</h2><p>{searchLanding.audience}</p></div>
        <div class="content-block"><h2>{searchLanding.criteriaTitle}</h2><ul class="check-list">{searchLanding.criteria.map((item) => <li>{item}</li>)}</ul></div>
        <div class="content-block"><h2>{searchLanding.processTitle}</h2><ol class="check-list">{searchLanding.process.map((item) => <li>{item}</li>)}</ol></div>
        <div class="content-block"><h2>{searchLanding.evidenceTitle}</h2><p>{searchLanding.evidence}</p></div>
        <div class="content-block faq"><h2>{t.faq}</h2>{searchLanding.faq.map((item,index) => <details open={index === 0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
        <div class="content-block"><a class="text-link" href={workHref} data-how-we-work-cta>{processPage.title} →</a></div>
      </div>
      <aside class="side-panel"><p class="eyebrow">CTSEG</p><h2>{searchLanding.ctaTitle}</h2><p>{searchLanding.ctaText}</p><a class="button" href={`${sectionHref('contact')}?intent=buyer_request#commercial-form`} data-contact-intent="buyer_request">{searchLanding.ctaLabel}</a></aside>
    </div></section>
  </>
)}

{key === 'products' && !id && (
  <>
    <PageHero lang={lang} eyebrow={t.products} title={copy.productsTitle} lead={copy.productsLead} />
    <section class="section catalogue-section"><div class="container">
      {(lang === 'tr' || lang === 'en') && <div class="catalog-download">
        <div><p class="eyebrow">PDF · 18 {lang === 'tr' ? 'ürün' : 'products'}</p><h2>{lang === 'tr' ? 'CTSEG Ticari Ürünler Kataloğu' : 'CTSEG Trade Products Catalogue'}</h2></div>
        <a class="button button-secondary" href={lang === 'tr' ? '/downloads/ctseg-ticari-urunler-katalogu.pdf' : '/downloads/ctseg-trade-products-catalogue.pdf'} download data-catalog-download data-catalog-language={lang}>{lang === 'tr' ? 'Kataloğu indir' : 'Download catalogue'}</a>
      </div>}
      <div class="origin-note"><strong>{t.origin}</strong><p>{t.complianceText}</p></div>
      <nav class="catalogue-category-nav" aria-label={jumpLabel}>
        <span class="category-nav-label">{jumpLabel}:</span>
        <div class="category-nav-list">
          {catalogueGroups.map((group, groupIndex) => (
            <a class="category-nav-pill" href={`#group-${group.key}`}>
              <span class="pill-num">{String(groupIndex + 1).padStart(2, '0')}</span>
              <span class="pill-title">{group.title}</span>
              <span class="pill-count">({group.ids.length})</span>
            </a>
          ))}
        </div>
      </nav>
      <div class="catalogue-directory">
        {catalogueGroups.map((group,groupIndex) => <div class="catalogue-group" id={`group-${group.key}`} data-catalogue-group={group.key}>
          <div class="catalogue-group-heading">
            <div class="group-heading-top">
              <span class="group-index">{String(groupIndex + 1).padStart(2,'0')}</span>
              <h2>{group.title}</h2>
            </div>
            <p class="group-lead">{categoryLeads[group.key]?.[lang]}</p>
            <div class="group-trade-badges">
              <span class="trade-badge">✓ {groupBadges[group.key]?.b1[lang]}</span>
              <span class="trade-badge">✓ {groupBadges[group.key]?.b2[lang]}</span>
              <span class="trade-badge">✓ {groupBadges[group.key]?.b3[lang]}</span>
            </div>
          </div>
          <div class="catalogue-grid">{group.ids.map((productId) => <ProductCard
            product={products[productId as keyof typeof products]}
            productId={productId}
            lang={lang}
            index={catalogueOrder.indexOf(productId)}
            family={group.key}
          />)}</div>
        </div>)}
      </div>
      <div class="catalogue-sourcing-desk">
        <div class="sourcing-desk-content">
          <span class="sourcing-desk-kicker">{sourcingDeskCopy[lang].kicker}</span>
          <h2 class="sourcing-desk-title">{sourcingDeskCopy[lang].title}</h2>
          <p class="sourcing-desk-lead">{sourcingDeskCopy[lang].lead}</p>
          <p class="sourcing-desk-note">🔒 {sourcingDeskCopy[lang].note}</p>
        </div>
        <div class="sourcing-desk-actions">
          <a class="button button-accent" href={`${sectionHref('contact')}?intent=buyer_request#commercial-form`} data-contact-intent="buyer_request">{sourcingDeskCopy[lang].cta} →</a>
          <a class="button button-secondary" href={`https://wa.me/${company.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp Quick Desk ↗</a>
        </div>
      </div>
    </div></section>
  </>
)}

{product && (
  <>
    <PageHero lang={lang} eyebrow={`${t.products} · B2B`} title={product.names[lang]} lead={product.descriptions[lang]} parentHref={sectionHref('products')} parentLabel={t.products} product={product} ctaHref={sectionHref('contact')} ctaLabel={t.quote} imageNote={editorial.productImageNote} />
    <section class="section product-detail-content"><div class="container content-grid">
      <div class="prose">
        <div class="content-block product-commercial-facts"><h2>{lang === 'tr' ? 'Ticari değerlendirme bilgileri' : lang === 'en' ? 'Commercial assessment information' : lang === 'de' ? 'Angaben zur kaufmännischen Bewertung' : lang === 'it' ? 'Informazioni per la valutazione commerciale' : lang === 'zh' ? '大宗商品商业评估核心参数' : lang === 'vi' ? 'Thông tin đánh giá thương mại' : 'Informations d’évaluation commerciale'}</h2>
          <dl>{productCommercialLabels.map((label,index) => {
            const values=[
              product.origin,product.names[lang],verifiedLater[0],verifiedLater[1],verifiedLater[2],
              verifiedLater[3],verifiedLater[4],verifiedLater[1],verifiedLater[1],verifiedLater[0],
              copy.productUses.join(' · '),
              lang === 'tr' ? 'Spesifikasyon, miktar, ambalaj, teslim yeri, hedef tarih ve belge beklentisi' :
              lang === 'en' ? 'Specification, quantity, packaging, delivery point, target date and document requirements' :
              lang === 'zh' ? '产品技术规格书、采购订购量 (MOQ)、包装方案、目标口岸、交付期及必备单证要求' :
              lang === 'vi' ? 'Thông số kỹ thuật, số lượng, quy cách đóng gói, địa điểm giao hàng, tiến độ và yêu cầu chứng từ' :
              verifiedLater[0]
            ];
            return <div><dt>{label}</dt><dd>{values[index]}</dd></div>;
          })}</dl>
        </div>
        <div class="content-block"><h2>{t.applications}</h2><ul class="check-list">{copy.productUses.map((item:string) => <li>{item}</li>)}</ul></div>
        <div class="content-block"><h2>{t.quality}</h2><ul class="check-list">{copy.productQuality.map((item:string) => <li>{item}</li>)}</ul><div class="origin-note"><strong>{t.origin}</strong><p>{t.complianceText}</p></div></div>
        <div class="content-block"><h2>{t.logistics}</h2><p>{t.contactLead}</p>{product.media.secondary && <ProductMedia product={product} lang={lang} secondary={true} className="secondary-product-media" />}</div>
        <div class="content-block faq"><h2>{t.faq}</h2><details open><summary>{t.origin}</summary><p>{t.complianceText}</p></details><details><summary>{t.samplePolicy}</summary><p>{t.sampleText}</p></details></div>
      </div>
