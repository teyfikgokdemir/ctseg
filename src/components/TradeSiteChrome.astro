---
const {lang='tr',mode='header'}=Astro.props;
const copy={
tr:{home:'Ana Sayfa',services:'Hizmetler',products:'Ticari Ürünler',markets:'Pazarlar',insights:'İçgörüler',about:'Hakkımızda',contact:'İletişim',quote:'Teklif İste',rights:'Tüm hakları saklıdır.',privacy:'Gizlilik Politikası',cookies:'Çerez Politikası',terms:'Kullanım Koşulları'},
en:{home:'Home',services:'Services',products:'Trade Products',markets:'Markets',insights:'Insights',about:'About',contact:'Contact',quote:'Request Quote',rights:'All rights reserved.',privacy:'Privacy Policy',cookies:'Cookie Policy',terms:'Terms of Use'},
de:{home:'Startseite',services:'Leistungen',products:'Handelsprodukte',markets:'Märkte',insights:'Einblicke',about:'Über uns',contact:'Kontakt',quote:'Angebot anfordern',rights:'Alle Rechte vorbehalten.',privacy:'Datenschutz',cookies:'Cookie-Richtlinie',terms:'Nutzungsbedingungen'},
it:{home:'Home',services:'Servizi',products:'Prodotti commerciali',markets:'Mercati',insights:'Approfondimenti',about:'Chi siamo',contact:'Contatti',quote:'Richiedi offerta',rights:'Tutti i diritti riservati.',privacy:'Privacy',cookies:'Cookie Policy',terms:'Termini di utilizzo'},
fr:{home:'Accueil',services:'Services',products:'Produits commerciaux',markets:'Marchés',insights:'Analyses',about:'À propos',contact:'Contact',quote:'Demander un devis',rights:'Tous droits réservés.',privacy:'Confidentialité',cookies:'Politique de cookies',terms:'Conditions d’utilisation'}
};
const c=copy[lang]??copy.en;
const home=lang==='tr'?'/':'/'+lang+'/';
const prefix=lang==='tr'?'/tr':'/'+lang;
const routes={tr:{services:'hizmetler',products:'ticari-urunler',markets:'pazarlar',insights:'blog',about:'hakkimizda',contact:'iletisim'},en:{services:'services',products:'trade-products',markets:'markets',insights:'insights',about:'about',contact:'contact'},de:{services:'leistungen',products:'handelsprodukte',markets:'maerkte',insights:'einblicke',about:'ueber-uns',contact:'kontakt'},it:{services:'servizi',products:'prodotti-commerciali',markets:'mercati',insights:'approfondimenti',about:'chi-siamo',contact:'contatti'},fr:{services:'services',products:'produits-commerciaux',markets:'marches',insights:'analyses',about:'a-propos',contact:'contact'}}[lang]??{};
const languages=[['TR','/'],['EN','/en/'],['DE','/de/'],['IT','/it/'],['FR','/fr/']];
---
{mode==='header'&&<header class:list={['ctseg-global-header',`chrome-${lang}`]}><a class="ctseg-global-brand" href={home} aria-label="CTSEG"><img src="/images/ctseg-logo-transparent.png" alt="CTSEG" width="1063" height="342"/></a><button class="ctseg-menu-toggle" type="button" aria-label="Menu" data-menu-toggle><span></span><span></span><span></span></button><nav class="ctseg-global-nav" data-menu><a href={home}>{c.home}</a><a href={`${prefix}/${routes.services}/`}>{c.services}</a><a href={`${prefix}/${routes.products}/`}>{c.products}</a><a href={`${prefix}/${routes.markets}/`}>{c.markets}</a><a href={`${prefix}/${routes.insights}/`}>{c.insights}</a><a href={`${prefix}/${routes.about}/`}>{c.about}</a><a href={`${prefix}/${routes.contact}/`}>{c.contact}</a></nav><div class="ctseg-language-switcher" aria-label="Language">{languages.map(([label,url])=><a href={url} class:list={{active:label.toLowerCase()===lang}}>{label}</a>)}</div><a class="ctseg-header-cta" href="mailto:info@ctseg.com.tr">{c.quote}</a></header>}
{mode==='footer'&&<footer class:list={['ctseg-global-footer',`chrome-${lang}`]}><div class="ctseg-footer-grid"><div><img src="/images/ctseg-logo-transparent.png" alt="CTSEG" width="1063" height="342"/><p>Strategic sourcing · Procurement · International trade</p></div><div><strong>{c.products}</strong><a href={`${prefix}/${routes.products}/`}>{c.products}</a><a href={`${prefix}/${routes.markets}/`}>{c.markets}</a><a href={`${prefix}/${routes.insights}/`}>{c.insights}</a></div><div><strong>{c.contact}</strong><a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a><a href={`${prefix}/${routes.contact}/`}>{c.contact}</a></div></div><div class="ctseg-footer-bottom"><span>© 2026 CTSEG. {c.rights}</span><nav><a href={`${prefix}/${lang==='tr'?'gizlilik-politikasi':lang==='de'?'datenschutz':lang==='it'?'privacy':lang==='fr'?'confidentialite':'privacy-policy'}/`}>{c.privacy}</a><a href={`${prefix}/${lang==='tr'?'cerez-politikasi':lang==='de'?'cookie-richtlinie':lang==='it'?'cookie-policy':lang==='fr'?'politique-cookies':'cookie-policy'}/`}>{c.cookies}</a><a href={`${prefix}/${lang==='tr'?'kullanim-kosullari':lang==='de'?'nutzungsbedingungen':lang==='it'?'termini-utilizzo':lang==='fr'?'conditions-utilisation':'terms'}/`}>{c.terms}</a></nav></div></footer>}
{mode==='header'&&<script is:inline>document.querySelectorAll('[data-menu-toggle]').forEach((button)=>button.addEventListener('click',()=>button.closest('.ctseg-global-header')?.querySelector('[data-menu]')?.classList.toggle('open')));</script>}
<style>
.ctseg-global-header{--chrome-accent:#e30a17;position:sticky;top:0;z-index:100;display:grid;grid-template-columns:auto 1fr auto auto;align-items:center;gap:18px;min-height:76px;padding:10px max(18px,calc((100vw - 1240px)/2));border-bottom:1px solid rgba(255,255,255,.1);background:rgba(7,11,17,.94);backdrop-filter:blur(18px)}.chrome-it{--chrome-accent:#169b62}.chrome-de{--chrome-accent:#ffce00}.chrome-en{--chrome-accent:#d7b56d}.chrome-fr{--chrome-accent:#0055a4}.ctseg-global-brand img{width:112px;height:auto}.ctseg-global-nav{display:flex;justify-content:center;gap:18px}.ctseg-global-nav a{font-size:13px;font-weight:750;color:#c7d0dc}.ctseg-global-nav a:hover{color:#fff}.ctseg-language-switcher{display:flex;gap:4px;padding:4px;border:1px solid #303947;border-radius:999px}.ctseg-language-switcher a{display:grid;place-items:center;min-width:34px;height:34px;border-radius:999px;color:#aeb8c5;font-size:11px;font-weight:850}.ctseg-language-switcher a.active{background:var(--chrome-accent);color:#fff}.chrome-de .ctseg-language-switcher a.active,.chrome-de .ctseg-header-cta{color:#111}.ctseg-header-cta{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 16px;border-radius:999px;background:var(--chrome-accent);color:#fff;font-weight:850;font-size:13px}.ctseg-menu-toggle{display:none}.ctseg-global-footer{--chrome-accent:#e30a17;padding:64px max(20px,calc((100vw - 1160px)/2)) 26px;border-top:1px solid #29323d;background:#060a0f}.ctseg-footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:32px}.ctseg-footer-grid img{width:140px}.ctseg-footer-grid p{color:#8f9baa}.ctseg-footer-grid>div{display:grid;align-content:start;gap:10px}.ctseg-footer-grid strong{color:#fff}.ctseg-footer-grid a{color:#aeb8c5}.ctseg-footer-bottom{display:flex;justify-content:space-between;gap:20px;margin-top:44px;padding-top:20px;border-top:1px solid #262f3a;color:#818d9d;font-size:13px}.ctseg-footer-bottom nav{display:flex;flex-wrap:wrap;gap:18px}@media(max-width:1050px){.ctseg-global-header{grid-template-columns:auto auto 1fr auto}.ctseg-menu-toggle{display:block;width:44px;height:44px;border:1px solid #303947;border-radius:50%;background:#0d141d}.ctseg-menu-toggle span{display:block;width:18px;height:2px;margin:4px auto;background:#fff}.ctseg-global-nav{display:none;position:absolute;top:76px;left:12px;right:12px;flex-direction:column;padding:18px;border:1px solid #303947;border-radius:18px;background:#090f16}.ctseg-global-nav.open{display:flex}.ctseg-language-switcher{justify-self:end}.ctseg-header-cta{display:none}}@media(max-width:700px){.ctseg-global-header{grid-template-columns:auto auto 1fr}.ctseg-language-switcher{grid-column:1/-1;justify-self:stretch;justify-content:center}.ctseg-footer-grid{grid-template-columns:1fr}.ctseg-footer-bottom{flex-direction:column}}
</style>