---
import type { Locale } from '../data/site';
const { lang } = Astro.props as { lang: Locale };
const copy = {
  tr:{eyebrow:'CTSEG · Ticari koordinasyon',title:'Araştırmadan ticari eşleştirmeye',text:'Ürün, üretici, numune ve pazar değerlendirmesini tek bir ticari koordinasyon akışında bir araya getiriyoruz.',label:'CTSEG ticari araştırma ve koordinasyon süreci',tag:'Saha · Veri · Doğrulama'},
  en:{eyebrow:'CTSEG · Commercial coordination',title:'From research to commercial matching',text:'We bring product, producer, sample and market assessment together in one commercial coordination flow.',label:'CTSEG commercial research and coordination process',tag:'Fieldwork · Data · Verification'},
  de:{eyebrow:'CTSEG · Handelskoordination',title:'Von der Recherche zur geschäftlichen Vermittlung',text:'Wir verbinden Produkt-, Hersteller-, Muster- und Marktbewertung in einem koordinierten Handelsprozess.',label:'CTSEG Prozess für Handelsrecherche und Koordination',tag:'Recherche · Daten · Verifizierung'},
  it:{eyebrow:'CTSEG · Coordinamento commerciale',title:'Dalla ricerca all’abbinamento commerciale',text:'Riuniamo la valutazione di prodotti, produttori, campioni e mercati in un unico processo di coordinamento commerciale.',label:'Processo CTSEG di ricerca e coordinamento commerciale',tag:'Ricerca · Dati · Verifica'},
  fa:{eyebrow:'CTSEG · هماهنگی تجاری',title:'از بررسی تا تطبیق تجاری',text:'بررسی محصول، تولیدکننده، نمونه و بازار را در یک مسیر هماهنگ تجاری کنار هم قرار می‌دهیم.',label:'فرایند بررسی و هماهنگی تجاری CTSEG',tag:'تحقیق · داده · راستی‌آزمایی'},
  ru:{eyebrow:'CTSEG · Коммерческая координация',title:'От исследования к коммерческому подбору',text:'Мы объединяем оценку продукции, производителей, образцов и рынков в единый процесс коммерческой координации.',label:'Процесс коммерческого исследования и координации CTSEG',tag:'Аналитика · Данные · Проверка'},
  zh:{eyebrow:'CTSEG · 跨国商贸协调',title:'从供应链调研到商业精准匹配',text:'我们将产品技术规格、工厂实测、样品化验与海外市场准入统筹于严密的商业协同流程中。',label:'CTSEG 跨国商业调研与供应链协调流程',tag:'调研 · 数据 · 验证'},
  vi:{eyebrow:'CTSEG · Điều phối thương mại',title:'Từ nghiên cứu đến kết nối thương mại',text:'Chúng tôi kết hợp đánh giá sản phẩm, nhà sản xuất, mẫu thử và thị trường trong một luồng điều phối thương mại thống nhất.',label:'Quy trình nghiên cứu và điều phối thương mại CTSEG',tag:'Nghiên cứu · Dữ liệu · Xác minh'}
}[lang];
---
<section class="section trade-video-section" data-trade-video-section>
  <div class="container trade-video-shell">
    <div class="trade-video-topline">
      <p class="eyebrow">{copy.eyebrow}</p>
      <span class="trade-video-tag">{copy.tag}</span>
    </div>
    <div class="trade-video-grid">
      <div class="trade-video-copy">
        <h2>{copy.title}</h2>
        <p>{copy.text}</p>
        <div class="trade-video-rule" aria-hidden="true"><span></span></div>
      </div>
      <figure class="trade-video-frame">
        <video
          data-trade-video
          muted
          loop
          playsinline
          preload="none"
          poster="/videos/ctseg-trade-coordination-poster.webp"
          aria-label={copy.label}
        >
          <source src="/videos/ctseg-trade-coordination-1080p.webm" type="video/webm" />
          <source src="/videos/ctseg-trade-coordination-1080p.mp4" type="video/mp4" />
        </video>
        <figcaption><span>CTSEG</span><strong>{copy.label}</strong></figcaption>
      </figure>
    </div>
  </div>
</section>

<style is:global>
  .trade-video-section{position:relative;background:#151515;color:#fff;overflow:hidden}
  .trade-video-section::before{content:"CTSEG";position:absolute;right:-.03em;top:-.18em;font-family:var(--font-sans,Arial,sans-serif);font-size:clamp(140px,20vw,360px);font-weight:900;line-height:1;letter-spacing:-.08em;color:rgba(255,255,255,.025);pointer-events:none}
  .trade-video-shell{position:relative;z-index:1}
  .trade-video-topline{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:clamp(38px,5vw,74px);padding-bottom:20px;border-bottom:1px solid rgba(255,255,255,.16)}
  .trade-video-copy .eyebrow,.trade-video-topline .eyebrow{margin:0;color:#c4f000!important;font-weight:800!important;letter-spacing:.1em!important}
  .trade-video-tag{color:#a7a7a2;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
  .trade-video-grid{display:grid;grid-template-columns:minmax(300px,.75fr) minmax(0,1.25fr);gap:clamp(44px,6vw,96px);align-items:end}
  .trade-video-copy{padding-bottom:clamp(8px,2vw,30px)}
  .trade-video-copy h2{margin:0;max-width:10ch;font-family:'Source Serif 4',Georgia,serif;font-size:clamp(48px,5.2vw,86px);font-weight:500;line-height:.94;letter-spacing:-.055em;text-wrap:balance;color:#fff}
  .trade-video-copy>p{max-width:34em;margin:28px 0 0;color:#d8d8d3!important;font-size:18px!important;line-height:1.65!important;font-weight:500!important}
  .trade-video-rule{margin-top:34px;width:min(280px,70%);height:2px;background:rgba(255,255,255,.14);overflow:hidden}
  .trade-video-rule span{display:block;width:38%;height:100%;background:#c4f000}
  .trade-video-frame{position:relative;margin:0;overflow:hidden;border:1px solid rgba(255,255,255,.16);border-radius:24px;background:#0d0d0d;aspect-ratio:16/10;box-shadow:0 30px 80px rgba(0,0,0,.34)}
  .trade-video-frame:before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,transparent 58%,rgba(0,0,0,.54) 100%)}
  .trade-video-frame video{display:block;width:100%;height:100%;object-fit:cover;background:#0d0d0d;transform:scale(1.015);transition:transform .7s cubic-bezier(.2,.7,.2,1),filter .7s ease}
  .trade-video-frame:hover video{transform:scale(1.045);filter:saturate(1.05)}
  .trade-video-frame figcaption{position:absolute;left:24px;right:24px;bottom:20px;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:20px;color:#fff}
  .trade-video-frame figcaption span{flex:0 0 auto;padding:8px 11px;border-radius:999px;background:#c4f000;color:#0a0a0a;font-size:11px;font-weight:900;letter-spacing:.08em}
  .trade-video-frame figcaption strong{max-width:32em;text-align:right;font-size:12px;line-height:1.35;font-weight:650;color:#f1f1ed}
  @media(max-width:960px){.trade-video-grid{grid-template-columns:1fr;align-items:start}.trade-video-copy h2{max-width:12ch}.trade-video-copy>p{max-width:46em}.trade-video-frame{aspect-ratio:16/9}}
  @media(max-width:620px){.trade-video-section{padding-block:64px}.trade-video-topline{align-items:flex-start;flex-direction:column;margin-bottom:32px}.trade-video-tag{white-space:normal}.trade-video-copy h2{font-size:clamp(36px,10vw,50px);line-height:.98}.trade-video-copy>p{font-size:16px!important}.trade-video-frame{margin-inline:-13px;border-inline:0;border-radius:0}.trade-video-frame figcaption{left:16px;right:16px;bottom:14px}.trade-video-frame figcaption strong{display:none}}
</style>

<script>
  (()=>{
    const section=document.querySelector('[data-trade-video-section]');
    const market=document.querySelector('.markets-editorial');
    if(section&&market&&section.parentElement!==market.parentElement){market.parentElement?.insertBefore(section,market)}
    else if(section&&market){market.parentElement?.insertBefore(section,market)}
    const video=section?.querySelector('[data-trade-video]') as HTMLVideoElement | null;
    if(!video)return;
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    if('IntersectionObserver' in window){
      const observer=new IntersectionObserver((entries)=>{
        entries.forEach((entry)=>{
          if(entry.isIntersecting && !reduced.matches){
            video.play().catch(()=>{});
          }else{
            video.pause();
          }
        });
      },{rootMargin:'100px'});
      observer.observe(video);
    }else if(!reduced.matches){
      video.play().catch(()=>{});
    }
  })();
</script>
