---
const labels = {
  tr: { open: 'CTSEG’e sorun', title: 'CTSEG Ticaret Asistanı', intro: 'Yayınlanmış CTSEG sayfalarına göre yanıtlar; fiyat veya ticari taahhüt vermez.', placeholder: 'Tedarik, pazar veya cam RFQ hakkında sorun…', send: 'Gönder', close: 'Kapat', unavailable: 'Asistan şu an kullanılamıyor. Ticari talebinizi iletişim formundan paylaşabilirsiniz.' },
  en: { open: 'Ask CTSEG', title: 'CTSEG Trade Assistant', intro: 'Answers from published CTSEG pages; it does not give prices or commercial commitments.', placeholder: 'Ask about sourcing, markets or glass RFQs…', send: 'Send', close: 'Close', unavailable: 'The assistant is currently unavailable. Please share your commercial request through the contact form.' },
  ar: { open: 'اسأل CTSEG', title: 'مساعد CTSEG التجاري', intro: 'يجيب بالاعتماد على صفحات CTSEG المنشورة ولا يقدم أسعاراً أو التزامات تجارية.', placeholder: 'اسأل عن التوريد أو الأسواق أو طلبات RFQ للزجاج…', send: 'إرسال', close: 'إغلاق', unavailable: 'المساعد غير متاح حالياً. يرجى إرسال طلبك التجاري عبر نموذج التواصل.' },
  fa: { open: 'از CTSEG بپرسید', title: 'دستیار تجاری CTSEG', intro: 'براساس صفحات منتشرشده CTSEG پاسخ می‌دهد و قیمت یا تعهد تجاری ارائه نمی‌کند.', placeholder: 'درباره تامین، بازار یا RFQ شیشه بپرسید…', send: 'ارسال', close: 'بستن', unavailable: 'دستیار در حال حاضر در دسترس نیست. لطفاً درخواست تجاری خود را از فرم تماس ارسال کنید.' }
};
const lang = String(Astro.props.lang || 'en');
const text = labels[lang as keyof typeof labels] || labels.en;
---

<section class="trade-assistant" data-trade-assistant data-lang={lang} aria-label={text.title}>
  <button class="trade-assistant__toggle" type="button" aria-expanded="false" aria-controls="trade-assistant-panel">
    <span aria-hidden="true">✦</span>{text.open}
  </button>
  <div class="trade-assistant__panel" id="trade-assistant-panel" hidden>
    <div class="trade-assistant__header">
      <div><strong>{text.title}</strong><p>{text.intro}</p></div>
      <button type="button" class="trade-assistant__close" aria-label={text.close}>×</button>
    </div>
    <div class="trade-assistant__messages" aria-live="polite"></div>
    <form class="trade-assistant__form">
      <label class="sr-only" for="trade-assistant-input">{text.placeholder}</label>
      <textarea id="trade-assistant-input" maxlength="1200" required placeholder={text.placeholder}></textarea>
      <button type="submit">{text.send}</button>
    </form>
  </div>
</section>

<script define:vars={{ unavailable: text.unavailable }}>
  const root = document.querySelector('[data-trade-assistant]');
  if (root) {
    const toggle = root.querySelector('.trade-assistant__toggle');
    const panel = root.querySelector('.trade-assistant__panel');
    const close = root.querySelector('.trade-assistant__close');
    const form = root.querySelector('.trade-assistant__form');
    const input = root.querySelector('textarea');
    const messages = root.querySelector('.trade-assistant__messages');
    const addMessage = (content, kind) => {
      const item = document.createElement('div');
      item.className = `trade-assistant__message trade-assistant__message--${kind}`;
      item.textContent = content;
      messages.append(item);
      messages.scrollTop = messages.scrollHeight;
    };
    const setOpen = (open) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) input.focus();
    };
    toggle.addEventListener('click', () => setOpen(panel.hidden));
    close.addEventListener('click', () => setOpen(false));
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const message = input.value.trim();
      if (!message) return;
      addMessage(message, 'user');
      input.value = '';
      input.disabled = true;
      form.querySelector('button').disabled = true;
      try {
        const response = await fetch('/api/assistant', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ message, pagePath: window.location.pathname })
        });
        const data = await response.json();
        addMessage(data.answer || unavailable, 'assistant');
      } catch {
        addMessage(unavailable, 'assistant');
      } finally {
        input.disabled = false;
        form.querySelector('button').disabled = false;
        input.focus();
      }
    });
  }
</script>
