---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommercialRequestForm from './CommercialRequestForm.astro';
import { activeLocales } from '../data/locales';
import { localizedGlassProductCopy, localizedGlassSlugs, type LocalizedGlassLocale, type LocalizedGlassSlug } from '../data/glass-product-locales';
import { getGlassSeoPage } from '../data/glass-seo';

const { lang, slug } = Astro.props as {lang:LocalizedGlassLocale;slug:LocalizedGlassSlug};
const localeCopy=localizedGlassProductCopy[lang];
const product=localeCopy.products[slug];
const canonical=`https://ctseg.com.tr/${lang}/glass/${slug}/`;
const alt=Object.fromEntries([
  ['tr',`https://ctseg.com.tr/glass/${slug}/`],
  ['en',`https://ctseg.com.tr/en/glass/${slug}/`],
  ...activeLocales.filter((code)=>!['tr','en'].includes(code)).map((code)=>[code,`https://ctseg.com.tr/${code}/glass/${slug}/`]),
  ['x-default',`https://ctseg.com.tr/en/glass/${slug}/`]
]);
const schema=[
  {'@context':'https://schema.org','@type':'Service','name':product.name,'description':product.description,'url':canonical,'areaServed':'Worldwide','provider':{'@type':'Organization','name':'CTSEG','url':'https://ctseg.com.tr/'}},
  {'@context':'https://schema.org','@type':'FAQPage','mainEntity':localeCopy.faq.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))},
  {'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':localeCopy.relatedTitle,'item':`https://ctseg.com.tr/${lang}/glass/`},{'@type':'ListItem','position':2,'name':product.name,'item':canonical}]}
];
const relatedMap:Record<string,string[]>={
  'float-glass':['low-iron-extra-clear-glass','tempered-glass','laminated-glass','low-e-coated-glass','processed-glass-cut-to-size'],
  'tempered-glass':['heat-strengthened-glass','heat-soak-tested-glass','laminated-glass','shower-enclosure-glass','balustrade-railing-glass'],
  'heat-strengthened-glass':['tempered-glass','heat-soak-tested-glass','laminated-glass','architectural-project-glass','insulated-glass-igu'],
  'heat-soak-tested-glass':['tempered-glass','heat-strengthened-glass','balustrade-railing-glass','architectural-project-glass','fire-rated-glass'],
  'laminated-glass':['tempered-glass','balustrade-railing-glass','office-partition-interior-glass','fire-rated-glass','architectural-project-glass'],
  'low-e-coated-glass':['solar-control-glass','insulated-glass-igu','architectural-project-glass','float-glass','low-iron-extra-clear-glass'],
  'solar-control-glass':['low-e-coated-glass','insulated-glass-igu','architectural-project-glass','float-glass','ceramic-printed-glass'],
  'insulated-glass-igu':['low-e-coated-glass','solar-control-glass','tempered-glass','architectural-project-glass','office-partition-interior-glass'],
  'low-iron-extra-clear-glass':['float-glass','laminated-glass','balustrade-railing-glass','furniture-retail-glass','architectural-project-glass'],
  'mirror-decorative-glass':['patterned-frosted-satin-glass','ceramic-printed-glass','furniture-retail-glass','office-partition-interior-glass','processed-glass-cut-to-size'],
  'patterned-frosted-satin-glass':['mirror-decorative-glass','ceramic-printed-glass','office-partition-interior-glass','shower-enclosure-glass','furniture-retail-glass'],
  'processed-glass-cut-to-size':['glass-processing-services','curved-glass','ceramic-printed-glass','furniture-retail-glass','household-appliance-glass'],
  'glass-processing-services':['processed-glass-cut-to-size','curved-glass','ceramic-printed-glass','household-appliance-glass','furniture-retail-glass'],
  'curved-glass':['glass-processing-services','processed-glass-cut-to-size','laminated-glass','architectural-project-glass','furniture-retail-glass'],
  'ceramic-printed-glass':['glass-processing-services','patterned-frosted-satin-glass','household-appliance-glass','furniture-retail-glass','architectural-project-glass'],
  'fire-rated-glass':['laminated-glass','office-partition-interior-glass','architectural-project-glass','heat-soak-tested-glass'],
  'shower-enclosure-glass':['tempered-glass','patterned-frosted-satin-glass','glass-processing-services','processed-glass-cut-to-size','furniture-retail-glass'],
  'balustrade-railing-glass':['laminated-glass','tempered-glass','heat-soak-tested-glass','low-iron-extra-clear-glass','architectural-project-glass'],
  'office-partition-interior-glass':['tempered-glass','laminated-glass','patterned-frosted-satin-glass','fire-rated-glass','furniture-retail-glass'],
  'household-appliance-glass':['ceramic-printed-glass','glass-processing-services','processed-glass-cut-to-size','tempered-glass','furniture-retail-glass'],
  'furniture-retail-glass':['processed-glass-cut-to-size','glass-processing-services','mirror-decorative-glass','patterned-frosted-satin-glass','household-appliance-glass'],
  'architectural-project-glass':['tempered-glass','laminated-glass','low-e-coated-glass','insulated-glass-igu','heat-soak-tested-glass','fire-rated-glass']
};
const related=(relatedMap[slug]||[]).filter((item)=>(localizedGlassSlugs as readonly string[]).includes(item)) as LocalizedGlassSlug[];
const visualMap:Record<string,string>={
  'float-glass':'/images/glass/glass-applications-turkey.webp',
  'tempered-glass':'/images/glass/tempered-glass-production-turkey.webp',
  'heat-strengthened-glass':'/images/glass/glass-processing-line-turkey.webp',
  'heat-soak-tested-glass':'/images/glass/clear-glass-balustrade-turkey.webp',
  'laminated-glass':'/images/glass/laminated-glass-canopy-turkey.webp',
  'low-e-coated-glass':'/images/glass/low-e-coated-glass-production-turkey.webp',
  'solar-control-glass':'/images/glass/low-e-solar-control-glass-turkey.webp',
  'insulated-glass-igu':'/images/glass/insulated-glass-igu-production-turkey.webp',
  'low-iron-extra-clear-glass':'/images/glass/architectural-glass-facade-turkey.webp',
  'mirror-decorative-glass':'/images/glass/commercial-entrance-glass-turkey.webp',
  'patterned-frosted-satin-glass':'/images/glass/shopping-mall-storefront-glass-turkey.webp',
  'processed-glass-cut-to-size':'/images/glass/glass-cnc-processing-turkey.webp',
  'glass-processing-services':'/images/glass/glass-processing-line-turkey.webp',
  'curved-glass':'/images/glass/curved-bent-glass-production-turkey.webp',
  'ceramic-printed-glass':'/images/glass/shopping-mall-storefront-glass-turkey.webp',
  'fire-rated-glass':'/images/glass/fire-rated-glass-turkey.webp',
  'shower-enclosure-glass':'/images/glass/shower-enclosure-glass-turkey.webp',
  'balustrade-railing-glass':'/images/glass/balustrade-railing-glass-turkey.webp',
  'office-partition-interior-glass':'/images/glass/office-partition-glass-turkey.webp',
  'household-appliance-glass':'/images/glass/glass-applications-turkey.webp',
  'furniture-retail-glass':'/images/glass/shopping-mall-storefront-glass-turkey.webp',
  'architectural-project-glass':'/images/glass/architectural-glass-facade-turkey.webp'
};
const visual=visualMap[slug]||'/images/glass/glass-applications-turkey.webp';
const heroCropMap:Record<string,{position:string;scale:number}>={
  'float-glass':{position:'50% 48%',scale:1.30},
  'tempered-glass':{position:'52% 48%',scale:1.30},
  'heat-strengthened-glass':{position:'53% 47%',scale:1.31},
  'heat-soak-tested-glass':{position:'50% 46%',scale:1.28},
  'laminated-glass':{position:'50% 44%',scale:1.32},
  'low-e-coated-glass':{position:'56% 47%',scale:1.32},
  'solar-control-glass':{position:'52% 47%',scale:1.30},
  'insulated-glass-igu':{position:'52% 48%',scale:1.30},
  'low-iron-extra-clear-glass':{position:'50% 46%',scale:1.28},
  'mirror-decorative-glass':{position:'50% 45%',scale:1.28},
  'patterned-frosted-satin-glass':{position:'50% 47%',scale:1.28},
  'processed-glass-cut-to-size':{position:'51% 48%',scale:1.32},
  'glass-processing-services':{position:'53% 48%',scale:1.31},
  'curved-glass':{position:'52% 47%',scale:1.30},
  'ceramic-printed-glass':{position:'50% 46%',scale:1.28},
  'fire-rated-glass':{position:'52% 47%',scale:1.28},
  'shower-enclosure-glass':{position:'52% 46%',scale:1.27},
  'balustrade-railing-glass':{position:'50% 47%',scale:1.27},
  'office-partition-interior-glass':{position:'50% 46%',scale:1.27},
  'household-appliance-glass':{position:'50% 48%',scale:1.28},
  'furniture-retail-glass':{position:'50% 46%',scale:1.27},
  'architectural-project-glass':{position:'50% 46%',scale:1.27}
};
const heroCrop=heroCropMap[slug]||{position:'50% 50%',scale:1};
const partnerNotes:Record<LocalizedGlassLocale,string>={
de:'CTSEG ist kein Hersteller. Wir arbeiten über etablierte Geschäftsbeziehungen mit führenden türkischen Glasherstellern und zuverlässigen Verarbeitern und wählen den passenden Produktionsweg für jede Anfrage.',
it:'CTSEG non è un produttore. Operiamo attraverso rapporti commerciali consolidati con importanti produttori turchi di vetro e processor affidabili, selezionando il percorso produttivo più adatto.',
ru:'CTSEG не является производителем. Мы работаем через устойчивые коммерческие отношения с ведущими турецкими производителями стекла и проверенными переработчиками, подбирая подходящий производственный маршрут.',
fa:'CTSEG تولیدکننده نیست. ما از طریق روابط تجاری تثبیت‌شده با تولیدکنندگان مطرح شیشه در ترکیه و واحدهای فرآوری قابل اعتماد، مسیر تولید مناسب هر درخواست را هماهنگ می‌کنیم.',
zh:'CTSEG并非制造商。我们通过与土耳其领先玻璃制造商及可靠深加工企业建立的长期商业合作，为每个需求匹配合适的生产路径。',
vi:'CTSEG không phải là nhà sản xuất. Chúng tôi làm việc thông qua các quan hệ thương mại đã được thiết lập với những nhà sản xuất kính hàng đầu tại Thổ Nhĩ Kỳ và các đơn vị gia công đáng tin cậy.',
uk:'CTSEG не є виробником. Ми працюємо через налагоджені комерційні відносини з провідними турецькими виробниками скла та надійними переробниками, підбираючи відповідний виробничий маршрут.',
ro:'CTSEG nu este producător. Lucrăm prin relații comerciale consolidate cu producători de sticlă de top din Türkiye și procesatori de încredere, potrivind cerința cu ruta de producție potrivită.',
bg:'CTSEG не е производител. Работим чрез утвърдени търговски отношения с водещи турски производители на стъкло и надеждни преработватели, като избираме правилния производствен канал.',
he:'CTSEG אינה יצרנית. אנו עובדים באמצעות קשרים מסחריים מבוססים עם יצרני זכוכית מובילים בטורקיה ועם מעבדים אמינים, ומתאימים לכל דרישה את מסלול הייצור הנכון.'
};
const premiumUi:Record<LocalizedGlassLocale,{
  eyebrow:string;all:string;ecosystem:string;network:string;networkTitle:string;networkText:string;
  trust:[string,string,string,string]; features:[string,string,string,string,string]
}> = {
  de:{eyebrow:'CTSEG · GLASBESCHAFFUNG',all:'Alle Glaslösungen',ecosystem:'Anwendungen & Beschaffungsfelder',network:'TÜRKEI GLASNETZWERK',networkTitle:'Etablierte Geschäftsbeziehungen mit führenden Herstellern und Verarbeitern',networkText:'Wir wählen den passenden Produktionsweg nach Produkttyp, Verarbeitung, Dokumentation und Lieferanforderungen.',trust:['Starkes Herstellernetzwerk','Projekt- & Handelsversorgung','Technische Eignung','Globale Lieferkoordination'],features:['Technische Zuordnung','Verarbeitungskapazität','Projektversorgung','Dokumentenprüfung','Globale Logistik']},
  it:{eyebrow:'CTSEG · SOURCING VETRO',all:'Tutte le soluzioni vetro',ecosystem:'Applicazioni e aree di sourcing',network:'RETE VETRO TÜRKİYE',networkTitle:'Rapporti commerciali consolidati con produttori e processor di primo piano',networkText:'Selezioniamo il percorso produttivo in base a prodotto, lavorazioni, documentazione e condizioni di consegna.',trust:['Rete produttiva consolidata','Fornitura progetto & commerciale','Idoneità tecnica','Coordinamento consegne globali'],features:['Matching tecnico','Capacità di lavorazione','Fornitura progetto','Controllo documenti','Logistica globale']},
  ru:{eyebrow:'CTSEG · ПОСТАВКА СТЕКЛА',all:'Все стекольные решения',ecosystem:'Применение и направления поставок',network:'СТЕКОЛЬНАЯ СЕТЬ TÜRKİYE',networkTitle:'Устойчивые коммерческие связи с ведущими производителями и переработчиками',networkText:'Производственный маршрут выбирается по типу продукта, обработке, документации и условиям поставки.',trust:['Сильная сеть производителей','Проектные и коммерческие поставки','Техническое соответствие','Глобальная координация поставок'],features:['Технический подбор','Возможности обработки','Проектные поставки','Проверка документов','Глобальная логистика']},
  fa:{eyebrow:'CTSEG · تأمین شیشه',all:'همه راهکارهای شیشه',ecosystem:'کاربردها و حوزه‌های تأمین',network:'شبکه تأمین شیشه ترکیه',networkTitle:'روابط تجاری تثبیت‌شده با تولیدکنندگان و فرآوری‌کنندگان پیشرو',networkText:'مسیر تولید بر اساس نوع محصول، فرآوری، اسناد و شرایط تحویل انتخاب می‌شود.',trust:['شبکه قوی تولیدکنندگان','تأمین پروژه و تجاری','انطباق فنی','هماهنگی تحویل جهانی'],features:['تطبیق فنی','توان فرآوری','تأمین پروژه','کنترل اسناد','لجستیک جهانی']},
  zh:{eyebrow:'CTSEG · 玻璃采购',all:'全部玻璃解决方案',ecosystem:'应用与采购领域',network:'土耳其玻璃供应网络',networkTitle:'与领先制造商及深加工企业建立稳定商业合作',networkText:'根据产品类型、加工能力、文件要求和交付条件选择合适生产路径。',trust:['领先制造网络','项目与商业供应','技术适配','全球交付协调'],features:['技术匹配','加工能力','项目供应','文件核验','全球物流']},
  vi:{eyebrow:'CTSEG · TÌM NGUỒN CUNG KÍNH',all:'Tất cả giải pháp kính',ecosystem:'Ứng dụng & khu vực sourcing',network:'MẠNG LƯỚI KÍNH TÜRKİYE',networkTitle:'Quan hệ thương mại ổn định với các nhà sản xuất và đơn vị gia công hàng đầu',networkText:'Lộ trình sản xuất được chọn theo loại sản phẩm, gia công, chứng từ và điều kiện giao hàng.',trust:['Mạng lưới nhà sản xuất mạnh','Cung ứng dự án & thương mại','Phù hợp kỹ thuật','Điều phối giao hàng toàn cầu'],features:['Khớp yêu cầu kỹ thuật','Năng lực gia công','Cung ứng dự án','Kiểm tra chứng từ','Logistics toàn cầu']},
  uk:{eyebrow:'CTSEG · ПОСТАЧАННЯ СКЛА',all:'Усі скляні рішення',ecosystem:'Застосування та напрями постачання',network:'СКЛЯНА МЕРЕЖА TÜRKİYE',networkTitle:'Налагоджені комерційні відносини з провідними виробниками та переробниками',networkText:'Виробничий маршрут визначається типом продукту, обробкою, документами та умовами постачання.',trust:['Сильна мережа виробників','Проєктне та комерційне постачання','Технічна відповідність','Глобальна координація доставки'],features:['Технічний підбір','Можливості обробки','Проєктне постачання','Перевірка документів','Глобальна логістика']},
  ro:{eyebrow:'CTSEG · APROVIZIONARE STICLĂ',all:'Toate soluțiile din sticlă',ecosystem:'Aplicații și zone de sourcing',network:'REȚEAUA DE STICLĂ TÜRKİYE',networkTitle:'Relații comerciale consolidate cu producători și procesatori de top',networkText:'Ruta de producție este selectată după tipul produsului, procesare, documentație și condițiile de livrare.',trust:['Rețea puternică de producători','Furnizare proiect & comercială','Compatibilitate tehnică','Coordonare globală a livrării'],features:['Potrivire tehnică','Capacitate de procesare','Furnizare proiect','Verificare documente','Logistică globală']},
  bg:{eyebrow:'CTSEG · СНАБДЯВАНЕ СЪС СТЪКЛО',all:'Всички решения за стъкло',ecosystem:'Приложения и направления за снабдяване',network:'МРЕЖА ЗА СТЪКЛО TÜRKİYE',networkTitle:'Утвърдени търговски отношения с водещи производители и преработватели',networkText:'Производственият маршрут се избира според продукта, обработката, документите и условията за доставка.',trust:['Силна мрежа от производители','Проектно и търговско снабдяване','Техническа съвместимост','Глобална координация на доставките'],features:['Техническо съпоставяне','Капацитет за обработка','Проектно снабдяване','Проверка на документи','Глобална логистика']},
  he:{eyebrow:'CTSEG · אספקת זכוכית',all:'כל פתרונות הזכוכית',ecosystem:'יישומים ותחומי אספקה',network:'רשת הזכוכית של TÜRKİYE',networkTitle:'קשרים מסחריים מבוססים עם יצרנים ומעבדים מובילים',networkText:'מסלול הייצור נבחר לפי סוג המוצר, עיבוד, מסמכים ותנאי אספקה.',trust:['רשת יצרנים חזקה','אספקת פרויקטים ומסחר','התאמה טכנית','תיאום אספקה גלובלי'],features:['התאמה טכנית','יכולת עיבוד','אספקת פרויקטים','בדיקת מסמכים','לוגיסטיקה גלובלית']}
};
const pu=premiumUi[lang];
const visualCards=related.slice(0,4).map((relatedSlug)=>({slug:relatedSlug,name:localeCopy.products[relatedSlug].name,image:visualMap[relatedSlug]||'/images/glass/glass-applications-turkey.webp'}));

---
<BaseLayout lang={lang as any} title={product.metaTitle} description={product.description} canonical={canonical} alternates={alt} schema={schema} pageKey="glass-product" pageId={slug}>
  <main class="glass-product" dir={lang==='fa'||lang==='he'?'rtl':'ltr'}>
    <section class="hero">
      <div class="hero-media" style={`--hero-pos:${heroCrop.position};--hero-scale:${heroCrop.scale}`}><img src={visual} alt={product.name} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async"/></div>
      <div class="hero-shade"></div>
      <div class="container hero-content">
        <div class="hero-copy">
          <span class="eyebrow">{pu.eyebrow}</span>
          <h1>{product.name}</h1>
          <p class="hero-lead">{product.lead}</p>
          <p class="partner-note">{partnerNotes[lang]}</p>
          <div class="hero-actions">
            <a class="button primary" href="#rfq">{localeCopy.rfq}</a>
            <a class="button ghost" href={`/${lang}/glass/`}>{pu.all}</a>
          </div>
        </div>
        <aside class="trust-panel">
          {pu.trust.map((title,index)=><div class="trust-item">
            <span class="trust-icon">{String(index+1).padStart(2,'0')}</span>
            <div><strong>{title}</strong><p>{index===0?partnerNotes[lang]:index===1?localeCopy.buyersTitle:index===2?localeCopy.applicationsTitle:pu.features[4]}</p></div>
          </div>)}
        </aside>
      </div>
    </section>

    <section class="feature-strip"><div class="container feature-grid">
      {pu.features.map((title,index)=><div class="feature-item"><strong>{title}</strong><span>{index<localeCopy.applications.length?localeCopy.applications[index]:localeCopy.buyers[index-localeCopy.applications.length]||title}</span></div>)}
    </div></section>

    <section class="section applications"><div class="container">
      <div class="section-intro"><div><span class="eyebrow dark">{pu.eyebrow}</span><h2>{pu.ecosystem}</h2></div><p>{product.description}</p></div>
      <div class="application-grid">
        {visualCards.map((item)=><a class="application-card" href={`/${lang}/glass/${item.slug}/`}>
          <img src={item.image} alt={item.name} width="1600" height="900" loading="lazy" decoding="async"/>
          <span class="card-shade"></span><div class="card-copy"><strong>{item.name}</strong><span>↗</span></div>
        </a>)}
      </div>
    </div></section>

    <section class="section partner-network"><div class="container partner-grid">
      <div>
        <span class="eyebrow dark">{pu.network}</span>
        <h2>{pu.networkTitle}</h2>
        <p>{partnerNotes[lang]}</p><p>{pu.networkText}</p>
        <a class="button dark-btn" href="#rfq">{localeCopy.rfq}</a>
      </div>
      <div class="partner-gallery">
        <img src="/images/glass/glass-processing-line-turkey.webp" alt="" width="1600" height="900" loading="lazy"/>
        <img src="/images/glass/glass-cnc-processing-turkey.webp" alt="" width="1600" height="900" loading="lazy"/>
        <img src="/images/glass/architectural-glass-facade-turkey.webp" alt="" width="1600" height="900" loading="lazy"/>
      </div>
    </div></section>

    <section class="section rfq-brief"><div class="container"><div class="center head"><h2>{localeCopy.rfqTitle}</h2></div><div class="brief-grid">{localeCopy.rfqItems.map((x)=><article><h3>{x}</h3></article>)}</div></div></section>
    <section class="section related"><div class="container"><div class="center head"><h2>{localeCopy.relatedTitle}</h2></div><div class="links">{related.map((relatedSlug)=><a href={`/${lang}/glass/${relatedSlug}/`}><strong>{localeCopy.products[relatedSlug].name}</strong><span>↗</span></a>)}</div></div></section>
    <section class="section faq"><div class="container"><div class="center head"><h2>{localeCopy.faqTitle}</h2></div><div class="faqs">{localeCopy.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
    <section class="section form" id="rfq"><div class="container"><CommercialRequestForm lang={lang as any}/></div></section>
  </main>
</BaseLayout>
