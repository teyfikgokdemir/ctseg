---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommercialRequestForm from './CommercialRequestForm.astro';
import { activeLocales } from '../data/locales';
import { localizedGlassProductCopy, localizedGlassSlugs, type LocalizedGlassLocale, type LocalizedGlassSlug } from '../data/glass-product-locales';
import { getGlassSeoPage } from '../data/glass-seo';

const { lang, slug } = Astro.props as {lang:LocalizedGlassLocale;slug:LocalizedGlassSlug};
const localeCopy=localizedGlassProductCopy[lang];
const product=localeCopy.products[slug];
const canonical=`https://ctseg.com.tr/${lang}/glass/${slug}/`;
const alt=Object.fromEntries([
  ['tr',`https://ctseg.com.tr/glass/${slug}/`],
  ['en',`https://ctseg.com.tr/en/glass/${slug}/`],
  ...activeLocales.filter((code)=>!['tr','en'].includes(code)).map((code)=>[code,`https://ctseg.com.tr/${code}/glass/${slug}/`]),
  ['x-default',`https://ctseg.com.tr/en/glass/${slug}/`]
]);
const schema=[
  {'@context':'https://schema.org','@type':'Service','name':product.name,'description':product.description,'url':canonical,'areaServed':'Worldwide','provider':{'@type':'Organization','name':'CTSEG','url':'https://ctseg.com.tr/'}},
  {'@context':'https://schema.org','@type':'FAQPage','mainEntity':localeCopy.faq.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))},
  {'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':localeCopy.relatedTitle,'item':`https://ctseg.com.tr/${lang}/glass/`},{'@type':'ListItem','position':2,'name':product.name,'item':canonical}]}
];
const relatedMap:Record<string,string[]>={
  'float-glass':['low-iron-extra-clear-glass','tempered-glass','laminated-glass','low-e-coated-glass','processed-glass-cut-to-size'],
  'tempered-glass':['heat-strengthened-glass','heat-soak-tested-glass','laminated-glass','shower-enclosure-glass','balustrade-railing-glass'],
  'heat-strengthened-glass':['tempered-glass','heat-soak-tested-glass','laminated-glass','architectural-project-glass','insulated-glass-igu'],
  'heat-soak-tested-glass':['tempered-glass','heat-strengthened-glass','balustrade-railing-glass','architectural-project-glass','fire-rated-glass'],
  'laminated-glass':['tempered-glass','balustrade-railing-glass','office-partition-interior-glass','fire-rated-glass','architectural-project-glass'],
  'low-e-coated-glass':['solar-control-glass','insulated-glass-igu','architectural-project-glass','float-glass','low-iron-extra-clear-glass'],
  'solar-control-glass':['low-e-coated-glass','insulated-glass-igu','architectural-project-glass','float-glass','ceramic-printed-glass'],
  'insulated-glass-igu':['low-e-coated-glass','solar-control-glass','tempered-glass','architectural-project-glass','office-partition-interior-glass'],
  'low-iron-extra-clear-glass':['float-glass','laminated-glass','balustrade-railing-glass','furniture-retail-glass','architectural-project-glass'],
  'mirror-decorative-glass':['patterned-frosted-satin-glass','ceramic-printed-glass','furniture-retail-glass','office-partition-interior-glass','processed-glass-cut-to-size'],
  'patterned-frosted-satin-glass':['mirror-decorative-glass','ceramic-printed-glass','office-partition-interior-glass','shower-enclosure-glass','furniture-retail-glass'],
  'processed-glass-cut-to-size':['glass-processing-services','curved-glass','ceramic-printed-glass','furniture-retail-glass','household-appliance-glass'],
  'glass-processing-services':['processed-glass-cut-to-size','curved-glass','ceramic-printed-glass','household-appliance-glass','furniture-retail-glass'],
  'curved-glass':['glass-processing-services','processed-glass-cut-to-size','laminated-glass','architectural-project-glass','furniture-retail-glass'],
  'ceramic-printed-glass':['glass-processing-services','patterned-frosted-satin-glass','household-appliance-glass','furniture-retail-glass','architectural-project-glass'],
  'fire-rated-glass':['laminated-glass','office-partition-interior-glass','architectural-project-glass','heat-soak-tested-glass'],
  'shower-enclosure-glass':['tempered-glass','patterned-frosted-satin-glass','glass-processing-services','processed-glass-cut-to-size','furniture-retail-glass'],
  'balustrade-railing-glass':['laminated-glass','tempered-glass','heat-soak-tested-glass','low-iron-extra-clear-glass','architectural-project-glass'],
  'office-partition-interior-glass':['tempered-glass','laminated-glass','patterned-frosted-satin-glass','fire-rated-glass','furniture-retail-glass'],
  'household-appliance-glass':['ceramic-printed-glass','glass-processing-services','processed-glass-cut-to-size','tempered-glass','furniture-retail-glass'],
  'furniture-retail-glass':['processed-glass-cut-to-size','glass-processing-services','mirror-decorative-glass','patterned-frosted-satin-glass','household-appliance-glass'],
  'architectural-project-glass':['tempered-glass','laminated-glass','low-e-coated-glass','insulated-glass-igu','heat-soak-tested-glass','fire-rated-glass']
};
const related=(relatedMap[slug]||[]).filter((item)=>(localizedGlassSlugs as readonly string[]).includes(item)) as LocalizedGlassSlug[];
const safetySlugs=new Set(['heat-soak-tested-glass','fire-rated-glass','tempered-glass','heat-strengthened-glass','laminated-glass']);
const applicationSlugs=new Set(['shower-enclosure-glass','balustrade-railing-glass','office-partition-interior-glass','household-appliance-glass','furniture-retail-glass']);
const visual=safetySlugs.has(slug)?'/images/glass/glass-safety-certified.svg':applicationSlugs.has(slug)?'/images/glass/glass-applications-oem.svg':'/images/glass/glass-core-performance.svg';
const partnerNotes:Record<LocalizedGlassLocale,string>={
de:'CTSEG ist kein Hersteller. Wir arbeiten über etablierte Geschäftsbeziehungen mit führenden türkischen Glasherstellern und zuverlässigen Verarbeitern und wählen den passenden Produktionsweg für jede Anfrage.',
it:'CTSEG non è un produttore. Operiamo attraverso rapporti commerciali consolidati con importanti produttori turchi di vetro e processor affidabili, selezionando il percorso produttivo più adatto.',
ru:'CTSEG не является производителем. Мы работаем через устойчивые коммерческие отношения с ведущими турецкими производителями стекла и проверенными переработчиками, подбирая подходящий производственный маршрут.',
fa:'CTSEG تولیدکننده نیست. ما از طریق روابط تجاری تثبیت‌شده با تولیدکنندگان مطرح شیشه در ترکیه و واحدهای فرآوری قابل اعتماد، مسیر تولید مناسب هر درخواست را هماهنگ می‌کنیم.',
zh:'CTSEG并非制造商。我们通过与土耳其领先玻璃制造商及可靠深加工企业建立的长期商业合作，为每个需求匹配合适的生产路径。',
vi:'CTSEG không phải là nhà sản xuất. Chúng tôi làm việc thông qua các quan hệ thương mại đã được thiết lập với những nhà sản xuất kính hàng đầu tại Thổ Nhĩ Kỳ và các đơn vị gia công đáng tin cậy.',
uk:'CTSEG не є виробником. Ми працюємо через налагоджені комерційні відносини з провідними турецькими виробниками скла та надійними переробниками, підбираючи відповідний виробничий маршрут.',
ro:'CTSEG nu este producător. Lucrăm prin relații comerciale consolidate cu producători de sticlă de top din Türkiye și procesatori de încredere, potrivind cerința cu ruta de producție potrivită.',
bg:'CTSEG не е производител. Работим чрез утвърдени търговски отношения с водещи турски производители на стъкло и надеждни преработватели, като избираме правилния производствен канал.',
he:'CTSEG אינה יצרנית. אנו עובדים באמצעות קשרים מסחריים מבוססים עם יצרני זכוכית מובילים בטורקיה ועם מעבדים אמינים, ומתאימים לכל דרישה את מסלול הייצור הנכון.'
};
---
<BaseLayout lang={lang as any} title={product.metaTitle} description={product.description} canonical={canonical} alternates={alt} schema={schema} pageKey="glass-product" pageId={slug}>
  <main class="glass-product" dir={lang==='fa'||lang==='he'?'rtl':'ltr'}>
    <section class="hero section"><div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">CTSEG · GLASS SOURCING</span>
        <h1>{product.name}</h1>
        <p>{product.lead}</p>
        <p class="partner-note">{partnerNotes[lang]}</p>
        <a class="button primary" href="#rfq">{localeCopy.rfq}</a>
      </div>
      <figure class="hero-visual"><img src={visual} alt={product.name} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async"/></figure>
    </div></section>
    <section class="section"><div class="container split">
      <div><h2>{localeCopy.applicationsTitle}</h2><ul>{localeCopy.applications.map((x)=><li>{x}</li>)}</ul></div>
      <div><h2>{localeCopy.buyersTitle}</h2><ul>{localeCopy.buyers.map((x)=><li>{x}</li>)}</ul></div>
    </div></section>
    <section class="section rfq-brief"><div class="container">
      <div class="center head"><h2>{localeCopy.rfqTitle}</h2></div>
      <div class="brief-grid">{localeCopy.rfqItems.map((x)=><article><h3>{x}</h3></article>)}</div>
    </div></section>
    <section class="section related"><div class="container">
      <div class="center head"><h2>{localeCopy.relatedTitle}</h2></div>
      <div class="links">
        {related.map((relatedSlug)=><a href={`/${lang}/glass/${relatedSlug}/`}><strong>{localeCopy.products[relatedSlug].name}</strong><span aria-hidden="true">↗</span></a>)}
        <a href={`/${lang}/glass/`}><strong>{lang==='de'?'Alle Glasgruppen':lang==='it'?'Tutti i gruppi vetro':lang==='ru'?'Все группы стекла':lang==='fa'?'همه گروه‌های شیشه':lang==='zh'?'全部玻璃类别':lang==='vi'?'Tất cả nhóm kính':lang==='uk'?'Усі групи скла':lang==='ro'?'Toate grupele de sticlă':lang==='bg'?'Всички групи стъкло':'כל קבוצות הזכוכית'}</strong><span aria-hidden="true">↗</span></a>
      </div>
    </div></section>
    <section class="section faq"><div class="container">
      <div class="center head"><h2>{localeCopy.faqTitle}</h2></div>
      <div class="faqs">{localeCopy.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div>
    </div></section>
    <section class="section form" id="rfq"><div class="container"><CommercialRequestForm lang={lang as any}/></div></section>
  </main>
</BaseLayout>
<style>
.glass-product{background:#f2efe7;color:#171914}.hero{background:#10120f;color:#f4f5ef;padding:clamp(3.5rem,6vw,6rem) 0;overflow:hidden}.hero-grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(420px,1.08fr);gap:clamp(2rem,5vw,5rem);align-items:center}.hero-copy{text-align:start}.hero h1,.head h2{max-width:1180px;margin:.65rem auto 0;text-align:center;text-wrap:balance}.hero h1{color:#f4f5ef!important;font-size:clamp(2.35rem,4.2vw,4.75rem);line-height:1.02;margin:.65rem 0 0;text-align:start}.hero p{max-width:760px;margin:1.15rem 0;color:#d8ddd7!important;line-height:1.7}.partner-note{font-size:.9rem;color:#b8c1ba!important;border-inline-start:2px solid #c7ff38;padding-inline-start:1rem}.hero-visual{margin:0;border:1px solid rgba(255,255,255,.1);border-radius:24px;overflow:hidden;background:#171a16;box-shadow:0 28px 70px rgba(0,0,0,.28)}.hero-visual img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem)}.split h2,.head h2{font-size:clamp(2rem,3vw,3.4rem);line-height:1.06}.split ul{list-style:none;margin:1.3rem 0 0;padding:0}.split li{padding:.9rem 0;border-bottom:1px solid rgba(0,0,0,.14)}.rfq-brief{background:#e7e2d7}.brief-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:2rem}.brief-grid article{background:#121712;color:#f4f5ef;padding:1.5rem;min-height:130px;display:flex;align-items:flex-end}.brief-grid h3{margin:0;color:#f4f5ef!important;font-size:1rem}.links{max-width:960px;margin:2rem auto 0}.links a{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-top:1px solid rgba(0,0,0,.15);color:inherit;text-decoration:none}.links a:last-child{border-bottom:1px solid rgba(0,0,0,.15)}.faqs{max-width:920px;margin:2rem auto 0}.faqs details{padding:1.1rem 0;border-top:1px solid rgba(0,0,0,.15)}.faqs details:last-child{border-bottom:1px solid rgba(0,0,0,.15)}.faqs summary{font-weight:750;cursor:pointer}.faqs p{line-height:1.7}.form{background:#10120f}@media(max-width:980px){.hero-grid{grid-template-columns:1fr}.hero-copy{text-align:center}.hero h1{text-align:center}.hero p{margin-left:auto;margin-right:auto}.partner-note{border-inline-start:0;border-top:2px solid #c7ff38;padding:1rem 0 0}.hero-visual{max-width:900px;margin:0 auto}.brief-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:720px){.split,.brief-grid{grid-template-columns:1fr}.hero h1{font-size:clamp(2.05rem,9vw,3rem)}}
</style>