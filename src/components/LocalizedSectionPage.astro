---
import BaseLayout from '../layouts/BaseLayout.astro';
import TradeSiteChrome from './TradeSiteChrome.astro';
const {lang='en',section='services',title,description,eyebrow,h1,lead,cards=[]}=Astro.props;
const canonical=`https://ctseg.com.tr/${lang==='tr'?'tr':lang}/${section}/`;
const schema={'@context':'https://schema.org','@type':'CollectionPage','@id':canonical+'#webpage',url:canonical,name:title,description,inLanguage:lang,isPartOf:{'@id':'https://ctseg.com.tr/#website'}};
---
<BaseLayout {lang} {title} {description} {canonical} schema={[schema]}>
<div class:list={['localized-page',`localized-${lang}`]}><TradeSiteChrome {lang} mode="header"/><main><section class="localized-hero"><div class="localized-flag"><span></span><span></span><span></span></div><div class="localized-wrap"><p>{eyebrow}</p><h1>{h1}</h1><div class="localized-lead">{lead}</div></div></section><section class="localized-content"><div class="localized-wrap"><div class="localized-grid">{cards.map(([heading,copy,url])=><a href={url||'mailto:info@ctseg.com.tr'}><span>CTSEG</span><h2>{heading}</h2><p>{copy}</p><b>↗</b></a>)}</div></div></section><section class="localized-cta"><div class="localized-wrap"><h2>CTSEG</h2><p>Strategic sourcing · Procurement · International trade</p><a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div></section></main><TradeSiteChrome {lang} mode="footer"/></div>
<style>
.localized-page{--accent:#e30a17;--accent2:#ff9a9f;--flag1:#e30a17;--flag2:#fff;--flag3:#e30a17;background:#070b11;color:#f5f7fa;min-height:100vh}.localized-it{--accent:#169b62;--accent2:#8fe0bc;--flag1:#169b62;--flag2:#fff;--flag3:#ce2b37}.localized-de{--accent:#ffce00;--accent2:#f6db72;--flag1:#111;--flag2:#d71920;--flag3:#ffce00}.localized-en{--accent:#d7b56d;--accent2:#f3d99a;--flag1:#163c73;--flag2:#fff;--flag3:#b31942}.localized-fr{--accent:#0055a4;--accent2:#8ec5f4;--flag1:#0055a4;--flag2:#fff;--flag3:#ef4135}.localized-wrap{width:min(1160px,calc(100% - 40px));margin:auto}.localized-hero{position:relative;padding:110px 0 90px;background:radial-gradient(circle at 80% 10%,color-mix(in srgb,var(--accent) 20%,transparent),transparent 28rem),linear-gradient(145deg,#070b11,#101923)}.localized-flag{position:absolute;inset:0 0 auto;height:4px;display:grid;grid-template-columns:repeat(3,1fr)}.localized-flag span:nth-child(1){background:var(--flag1)}.localized-flag span:nth-child(2){background:var(--flag2)}.localized-flag span:nth-child(3){background:var(--flag3)}.localized-hero p{margin:0 0 18px;color:var(--accent2);font-size:12px;font-weight:850;letter-spacing:.16em;text-transform:uppercase}.localized-hero h1{max-width:980px;margin:0;font-size:clamp(46px,7vw,88px);line-height:.98;letter-spacing:-.055em}.localized-lead{max-width:820px;margin-top:28px;color:#b8c3cf;font-size:clamp(18px,2vw,24px);line-height:1.65}.localized-content{padding:90px 0;border-top:1px solid #222a34}.localized-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.localized-grid a{position:relative;min-height:260px;padding:28px;border:1px solid #2c3541;border-radius:24px;background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.015))}.localized-grid span{color:var(--accent2);font-size:11px;font-weight:850;letter-spacing:.14em}.localized-grid h2{margin:24px 0 14px;font-size:28px}.localized-grid p{color:#aeb9c6;line-height:1.7}.localized-grid b{position:absolute;right:24px;bottom:22px;color:var(--accent);font-size:24px}.localized-cta{padding:90px 0;text-align:center;background:#0a1119}.localized-cta h2{margin:0;font-size:48px}.localized-cta p{color:#9da9b7}.localized-cta a{display:inline-flex;margin-top:15px;padding:14px 22px;border-radius:999px;background:var(--accent);color:#fff;font-weight:850}.localized-de .localized-cta a{color:#111}@media(max-width:850px){.localized-grid{grid-template-columns:1fr}.localized-wrap{width:min(1160px,calc(100% - 24px))}}
</style>
</BaseLayout>