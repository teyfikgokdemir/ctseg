---
import { localizedPath, ui, type Locale } from '../data/site';
const { lang, eyebrow, title, lead, parentHref, parentLabel } = Astro.props as {
  lang: Locale; eyebrow: string; title: string; lead: string; parentHref?: string; parentLabel?: string;
};
---
<section class="page-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href={localizedPath(lang,'home')}>{ui[lang].home}</a>
      {parentHref && <><span>/</span><a href={parentHref}>{parentLabel}</a></>}
      <span>/</span><span>{title}</span>
    </div>
    <p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="lead">{lead}</p>
  </div>
</section>
