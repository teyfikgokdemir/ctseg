---
import { localizedPath, ui, type Locale } from '../data/site';
import ProductMedia from './ProductMedia.astro';
const { lang, eyebrow, title, lead, parentHref, parentLabel, product, ctaHref, ctaLabel, imageNote, compact=false } = Astro.props as {
  lang: Locale; eyebrow: string; title: string; lead: string; parentHref?: string; parentLabel?: string;
  product?:any; ctaHref?:string; ctaLabel?:string; imageNote?:string; compact?:boolean;
};
---
<section class:list={['page-hero', { 'product-page-hero':product, 'page-hero--compact':compact }]} data-page-hero>
  <div class:list={['container', { 'page-hero-grid':product }]}>
    <div class="page-hero-copy">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={localizedPath(lang,'home')}>{ui[lang].home}</a>
        {parentHref && <><span aria-hidden="true">/</span><a href={parentHref}>{parentLabel}</a></>}
        <span aria-hidden="true">/</span><span aria-current="page">{title}</span>
      </nav>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      {ctaHref && ctaLabel && <div class="actions"><a class="button" href={ctaHref}>{ctaLabel}</a></div>}
    </div>
    {product && <div class="page-hero-media-wrap"><ProductMedia product={product} lang={lang} eager={true} className="product-hero-media" />{imageNote && <p class="media-note">{imageNote}</p>}</div>}
  </div>
</section>

<style is:global>
  .page-hero{
    position:relative;
    overflow:hidden;
    background:#161616!important;
    color:#fff!important;
    border-bottom:1px solid rgba(255,255,255,.1);
    padding-block:clamp(72px,8vw,132px)!important;
  }
  .page-hero::before{
    content:none!important;
    display:none!important;
  }
  .page-hero>.container{position:relative;z-index:1}
  .page-hero-grid{display:grid!important;grid-template-columns:minmax(0,.9fr) minmax(420px,1.1fr)!important;gap:clamp(44px,6vw,96px)!important;align-items:center!important}
  .page-hero-copy{max-width:900px}
  .page-hero .breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:0 0 34px;font-size:12px;line-height:1.3;color:#9d9d98}
  .page-hero .breadcrumb a{color:#c8c8c2;text-decoration:none;transition:color .2s ease}
  .page-hero .breadcrumb a:hover{color:#c4f000}
  .page-hero .breadcrumb [aria-current="page"]{color:#777773;max-width:44ch;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .page-hero .eyebrow{margin:0 0 18px;color:#c4f000!important;font-size:12px!important;line-height:1.2;font-weight:800!important;letter-spacing:.15em!important;text-transform:uppercase}
  .page-hero h1{
    margin:0!important;
    max-width:13ch!important;
    color:#fff!important;
    font-family:var(--font-sans,Arial,sans-serif)!important;
    font-size:clamp(52px,6.1vw,96px)!important;
    font-weight:800!important;
    line-height:.95!important;
    letter-spacing:-.06em!important;
    text-wrap:balance;
  }
  .page-hero .lead{
    max-width:48rem!important;
    margin:30px 0 0!important;
    color:#d9d9d4!important;
    font-size:clamp(17px,1.35vw,20px)!important;
    line-height:1.65!important;
    font-weight:500!important;
  }
  .page-hero .actions{margin-top:32px}
  .page-hero .button{border-radius:999px!important;background:#c4f000!important;color:#0a0a0a!important;border-color:#c4f000!important;padding:14px 22px!important;font-weight:800!important}
  .page-hero-media-wrap{position:relative;min-width:0}
  .page-hero .product-hero-media{border-radius:24px!important;overflow:hidden!important;border:1px solid rgba(255,255,255,.14)!important;box-shadow:0 28px 70px rgba(0,0,0,.28)!important}
  .page-hero .media-note{margin:12px 0 0!important;color:#a8a8a3!important;font-size:12px!important}
  .page-hero.page-hero--compact{padding-block:clamp(40px,4.2vw,64px)!important}
  .page-hero--compact h1{font-size:clamp(46px,5vw,78px)!important;max-width:15ch!important}

  @media(max-width:980px){
    .page-hero-grid{grid-template-columns:1fr!important}
    .page-hero h1{font-size:clamp(46px,8vw,72px)!important;max-width:16ch!important}
    .page-hero .breadcrumb{margin-bottom:26px}
  }
  @media(max-width:620px){
    .page-hero{padding-block:58px!important}
    .page-hero.page-hero--compact{padding-block:40px!important}
    .page-hero h1{font-size:clamp(38px,10.5vw,52px)!important;line-height:.98!important;letter-spacing:-.045em!important;max-width:100%!important}
    .page-hero .lead{margin-top:22px!important;font-size:16px!important;line-height:1.6!important}
    .page-hero .breadcrumb [aria-current="page"]{max-width:26ch}
    .page-hero .button{width:100%;justify-content:center}
  }
</style>
