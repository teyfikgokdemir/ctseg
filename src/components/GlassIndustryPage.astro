---
import CommercialRequestForm from './CommercialRequestForm.astro';
import { glassSeoPages } from '../data/glass-seo';
const { lang='tr' }=Astro.props as {lang?:'tr'|'en'}; const tr=lang==='tr';
const c=tr?{
eyebrow:'Cam Tedariki · Türkiye & Global',title:'Cam tedariği için tek ticari koordinasyon noktası.',lead:'CTSEG; mimari, endüstriyel ve proje bazlı cam ihtiyaçlarında ürün eşleştirme, tedarikçi koordinasyonu, RFQ, ihracat ve teslim sürecini B2B alıcılar için tek akışta yönetir.',
productsTitle:'Cam ürün grupları',products:[['Float / Düz Cam','Şeffaf float cam, ultra clear ve farklı kalınlık/ebat seçenekleri.'],['Renkli Float Cam','Füme, bronz, yeşil ve mavi tonlarda proje ihtiyaçları.'],['Low-E & Kaplamalı Cam','Enerji verimliliği ve performans odaklı kaplamalı cam çözümleri.'],['Solar Control Cam','Cephe, pencere ve ticari yapı uygulamaları için güneş kontrol camı.'],['Lamine Cam','Güvenlik, akustik performans ve proje şartnamelerine uygun tedarik.'],['Temperlenebilir Cam','Isıl işlem gerektiren projeler için uygun baz cam seçenekleri.'],['Ayna & Dekoratif Cam','Ayna, satina, boyalı ve iç mimari cam grupları.'],['Proje Bazlı Cam','Cephe, IGU, doğrama ve endüstriyel projeler için spesifikasyona göre tedarik.']],
processTitle:'RFQ’dan teslimata kadar ticari akış',process:['Ürün tipi, kalınlık, ebat ve teknik gereksinimin netleştirilmesi','Miktar, paketleme ve yükleme planının belirlenmesi','Uygun üretim ve tedarik kanalının eşleştirilmesi','EXW, FOB, CIF veya proje şartına göre teklif koordinasyonu','İhracat, dokümantasyon ve teslim sürecinin takibi'],
buyersTitle:'Kimler için?',buyers:['Cam ithalatçıları ve distribütörleri','IGU / ısıcam üreticileri','Cam işleme ve temper tesisleri','Cephe ve alüminyum sistem firmaları','Pencere ve doğrama üreticileri','Müteahhitler ve proje satın alma ekipleri'],
faqTitle:'Cam tedariğinde sık sorulanlar',faq:[['Teklif için hangi bilgiler gerekli?','Ürün tipi, kalınlık, ebat, yaklaşık miktar, teslim noktası ve tercih edilen Incoterm başlangıç için yeterlidir.'],['Konteyner bazlı teklif alınabilir mi?','Evet. Ebat, kalınlık, paketleme ve ağırlık sınırlarına göre uygun yükleme modeli oluşturulur.'],['Türkiye dışına ihracat yapılabilir mi?','Evet. Uygun ürün ve tedarik kanalına göre ihracat ve teslim seçenekleri RFQ aşamasında değerlendirilir.'],['Tek bir üreticiyle mi çalışılıyor?','Hayır. Amaç marka reklamı değil, alıcının teknik ve ticari gereksinimine uygun tedarik kanalını oluşturmaktır.']],cta:'Cam RFQ Gönder'
}:{eyebrow:'Glass Sourcing · Türkiye & Global',title:'One commercial coordination point for glass sourcing.',lead:'CTSEG coordinates product matching, supplier sourcing, RFQs, export and delivery for architectural, industrial and project-based glass requirements.',
productsTitle:'Glass product groups',products:[['Clear Float Glass','Clear float and ultra-clear options across project-driven thickness and sheet sizes.'],['Tinted Float Glass','Smoke, bronze, green and blue tinted float glass.'],['Low-E & Coated Glass','Coated glass for thermal performance and energy efficiency.'],['Solar Control Glass','Solar-control solutions for façades, windows and commercial buildings.'],['Laminated Glass','Laminated glass for safety, acoustic and project specifications.'],['Temperable Glass','Suitable base-glass options for applications requiring heat treatment.'],['Mirror & Decorative Glass','Mirror, satin, lacquered and decorative glass groups.'],['Project Glass Supply','Specification-led sourcing for façades, IGU, fenestration and industrial projects.']],
processTitle:'Commercial flow from RFQ to delivery',process:['Define glass type, thickness, dimensions and technical requirements','Confirm quantity, packing and loading requirements','Match the requirement with an appropriate supply channel','Coordinate EXW, FOB, CIF or project-specific terms','Follow export documentation and delivery coordination'],
buyersTitle:'Who we work with',buyers:['Glass importers and distributors','IGU manufacturers','Glass processors and tempering plants','Façade and aluminium system companies','Window and fenestration manufacturers','Contractors and project procurement teams'],
faqTitle:'Glass sourcing FAQ',faq:[['What information is needed for a quotation?','Glass type, thickness, dimensions, approximate quantity, destination and preferred Incoterm are enough to start.'],['Can you quote container quantities?','Yes. Loading is evaluated according to dimensions, thickness, packing method and weight limits.'],['Can glass be supplied for export markets?','Yes. Export and delivery options are evaluated against the product, supply channel and destination.'],['Do you work with only one manufacturer?','No. The objective is not to promote a single brand, but to build a supply route aligned with the buyer requirement.']],cta:'Send Glass RFQ'};
---
<div class="glass-hub"><section class="glass-hero section"><div class="container center"><span class="eyebrow">{c.eyebrow}</span><h1>{c.title}</h1><p class="lead">{c.lead}</p><a class="button primary" href="#glass-rfq">{c.cta}</a></div></section>
<section class="section products"><div class="container"><div class="head"><h2>{c.productsTitle}</h2></div><div class="grid">{c.products.map(([n,t])=><article><h3>{n}</h3><p>{t}</p></article>)}</div></div></section>
<section class="section pathways"><div class="container"><div class="head"><h2>{tr?'Ürün bazlı cam tedarik sayfaları':'Product-specific glass sourcing'}</h2></div><div class="path-grid">{glassSeoPages.map((page)=><a href={`${tr?'/glass':'/en/glass'}/${page.slug}/`}><strong>{page[lang].title}</strong><span>↗</span></a>)}</div></div></section>
<section class="section commercial"><div class="container two"><div><h2>{c.processTitle}</h2><ul>{c.process.map(x=><li>{x}</li>)}</ul></div><div><h2>{c.buyersTitle}</h2><ul>{c.buyers.map(x=><li>{x}</li>)}</ul></div></div></section>
<section class="section faq"><div class="container"><div class="head"><h2>{c.faqTitle}</h2></div><div class="faqs">{c.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
<section class="section form" id="glass-rfq"><div class="container"><CommercialRequestForm lang={lang}/></div></section></div>
<style>
.glass-hub{background:#f2efe7;color:#171914}.glass-hero{background:#10120f;color:#f3f4ef;padding:clamp(4rem,7vw,7rem) 0}.center,.head{text-align:center}.center h1,.head h2{margin:.65rem auto 0;max-width:1180px;text-align:center;text-wrap:balance}.center h1{color:#f3f4ef!important;font-size:clamp(2.4rem,4.2vw,4.8rem);line-height:1.02}.center .lead{max-width:850px;margin:1.25rem auto 1.5rem;color:#d8ddd7!important;line-height:1.7}.products{padding:clamp(3.5rem,6vw,6rem) 0}.head{margin-bottom:2rem}.head h2,.two h2{font-size:clamp(2rem,3vw,3.5rem);line-height:1.05}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.grid article{min-height:210px;padding:1.5rem;background:#131813;color:#f3f4ef;border:1px solid rgba(255,255,255,.09)}.grid h3{margin:0;color:#f3f4ef!important;font-size:1.15rem}.grid p{margin:.85rem 0 0;color:#d8ddd7!important;line-height:1.65}.pathways{background:#f2efe7}.path-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.path-grid a{display:flex;justify-content:space-between;gap:1rem;padding:1.2rem 1.3rem;border:1px solid rgba(0,0,0,.14);color:inherit;text-decoration:none;background:#f7f4ed}.path-grid strong{font-size:1rem}.commercial{background:#e7e2d7}.two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem)}.two ul{margin:1.4rem 0 0;padding:0;list-style:none}.two li{padding:.85rem 0;border-bottom:1px solid rgba(0,0,0,.13)}.faq{padding:clamp(3.5rem,6vw,6rem) 0}.faqs{max-width:920px;margin:auto}.faqs details{border-top:1px solid rgba(0,0,0,.16);padding:1.1rem 0}.faqs details:last-child{border-bottom:1px solid rgba(0,0,0,.16)}.faqs summary{cursor:pointer;font-weight:750}.faqs p{line-height:1.7}.form{background:#10120f}@media(max-width:980px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.path-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:720px){.grid,.two,.path-grid{grid-template-columns:1fr}.grid article{min-height:0}.center h1{font-size:clamp(2rem,9vw,3rem)}}
</style>