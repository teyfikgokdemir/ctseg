---
import CommercialRequestForm from './CommercialRequestForm.astro';
import { glassSeoPages } from '../data/glass-seo';
import { glassHubLocaleCopy, type GlassHubLocale } from '../data/glass-hub-locales';
import { localizedGlassProductCopy, localizedGlassSlugs, type LocalizedGlassLocale } from '../data/glass-product-locales';
import { glassMarketPages, glassMarketSlugs } from '../data/glass-market-seo';
const glassPathGroups=[
  {key:'core',slugs:['float-glass','tempered-glass','heat-strengthened-glass','laminated-glass','low-e-coated-glass','solar-control-glass','insulated-glass-igu','low-iron-extra-clear-glass']},
  {key:'processing',slugs:['mirror-decorative-glass','patterned-frosted-satin-glass','processed-glass-cut-to-size','glass-processing-services','curved-glass','ceramic-printed-glass']},
  {key:'safety',slugs:['heat-soak-tested-glass','fire-rated-glass']},
  {key:'applications',slugs:['shower-enclosure-glass','balustrade-railing-glass','office-partition-interior-glass','household-appliance-glass','furniture-retail-glass','architectural-project-glass']}
] as const;
const glassGroupLabels:Record<string,Record<string,string>>={
  tr:{core:'Ana ürünler ve performans camları',processing:'İşlenmiş ve dekoratif cam',safety:'Güvenlik ve sertifikalı proje camı',applications:'Uygulama ve OEM camları'},
  en:{core:'Core & performance glass',processing:'Processed & decorative glass',safety:'Safety & certified project glass',applications:'Applications & OEM glass'},
  de:{core:'Basis- & Performanceglas',processing:'Bearbeitetes & dekoratives Glas',safety:'Sicherheits- & zertifiziertes Projektglas',applications:'Anwendungs- & OEM-Glas'},
  it:{core:'Vetro base e prestazionale',processing:'Vetro lavorato e decorativo',safety:'Vetro di sicurezza e certificato',applications:'Vetro per applicazioni e OEM'},
  ru:{core:'Базовое и функциональное стекло',processing:'Обработанное и декоративное стекло',safety:'Безопасное и сертифицированное стекло',applications:'Стекло для применений и OEM'},
  fa:{core:'شیشه پایه و عملکردی',processing:'شیشه فرآوری‌شده و دکوراتیو',safety:'شیشه ایمنی و پروژه‌ای دارای گواهی',applications:'شیشه کاربردی و OEM'},
  zh:{core:'基础与性能玻璃',processing:'深加工与装饰玻璃',safety:'安全与认证工程玻璃',applications:'应用与OEM玻璃'},
  vi:{core:'Kính cơ bản và hiệu suất',processing:'Kính gia công và trang trí',safety:'Kính an toàn và dự án có chứng nhận',applications:'Kính ứng dụng và OEM'},
  uk:{core:'Базове та функціональне скло',processing:'Оброблене та декоративне скло',safety:'Безпечне та сертифіковане проєктне скло',applications:'Скло для застосувань та OEM'},
  ro:{core:'Sticlă de bază și performanță',processing:'Sticlă procesată și decorativă',safety:'Sticlă de siguranță și certificată',applications:'Sticlă pentru aplicații și OEM'},
  bg:{core:'Основно и високоефективно стъкло',processing:'Обработено и декоративно стъкло',safety:'Безопасно и сертифицирано проектно стъкло',applications:'Стъкло за приложения и OEM'},
  he:{core:'זכוכית בסיס וביצועים',processing:'זכוכית מעובדת ודקורטיבית',safety:'זכוכית בטיחות ופרויקטים מאושרת',applications:'זכוכית ליישומים ו-OEM'}
};
const productCardSlugs=['float-glass','float-glass','low-e-coated-glass','solar-control-glass','laminated-glass','tempered-glass','mirror-decorative-glass','architectural-project-glass'] as const;
const productCardImages=[
  '/images/glass/glass-applications-turkey.webp',
  '/images/glass/commercial-entrance-glass-turkey.webp',
  '/images/glass/low-e-coated-glass-production-turkey.webp',
  '/images/glass/low-e-solar-control-glass-turkey.webp',
  '/images/glass/laminated-glass-canopy-turkey.webp',
  '/images/glass/tempered-glass-production-turkey.webp',
  '/images/glass/interior-glass-partition-turkey.webp',
  '/images/glass/architectural-glass-facade-turkey.webp'
] as const;
const productCardHref=(slug:string)=>lang==='tr'? `/glass/${slug}/` : lang==='en'? `/en/glass/${slug}/` : `/${lang}/glass/${slug}/`;
const { lang='tr' }=Astro.props as {lang?:string}; const tr=lang==='tr'; const en=lang==='en';
const c=tr?{
eyebrow:'Cam Tedariki · Türkiye & Global',title:'Türkiye’de cam tedarikçisi, üretici ve işleme kapasitesi bulma.',lead:'CTSEG; float, temperli, lamine, Low-E, IGU, extra clear ve işlenmiş cam ihtiyaçlarında uygun üretici, tedarikçi ve cam işleme kapasitesini eşleştirir; RFQ, paketleme, ihracat ve teslim koordinasyonunu tek ticari akışta yönetir.',
productsTitle:'Cam ürün grupları',products:[['Float / Düz Cam','Şeffaf float cam, ultra clear ve farklı kalınlık/ebat seçenekleri.'],['Renkli Float Cam','Füme, bronz, yeşil ve mavi tonlarda proje ihtiyaçları.'],['Low-E & Kaplamalı Cam','Enerji verimliliği ve performans odaklı kaplamalı cam çözümleri.'],['Solar Control Cam','Cephe, pencere ve ticari yapı uygulamaları için güneş kontrol camı.'],['Lamine Cam','Güvenlik, akustik performans ve proje şartnamelerine uygun tedarik.'],['Temperlenebilir Cam','Isıl işlem gerektiren projeler için uygun baz cam seçenekleri.'],['Ayna & Dekoratif Cam','Ayna, satina, boyalı ve iç mimari cam grupları.'],['Proje Bazlı Cam','Cephe, IGU, doğrama ve endüstriyel projeler için spesifikasyona göre tedarik.']],
processTitle:'RFQ’dan teslimata kadar ticari akış',process:['Ürün tipi, kalınlık, ebat ve teknik gereksinimin netleştirilmesi','Miktar, paketleme ve yükleme planının belirlenmesi','Uygun üretim ve tedarik kanalının eşleştirilmesi','EXW, FOB, CIF veya proje şartına göre teklif koordinasyonu','İhracat, dokümantasyon ve teslim sürecinin takibi'],
buyersTitle:'Kimler için?',buyers:['Cam ithalatçıları ve distribütörleri','IGU / ısıcam üreticileri','Cam işleme ve temper tesisleri','Cephe ve alüminyum sistem firmaları','Pencere ve doğrama üreticileri','Müteahhitler ve proje satın alma ekipleri'],
faqTitle:'Cam tedariğinde sık sorulanlar',faq:[['CTSEG cam üreticisi midir?','Hayır. CTSEG; alıcının teknik ve ticari ihtiyacına göre uygun üretici, processor, distribütör veya ihracat kanalını araştıran ve RFQ/teslim sürecini koordine eden ticari yapıdır.'],['Teklif için hangi bilgiler gerekli?','Ürün tipi, kalınlık, ebat, yaklaşık miktar, teslim noktası ve tercih edilen Incoterm başlangıç için yeterlidir.'],['Konteyner bazlı teklif alınabilir mi?','Evet. Ebat, kalınlık, paketleme ve ağırlık sınırlarına göre uygun yükleme modeli oluşturulur.'],['Türkiye dışına ihracat yapılabilir mi?','Evet. Uygun ürün ve tedarik kanalına göre ihracat ve teslim seçenekleri RFQ aşamasında değerlendirilir.'],['Türkiye’de cam üreticisi veya işleme tesisi nasıl seçiliyor?','Ürün tipi, ebat, kalınlık, işleme kabiliyeti, kapasite, belge ihtiyacı, paketleme ve teslim koşulları birlikte değerlendirilir.'],['Tek bir üreticiyle mi çalışılıyor?','Hayır. Amaç marka reklamı değil, alıcının teknik ve ticari gereksinimine uygun üretici, işlemeci veya tedarik kanalını oluşturmaktır.']],cta:'Cam RFQ Gönder'
}:en?{eyebrow:'Glass Sourcing · Türkiye & Global',title:'Find glass suppliers, manufacturers and processors in Türkiye.',lead:'CTSEG matches international buyers with suitable glass suppliers, manufacturers and processing capacity in Türkiye, then coordinates technical RFQs, packing, export and delivery for float, tempered, laminated, Low-E, IGU, extra-clear and processed glass.',
productsTitle:'Glass product groups',products:[['Clear Float Glass','Clear float and ultra-clear options across project-driven thickness and sheet sizes.'],['Tinted Float Glass','Smoke, bronze, green and blue tinted float glass.'],['Low-E & Coated Glass','Coated glass for thermal performance and energy efficiency.'],['Solar Control Glass','Solar-control solutions for façades, windows and commercial buildings.'],['Laminated Glass','Laminated glass for safety, acoustic and project specifications.'],['Temperable Glass','Suitable base-glass options for applications requiring heat treatment.'],['Mirror & Decorative Glass','Mirror, satin, lacquered and decorative glass groups.'],['Project Glass Supply','Specification-led sourcing for façades, IGU, fenestration and industrial projects.']],
processTitle:'Commercial flow from RFQ to delivery',process:['Define glass type, thickness, dimensions and technical requirements','Confirm quantity, packing and loading requirements','Match the requirement with an appropriate supply channel','Coordinate EXW, FOB, CIF or project-specific terms','Follow export documentation and delivery coordination'],
buyersTitle:'Who we work with',buyers:['Glass importers and distributors','IGU manufacturers','Glass processors and tempering plants','Façade and aluminium system companies','Window and fenestration manufacturers','Contractors and project procurement teams'],
faqTitle:'Glass sourcing FAQ',faq:[['Is CTSEG a glass manufacturer?','No. CTSEG researches and coordinates suitable manufacturers, processors, distributors and export-ready supply channels according to the buyer requirement.'],['What information is needed for a quotation?','Glass type, thickness, dimensions, approximate quantity, destination and preferred Incoterm are enough to start.'],['Can you quote container quantities?','Yes. Loading is evaluated according to dimensions, thickness, packing method and weight limits.'],['Can glass be supplied for export markets?','Yes. Export and delivery options are evaluated against the product, supply channel and destination.'],['How do you select a glass manufacturer or processor in Türkiye?','Product type, dimensions, thickness, processing capability, capacity, documentation, packing and delivery requirements are evaluated together.'],['Do you work with only one manufacturer?','No. The objective is not to promote a single brand, but to build a supplier, manufacturer or processor route aligned with the buyer requirement.']],cta:'Send Glass RFQ'}:glassHubLocaleCopy[lang as GlassHubLocale] || glassHubLocaleCopy.de;
---
<div class="glass-hub"><section class="glass-hero section"><div class="container center"><span class="eyebrow">{c.eyebrow}</span><h1>{c.title}</h1><p class="lead">{c.lead}</p><a class="button primary" href="#glass-rfq">{c.cta}</a></div></section>
<section class="section products"><div class="container"><div class="head"><h2>{c.productsTitle}</h2></div><div class="grid">{c.products.map(([n,t],index)=><a class="product-card" href={productCardHref(productCardSlugs[index])}>
  <div class="product-card__media"><img src={productCardImages[index]} alt={n} width="1600" height="900" loading="lazy" decoding="async"/></div>
  <div class="product-card__body"><h3>{n}</h3><p>{t}</p><span class="product-card__arrow">↗</span></div>
</a>)}</div></div></section>
<section class="section pathways"><div class="container"><div class="head"><h2>{tr?'Cam tedarik ve uygulama kümeleri':en?'Glass sourcing & application clusters':c.productsTitle}</h2></div>
{glassPathGroups.map((group)=><div class="path-group">
  <h3>{glassGroupLabels[lang]?.[group.key] || glassGroupLabels.en[group.key]}</h3>
  <div class="path-grid">
    {group.slugs.map((slug)=>{
      if(tr||en){
        const page=glassSeoPages.find((item)=>item.slug===slug);
        return page?<a href={`${tr?'/glass':'/en/glass'}/${slug}/`}><strong>{page[lang as 'tr'|'en'].title}</strong><span>↗</span></a>:null;
      }
      const product=localizedGlassProductCopy[lang as LocalizedGlassLocale]?.products[slug];
      return product?<a href={`/${lang}/glass/${slug}/`}><strong>{product.name}</strong><span>↗</span></a>:null;
    })}
  </div>
</div>)}
</div></section>
{(tr||en) && <section class="section market-pathways"><div class="container"><div class="head"><h2>{tr?'Pazar bazlı cam tedarik yolları':'Market-specific glass sourcing'}</h2></div><div class="path-grid">
{glassMarketSlugs.map((slug)=><a href={`${tr?'/glass/markets':'/en/glass/markets'}/${slug}/`}><strong>{glassMarketPages[slug][lang as 'tr'|'en'].title}</strong><span>↗</span></a>)}
</div></div></section>}
<section class="section commercial"><div class="container two"><div><h2>{c.processTitle}</h2><ul>{c.process.map(x=><li>{x}</li>)}</ul></div><div><h2>{c.buyersTitle}</h2><ul>{c.buyers.map(x=><li>{x}</li>)}</ul></div></div></section>
<section class="section faq"><div class="container"><div class="head"><h2>{c.faqTitle}</h2></div><div class="faqs">{c.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
<section class="section form" id="glass-rfq"><div class="container"><CommercialRequestForm lang={lang}/></div></section></div>
<style>
.glass-hub{background:#f2efe7;color:#171914}.glass-hero{background:#10120f;color:#f3f4ef;padding:clamp(4rem,7vw,7rem) 0}.center,.head{text-align:center}.center h1,.head h2{margin:.65rem auto 0;max-width:1180px;text-align:center;text-wrap:balance}.center h1{color:#f3f4ef!important;font-size:clamp(2.4rem,4.2vw,4.8rem);line-height:1.02}.center .lead{max-width:850px;margin:1.25rem auto 1.5rem;color:#d8ddd7!important;line-height:1.7}.products{padding:clamp(3.5rem,6vw,6rem) 0}.head{margin-bottom:2rem}.head h2,.two h2{font-size:clamp(2rem,3vw,3.5rem);line-height:1.05}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.product-card{display:block;background:#131813;color:#f3f4ef;border:1px solid rgba(255,255,255,.09);text-decoration:none;overflow:hidden;transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease}.product-card:hover{transform:translateY(-3px);border-color:rgba(199,255,56,.32);box-shadow:0 18px 38px rgba(0,0,0,.13)}.product-card__media{aspect-ratio:16/9;overflow:hidden;background:#0e120f}.product-card__media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s ease}.product-card:hover .product-card__media img{transform:scale(1.035)}.product-card__body{position:relative;min-height:170px;padding:1.35rem 1.4rem 1.5rem}.grid h3{margin:0;color:#f3f4ef!important;font-size:1.15rem}.grid p{margin:.8rem 2rem 0 0;color:#d8ddd7!important;line-height:1.62}.product-card__arrow{position:absolute;right:1.15rem;bottom:1.15rem;width:30px;height:30px;border:1px solid rgba(199,255,56,.45);border-radius:50%;display:grid;place-items:center;color:#c7ff38;font-size:.82rem}.pathways{background:#f2efe7}.path-group{margin-top:2rem}.path-group:first-of-type{margin-top:0}.path-group h3{margin:0 0:.85rem;font-size:clamp(1.05rem,1.5vw,1.35rem);letter-spacing:-.01em}.path-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.path-grid a{display:flex;justify-content:space-between;gap:1rem;padding:1.2rem 1.3rem;border:1px solid rgba(0,0,0,.14);color:inherit;text-decoration:none;background:#f7f4ed}.path-grid strong{font-size:1rem}.commercial{background:#e7e2d7}.two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem)}.two ul{margin:1.4rem 0 0;padding:0;list-style:none}.two li{padding:.85rem 0;border-bottom:1px solid rgba(0,0,0,.13)}.faq{padding:clamp(3.5rem,6vw,6rem) 0}.faqs{max-width:920px;margin:auto}.faqs details{border-top:1px solid rgba(0,0,0,.16);padding:1.1rem 0}.faqs details:last-child{border-bottom:1px solid rgba(0,0,0,.16)}.faqs summary{cursor:pointer;font-weight:750}.faqs p{line-height:1.7}.form{background:#10120f}@media(max-width:980px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.path-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:720px){.grid,.two,.path-grid{grid-template-columns:1fr}.product-card__body{min-height:0;padding-bottom:3.3rem}.center h1{font-size:clamp(2rem,9vw,3rem)}}
</style>