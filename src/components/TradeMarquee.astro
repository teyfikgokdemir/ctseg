---
const { lang='en' } = Astro.props as { lang?: string };
const copy:Record<string,string[]> = {
  tr:['STRATEJİK TEDARİK','PAZARA GİRİŞ','TEDARİKÇİ KEŞFİ'],
  en:['STRATEGIC SOURCING','MARKET ENTRY','SUPPLIER DISCOVERY'],
  de:['STRATEGISCHE BESCHAFFUNG','MARKTEINTRITT','LIEFERANTENSUCHE'],
  it:['SOURCING STRATEGICO','INGRESSO NEL MERCATO','RICERCA FORNITORI'],
  fa:['تأمین راهبردی','ورود به بازار','شناسایی تأمین‌کننده'],
  ru:['СТРАТЕГИЧЕСКИЙ СОРСИНГ','ВЫХОД НА РЫНОК','ПОИСК ПОСТАВЩИКОВ'],
  zh:['战略采购','市场进入','供应商开发'],
  vi:['THU MUA CHIẾN LƯỢC','THÂM NHẬP THỊ TRƯỜNG','TÌM KIẾM NHÀ CUNG CẤP'],
  uk:['СТРАТЕГІЧНЕ ПОСТАЧАННЯ','ВИХІД НА РИНОК','ПОШУК ПОСТАЧАЛЬНИКІВ'],
  ro:['SOURCING STRATEGIC','INTRARE PE PIAȚĂ','IDENTIFICARE FURNIZORI'],
  bg:['СТРАТЕГИЧЕСКО СНАБДЯВАНЕ','НАВЛИЗАНЕ НА ПАЗАРА','ОТКРИВАНЕ НА ДОСТАВЧИЦИ'],
  he:['איתור ורכש אסטרטגי','כניסה לשוק','איתור ספקים'],
  sr:['STRATEŠKI SOURCING','ULAZAK NA TRŽIŠTE','PRONALAŽENJE DOBAVLJAČA']
};
const items=copy[lang] || copy.en;
const loopItems = Array.from({length:4},()=>items).flat();
---
<div class:list={['trade-marquee',{'trade-marquee--rtl':lang==='he'||lang==='fa'}]} data-trade-marquee aria-label={items.join(' · ')}>
  <div class="trade-marquee__track">
    <div class="trade-marquee__group" data-marquee-group>
      {loopItems.map((item)=><span><bdi dir={lang==='he'||lang==='fa'?'rtl':'auto'}>{item}</bdi></span>)}
    </div>
    <div class="trade-marquee__group" data-marquee-group aria-hidden="true">
      {loopItems.map((item)=><span><bdi dir={lang==='he'||lang==='fa'?'rtl':'auto'}>{item}</bdi></span>)}
    </div>
  </div>
</div>
<style is:global>
.trade-marquee{position:relative;width:100%;overflow:hidden;background:#c4f000;color:#080a08;border-block:1px solid #9ebf00;direction:ltr}
.trade-marquee__track{display:flex;width:max-content;will-change:transform;animation:ctseg-marquee 42s linear infinite}
.trade-marquee--rtl .trade-marquee__track{animation-name:ctseg-marquee-rtl}
.trade-marquee__group{display:flex;align-items:center;flex:0 0 auto;white-space:nowrap;min-width:max-content}
.trade-marquee__group span{display:inline-flex;align-items:center;min-height:58px;padding-inline:26px;font-size:clamp(20px,2.35vw,38px);line-height:1;font-weight:900;letter-spacing:-.025em}
.trade-marquee__group span::before{content:"•";margin-inline-end:22px;font-size:.65em}
@keyframes ctseg-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes ctseg-marquee-rtl{from{transform:translateX(-50%)}to{transform:translateX(0)}}
@media(max-width:700px){.trade-marquee__group span{min-height:48px;padding-inline:18px;font-size:18px}.trade-marquee__group span::before{margin-inline-end:14px}}
@media(prefers-reduced-motion:reduce){.trade-marquee__track{animation:none;transform:none}}
</style>