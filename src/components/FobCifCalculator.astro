---
import { localizedPath, type Locale } from '../data/site';

interface Props {
  lang: Locale | string;
}

const { lang } = Astro.props;
const isTr = lang === 'tr';

const copy = isTr
  ? {
      kicker: 'B2B DIŞ TİCARET ARACI · CANLI ECB DÖVİZ',
      title: 'FOB / CIF Konteyner & Birim Maliyet Hesaplayıcı',
      lead: 'Liman rotası, 20ft/40ft konteyner yükü, fabrika çıkış fiyatı, deniz navlunu, sigorta ve gümrük vergisini birleştirerek kilogram ve ton başına gerçek teslim (landed) maliyeti canlı ECB döviz kurlarıyla hesaplayın.',
      corridorLabel: 'Referans Ticaret Koridoru (Liman Rotası)',
      containerLabel: 'Konteyner Tipi',
      currencyLabel: 'Sonuç Para Birimi',
      weightLabel: 'Net Yük Miktarı (kg)',
      unitPriceLabel: 'FOB / Fabrika Birim Fiyatı (USD / kg)',
      portHandlingLabel: 'İç Nakliye & Liman Masrafı (USD)',
      freightLabel: 'Deniz Navlunu (USD / Konteyner)',
      insuranceLabel: 'Nakliyat Sigortası (%)',
      dutyLabel: 'Varış Ülkesi Gümrük Vergisi (%)',
      fobTotal: 'Toplam FOB Bedeli',
      cifTotal: 'Toplam CIF Bedeli',
      landedTotal: 'Vergi Dahil Toplam Maliyet',
      perKg: 'Birim Teslim Maliyeti (/ kg)',
      perMt: 'Ton Başına Maliyet (/ MT)',
      logisticsShare: 'Navlun + Sigorta Payı',
      fxLoading: 'Canlı ECB döviz kuru yükleniyor...',
      fxLivePrefix: 'Canlı ECB Kuru',
      fxFallback: 'Referans kur (çevrimdışı yedek)',
      ctaText: 'Doğrulanmış FOB / CIF Teklifi Alın',
      disclaimer: 'Döviz kurları Avrupa Merkez Bankası (ECB / Frankfurter) üzerinden canlı alınır. Navlun ve liman kalemleri referans koridor değerleridir; kesin teklif için rota bazlı RFQ talep edin.',
      corridors: [
        { id: 'mersin-rtm', label: 'Mersin (TR) → Rotterdam (NL) · AB EUR.1 (%0 Vergi)', port: 650, freight: 2400, duty: 0 },
        { id: 'izmir-ham', label: 'İzmir (TR) → Hamburg (DE) · AB EUR.1 (%0 Vergi)', port: 600, freight: 2350, duty: 0 },
        { id: 'mersin-jea', label: 'Mersin (TR) → Jebel Ali (AE) · Körfez (%5 Vergi)', port: 650, freight: 1850, duty: 5 },
        { id: 'bnd-mersin', label: 'Bandar Abbas (IR) → Mersin (TR) · Transit Koridor', port: 700, freight: 1900, duty: 0 },
        { id: 'mersin-nyc', label: 'Mersin (TR) → Newark / NY (US) · Transatlantik', port: 700, freight: 3400, duty: 3.5 },
        { id: 'custom', label: 'Özel Rota (Manuel Girin)', port: 650, freight: 2400, duty: 0 },
      ],
      presets: [
        { id: '20ft', label: '20ft FCL (19.000 kg — Kuru Meyve / Kuruyemiş)', weight: 19000 },
        { id: '40ft', label: '40ft FCL (25.000 kg — Standart Konteyner)', weight: 25000 },
        { id: '40hc', label: '40ft High Cube (26.000 kg — Hacimli Yük)', weight: 26000 },
        { id: 'custom', label: 'Özel Miktar (Manuel Girin)', weight: 10000 },
      ],
    }
  : {
      kicker: 'B2B TRADE UTILITY · LIVE ECB FX',
      title: 'FOB / CIF Container & Landed Cost Calculator',
      lead: 'Select a trade corridor and combine unit FOB price, port handling, ocean freight, marine insurance, and destination import duty with live ECB exchange rates to calculate real landed cost per kg and metric ton.',
      corridorLabel: 'Reference Trade Corridor (Port-to-Port)',
      containerLabel: 'Container Type',
      currencyLabel: 'Display Currency',
      weightLabel: 'Net Cargo Weight (kg)',
      unitPriceLabel: 'FOB Unit Price (USD / kg)',
      portHandlingLabel: 'Inland & Port Handling (USD)',
      freightLabel: 'Ocean Freight (USD / Container)',
      insuranceLabel: 'Marine Insurance (%)',
      dutyLabel: 'Destination Import Duty (%)',
      fobTotal: 'Total FOB Value',
      cifTotal: 'Total CIF Value',
      landedTotal: 'Total Landed Cost (Incl. Duty)',
      perKg: 'Landed Cost per kg',
      perMt: 'Landed Cost per Metric Ton',
      logisticsShare: 'Freight & Insurance Share',
      fxLoading: 'Loading live ECB exchange rates...',
      fxLivePrefix: 'Live ECB FX',
      fxFallback: 'Reference FX (offline fallback)',
      ctaText: 'Request Verified FOB / CIF Quote',
      disclaimer: 'Exchange rates are fetched live from the European Central Bank (Frankfurter API). Ocean freight and port figures are corridor benchmarks; request a formal RFQ for firm vessel quotes.',
      corridors: [
        { id: 'mersin-rtm', label: 'Mersin (TR) → Rotterdam (NL) · EU EUR.1 (0% Duty)', port: 650, freight: 2400, duty: 0 },
        { id: 'izmir-ham', label: 'Izmir (TR) → Hamburg (DE) · EU EUR.1 (0% Duty)', port: 600, freight: 2350, duty: 0 },
        { id: 'mersin-jea', label: 'Mersin (TR) → Jebel Ali (AE) · GCC (5% Duty)', port: 650, freight: 1850, duty: 5 },
        { id: 'bnd-mersin', label: 'Bandar Abbas (IR) → Mersin (TR) · Transit Corridor', port: 700, freight: 1900, duty: 0 },
        { id: 'mersin-nyc', label: 'Mersin (TR) → Newark / NY (US) · Transatlantic', port: 700, freight: 3400, duty: 3.5 },
        { id: 'custom', label: 'Custom Corridor (Manual)', port: 650, freight: 2400, duty: 0 },
      ],
      presets: [
        { id: '20ft', label: '20ft FCL (19,000 kg — Dried Fruit / Nuts)', weight: 19000 },
        { id: '40ft', label: '40ft FCL (25,000 kg — Standard Container)', weight: 25000 },
        { id: '40hc', label: '40ft High Cube (26,000 kg — High Volume)', weight: 26000 },
        { id: 'custom', label: 'Custom Net Weight (Manual)', weight: 10000 },
      ],
    };

const contactHref = localizedPath(lang, 'contact');
---

<section class="calc-hero">
  <div class="container">
    <span class="calc-kicker">{copy.kicker}</span>
    <h1>{copy.title}</h1>
    <p class="calc-lead">{copy.lead}</p>
    <div class="calc-fx-pill" id="fx-status" data-live={copy.fxLivePrefix} data-fallback={copy.fxFallback}>
      <span class="fx-dot"></span>
      <span id="fx-text">{copy.fxLoading}</span>
    </div>
  </div>
</section>

<section class="calc-section">
  <div class="container calc-grid">
    <div class="calc-card calc-inputs">
      <div class="calc-field">
        <label for="calc-corridor">{copy.corridorLabel}</label>
        <select id="calc-corridor">
          {copy.corridors.map((c) => (
            <option value={c.id} data-port={c.port} data-freight={c.freight} data-duty={c.duty}>{c.label}</option>
          ))}
        </select>
      </div>

      <div class="calc-row">
        <div class="calc-field">
          <label for="calc-preset">{copy.containerLabel}</label>
          <select id="calc-preset">
            {copy.presets.map((p) => (
              <option value={p.id} data-weight={p.weight}>{p.label}</option>
            ))}
          </select>
        </div>
        <div class="calc-field">
          <label for="calc-currency">{copy.currencyLabel}</label>
          <select id="calc-currency">
            <option value="USD" selected>USD ($)</option>
            <option value="EUR">EUR (€)</option>
            <option value="TRY">TRY (₺)</option>
            <option value="GBP">GBP (£)</option>
          </select>
        </div>
      </div>

      <div class="calc-row">
        <div class="calc-field">
          <label for="calc-weight">{copy.weightLabel}</label>
          <input id="calc-weight" type="number" min="100" step="100" value="19000" />
        </div>
        <div class="calc-field">
          <label for="calc-price">{copy.unitPriceLabel}</label>
          <input id="calc-price" type="number" min="0.1" step="0.05" value="4.20" />
        </div>
      </div>

      <div class="calc-row">
        <div class="calc-field">
          <label for="calc-port">{copy.portHandlingLabel}</label>
          <input id="calc-port" type="number" min="0" step="50" value="650" />
        </div>
        <div class="calc-field">
          <label for="calc-freight">{copy.freightLabel}</label>
          <input id="calc-freight" type="number" min="0" step="50" value="2400" />
        </div>
      </div>

      <div class="calc-row">
        <div class="calc-field">
          <label for="calc-ins">{copy.insuranceLabel}</label>
          <input id="calc-ins" type="number" min="0" max="10" step="0.05" value="0.35" />
        </div>
        <div class="calc-field">
          <label for="calc-duty">{copy.dutyLabel}</label>
          <input id="calc-duty" type="number" min="0" max="100" step="0.5" value="0" />
        </div>
      </div>
    </div>

    <div class="calc-card calc-results" aria-live="polite">
      <div class="calc-metric-primary">
        <span>{copy.perKg}</span>
        <strong id="out-per-kg">$4.36</strong>
        <small id="out-per-mt">{copy.perMt}: $4,363</small>
      </div>

      <dl class="calc-breakdown">
        <div>
          <dt>{copy.fobTotal}</dt>
          <dd id="out-fob">$80,450</dd>
        </div>
        <div>
          <dt>{copy.cifTotal}</dt>
          <dd id="out-cif">$83,140</dd>
        </div>
        <div>
          <dt>{copy.landedTotal}</dt>
          <dd id="out-landed">$83,140</dd>
        </div>
        <div>
          <dt>{copy.logisticsShare}</dt>
          <dd id="out-share">3.2%</dd>
        </div>
      </dl>

      <a class="calc-cta" href={contactHref}>{copy.ctaText} &rarr;</a>
      <p class="calc-disclaimer">{copy.disclaimer}</p>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const corridor = document.getElementById('calc-corridor');
    const preset = document.getElementById('calc-preset');
    const currency = document.getElementById('calc-currency');
    const weight = document.getElementById('calc-weight');
    const price = document.getElementById('calc-price');
    const port = document.getElementById('calc-port');
    const freight = document.getElementById('calc-freight');
    const ins = document.getElementById('calc-ins');
    const duty = document.getElementById('calc-duty');

    const outKg = document.getElementById('out-per-kg');
    const outMt = document.getElementById('out-per-mt');
    const outFob = document.getElementById('out-fob');
    const outCif = document.getElementById('out-cif');
    const outLanded = document.getElementById('out-landed');
    const outShare = document.getElementById('out-share');
    const fxStatus = document.getElementById('fx-status');
    const fxText = document.getElementById('fx-text');

    const rates = { USD: 1, EUR: 0.92, TRY: 34.5, GBP: 0.79 };
    const symbols = { USD: '$', EUR: '€', TRY: '₺', GBP: '£' };

    const fmt = (usdAmount, decimals = 0) => {
      const code = currency?.value || 'USD';
      const val = (Number(usdAmount) || 0) * (rates[code] || 1);
      return (symbols[code] || '$') + val.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
    };

    const compute = () => {
      const w = Math.max(1, Number(weight.value) || 0);
      const p = Math.max(0, Number(price.value) || 0);
      const ph = Math.max(0, Number(port.value) || 0);
      const fr = Math.max(0, Number(freight.value) || 0);
      const insPct = Math.max(0, Number(ins.value) || 0) / 100;
      const dutyPct = Math.max(0, Number(duty.value) || 0) / 100;

      const fob = w * p + ph;
      const insuranceCost = (fob + fr) * insPct;
      const cif = fob + fr + insuranceCost;
      const landed = cif * (1 + dutyPct);
      const perKg = landed / w;
      const perMt = perKg * 1000;
      const logisticsPct = landed > 0 ? ((fr + insuranceCost + ph) / landed) * 100 : 0;

      outKg.textContent = fmt(perKg, 2);
      outMt.textContent = outMt.textContent.split(':')[0] + ': ' + fmt(perMt, 0);
      outFob.textContent = fmt(fob, 0);
      outCif.textContent = fmt(cif, 0);
      outLanded.textContent = fmt(landed, 0);
      outShare.textContent = logisticsPct.toFixed(1) + '%';
    };

    corridor?.addEventListener('change', () => {
      const opt = corridor.options[corridor.selectedIndex];
      if (opt && opt.value !== 'custom') {
        port.value = opt.getAttribute('data-port') || port.value;
        freight.value = opt.getAttribute('data-freight') || freight.value;
        duty.value = opt.getAttribute('data-duty') || duty.value;
      }
      compute();
    });

    preset?.addEventListener('change', () => {
      const opt = preset.options[preset.selectedIndex];
      const w = opt?.getAttribute('data-weight');
      if (w && opt.value !== 'custom') {
        weight.value = w;
      }
      compute();
    });

    currency?.addEventListener('change', compute);
    [weight, price, port, freight, ins, duty].forEach((el) => el?.addEventListener('input', compute));
    compute();

    fetch('https://api.frankfurter.dev/v1/latest?base=USD&symbols=EUR,TRY,GBP')
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error('FX fetch failed'))))
      .then((data) => {
        if (data && data.rates) {
          if (data.rates.EUR) rates.EUR = data.rates.EUR;
          if (data.rates.TRY) rates.TRY = data.rates.TRY;
          if (data.rates.GBP) rates.GBP = data.rates.GBP;
          const label = fxStatus?.getAttribute('data-live') || 'Live ECB FX';
          if (fxText) {
            fxText.textContent = `${label} (${data.date || 'ECB'}): 1 USD = ${rates.EUR.toFixed(3)} EUR · ${rates.TRY.toFixed(2)} TRY · ${rates.GBP.toFixed(3)} GBP`;
          }
          compute();
        }
      })
      .catch(() => {
        const label = fxStatus?.getAttribute('data-fallback') || 'Reference FX';
        if (fxText) {
          fxText.textContent = `${label}: 1 USD = ${rates.EUR.toFixed(3)} EUR · ${rates.TRY.toFixed(2)} TRY · ${rates.GBP.toFixed(3)} GBP`;
        }
      });
  })();
</script>

<style>
  .calc-hero {
    padding: clamp(48px, 6vw, 84px) 0 28px;
  }
  .calc-kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    background: #111;
    color: #c4f000;
    margin-bottom: 16px;
  }
  .calc-hero h1 {
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 18ch;
    margin: 0 0 16px;
  }
  .calc-lead {
    max-width: 64ch;
    color: #4c4c49;
    line-height: 1.65;
    margin: 0 0 18px;
  }
  .calc-fx-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid #dedcd5;
    background: #f8f7f3;
    font-size: 13px;
    font-weight: 600;
    color: #222;
  }
  .fx-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 8px rgba(22, 163, 74, 0.6);
  }
  .calc-section {
    padding: 16px 0 clamp(60px, 7vw, 96px);
  }
  .calc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 24px;
    align-items: start;
  }
  .calc-card {
    border: 1px solid #dedcd5;
    border-radius: 22px;
    padding: clamp(24px, 3vw, 34px);
    background: linear-gradient(145deg, #fff 0%, #f8f7f3 100%);
    box-shadow: 0 18px 48px rgba(12, 12, 12, 0.055);
  }
  .calc-inputs {
    display: grid;
    gap: 18px;
  }
  .calc-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .calc-field {
    display: grid;
    gap: 8px;
  }
  .calc-field label {
    font-size: 13px;
    font-weight: 700;
    color: #1c1c1a;
  }
  .calc-field input,
  .calc-field select {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #d5d3cb;
    border-radius: 12px;
    font: inherit;
    font-size: 15px;
    background: #fff;
    color: #111;
  }
  .calc-results {
    background: #111;
    color: #fff;
    border-color: #242422;
  }
  .calc-metric-primary {
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    margin-bottom: 20px;
  }
  .calc-metric-primary span {
    display: block;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #a8a8a1;
    margin-bottom: 8px;
  }
  .calc-metric-primary strong {
    display: block;
    font-size: clamp(36px, 4vw, 48px);
    line-height: 1;
    color: #c4f000;
    margin-bottom: 8px;
  }
  .calc-metric-primary small {
    color: #d8d8d2;
    font-size: 14px;
  }
  .calc-breakdown {
    display: grid;
    gap: 12px;
    margin: 0 0 24px;
  }
  .calc-breakdown > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 15px;
  }
  .calc-breakdown dt {
    color: #b4b4ad;
  }
  .calc-breakdown dd {
    margin: 0;
    font-weight: 700;
    color: #fff;
  }
  .calc-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 14px 18px;
    border-radius: 999px;
    background: #c4f000;
    color: #0a0a0a;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .calc-cta:hover {
    transform: translateY(-1px);
  }
  .calc-disclaimer {
    margin: 14px 0 0;
    font-size: 12px;
    line-height: 1.5;
    color: #9e9e97;
  }
  @media (max-width: 860px) {
    .calc-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .calc-row {
      grid-template-columns: 1fr;
    }
  }
</style>
