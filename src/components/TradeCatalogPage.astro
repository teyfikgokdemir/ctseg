---
import BaseLayout from '../layouts/BaseLayout.astro';
import TradeSiteChrome from './TradeSiteChrome.astro';
const {lang='tr',title,description,canonical,eyebrow,h1,lead,products=[]}=Astro.props;
const labels={tr:{portfolio:'B2B ürün portföyü',heading:'Kuruyemiş, kuru meyve ve seçili yüksek değerli ürünler.',view:'Ürünü incele',missing:'Listede olmayan bir ürün mü arıyorsunuz?',missingCopy:'Ürün, teknik özellik, miktar ve teslim ülkesini paylaşın; uygun üretici ve tedarik modelini araştıralım.',cta:'Tedarik talebi oluştur'},en:{portfolio:'B2B product portfolio',heading:'Nuts, dried fruits and selected high-value products.',view:'View product',missing:'Looking for a product not listed?',missingCopy:'Share the product, specification, volume and destination so we can research a suitable supplier and sourcing model.',cta:'Create sourcing request'},de:{portfolio:'B2B-Produktportfolio',heading:'Nüsse, Trockenfrüchte und ausgewählte hochwertige Produkte.',view:'Produkt ansehen',missing:'Suchen Sie ein nicht aufgeführtes Produkt?',missingCopy:'Teilen Sie Produkt, Spezifikation, Menge und Zielland mit; wir prüfen geeignete Lieferanten und Beschaffungsmodelle.',cta:'Beschaffungsanfrage senden'},it:{portfolio:'Portafoglio prodotti B2B',heading:'Frutta secca, frutta essiccata e prodotti selezionati ad alto valore.',view:'Scopri il prodotto',missing:'Cerchi un prodotto non presente?',missingCopy:'Condividi prodotto, specifica, volume e paese di destinazione; individueremo il fornitore e il modello di approvvigionamento più adatti.',cta:'Invia richiesta di fornitura'},fr:{portfolio:'Portefeuille de produits B2B',heading:'Fruits à coque, fruits secs et produits sélectionnés à forte valeur ajoutée.',view:'Voir le produit',missing:'Vous recherchez un produit non listé ?',missingCopy:'Indiquez le produit, les spécifications, le volume et le pays de destination afin que nous recherchions le fournisseur et le modèle d’approvisionnement adaptés.',cta:'Envoyer une demande'}};
const l=labels[lang]??labels.en;
const schema={'@context':'https://schema.org','@type':'CollectionPage','@id':canonical+'#webpage',name:title,url:canonical,description,inLanguage:lang,isPartOf:{'@id':'https://ctseg.com.tr/#website'},hasPart:products.map(([name,,url])=>({'@type':'Product',name,url:new URL(url,'https://ctseg.com.tr').toString()}))};
---
<BaseLayout {lang} {title} {description} {canonical} schema={[schema]}>
<div class:list={['catalog-page',`catalog-${lang}`]}><TradeSiteChrome {lang} mode="header"/><main><section class="catalog-hero"><div class="catalog-flag"><span></span><span></span><span></span></div><div class="catalog-wrap"><p>{eyebrow}</p><h1>{h1}</h1><span>{lead}</span></div></section><section class="catalog-section"><div class="catalog-wrap"><div class="catalog-head"><p>{l.portfolio}</p><h2>{l.heading}</h2></div><div class="catalog-grid">{products.map(([name,copy,url],i)=><a href={url}><small>{String(i+1).padStart(2,'0')}</small><h3>{name}</h3><p>{copy}</p><strong>{l.view} ↗</strong></a>)}</div></div></section><section class="catalog-cta"><div class="catalog-wrap"><h2>{l.missing}</h2><p>{l.missingCopy}</p><a href="mailto:info@ctseg.com.tr">{l.cta}</a></div></section></main><TradeSiteChrome {lang} mode="footer"/></div>
<style>
.catalog-page{--accent:#e30a17;--accent2:#ff8b91;--flag1:#e30a17;--flag2:#fff;--flag3:#e30a17;background:#070b11;color:#f5f7fa;min-height:100vh}.catalog-it{--accent:#169b62;--accent2:#8fe0bc;--flag1:#169b62;--flag2:#fff;--flag3:#ce2b37}.catalog-de{--accent:#ffce00;--accent2:#f5d76d;--flag1:#111;--flag2:#d71920;--flag3:#ffce00}.catalog-en{--accent:#d7b56d;--accent2:#f3d99a;--flag1:#163c73;--flag2:#fff;--flag3:#b31942}.catalog-fr{--accent:#0055a4;--accent2:#8ec5f4;--flag1:#0055a4;--flag2:#fff;--flag3:#ef4135}.catalog-wrap{width:min(1160px,calc(100% - 40px));margin:auto}.catalog-hero{position:relative;padding:120px 0 100px;background:radial-gradient(circle at 80% 10%,color-mix(in srgb,var(--accent) 20%,transparent),transparent 30rem),linear-gradient(145deg,#070b11,#111a25)}.catalog-flag{position:absolute;inset:0 0 auto;height:4px;display:grid;grid-template-columns:repeat(3,1fr)}.catalog-flag span:nth-child(1){background:var(--flag1)}.catalog-flag span:nth-child(2){background:var(--flag2)}.catalog-flag span:nth-child(3){background:var(--flag3)}.catalog-hero p,.catalog-head p{color:var(--accent2);font-size:12px;font-weight:850;letter-spacing:.16em;text-transform:uppercase}.catalog-hero h1,.catalog-head h2,.catalog-cta h2{max-width:1000px;margin:16px 0 24px;font-size:clamp(46px,7vw,88px);line-height:.98;letter-spacing:-.055em}.catalog-hero span{display:block;max-width:800px;color:#b9c3cf;font-size:21px;line-height:1.65}.catalog-section{padding:96px 0}.catalog-head h2,.catalog-cta h2{font-size:clamp(38px,5vw,64px)}.catalog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.catalog-grid a{padding:30px;border:1px solid #2b3541;border-radius:24px;background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.015))}.catalog-grid small{color:var(--accent2)}.catalog-grid h3{font-size:25px}.catalog-grid p{color:#b7c1cd;line-height:1.7}.catalog-grid strong{display:block;margin-top:28px;color:var(--accent2)}.catalog-cta{padding:96px 0;text-align:center;border-top:1px solid #252e39;background:#0b121b}.catalog-cta h2,.catalog-cta p{margin-inline:auto}.catalog-cta p{max-width:700px;color:#b7c1cd;font-size:18px}.catalog-cta a{display:inline-flex;margin-top:22px;padding:14px 24px;border-radius:999px;background:var(--accent);color:#fff;font-weight:850}.catalog-de .catalog-cta a{color:#111}@media(max-width:900px){.catalog-grid{grid-template-columns:1fr 1fr}}@media(max-width:650px){.catalog-grid{grid-template-columns:1fr}.catalog-wrap{width:min(1160px,calc(100% - 24px))}.catalog-hero{padding:90px 0}.catalog-section,.catalog-cta{padding:72px 0}}
</style>
</BaseLayout>