---
import type { PoultryFeedPage as Page, PoultryFeedLocale } from '../data/poultry-feed';
import { poultryFeedCommon, poultryFeedFaqs } from '../data/poultry-feed';

const { lang, page } = Astro.props as { lang:PoultryFeedLocale; page:Page };
const common=poultryFeedCommon[lang];
const labels={tr:{faq:'Sık sorulan sorular',note:'CTSEG · BAĞIMSIZ B2B KOORDİNASYON'},en:{faq:'Frequently asked questions',note:'CTSEG · INDEPENDENT B2B COORDINATION'},ar:{faq:'الأسئلة الشائعة',note:'CTSEG · تنسيق B2B مستقل'}}[lang];
const faqs=poultryFeedFaqs(lang,page);
const programmePages=new Set(['chick-starter-0-14-days','chick-starter-0-30-days','broiler-grower-finisher-feed','commercial-layer-feed','breeder-feed']);
const image=programmePages.has((Astro.props as { id?:string }).id || '') ? '/images/poultry-feed-document-review.png' : '/images/poultry-feed-sourcing-warehouse.png';
const imageAlt={tr:'Kanatlı yemi tedarik ve belge değerlendirme süreci',en:'Poultry-feed sourcing and document-review process',ar:'عملية توريد أعلاف الدواجن ومراجعة الوثائق'}[lang];
---
<section class="hero poultry-hero" data-poultry-hero><img class="poultry-hero__image" src={image} width="1920" height="1080" alt={imageAlt} loading="eager" decoding="async"/><div class="poultry-hero__veil"></div><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p class="hero-lead">{page.lead}</p><div class="poultry-hero__tags" aria-label={labels.note}><span>RFQ</span><span>COA</span><span>{lang === 'tr' ? 'İhracat koordinasyonu' : lang === 'ar' ? 'تنسيق التصدير' : 'Export coordination'}</span></div><a class="button" href={common.contact} data-contact-intent="buyer_request">{page.cta}</a></div></div></section>
<section class="section"><div class="container content-grid"><div class="prose">
  <div class="content-block direct-answer poultry-intro"><p>{page.description}</p></div>
  <div class="content-block poultry-card"><h2>{page.scopeTitle}</h2><ul class="check-list">{page.scope.map((item)=><li>{item}</li>)}</ul></div>
  <div class="content-block poultry-card"><h2>{page.assessmentTitle}</h2><p>{page.assessment}</p><ul class="check-list">{common.checks.map((item)=><li>{item}</li>)}</ul></div>
  <div class="content-block origin-note poultry-market-note"><h2>{page.marketTitle}</h2><p>{page.market}</p></div>
  <div class="content-block faq poultry-faq"><h2>{labels.faq}</h2>{faqs.map((item,index)=><details open={index===0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
</div><aside class="side-panel poultry-side-panel"><figure class="poultry-side-panel__image"><img src="/images/poultry-feed-rfq-desk.png" width="1122" height="1536" loading="lazy" decoding="async" alt={imageAlt}/></figure><p class="eyebrow">{labels.note}</p><h2>{page.scopeTitle}</h2><p>{common.footer}</p><a class="button" href={common.contact} data-contact-intent="buyer_request">{page.cta}</a></aside></div></section>
<style is:global>
  .poultry-hero{position:relative;isolation:isolate;display:grid;align-items:center;min-height:clamp(580px,70vh,680px);padding:68px 0;overflow:hidden}
  .poultry-hero .hero-grid{width:min(1360px,calc(100% - 112px));margin-inline:auto}
  .poultry-hero .hero-copy{max-width:680px}
  html[data-locale] .poultry-hero .hero-copy h1{width:100%;max-width:680px!important;margin:0 0 20px!important;font-size:clamp(3.25rem,3.65vw,4.35rem)!important;line-height:.98!important;letter-spacing:-.052em!important;text-wrap:balance;word-break:normal!important;overflow-wrap:normal!important;hyphens:none!important}
  .poultry-hero .hero-lead{max-width:590px;margin:0 0 24px;font-size:clamp(1rem,1.05vw,1.14rem);line-height:1.58}
  .poultry-hero__tags{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 26px}.poultry-hero__tags span{padding:7px 10px;border:1px solid rgba(255,255,255,.28);border-radius:999px;background:rgba(10,12,10,.3);color:#f5f4ed;font-size:.7rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
  .poultry-hero__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:-2}.poultry-hero__veil{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(9,11,9,.96) 0%,rgba(9,11,9,.86) 32%,rgba(9,11,9,.42) 54%,rgba(9,11,9,.08) 100%)}html[dir="rtl"] .poultry-hero__veil{background:linear-gradient(270deg,rgba(9,11,9,.96) 0%,rgba(9,11,9,.86) 32%,rgba(9,11,9,.42) 54%,rgba(9,11,9,.08) 100%)}
  .poultry-side-panel{padding-top:0!important}.poultry-side-panel__image{position:relative;aspect-ratio:1.14;margin:0 0 24px;overflow:hidden;border:1px solid var(--line);border-radius:16px;background:#1a1a17}.poultry-side-panel__image::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(10,12,10,.24))}.poultry-side-panel__image img{display:block;width:100%;height:100%;object-fit:cover;object-position:52% 64%}
  .poultry-intro{margin-bottom:18px;padding:22px 24px!important;border:1px solid var(--line)!important;border-left:3px solid var(--accent)!important;border-radius:16px;background:color-mix(in srgb,var(--surface-soft) 65%,transparent)}.poultry-intro p{margin:0;font-size:1.08rem;line-height:1.6}.poultry-card{margin-bottom:18px;padding:30px!important;border:1px solid var(--line)!important;border-radius:18px;background:rgba(255,255,255,.32)}.poultry-card h2{font-size:clamp(1.9rem,2.7vw,3rem)!important}.poultry-market-note{margin:18px 0;padding:30px!important;border:1px solid var(--line)!important;border-left:3px solid var(--accent)!important;border-radius:18px;background:#151615}.poultry-market-note h2{color:#fff!important}.poultry-market-note p{color:#d8d6cf!important}.poultry-faq{margin-top:42px}.poultry-faq details{padding-inline:18px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.25)}.poultry-faq details+details{margin-top:10px}.poultry-faq summary{display:flex;align-items:center;justify-content:space-between;gap:16px;font-weight:750}.poultry-faq summary::-webkit-details-marker{display:none}.poultry-faq summary::after{content:'+';color:var(--accent);font-size:1.4rem}.poultry-faq details[open] summary::after{content:'−'}.poultry-faq details p{max-width:68ch}.poultry-faq h2{margin-bottom:26px}
  @media(max-width:1050px){.poultry-hero .hero-grid{width:min(100% - 48px,760px)}.poultry-hero .hero-copy{max-width:620px}html[data-locale] .poultry-hero .hero-copy h1{max-width:620px!important;font-size:clamp(2.6rem,5.2vw,3.65rem)!important}.poultry-side-panel__image{max-width:440px}}
  @media(max-width:700px){.poultry-hero{min-height:calc(100svh - var(--header-height,74px));padding:48px 0 38px}.poultry-hero .hero-grid{width:min(100% - 32px,620px)}html[data-locale] .poultry-hero .hero-copy h1{max-width:100%!important;font-size:clamp(2.1rem,8.4vw,2.8rem)!important}.poultry-hero__veil{background:linear-gradient(180deg,rgba(9,11,9,.46),rgba(9,11,9,.95) 70%)}.poultry-hero__image{object-position:68% center}.poultry-card,.poultry-market-note{padding:24px!important}.poultry-faq details{padding-inline:14px}}
</style>
