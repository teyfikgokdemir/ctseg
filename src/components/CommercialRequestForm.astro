---
import { localizedPath } from '../data/site';
import { company } from '../data/site';
import { contactCopy, emailHref, whatsappHref, type ContactLocale } from '../data/contact-experience';
import { contactQualification } from '../data/contact-qualification';

const { lang } = Astro.props as { lang:ContactLocale };
const copy = contactCopy[lang];
const qualification = contactQualification[lang];
const privacyHref = lang === 'fa' ? '/fa/privacy/' : localizedPath(lang,'legal','privacy');

const supportNeedCopy = {
  tr:{label:'Hangi konuda destek arıyorsunuz?',options:[
    ['supplier_sourcing','Türkiye’de üretici veya tedarikçi bulma'],
    ['rfq_comparison','RFQ hazırlama ve teklif karşılaştırma'],
    ['private_label','Özel marka / fason üretici araştırması'],
    ['market_entry','İhracat ve yeni pazar girişi'],
    ['document_assessment','Ürün, menşe veya batch belgesi değerlendirmesi'],
    ['external_trade_desk','Sürekli Dış Ticaret Masası'],
    ['other','Diğer']
  ]},
  en:{label:'What support do you need?',options:[
    ['supplier_sourcing','Find and verify a manufacturer or supplier in Türkiye'],
    ['rfq_comparison','RFQ preparation and bid comparison'],
    ['private_label','Private-label / contract manufacturer research'],
    ['market_entry','Export and new-market entry'],
    ['document_assessment','Product, origin or batch-document assessment'],
    ['external_trade_desk','Ongoing External Trade Desk'],
    ['other','Other']
  ]},
  de:{label:'Wobei benötigen Sie Unterstützung?',options:[
    ['supplier_sourcing','Hersteller oder Lieferanten in der Türkei finden'],
    ['rfq_comparison','RFQ-Erstellung und Angebotsvergleich'],
    ['private_label','Private-Label- / Lohnhersteller-Recherche'],
    ['market_entry','Export und Markteintritt'],
    ['document_assessment','Produkt-, Ursprungs- oder Chargendokumentprüfung'],
    ['external_trade_desk','Laufender externer Trade Desk'],
    ['other','Sonstiges']
  ]},
  it:{label:'Di quale supporto avete bisogno?',options:[
    ['supplier_sourcing','Ricerca e verifica di produttori o fornitori in Turchia'],
    ['rfq_comparison','Preparazione RFQ e confronto offerte'],
    ['private_label','Ricerca produttore private label / conto terzi'],
    ['market_entry','Export e ingresso in nuovi mercati'],
    ['document_assessment','Valutazione prodotto, origine o documenti di lotto'],
    ['external_trade_desk','Trade Desk esterno continuativo'],
    ['other','Altro']
  ]},
  ru:{label:'Какая поддержка вам нужна?',options:[
    ['supplier_sourcing','Поиск и проверка производителя или поставщика в Турции'],
    ['rfq_comparison','Подготовка RFQ и сравнение предложений'],
    ['private_label','Поиск контрактного / private-label производителя'],
    ['market_entry','Экспорт и выход на новый рынок'],
    ['document_assessment','Проверка товара, происхождения или документов партии'],
    ['external_trade_desk','Постоянный внешний Trade Desk'],
    ['other','Другое']
  ]},
  fa:{label:'به چه نوع پشتیبانی نیاز دارید؟',options:[
    ['supplier_sourcing','یافتن و اعتبارسنجی تولیدکننده یا تأمین‌کننده در ترکیه'],
    ['rfq_comparison','تهیه RFQ و مقایسه پیشنهادها'],
    ['private_label','تحقیق تولیدکننده پرایوت‌لیبل / قراردادی'],
    ['market_entry','صادرات و ورود به بازار جدید'],
    ['document_assessment','ارزیابی محصول، مبدأ یا اسناد پارت'],
    ['external_trade_desk','میز تجارت خارجی مستمر'],
    ['other','سایر']
  ]},
  zh:{label:'您需要哪类商业支持？',options:[
    ['supplier_sourcing','寻找并核验土耳其制造商或供应商'],
    ['rfq_comparison','RFQ编制与多供应商报价对比'],
    ['private_label','贴牌 / 合同制造商调研'],
    ['market_entry','出口与新市场进入'],
    ['document_assessment','产品、原产地或批次文件评估'],
    ['external_trade_desk','长期外包国际贸易团队'],
    ['other','其他']
  ]},
  vi:{label:'Bạn cần hỗ trợ về nội dung nào?',options:[
    ['supplier_sourcing','Tìm và xác minh nhà sản xuất / nhà cung cấp tại Thổ Nhĩ Kỳ'],
    ['rfq_comparison','Chuẩn bị RFQ và so sánh báo giá'],
    ['private_label','Nghiên cứu nhà sản xuất private label / gia công'],
    ['market_entry','Xuất khẩu và tiếp cận thị trường mới'],
    ['document_assessment','Đánh giá sản phẩm, xuất xứ hoặc hồ sơ lô hàng'],
    ['external_trade_desk','Bộ phận Ngoại thương thuê ngoài dài hạn'],
    ['other','Khác']
  ]}
}[lang];

const dynamicPlaceholders = {
  tr: {
    buyer_request: 'Aradığınız ürün spesifikasyonu, tahmini hacim (MT / Konteyner), teslimat Incoterm (FOB/CIF) ve hedef varış limanı detayları...',
    supplier_market_entry: 'Ürettiğiniz ürünler, aylık/yıllık fiili üretim kapasiteniz, sahip olduğunuz kalite sertifikaları ve açılmak istediğiniz hedef pazarlar...',
    external_trade_desk: 'Şirketinizin dış ticaret hedefi, mevcut ekip yapısı, hedef ülkeler, ürün grupları, aylık ihtiyaç ve CTSEG’den beklediğiniz operasyon kapsamı...',
    default: 'Ticari talebinizin detayları, ürün spesifikasyonları ve teslimat gereksinimleri...'
  },
  en: {
    buyer_request: 'Required product specifications, estimated volume (MT / containers), preferred Incoterm (FOB/CIF), and target destination port...',
    supplier_market_entry: 'Manufactured product lines, monthly/annual production capacity, international quality certifications, and target export regions...',
    external_trade_desk: 'Your company’s trade objectives, target markets, product groups, current team setup and the ongoing scope you want CTSEG to manage...',
    default: 'Details of your commercial request, product specifications, and delivery requirements...'
  },
  de: {
    buyer_request: 'Produktspezifikationen, geschätztes Volumen (Tonnen / Container), bevorzugte Incoterm (FOB/CIF) und Bestimmungshafen...',
    supplier_market_entry: 'Hergestellte Produktlinien, monatliche/jährliche Produktionskapazität, Zertifizierungen und angestrebte Exportmärkte...',
    external_trade_desk: 'Außenhandelsziele Ihres Unternehmens, Zielmärkte, Produktgruppen, aktuelles Team und gewünschter laufender Leistungsumfang...',
    default: 'Details zu Ihrer kommerziellen Anfrage, Produktspezifikationen und Lieferanforderungen...'
  },
  it: {
    buyer_request: 'Specifiche del prodotto richiesto, volumi stimati (tonnellate / container), Incoterm desiderato (FOB/CIF) e porto di destinazione...',
    supplier_market_entry: 'Linee di prodotto fabbricate, capacità produttiva mensile/annuale, certificazioni di qualità e mercati esteri target...',
    external_trade_desk: 'Obiettivi di commercio estero, mercati target, prodotti, struttura interna e attività continuative che volete affidare a CTSEG...',
    default: 'Dettagli della richiesta commerciale, specifiche di prodotto e requisiti di consegna...'
  },
  ru: {
    buyer_request: 'Требуемая спецификация товара, ориентировочный объем (тонны / контейнеры), предпочтительный Incoterm (FOB/CIF) и порт назначения...',
    supplier_market_entry: 'Производимая номенклатура, фактическая мощность (в месяц/год), сертификаты качества и целевые рынки сбыта...',
    external_trade_desk: 'Цели внешней торговли, целевые рынки, товарные группы, текущая команда и постоянный объём задач для CTSEG...',
    default: 'Детали коммерческого запроса, технические параметры и условия поставки...'
  },
  fa: {
    buyer_request: 'مشخصات فنی کالای درخواستی، تناژ یا حجم تقریبی (کانتینر/تن)، اینکوترمز ترجیحی (FOB/CIF) و بندر مقصد...',
    supplier_market_entry: 'خطوط تولید کارخانه، ظرفیت تولید ماهانه/سالانه، گواهینامه‌های کیفی بین‌المللی و بازارهای صادراتی هدف...',
    external_trade_desk: 'اهداف تجارت خارجی شرکت، بازارهای هدف، گروه‌های محصول، ساختار فعلی تیم و دامنه عملیات مستمر مورد انتظار از CTSEG...',
    default: 'شرح درخواست تجاری، مشخصات فنی کالا و شرایط تحویل...'
  },
  zh: {
    buyer_request: '所需产品的详细理化指标与规格、预估采购吨位/集装箱量、贸易术语(FOB/CIF)及目的港...',
    supplier_market_entry: '源头工厂主营产品线、月度/年度实际产出量、已取得的国际质量认证与意向出口目标市场...',
    external_trade_desk: '企业国际贸易目标、目标国家、产品线、现有团队配置，以及希望由 CTSEG 持续负责的业务范围...',
    default: '商业询盘详情、技术规格指标与交货需求...'
  },
  vi: {
    buyer_request: 'Thông số kỹ thuật sản phẩm yêu cầu, khối lượng ước tính (tấn / container), Incoterm mong muốn (FOB/CIF) và cảng đích...',
    supplier_market_entry: 'Danh mục sản phẩm sản xuất, công suất thực tế hàng tháng/năm, các chứng nhận chất lượng và thị trường xuất khẩu mục tiêu...',
    external_trade_desk: 'Mục tiêu ngoại thương, thị trường mục tiêu, nhóm sản phẩm, cơ cấu đội ngũ hiện tại và phạm vi công việc dài hạn muốn CTSEG quản lý...',
    default: 'Chi tiết yêu cầu thương mại, thông số kỹ thuật và điều kiện giao hàng...'
  }
}[lang] || {
  buyer_request: 'Required product specifications, estimated volume, preferred Incoterm, and destination...',
  supplier_market_entry: 'Manufactured products, verified production capacity, quality certifications, and target markets...',
  default: 'Details of your commercial request...'
};
---
<section class="commercial-form-panel" id="commercial-form" aria-labelledby="commercial-form-title">
  <div class="commercial-form-intro">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="commercial-form-title">{copy.title}</h2>
    <p>{copy.intro}</p>
    <div class="direct-contact-cards" aria-label={copy.floatingLabel}>
      <a class="direct-contact-card" href={whatsappHref(lang)} target="_blank" rel="noopener noreferrer" data-contact-whatsapp>
        <span aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23-1.48 0-2.93-.39-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.32a8.188 8.188 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23m-2.52 3.67c-.17 0-.45.06-.69.32-.23.26-.88.87-.88 2.1 0 1.24.9 2.43 1.04 2.6.13.17 1.8 2.77 4.36 3.88 2.12.92 2.55.74 3.02.7.47-.05 1.51-.62 1.73-1.23.22-.61.22-1.13.15-1.24-.07-.11-.24-.17-.5-.3-.26-.13-1.52-.75-1.76-.84-.22-.09-.38-.13-.54.13-.16.26-.63.81-.77.97-.14.16-.28.18-.54.05-.26-.13-1.33-.49-2.6-1.62-.99-.88-1.66-1.97-1.79-2.19-.13-.22-.01-.34.12-.47.12-.12.27-.31.4-.46.13-.15.18-.26.27-.43.09-.17.04-.32-.02-.45-.06-.13-.52-1.27-.71-1.73-.18-.45-.37-.39-.51-.4-.13-.01-.29-.01-.45-.01"/>
          </svg>
        </span>
        <strong>{copy.whatsapp}</strong>
      </a>
      <a class="direct-contact-card" href={emailHref(lang)} data-contact-email>
        <span aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </span>
        <strong>{copy.email}</strong><small>{company.email}</small>
      </a>
      <a class="direct-contact-card" href="https://t.me/teyfikgokdemir" target="_blank" rel="noopener noreferrer" data-contact-telegram>
        <span aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="m20.665 3.717-17.73 6.837c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701h-.002l-.313 4.67c.458 0 .66-.21.916-.457l2.199-2.138 4.574 3.379c.843.465 1.448.225 1.658-.783l2.998-14.133c.307-1.233-.472-1.792-1.208-1.505z"/>
          </svg>
        </span>
        <strong>Telegram</strong><small>@teyfikgokdemir</small>
      </a>
    </div>
  </div>
  <div class="commercial-form-disclosure commercial-form-disclosure--open">
    <div class="commercial-form-disclosure-title">{copy.formDisclosure}</div>
  <form class="commercial-form" id="commercial-request-fields" data-commercial-form data-lang={lang} action="/api/contact" method="post" novalidate>
    <input type="hidden" name="locale" value={lang} />
    <input type="hidden" name="startedAt" value="" data-started-at />
    <input type="hidden" name="pagePath" value="" data-attribution="page_path" />
    <input type="hidden" name="landingPath" value="" data-attribution="landing_path" />
    <input type="hidden" name="referrerHost" value="" data-attribution="referrer_host" />
    <input type="hidden" name="utmSource" value="" data-attribution="utm_source" />
    <input type="hidden" name="utmMedium" value="" data-attribution="utm_medium" />
    <input type="hidden" name="utmCampaign" value="" data-attribution="utm_campaign" />
    <input type="hidden" name="utmContent" value="" data-attribution="utm_content" />
    <input type="hidden" name="utmTerm" value="" data-attribution="utm_term" />
    <input type="hidden" name="clickId" value="" data-attribution="click_id" />
    <div class="form-honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <div class="commercial-intent-cards" role="radiogroup" aria-label={copy.intentLabel}>
      <button type="button" class="intent-card" data-intent-toggle="buyer_request" aria-pressed="false">
        <span class="intent-card-icon">🛒</span>
        <div class="intent-card-content">
          <span class="intent-card-kicker">{lang === 'tr' ? 'ALICI / TEDARİK MASASI' : lang === 'de' ? 'EINKAUF / BESCHAFFUNG' : lang === 'it' ? 'ACQUIRENTE / SOURCING' : lang === 'ru' ? 'ЗАКУПКИ / СОРСИНГ' : lang === 'fa' ? 'خریدار / میز تأمین' : lang === 'zh' ? '跨国买家 / 战略寻源' : lang === 'vi' ? 'BÊN MUA / TÌM NGUỒN CUNG' : 'BUYER / SOURCING DESK'}</span>
          <strong>{copy.buyerIntent}</strong>
          <p>{lang === 'tr' ? 'Ürün, üretici doğrulama ve rekabetçi B2B teklif' :
              lang === 'en' ? 'Product specification, factory verification & commercial quotation' :
              lang === 'de' ? 'Produktspezifikation, Werksprüfung & kaufmännische Angebote' :
              lang === 'it' ? 'Specifiche di prodotto, audit produttore e offerta commerciale' :
              lang === 'ru' ? 'Спецификация продукции, аудит фабрики и коммерческий расчет' :
              lang === 'fa' ? 'مشخصات فنی کالا، بازرسی کارخانجات و استعلام قیمت بین‌المللی' :
              lang === 'zh' ? '大宗商品技术规格书、源头工厂审核与多方比价寻源' :
              'Thông số kỹ thuật, thẩm định nhà máy & báo giá thương mại'}</p>
        </div>
      </button>
      <button type="button" class="intent-card" data-intent-toggle="supplier_market_entry" aria-pressed="false">
        <span class="intent-card-icon">🏭</span>
        <div class="intent-card-content">
          <span class="intent-card-kicker">{lang === 'tr' ? 'ÜRETİCİ / İHRACAT AÇILIMI' : lang === 'de' ? 'HERSTELLER / MARKTZUGANG' : lang === 'it' ? 'PRODUTTORE / EXPORT' : lang === 'ru' ? 'ПРОИЗВОДИТЕЛЬ / ЭКСПОРТ' : lang === 'fa' ? 'تولیدکننده / ورود به بازار' : lang === 'zh' ? '源头工厂 / 出海对接' : lang === 'vi' ? 'NHÀ SẢN XUẤT / XUẤT KHẨU' : 'PRODUCER / MARKET ENTRY'}</span>
          <strong>{copy.producerIntent}</strong>
          <p>{lang === 'tr' ? 'Hedef pazar, alıcı eşleştirme ve ihracat geliştirme' :
              lang === 'en' ? 'Production capacity verification, buyer matching & global export expansion' :
              lang === 'de' ? 'Kapazitätsprüfung, Einkäufer-Matching & internationale Marktexpansion' :
              lang === 'it' ? 'Verifica capacità produttiva, matching buyer ed espansione estera' :
              lang === 'ru' ? 'Верификация мощностей, подбор покупателей и экспортный выход' :
              lang === 'fa' ? 'اعتبارسنجی ظرفیت تولیدی، اتصال به خریداران جهانی و توسعه صادرات' :
              lang === 'zh' ? '真实产能认证核验、跨国采购商对接与目标市场准入落地' :
              'Xác minh năng lực sản xuất, kết nối người mua & mở rộng xuất khẩu'}</p>
        </div>
      </button>
      <button type="button" class="intent-card" data-intent-toggle="external_trade_desk" aria-pressed="false">
        <span class="intent-card-icon">🌐</span>
        <div class="intent-card-content">
          <span class="intent-card-kicker">{lang === 'tr' ? 'DIŞ TİCARET MASASI' : lang === 'de' ? 'EXTERNER TRADE DESK' : lang === 'it' ? 'TRADE DESK ESTERNO' : lang === 'ru' ? 'ВНЕШНИЙ TRADE DESK' : lang === 'fa' ? 'میز تجارت خارجی' : lang === 'zh' ? '外包国际贸易团队' : lang === 'vi' ? 'BỘ PHẬN NGOẠI THƯƠNG' : 'EXTERNAL TRADE DESK'}</span>
          <strong>{lang === 'tr' ? 'Dış ticaret operasyonumu CTSEG yönetsin' : lang === 'de' ? 'CTSEG soll meine Außenhandelsaktivitäten mitsteuern' : lang === 'it' ? 'Voglio affidare a CTSEG la gestione continuativa del commercio estero' : lang === 'ru' ? 'Нужна постоянная внешнеторговая функция от CTSEG' : lang === 'fa' ? 'مدیریت مستمر تجارت خارجی را به CTSEG بسپارم' : lang === 'zh' ? '由 CTSEG 持续运营我的国际贸易业务' : lang === 'vi' ? 'Tôi muốn CTSEG vận hành hoạt động ngoại thương thường xuyên' : 'I need CTSEG as an ongoing external trade function'}</strong>
          <p>{lang === 'tr' ? 'Sourcing, buyer/distribütör araştırması ve RFQ takibi' : lang === 'de' ? 'Sourcing, Exportentwicklung, Käufer-/Distributoren-Follow-up, RFQ und Reporting' : lang === 'it' ? 'Sourcing, sviluppo export, ricerca buyer/distributori, RFQ e reporting' : lang === 'ru' ? 'Сорсинг, развитие экспорта, поиск покупателей, RFQ и отчетность' : lang === 'fa' ? 'تأمین، توسعه صادرات، شناسایی خریدار، پیگیری RFQ و گزارش‌دهی' : lang === 'zh' ? '供应链开发、出口拓展、买家/经销商跟进、RFQ 与定期报告' : lang === 'vi' ? 'Sourcing, phát triển xuất khẩu, theo dõi buyer/nhà phân phối, RFQ và báo cáo' : 'Ongoing sourcing, export development, buyer/distributor follow-up, RFQ and reporting'}</p>
        </div>
      </button>
    </div>
    <div class="commercial-form-grid commercial-form-grid--core">
      <label class="commercial-field"><span>{copy.intentLabel}</span><select name="intent" required data-commercial-intent><option value=""></option><option value="buyer_request">{copy.buyerIntent}</option><option value="supplier_market_entry">{copy.producerIntent}</option><option value="external_trade_desk">{lang === 'tr' ? 'Dış Ticaret Masası' : lang === 'de' ? 'Externer Trade Desk' : lang === 'it' ? 'Trade Desk esterno' : lang === 'ru' ? 'Внешний Trade Desk' : lang === 'fa' ? 'میز تجارت خارجی' : lang === 'zh' ? '外包国际贸易团队' : lang === 'vi' ? 'Bộ phận Ngoại thương thuê ngoài' : 'External Trade Desk'}</option></select></label>
      <label class="commercial-field commercial-field--wide"><span>{supportNeedCopy.label}</span><select name="supportNeed" required data-support-need><option value=""></option>{supportNeedCopy.options.map(([value,label])=><option value={value}>{label}</option>)}</select></label>
      <label class="commercial-field"><span>{qualification.tradeDirection}</span><select name="tradeDirection" required data-trade-direction><option value=""></option>{qualification.tradeDirections.map((option)=><option value={option.value}>{option.label}</option>)}</select></label>
      <label class="commercial-field commercial-field--wide"><span>{qualification.productFamily}</span><select name="productFamily" required data-product-family><option value=""></option>{qualification.productFamilies.map((option)=><option value={option.value}>{option.label}</option>)}</select></label>
      <label class="commercial-field"><span>{copy.name}</span><input type="text" name="name" autocomplete="name" maxlength="120" required /></label>
      <label class="commercial-field"><span>{copy.company}</span><input type="text" name="company" autocomplete="organization" maxlength="160" required /></label>
      <label class="commercial-field commercial-field--wide"><span>{copy.contact}</span><input type="text" name="emailOrPhone" autocomplete="email" maxlength="254" required data-contact-field /></label>
      <label class="commercial-field commercial-field--wide"><span>{copy.message}</span><textarea name="message" maxlength="2000" rows="4" placeholder={dynamicPlaceholders.default} required></textarea></label>
    </div>
    <details class="commercial-details">
      <summary>{copy.details}</summary>
      <div class="commercial-form-grid">
        <label class="commercial-field"><span>{qualification.originMarket}</span><input type="text" name="originMarket" autocomplete="country-name" maxlength="100" /></label>
        <label class="commercial-field"><span>{qualification.destinationMarket}</span><input type="text" name="destinationMarket" maxlength="100" /></label>
        <label class="commercial-field"><span>{copy.product}</span><input type="text" name="product" maxlength="240" /></label>
        <label class="commercial-field"><span>{copy.quantity}</span><input type="text" name="quantity" maxlength="120" /></label>
        <label class="commercial-field"><span>{qualification.packaging}</span><input type="text" name="packaging" maxlength="160" /></label>
        <label class="commercial-field"><span>{qualification.incoterm}</span><input type="text" name="incoterm" maxlength="30" /></label>
        <label class="commercial-field"><span>{copy.delivery}</span><input type="text" name="delivery" autocomplete="street-address" maxlength="180" /></label>
        <label class="commercial-field"><span>{copy.targetDate}</span><input type="date" name="targetDate" /></label>
        <label class="commercial-field commercial-field--wide"><span>{copy.requirements}</span><input type="text" name="requirements" maxlength="500" /></label>
      </div>
    </details>
    <label class="privacy-check"><input type="checkbox" name="privacy" value="accepted" required /><span>{copy.privacy} <a href={privacyHref}>{copy.privacyLink}</a></span></label>
    <div class="commercial-form-actions"><button class="button" type="submit">{copy.submit}</button></div>
    <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    <div class="form-fallback" data-form-fallback hidden><p>{copy.fallback}</p><button type="button" class="button button-secondary" data-download-summary>{copy.download}</button></div>
  </form>
  </div>
</section>

