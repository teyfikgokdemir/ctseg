---
import { localizedPath } from '../data/site';
import { company } from '../data/site';
import { contactCopy, emailHref, whatsappHref, type ContactLocale } from '../data/contact-experience';
import { contactQualification } from '../data/contact-qualification';

const { lang } = Astro.props as { lang:ContactLocale };
const copy = contactCopy[lang];
const qualification = contactQualification[lang];
const privacyHref = lang === 'fa' ? '/fa/#privacy' : localizedPath(lang,'legal','privacy');
---
<section class="commercial-form-panel" id="commercial-form" aria-labelledby="commercial-form-title">
  <div class="commercial-form-intro">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="commercial-form-title">{copy.title}</h2>
    <p>{copy.intro}</p>
    <div class="direct-contact-cards" aria-label={copy.floatingLabel}>
      <a class="direct-contact-card" href={whatsappHref(lang)} target="_blank" rel="noopener noreferrer" data-contact-whatsapp>
        <span aria-hidden="true">WA</span><strong>{copy.whatsapp}</strong>
      </a>
      <a class="direct-contact-card" href={emailHref(lang)} data-contact-email>
        <span aria-hidden="true">@</span><strong>{copy.email}</strong><small>{company.email}</small>
      </a>
      <a class="direct-contact-card" href="https://t.me/teyfikgokdemir" target="_blank" rel="noopener noreferrer" data-contact-telegram>
        <span aria-hidden="true">TG</span><strong>Telegram</strong><small>@teyfikgokdemir</small>
      </a>
    </div>
  </div>
  <details class="commercial-form-disclosure">
    <summary>{copy.formDisclosure}<span aria-hidden="true">＋</span></summary>
  <form class="commercial-form" id="commercial-request-fields" data-commercial-form data-lang={lang} action="/api/contact" method="post" novalidate>
    <input type="hidden" name="locale" value={lang} />
    <input type="hidden" name="startedAt" value="" data-started-at />
    <input type="hidden" name="pagePath" value="" data-attribution="page_path" />
    <input type="hidden" name="landingPath" value="" data-attribution="landing_path" />
    <input type="hidden" name="referrerHost" value="" data-attribution="referrer_host" />
    <input type="hidden" name="utmSource" value="" data-attribution="utm_source" />
    <input type="hidden" name="utmMedium" value="" data-attribution="utm_medium" />
    <input type="hidden" name="utmCampaign" value="" data-attribution="utm_campaign" />
    <input type="hidden" name="utmContent" value="" data-attribution="utm_content" />
    <input type="hidden" name="utmTerm" value="" data-attribution="utm_term" />
    <input type="hidden" name="clickId" value="" data-attribution="click_id" />
    <div class="form-honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <div class="commercial-form-grid commercial-form-grid--core">
      <label class="commercial-field"><span>{copy.intentLabel}</span><select name="intent" required data-commercial-intent><option value=""></option><option value="buyer_request">{copy.buyerIntent}</option><option value="supplier_market_entry">{copy.producerIntent}</option></select></label>
      <label class="commercial-field"><span>{qualification.tradeDirection}</span><select name="tradeDirection" required data-trade-direction><option value=""></option>{qualification.tradeDirections.map((option)=><option value={option.value}>{option.label}</option>)}</select></label>
      <label class="commercial-field commercial-field--wide"><span>{qualification.productFamily}</span><select name="productFamily" required data-product-family><option value=""></option>{qualification.productFamilies.map((option)=><option value={option.value}>{option.label}</option>)}</select></label>
      <label class="commercial-field"><span>{copy.name}</span><input type="text" name="name" autocomplete="name" maxlength="120" required /></label>
      <label class="commercial-field"><span>{copy.company}</span><input type="text" name="company" autocomplete="organization" maxlength="160" required /></label>
      <label class="commercial-field commercial-field--wide"><span>{copy.contact}</span><input type="text" name="emailOrPhone" autocomplete="email" maxlength="254" required data-contact-field /></label>
      <label class="commercial-field commercial-field--wide"><span>{copy.message}</span><textarea name="message" maxlength="2000" rows="4" required></textarea></label>
    </div>
    <details class="commercial-details">
      <summary>{copy.details}</summary>
      <div class="commercial-form-grid">
        <label class="commercial-field"><span>{qualification.originMarket}</span><input type="text" name="originMarket" autocomplete="country-name" maxlength="100" /></label>
        <label class="commercial-field"><span>{qualification.destinationMarket}</span><input type="text" name="destinationMarket" maxlength="100" /></label>
        <label class="commercial-field"><span>{copy.product}</span><input type="text" name="product" maxlength="240" /></label>
        <label class="commercial-field"><span>{copy.quantity}</span><input type="text" name="quantity" maxlength="120" /></label>
        <label class="commercial-field"><span>{qualification.packaging}</span><input type="text" name="packaging" maxlength="160" /></label>
        <label class="commercial-field"><span>{qualification.incoterm}</span><input type="text" name="incoterm" maxlength="30" /></label>
        <label class="commercial-field"><span>{copy.delivery}</span><input type="text" name="delivery" autocomplete="street-address" maxlength="180" /></label>
        <label class="commercial-field"><span>{copy.targetDate}</span><input type="date" name="targetDate" /></label>
        <label class="commercial-field commercial-field--wide"><span>{copy.requirements}</span><input type="text" name="requirements" maxlength="500" /></label>
      </div>
    </details>
    <label class="privacy-check"><input type="checkbox" name="privacy" value="accepted" required /><span>{copy.privacy} <a href={privacyHref}>{copy.privacyLink}</a></span></label>
    <div class="commercial-form-actions"><button class="button" type="submit">{copy.submit}</button></div>
    <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    <div class="form-fallback" data-form-fallback hidden><p>{copy.fallback}</p><button type="button" class="button button-secondary" data-download-summary>{copy.download}</button></div>
  </form>
  </details>
</section>

<style is:global>
  .commercial-form-panel{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(34px,5vw,82px);overflow:hidden;padding:clamp(38px,5vw,76px);border:1px solid rgba(255,255,255,.1);border-radius:30px;background:#111;color:#fff;box-shadow:0 28px 80px rgba(0,0,0,.16)}
  .commercial-form-panel::before{content:"CTSEG";position:absolute;right:-.05em;bottom:-.16em;z-index:-1;font-size:clamp(150px,22vw,360px);font-weight:900;line-height:.8;letter-spacing:-.09em;color:rgba(255,255,255,.022);pointer-events:none;user-select:none}
  .commercial-form-panel::after{content:"";position:absolute;left:0;top:0;width:34%;height:5px;background:#c4f000}
  .commercial-form-intro{align-self:start;position:sticky;top:118px}
  .commercial-form-intro .eyebrow{color:#c4f000!important;font-weight:800!important;letter-spacing:.1em!important}
  .commercial-form-intro h2{margin:18px 0 22px;color:#fff;font-size:clamp(42px,4.6vw,76px);line-height:.94;letter-spacing:-.055em;max-width:10ch;text-wrap:balance}
  .commercial-form-intro>p:not(.eyebrow){max-width:34em;color:#d4d4cf!important;font-size:17px;line-height:1.62}
  .direct-contact-cards{display:grid;gap:10px;margin-top:34px}
  .direct-contact-card{position:relative;display:grid;grid-template-columns:46px minmax(0,1fr);gap:14px;align-items:center;min-height:68px;padding:12px 16px;border:1px solid rgba(255,255,255,.14);border-radius:16px;background:rgba(255,255,255,.035);color:#fff;text-decoration:none;transition:transform .25s ease,border-color .25s ease,background .25s ease}
  .direct-contact-card>span{display:grid;place-items:center;width:42px;height:42px;border-radius:999px;background:#c4f000;color:#0a0a0a!important;font-size:12px;font-weight:900;letter-spacing:.04em}
  .direct-contact-card strong{font-size:15px;color:#fff}
  .direct-contact-card small{grid-column:2;color:#aaa!important;margin-top:-10px;overflow-wrap:anywhere}
  .direct-contact-card:hover{transform:translateX(5px);border-color:#c4f000;background:rgba(196,240,0,.06)}
  .commercial-form-disclosure{align-self:start;border:1px solid rgba(255,255,255,.14);border-radius:24px;background:#f6f6f1;color:#111;overflow:hidden;box-shadow:0 22px 60px rgba(0,0,0,.2)}
  .commercial-form-disclosure>summary{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 26px;cursor:pointer;list-style:none;font-size:18px;font-weight:800;color:#111}
  .commercial-form-disclosure>summary::-webkit-details-marker{display:none}
  .commercial-form-disclosure>summary span{display:grid;place-items:center;width:36px;height:36px;border-radius:999px;background:#c4f000;color:#0a0a0a!important;font-size:20px;transition:transform .25s ease}
  .commercial-form-disclosure[open]>summary span{transform:rotate(45deg)}
  .commercial-form{padding:0 26px 28px}
  .commercial-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .commercial-field{display:flex;flex-direction:column;gap:8px;min-width:0}
  .commercial-field--wide{grid-column:1/-1}
  .commercial-field>span{font-size:12px!important;font-weight:800!important;letter-spacing:.055em;text-transform:uppercase;color:#464640!important}
  .commercial-field input,.commercial-field select,.commercial-field textarea{width:100%;min-height:52px;padding:13px 14px;border:1px solid #d4d4cc;border-radius:12px;background:#fff;color:#111;font:inherit;outline:none;transition:border-color .2s ease,box-shadow .2s ease}
  .commercial-field textarea{min-height:120px;resize:vertical}
  .commercial-field input:focus,.commercial-field select:focus,.commercial-field textarea:focus{border-color:#9cbf00;box-shadow:0 0 0 3px rgba(196,240,0,.24)}
  .commercial-details{margin-top:18px;border-top:1px solid #deded7;padding-top:18px}
  .commercial-details>summary{cursor:pointer;font-weight:800;color:#1b1b19;margin-bottom:18px}
  .privacy-check{display:flex;gap:10px;align-items:flex-start;margin-top:22px;color:#4a4a45;font-size:13px;line-height:1.5}
  .privacy-check input{margin-top:3px;accent-color:#111}
  .privacy-check a{color:#111;font-weight:800}
  .commercial-form-actions{margin-top:22px}
  .commercial-form-actions .button{min-height:50px;border-radius:999px;background:#111!important;color:#fff!important;border-color:#111!important;padding-inline:22px;font-weight:800}
  .commercial-form-actions .button:hover{background:#c4f000!important;color:#111!important;border-color:#c4f000!important}
  .form-status{margin-top:16px!important;color:#30302d!important}
  .form-fallback{margin-top:16px;padding:16px;border-radius:14px;background:#ecece6}
  .form-honeypot{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;overflow:hidden!important}
  @media(max-width:980px){
    .commercial-form-panel{grid-template-columns:1fr;padding:34px;border-radius:24px}.commercial-form-intro{position:static}.commercial-form-intro h2{max-width:14ch}.direct-contact-cards{grid-template-columns:repeat(3,minmax(0,1fr))}.direct-contact-card{grid-template-columns:42px minmax(0,1fr)}
  }
  @media(max-width:720px){
    .commercial-form-panel{padding:24px 18px;border-radius:20px;margin-inline:-2px}.commercial-form-intro h2{font-size:clamp(38px,10vw,52px);max-width:100%}.commercial-form-intro>p:not(.eyebrow){font-size:16px}.direct-contact-cards{grid-template-columns:1fr}.commercial-form-disclosure{border-radius:18px}.commercial-form-disclosure>summary{padding:20px;font-size:16px}.commercial-form{padding:0 18px 22px}.commercial-form-grid{grid-template-columns:1fr}.commercial-field--wide{grid-column:auto}.commercial-form-actions .button{width:100%}.commercial-form-panel::before{font-size:42vw;bottom:-.04em}}
  /* Trade desk composition: ruled contact routes and a clear request sheet. */
  .commercial-form-panel{border-radius:0;box-shadow:none}
  .commercial-form-panel::before{content:none}
  .direct-contact-cards{gap:0;border-top:1px solid rgba(255,255,255,.2)}
  .direct-contact-card{min-height:68px;padding:12px 0;border:0;border-bottom:1px solid rgba(255,255,255,.2);border-radius:0;background:transparent;box-shadow:none}
  .direct-contact-card>span{width:38px;height:38px;border-radius:0;background:transparent;color:#c4f000!important;border:1px solid rgba(196,240,0,.45)}
  .direct-contact-card:hover,.direct-contact-card:focus-visible{transform:none;background:transparent;border-color:#c4f000}
  .commercial-form-disclosure{border-radius:0;box-shadow:none}
  .commercial-form-disclosure>summary{border-bottom:1px solid #d4d4cc}
  .commercial-form-disclosure>summary span{border-radius:0}
  .commercial-field input,.commercial-field select,.commercial-field textarea{border-radius:0}
  .commercial-form-actions .button,.form-fallback{border-radius:0}
  @media(max-width:980px){.direct-contact-cards{border-top:0}.direct-contact-card{border-top:1px solid rgba(255,255,255,.2)}}
</style>

<script define:vars={{ copy }}>
  (() => {
    document.querySelectorAll('[data-commercial-form]').forEach((form) => {
      if(form.dataset.enhanced)return;form.dataset.enhanced='true';
      const started=form.querySelector('[data-started-at]');
      const status=form.querySelector('[data-form-status]');
      const fallback=form.querySelector('[data-form-fallback]');
      const download=form.querySelector('[data-download-summary]');
      const product=form.elements.namedItem('product');
      const intent=form.elements.namedItem('intent');
      const tradeDirection=form.elements.namedItem('tradeDirection');
      const productFamily=form.elements.namedItem('productFamily');
      started.value=String(Date.now());
      const attribution=window.__ctsegAttribution||{landing_path:location.pathname};
      form.querySelectorAll('[data-attribution]').forEach((input)=>{input.value=input.dataset.attribution==='page_path'?location.pathname:(attribution[input.dataset.attribution]||'')});
      const savedProduct=sessionStorage.getItem('ctseg-product-request');
      if(savedProduct&&product instanceof HTMLInputElement){product.value=savedProduct;sessionStorage.removeItem('ctseg-product-request')}
      const requestParams=new URLSearchParams(location.search);
      const requestedIntent=requestParams.get('intent');
      const requestedDirection=requestParams.get('direction');
      const requestedFamily=requestParams.get('category');
      if(intent instanceof HTMLSelectElement&&['buyer_request','supplier_market_entry'].includes(requestedIntent||''))intent.value=requestedIntent;
      if(tradeDirection instanceof HTMLSelectElement&&['export_from_turkiye','import_to_turkiye','cross_border_sourcing','market_entry','other'].includes(requestedDirection||''))tradeDirection.value=requestedDirection;
      if(productFamily instanceof HTMLSelectElement&&['vegetable_oils','nuts_dried_fruit','reflex_gloves','biofuel_feedstock','other'].includes(requestedFamily||''))productFamily.value=requestedFamily;
      document.querySelectorAll('[data-fa-intent],[data-contact-intent],[data-trade-intent]').forEach((link)=>link.addEventListener('click',()=>{const value=link.getAttribute('data-fa-intent')||link.getAttribute('data-contact-intent')||link.getAttribute('data-trade-intent');if(intent instanceof HTMLSelectElement&&value)intent.value=value}));
      let startedTracked=false;
      const track=(event,parameters={})=>window.ctsegTrack?.(event,{form_type:'qualified_commercial_request',trade_intent:intent instanceof HTMLSelectElement?intent.value:'',trade_direction:tradeDirection instanceof HTMLSelectElement?tradeDirection.value:'',product_family:productFamily instanceof HTMLSelectElement?productFamily.value:'',...parameters});
      form.addEventListener('focusin',()=>{if(!startedTracked){startedTracked=true;track('contact_form_start')}},{once:true});
      const summary=()=>Array.from(new FormData(form).entries()).filter(([key,value])=>!['website','startedAt','privacy','locale','pagePath','landingPath','referrerHost','utmSource','utmMedium','utmCampaign','utmContent','utmTerm','clickId'].includes(key)&&String(value).trim()).map(([key,value])=>`${key}: ${String(value).trim()}`).join('\n');
      download?.addEventListener('click',()=>{track('form_fallback_download');const blob=new Blob([`CTSEG short commercial request\n\n${summary()}\n`],{type:'text/plain;charset=utf-8'});const url=URL.createObjectURL(blob);const link=document.createElement('a');link.href=url;link.download='ctseg-commercial-request.txt';link.click();URL.revokeObjectURL(url)});
      form.closest('.commercial-form-disclosure')?.addEventListener('toggle',(event)=>{if(event.currentTarget.open)track('contact_form_open')});
      form.addEventListener('submit',async(event)=>{
        event.preventDefault();fallback.hidden=true;status.textContent='';if(!form.reportValidity())return;
        track('contact_form_submit_attempt');const submit=form.querySelector('[type="submit"]');submit.disabled=true;
        try{const response=await fetch(form.action,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form)))});const result=await response.json().catch(()=>({}));if(!response.ok)throw new Error(result.code||'request_failed');status.textContent=copy.success;track('contact_form_success');track('generate_lead');window.dispatchEvent(new CustomEvent('ctseg:form-success'));if(document.documentElement.lang==='fa')window.dispatchEvent(new CustomEvent('ctseg:fa-form-success'));form.reset();started.value=String(Date.now())}
        catch{status.textContent=`${copy.error} ${copy.fallback}`;fallback.hidden=false;track('contact_form_error')}
        finally{submit.disabled=false}
      });
    });
  })();
</script>
