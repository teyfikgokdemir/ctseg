---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommercialRequestForm from './CommercialRequestForm.astro';
import type { GlassSeoPage, GlassSeoLocale } from '../data/glass-seo';
import { glassSeoPages } from '../data/glass-seo';
import { activeLocales } from '../data/locales';
import { localizedGlassSlugs } from '../data/glass-product-locales';
const { page, lang='tr' }=Astro.props as {page:GlassSeoPage;lang?:GlassSeoLocale};
const c=page[lang]; const tr=lang==='tr';
const base=tr?'/glass':'/en/glass'; const canonical=`https://ctseg.com.tr${base}/${page.slug}/`;
const isLocalizedProduct=(localizedGlassSlugs as readonly string[]).includes(page.slug);
const alt=Object.fromEntries([['tr',`https://ctseg.com.tr/glass/${page.slug}/`],['en',`https://ctseg.com.tr/en/glass/${page.slug}/`],...(isLocalizedProduct?activeLocales.filter((code)=>!['tr','en'].includes(code)).map((code)=>[code,`https://ctseg.com.tr/${code}/glass/${page.slug}/`]):[]),['x-default',`https://ctseg.com.tr/en/glass/${page.slug}/`]]);
const relatedMap:Record<string,string[]>={
  'float-glass':['low-iron-extra-clear-glass','tempered-glass','laminated-glass','low-e-coated-glass','processed-glass-cut-to-size'],
  'tempered-glass':['heat-strengthened-glass','heat-soak-tested-glass','laminated-glass','shower-enclosure-glass','balustrade-railing-glass'],
  'heat-strengthened-glass':['tempered-glass','heat-soak-tested-glass','laminated-glass','architectural-project-glass','insulated-glass-igu'],
  'heat-soak-tested-glass':['tempered-glass','heat-strengthened-glass','balustrade-railing-glass','architectural-project-glass','fire-rated-glass'],
  'laminated-glass':['tempered-glass','balustrade-railing-glass','office-partition-interior-glass','fire-rated-glass','architectural-project-glass'],
  'low-e-coated-glass':['solar-control-glass','insulated-glass-igu','architectural-project-glass','float-glass','low-iron-extra-clear-glass'],
  'solar-control-glass':['low-e-coated-glass','insulated-glass-igu','architectural-project-glass','float-glass','ceramic-printed-glass'],
  'insulated-glass-igu':['low-e-coated-glass','solar-control-glass','tempered-glass','architectural-project-glass','office-partition-interior-glass'],
  'low-iron-extra-clear-glass':['float-glass','laminated-glass','balustrade-railing-glass','furniture-retail-glass','architectural-project-glass'],
  'mirror-decorative-glass':['patterned-frosted-satin-glass','ceramic-printed-glass','furniture-retail-glass','office-partition-interior-glass','processed-glass-cut-to-size'],
  'patterned-frosted-satin-glass':['mirror-decorative-glass','ceramic-printed-glass','office-partition-interior-glass','shower-enclosure-glass','furniture-retail-glass'],
  'processed-glass-cut-to-size':['glass-processing-services','curved-glass','ceramic-printed-glass','furniture-retail-glass','household-appliance-glass'],
  'glass-processing-services':['processed-glass-cut-to-size','curved-glass','ceramic-printed-glass','household-appliance-glass','furniture-retail-glass'],
  'curved-glass':['glass-processing-services','processed-glass-cut-to-size','laminated-glass','architectural-project-glass','furniture-retail-glass'],
  'ceramic-printed-glass':['glass-processing-services','patterned-frosted-satin-glass','household-appliance-glass','furniture-retail-glass','architectural-project-glass'],
  'fire-rated-glass':['laminated-glass','office-partition-interior-glass','architectural-project-glass','heat-soak-tested-glass'],
  'shower-enclosure-glass':['tempered-glass','patterned-frosted-satin-glass','glass-processing-services','processed-glass-cut-to-size','furniture-retail-glass'],
  'balustrade-railing-glass':['laminated-glass','tempered-glass','heat-soak-tested-glass','low-iron-extra-clear-glass','architectural-project-glass'],
  'office-partition-interior-glass':['tempered-glass','laminated-glass','patterned-frosted-satin-glass','fire-rated-glass','furniture-retail-glass'],
  'household-appliance-glass':['ceramic-printed-glass','glass-processing-services','processed-glass-cut-to-size','tempered-glass','furniture-retail-glass'],
  'furniture-retail-glass':['processed-glass-cut-to-size','glass-processing-services','mirror-decorative-glass','patterned-frosted-satin-glass','household-appliance-glass'],
  'architectural-project-glass':['tempered-glass','laminated-glass','low-e-coated-glass','insulated-glass-igu','heat-soak-tested-glass','fire-rated-glass']
};
const relatedPages=(relatedMap[page.slug]||[]).map((slug)=>glassSeoPages.find((item)=>item.slug===slug)).filter(Boolean) as GlassSeoPage[];
const visualMap:Record<string,string>={
  'float-glass':'/images/glass/glass-applications-turkey.webp',
  'tempered-glass':'/images/glass/tempered-glass-production-turkey.webp',
  'heat-strengthened-glass':'/images/glass/glass-processing-line-turkey.webp',
  'heat-soak-tested-glass':'/images/glass/clear-glass-balustrade-turkey.webp',
  'laminated-glass':'/images/glass/laminated-glass-canopy-turkey.webp',
  'low-e-coated-glass':'/images/glass/low-e-coated-glass-production-turkey.webp',
  'solar-control-glass':'/images/glass/low-e-solar-control-glass-turkey.webp',
  'insulated-glass-igu':'/images/glass/insulated-glass-igu-production-turkey.webp',
  'low-iron-extra-clear-glass':'/images/glass/architectural-glass-facade-turkey.webp',
  'mirror-decorative-glass':'/images/glass/commercial-entrance-glass-turkey.webp',
  'patterned-frosted-satin-glass':'/images/glass/shopping-mall-storefront-glass-turkey.webp',
  'processed-glass-cut-to-size':'/images/glass/glass-cnc-processing-turkey.webp',
  'glass-processing-services':'/images/glass/glass-processing-line-turkey.webp',
  'curved-glass':'/images/glass/curved-bent-glass-production-turkey.webp',
  'ceramic-printed-glass':'/images/glass/shopping-mall-storefront-glass-turkey.webp',
  'fire-rated-glass':'/images/glass/fire-rated-glass-turkey.webp',
  'shower-enclosure-glass':'/images/glass/shower-enclosure-glass-turkey.webp',
  'balustrade-railing-glass':'/images/glass/balustrade-railing-glass-turkey.webp',
  'office-partition-interior-glass':'/images/glass/office-partition-glass-turkey.webp',
  'household-appliance-glass':'/images/glass/glass-applications-turkey.webp',
  'furniture-retail-glass':'/images/glass/shopping-mall-storefront-glass-turkey.webp',
  'architectural-project-glass':'/images/glass/architectural-glass-facade-turkey.webp'
};
const visual=visualMap[page.slug]||'/images/glass/glass-applications-turkey.webp';
const heroCropMap:Record<string,{position:string;scale:number}>={
  'float-glass':{position:'50% 48%',scale:1.30},
  'tempered-glass':{position:'52% 48%',scale:1.30},
  'heat-strengthened-glass':{position:'53% 47%',scale:1.31},
  'heat-soak-tested-glass':{position:'50% 46%',scale:1.28},
  'laminated-glass':{position:'50% 44%',scale:1.32},
  'low-e-coated-glass':{position:'56% 47%',scale:1.32},
  'solar-control-glass':{position:'52% 47%',scale:1.30},
  'insulated-glass-igu':{position:'52% 48%',scale:1.30},
  'low-iron-extra-clear-glass':{position:'50% 46%',scale:1.28},
  'mirror-decorative-glass':{position:'50% 45%',scale:1.28},
  'patterned-frosted-satin-glass':{position:'50% 47%',scale:1.28},
  'processed-glass-cut-to-size':{position:'51% 48%',scale:1.32},
  'glass-processing-services':{position:'53% 48%',scale:1.31},
  'curved-glass':{position:'52% 47%',scale:1.30},
  'ceramic-printed-glass':{position:'50% 46%',scale:1.28},
  'fire-rated-glass':{position:'52% 47%',scale:1.28},
  'shower-enclosure-glass':{position:'52% 46%',scale:1.27},
  'balustrade-railing-glass':{position:'50% 47%',scale:1.27},
  'office-partition-interior-glass':{position:'50% 46%',scale:1.27},
  'household-appliance-glass':{position:'50% 48%',scale:1.28},
  'furniture-retail-glass':{position:'50% 46%',scale:1.27},
  'architectural-project-glass':{position:'50% 46%',scale:1.27}
};
const heroCrop=heroCropMap[page.slug]||{position:'50% 50%',scale:1};
const visualAlt=tr?`${c.title} için Türkiye cam tedarik ağı görseli`:`${c.title} sourcing network in Türkiye`;
const visualCards=relatedPages.slice(0,4).map((item)=>({
  ...item,
  image:visualMap[item.slug]||'/images/glass/glass-applications-turkey.webp'
}));
const trustItems=tr?[
  ['Türkiye’de Güçlü Üretici Ağı','Önde gelen cam üreticileri ve güvenilir processorlarla kurulmuş ticari ilişkiler'],
  ['Proje ve Ticari Tedarik','Tek seferlik projeden düzenli B2B tedarike kadar uygun kanal eşleştirmesi'],
  ['Teknik Uygunluk','Standart, işleme, ölçü ve dokümantasyon gereksinimlerinin RFQ bazında kontrolü'],
  ['Global Teslimat Koordinasyonu','Avrupa, Balkanlar, Orta Doğu ve diğer pazarlara uygun lojistik planlama']
]:[
  ['Established Turkish Supply Network','Commercial relationships with leading glass manufacturers and trusted processors'],
  ['Project & Commercial Supply','Supplier matching from project orders to recurring B2B requirements'],
  ['Technical Fit','Standards, processing, dimensions and documentation checked at RFQ level'],
  ['Global Delivery Coordination','Logistics planning for Europe, the Balkans, Middle East and wider markets']
];
const featureItems=tr?[
  ['Teknik Eşleştirme','Talebe uygun cam tipi ve build-up'],
  ['İşleme Kabiliyeti','Kesim, delik, kenar, CNC ve özel işlemler'],
  ['Proje Tedariki','Mimari, endüstriyel ve OEM talepler'],
  ['Belge Kontrolü','Talep edilen standart ve dokümanların doğrulanması'],
  ['Global Lojistik','Teslim noktası ve Incoterm bazlı koordinasyon']
]:[
  ['Technical Matching','Glass type and build-up matched to the requirement'],
  ['Processing Capability','Cutting, drilling, edging, CNC and special processing'],
  ['Project Supply','Architectural, industrial and OEM requirements'],
  ['Document Check','Requested standards and documentation verified'],
  ['Global Logistics','Delivery-point and Incoterm-based coordination']
];
const partnerNote=tr
  ? 'CTSEG üretici değildir. Türkiye’nin önde gelen cam üreticileri ve güvenilir işleme tesisleriyle kurulmuş ticari iş birlikleri üzerinden doğru üretim kanalını eşleştirir.'
  : 'CTSEG is not a manufacturer. We work through established commercial relationships with leading Turkish glass manufacturers and trusted processors to match each requirement with the right production route.';
const schema=[{'@context':'https://schema.org','@type':'Service','name':c.title,'description':c.description,'url':canonical,'areaServed':'Worldwide','provider':{'@type':'Organization','name':'CTSEG','url':'https://ctseg.com.tr/'}},{'@context':'https://schema.org','@type':'FAQPage','mainEntity':c.faq.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))},{'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':tr?'Cam Tedariki':'Glass Sourcing','item':`https://ctseg.com.tr${base}/`},{'@type':'ListItem','position':2,'name':c.title,'item':canonical}]}];
---
<BaseLayout lang={lang} title={c.metaTitle} description={c.description} canonical={canonical} alternates={alt} schema={schema} pageKey="glass-product" pageId={page.slug}>
  <main class="glass-product">
    <section class="hero">
      <div class="hero-media" style={`--hero-pos:${heroCrop.position};--hero-scale:${heroCrop.scale}`}><img src={visual} alt={visualAlt} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async"/></div>
      <div class="hero-shade"></div>
      <div class="container hero-content">
        <div class="hero-copy">
          <span class="eyebrow">{c.eyebrow}</span>
          <h1>{c.title}</h1>
          <p class="hero-lead">{c.lead}</p>
          <p class="partner-note">{partnerNote}</p>
          <div class="hero-actions">
            <a class="button primary" href="#rfq">{tr?'Cam RFQ Gönder':'Send Glass RFQ'}</a>
            <a class="button ghost" href={tr?'/glass/':'/en/glass/'}>{tr?'Tüm Cam Çözümleri':'All Glass Solutions'}</a>
          </div>
        </div>
        <aside class="trust-panel">
          {trustItems.map(([title,text],index)=><div class="trust-item">
            <span class="trust-icon" aria-hidden="true"></span>
            <div><strong>{title}</strong><p>{text}</p></div>
          </div>)}
        </aside>
      </div>
    </section>

    <section class="feature-strip"><div class="container feature-grid">
      {featureItems.map(([title,text])=><div class="feature-item"><strong>{title}</strong><span>{text}</span></div>)}
    </div></section>

    <section class="section applications"><div class="container">
      <div class="section-intro">
        <div><span class="eyebrow dark">{tr?'CAM TEDARİK EKOSİSTEMİ':'GLASS SOURCING ECOSYSTEM'}</span><h2>{tr?'İlgili kullanım ve tedarik alanları':'Related applications & sourcing areas'}</h2></div>
        <p>{tr?'Ürün gereksiniminizi yalnız tek bir cam kategorisi olarak değil, kullanım alanı ve işleme ihtiyacıyla birlikte değerlendiriyoruz.':'We evaluate the requirement together with its application and processing needs rather than treating it as a standalone glass category.'}</p>
      </div>
      <div class="application-grid">
        {visualCards.map((item)=><a class="application-card" href={`${base}/${item.slug}/`}>
          <img src={item.image} alt={item[lang].title} width="1600" height="900" loading="lazy" decoding="async"/>
          <span class="card-shade"></span>
          <div class="card-copy"><strong>{item[lang].title}</strong><span>↗</span></div>
        </a>)}
      </div>
    </div></section>

    <section class="section partner-network"><div class="container partner-grid">
      <div>
        <span class="eyebrow dark">{tr?'TÜRKİYE CAM TEDARİK AĞI':'TÜRKİYE GLASS SUPPLY NETWORK'}</span>
        <h2>{tr?'Önde gelen üretici ve processorlarla kurulu ticari ilişkiler':'Established commercial relationships with leading manufacturers and processors'}</h2>
        <p>{partnerNote}</p>
        <p>{tr?'Amaç tek bir üreticiyi öne çıkarmak değil; ürün tipi, kapasite, işleme kabiliyeti, belge gereksinimi ve teslim koşuluna göre doğru üretim kanalını seçmektir.':'The objective is not to promote a single manufacturer, but to select the right production route according to product type, capacity, processing capability, documentation and delivery requirements.'}</p>
        <a class="button dark-btn" href="#rfq">{tr?'Tedarik Talebi Oluştur':'Start a Sourcing Request'}</a>
      </div>
      <div class="partner-gallery">
        <img src="/images/glass/glass-processing-line-turkey.webp" alt={tr?'Türkiye cam işleme hattı':'Glass processing line in Türkiye'} width="1600" height="900" loading="lazy"/>
        <img src="/images/glass/glass-cnc-processing-turkey.webp" alt={tr?'Cam CNC işleme':'Glass CNC processing'} width="1600" height="900" loading="lazy"/>
        <img src="/images/glass/architectural-glass-facade-turkey.webp" alt={tr?'Mimari cam uygulaması':'Architectural glass application'} width="1600" height="900" loading="lazy"/>
      </div>
    </div></section>

    <section class="section rfq-brief"><div class="container"><div class="center head"><h2>{tr?'Doğru teklif için RFQ bilgileri':'RFQ inputs for an accurate quotation'}</h2></div><div class="brief-grid">{c.rfq.map(x=><article><h3>{x}</h3></article>)}</div></div></section>
    <section class="section related"><div class="container"><div class="center head"><h2>{tr?'İlgili cam tedarik sayfaları':'Related glass sourcing pages'}</h2></div><div class="links">{relatedPages.map(x=><a href={`${base}/${x.slug}/`}><strong>{x[lang].title}</strong><span>↗</span></a>)}</div></div></section>
    <section class="section faq"><div class="container"><div class="center head"><h2>{tr?'Sık sorulanlar':'Frequently asked questions'}</h2></div><div class="faqs">{c.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
    <section class="section form" id="rfq"><div class="container"><CommercialRequestForm lang={lang}/></div></section>
  </main>
</BaseLayout>
<style>
.glass-product{background:#f4f1e9;color:#171914}.hero{position:relative;min-height:610px;height:auto;background:#0d110e;color:#f4f5ef;overflow:hidden}.hero-media{position:absolute;inset:0 0 0 42%;z-index:0}.hero-media img{width:100%;height:100%;object-fit:cover;object-position:var(--hero-pos,50% 50%);display:block;transform:scale(var(--hero-scale,1));transform-origin:center;transition:transform .25s ease}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,#0b0e0c 0%,#0b0e0c 36%,rgba(11,14,12,.92) 48%,rgba(11,14,12,.25) 74%,rgba(11,14,12,.08) 100%);z-index:1}.hero-content{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1.08fr) minmax(300px,.52fr);gap:clamp(1.25rem,2.7vw,2.8rem);align-items:center;min-height:610px;padding-top:1rem;padding-bottom:1rem}.hero-copy{max-width:780px}.hero h1{color:#f4f5ef!important;font-size:clamp(2.15rem,3.15vw,3.55rem);line-height:.94;margin:.4rem 0 .55rem;letter-spacing:-.04em;max-width:14.5ch;text-wrap:balance}.hero-lead{font-size:clamp(.92rem,1.05vw,1.05rem);line-height:1.45;color:#eef1eb!important;max-width:690px;margin:.55rem 0}.partner-note{font-size:.76rem;line-height:1.42;color:#bfc7c0!important;border-left:2px solid #c7ff38;padding-left:.8rem;max-width:690px;margin:.55rem 0}.hero-actions{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.7rem}.hero-actions .button{padding:11px 18px!important;min-height:42px!important;font-size:.78rem!important}.button.ghost{background:#f3f4ef!important;color:#101410!important;border-color:#f3f4ef!important}.trust-panel{background:rgba(8,24,20,.88);border:1px solid rgba(199,255,56,.18);backdrop-filter:blur(16px);padding:.62rem .9rem;border-radius:18px;box-shadow:0 25px 65px rgba(0,0,0,.28)}.trust-item{display:grid;grid-template-columns:18px 1fr;gap:.7rem;padding:.58rem 0;border-bottom:1px solid rgba(255,255,255,.1)}.trust-item:last-child{border-bottom:0}.trust-icon{width:12px;height:12px;border-radius:50%;display:block;background:#c7ff38;box-shadow:0 0 0 6