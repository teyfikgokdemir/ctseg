---
import { contactCopy, whatsappHref, type ContactLocale } from '../data/contact-experience';
const { lang } = Astro.props as { lang:ContactLocale };
const copy = contactCopy[lang];
---
<nav class="floating-actions" aria-label={copy.floatingLabel} data-floating-actions>
  <a class="floating-action floating-whatsapp" href={whatsappHref(lang)} target="_blank" rel="noopener noreferrer" aria-label={copy.whatsapp} data-floating-whatsapp><span aria-hidden="true">WA</span></a>
  <button class="floating-action back-to-top" type="button" aria-label={copy.backToTop} aria-hidden="true" tabindex="-1" data-back-to-top><span aria-hidden="true">↑</span></button>
</nav>
<script>
  (()=>{
    document.querySelectorAll('[data-floating-actions]').forEach((actions)=>{
      if(actions.dataset.enhanced)return;actions.dataset.enhanced='true';
      const top=actions.querySelector('[data-back-to-top]');
      const reduced=matchMedia('(prefers-reduced-motion: reduce)');
      const update=()=>{const visible=scrollY>480;top.classList.toggle('visible',visible);top.setAttribute('aria-hidden',String(!visible));top.tabIndex=visible?0:-1};
      update();addEventListener('scroll',update,{passive:true});
      top.addEventListener('click',()=>scrollTo({top:0,behavior:reduced.matches?'auto':'smooth'}));
      const cookie=document.querySelector('[data-cookie-consent],.fa-cookie');
      const offset=()=>{const visible=cookie&&!cookie.hidden;actions.style.setProperty('--floating-cookie-offset',visible?`${cookie.getBoundingClientRect().height+24}px`:'0px')};
      offset();if(cookie)new MutationObserver(offset).observe(cookie,{attributes:true,attributeFilter:['hidden']});addEventListener('resize',offset,{passive:true});
    });
  })();
</script>
