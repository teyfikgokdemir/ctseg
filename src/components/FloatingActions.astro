---
import { contactCopy, whatsappHref, type ContactLocale } from '../data/contact-experience';
const { lang } = Astro.props as { lang:ContactLocale };
const copy = contactCopy[lang];
---
<nav class="floating-actions" aria-label={copy.floatingLabel} data-floating-actions>
  <button class="floating-action back-to-top" type="button" aria-label={copy.backToTop} aria-hidden="true" tabindex="-1" data-back-to-top>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5m0 0-6 6m6-6 6 6"/></svg>
  </button>
  <a class="floating-action floating-whatsapp" href={whatsappHref(lang)} target="_blank" rel="noopener noreferrer" aria-label={copy.whatsapp} data-floating-whatsapp>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.7A8.5 8.5 0 1 1 20.5 11.7Z"/>
      <path d="M8.2 7.8c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .5.4l.8 1.9c.1.3.1.5-.1.7l-.6.7c-.2.2-.2.4 0 .7.6 1.1 1.5 2 2.6 2.6.3.2.5.2.7 0l.8-1c.2-.2.4-.3.7-.2l1.9.9c.3.1.4.3.4.5 0 .2-.1 1.1-.7 1.7-.5.6-1.3.9-2.1.9-1 0-2.8-.4-4.8-2.2-2.4-2.1-3.1-4.4-3.1-5.5 0-.7.2-1.2.4-1.6Z"/>
    </svg>
  </a>
</nav>

<style is:global>
  .floating-actions{--floating-cookie-offset:0px;position:fixed!important;inset-inline-end:max(24px,env(safe-area-inset-right))!important;inset-inline-start:auto!important;bottom:calc(24px + env(safe-area-inset-bottom) + var(--floating-cookie-offset))!important;display:flex!important;flex-direction:column!important;align-items:center;gap:8px;z-index:45;pointer-events:none;transition:bottom .2s ease}
  .floating-actions .floating-action{width:48px!important;height:48px!important;min-width:48px;min-height:48px;display:grid!important;place-items:center;padding:0!important;border:1px solid rgba(242,239,231,.25)!important;border-radius:999px!important;background:#272923!important;color:#f2efe7!important;box-shadow:0 5px 14px rgba(34,35,31,.16)!important;cursor:pointer;pointer-events:auto;transition:transform .18s ease,background .18s ease,border-color .18s ease,opacity .18s ease}
  .floating-actions .floating-action:hover{transform:translateY(-1px);background:#34372f!important;border-color:#a95638!important}
  .floating-actions .floating-action:focus-visible{outline:3px solid #a95638;outline-offset:3px}
  .floating-actions .floating-whatsapp{background:#25d366!important;border-color:#20b858!important;color:#fff!important;box-shadow:0 5px 14px rgba(34,35,31,.18)!important}
  .floating-actions .floating-whatsapp:hover{background:#20c45e!important;border-color:#1aa34d!important}
  .floating-actions svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .floating-actions .floating-whatsapp svg path:first-child{fill:currentColor;fill-opacity:.1}
  .floating-actions .back-to-top{opacity:0;visibility:hidden;transform:translateY(6px);pointer-events:none}
  .floating-actions .back-to-top.visible{opacity:1;visibility:visible;transform:none;pointer-events:auto}

  .fa-trade-video{padding:72px 0;border-top:1px solid #d3cec1;background:#e8e3d8;color:#22231f}
  .fa-trade-video__inner{width:min(1220px,calc(100% - 48px));margin-inline:auto}
  .fa-trade-video__head{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.65fr);gap:48px;align-items:end;margin-bottom:30px}
  .fa-trade-video__head h2{margin:0;font-size:clamp(2.1rem,3.5vw,3.45rem);line-height:1.25}
  .fa-trade-video__head p{margin:0;color:#52544d}
  .fa-trade-video video{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;background:#272923;border:1px solid #c7c1b5}

  @media(max-width:820px){
    .floating-actions{inset-inline-end:max(16px,env(safe-area-inset-right))!important;bottom:calc(16px + env(safe-area-inset-bottom) + var(--floating-cookie-offset))!important;gap:7px}
    .floating-actions .floating-action{width:46px!important;height:46px!important;min-width:46px;min-height:46px}
    .floating-actions svg{width:20px;height:20px}
    body.fa-menu-open .floating-actions{display:none!important}
    body.fa-menu-open .fa-cookie{display:none!important}

    .fa-header{position:sticky!important;top:0!important;z-index:120!important;backdrop-filter:none!important}
    .fa-menu-backdrop[data-fa-mobile-portal]{position:fixed!important;z-index:118!important;inset:72px 0 0!important;display:block;background:rgba(5,7,11,.82)!important;backdrop-filter:blur(3px)}
    .fa-menu-backdrop[data-fa-mobile-portal][hidden]{display:none!important}
    .fa-nav[data-fa-mobile-portal]{position:fixed!important;z-index:119!important;top:72px!important;right:0!important;left:auto!important;bottom:0!important;width:min(88vw,390px)!important;height:calc(100dvh - 72px)!important;max-height:none!important;display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:0!important;overflow-x:hidden!important;overflow-y:auto!important;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;background:#272923!important;box-shadow:-18px 0 50px rgba(0,0,0,.42)!important;transform:translate3d(105%,0,0)!important;opacity:0!important;visibility:hidden!important;pointer-events:none!important;padding:16px 20px calc(28px + env(safe-area-inset-bottom))!important;transition:transform .24s ease,opacity .18s ease,visibility .18s ease!important}
    .fa-nav[data-fa-mobile-portal].open{transform:translate3d(0,0,0)!important;opacity:1!important;visibility:visible!important;pointer-events:auto!important}
    .fa-nav[data-fa-mobile-portal] .fa-nav-section,.fa-nav[data-fa-mobile-portal] .fa-desktop-cta{display:none!important}
    .fa-mobile-nav-links{display:grid!important}
    .fa-mobile-nav-links a{display:flex!important;min-height:54px!important;align-items:center!important;border-bottom:1px solid rgba(255,255,255,.13)!important;color:#f2efe7!important;font-size:1rem!important;font-weight:700!important}
    .fa-language{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:8px!important;width:100%!important;margin-top:18px!important;padding:18px 0 0!important;border-top:1px solid rgba(255,255,255,.13)!important;border-inline-start:0!important}
    .fa-language a{min-width:0!important;min-height:42px!important;border:1px solid rgba(255,255,255,.2)!important;color:#f2efe7!important}
    .fa-mobile-nav-cta{display:inline-flex!important;width:100%!important;margin-top:14px!important}
    .fa-menu-toggle{position:relative!important;z-index:121!important;width:42px!important;height:42px!important;padding:9px!important}
    .fa-brand img{width:126px!important}

    .fa-trade-video{padding:58px 0}
    .fa-trade-video__inner{width:min(1220px,calc(100% - 34px))}
    .fa-trade-video__head{grid-template-columns:1fr;gap:14px}
  }
  @media(max-width:560px){.fa-trade-video__inner{width:min(1220px,calc(100% - 26px))}.fa-trade-video__head h2{font-size:clamp(1.95rem,9vw,2.5rem)}}
  @media(prefers-reduced-motion:reduce){.floating-actions,.floating-actions .floating-action,.fa-nav[data-fa-mobile-portal]{transition:none!important}}
</style>

<script>
  (()=>{
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');

    document.querySelectorAll('[data-floating-actions]').forEach((actions)=>{
      if(actions.dataset.enhanced)return;
      actions.dataset.enhanced='true';
      const top=actions.querySelector('[data-back-to-top]');
      if(!(top instanceof HTMLButtonElement))return;
      const update=()=>{
        const visible=scrollY>180;
        top.classList.toggle('visible',visible);
        top.setAttribute('aria-hidden',String(!visible));
        top.tabIndex=visible?0:-1;
      };
      update();
      addEventListener('scroll',update,{passive:true});
      top.addEventListener('click',()=>scrollTo({top:0,behavior:reduced.matches?'auto':'smooth'}));
      const cookie=document.querySelector('[data-cookie-consent],.fa-cookie');
      const updateCookieOffset=()=>{
        const visible=cookie instanceof HTMLElement&&!cookie.hidden&&!document.body.classList.contains('fa-menu-open');
        actions.style.setProperty('--floating-cookie-offset',visible?`${cookie.getBoundingClientRect().height+16}px`:'0px');
      };
      updateCookieOffset();
      if(cookie)new MutationObserver(updateCookieOffset).observe(cookie,{attributes:true,attributeFilter:['hidden','class']});
      new MutationObserver(updateCookieOffset).observe(document.body,{attributes:true,attributeFilter:['class']});
      addEventListener('resize',updateCookieOffset,{passive:true});
    });

    if(document.documentElement.lang!=='fa')return;

    const nav=document.querySelector('[data-fa-primary-nav]');
    const backdrop=document.querySelector('[data-fa-menu-backdrop]');
    const headerInner=document.querySelector('.fa-header-inner');
    const navAnchor=document.createComment('fa-nav-anchor');
    const backdropAnchor=document.createComment('fa-backdrop-anchor');
    if(nav?.parentNode)nav.parentNode.insertBefore(navAnchor,nav);
    if(backdrop?.parentNode)backdrop.parentNode.insertBefore(backdropAnchor,backdrop);
    const mobile=matchMedia('(max-width: 820px)');
    const portalMobileMenu=()=>{
      if(!(nav instanceof HTMLElement)||!(backdrop instanceof HTMLElement))return;
      if(mobile.matches){
        if(backdrop.parentElement!==document.body)document.body.append(backdrop);
        if(nav.parentElement!==document.body)document.body.append(nav);
        nav.dataset.faMobilePortal='';
        backdrop.dataset.faMobilePortal='';
      }else{
        if(backdropAnchor.parentNode)backdropAnchor.parentNode.insertBefore(backdrop,backdropAnchor.nextSibling);
        else if(headerInner instanceof HTMLElement)headerInner.append(backdrop);
        if(navAnchor.parentNode)navAnchor.parentNode.insertBefore(nav,navAnchor.nextSibling);
        else if(headerInner instanceof HTMLElement)headerInner.append(nav);
        nav.removeAttribute('data-fa-mobile-portal');
        backdrop.removeAttribute('data-fa-mobile-portal');
      }
    };
    portalMobileMenu();
    mobile.addEventListener?.('change',portalMobileMenu);

    if(!document.querySelector('[data-fa-trade-video]')){
      const process=document.querySelector('#process');
      if(process){
        const section=document.createElement('section');
        section.className='fa-trade-video';
        section.dataset.faTradeVideo='';
        section.setAttribute('aria-labelledby','fa-trade-video-title');
        section.innerHTML=`<div class="fa-trade-video__inner"><div class="fa-trade-video__head"><div><p class="fa-section-kicker">هماهنگی تجاری در عمل</p><h2 id="fa-trade-video-title">از ارزیابی محصول تا هماهنگی تجاری</h2></div><p>نمونه‌ای تصویری از بررسی محصول، کنترل کیفیت، ارزیابی اسناد و هماهنگی مسیر تجاری.</p></div><video autoplay muted loop playsinline preload="metadata" poster="/videos/ctseg-trade-coordination-poster.jpg" aria-label="فرایند ارزیابی و هماهنگی تجاری CTSEG" controlslist="nodownload noplaybackrate" disablepictureinpicture><source src="/videos/ctseg-trade-coordination-1080p.mp4" type="video/mp4"><source src="/videos/ctseg-trade-coordination-1080p.webm" type="video/webm"></video></div>`;
        process.insertAdjacentElement('afterend',section);
        const video=section.querySelector('video');
        if(video instanceof HTMLVideoElement){
          video.muted=true;
          video.defaultMuted=true;
          const attemptPlay=()=>{
            if(reduced.matches){video.pause();video.removeAttribute('autoplay');return}
            video.autoplay=true;
            video.play().then(()=>video.removeAttribute('controls')).catch(()=>video.setAttribute('controls',''));
          };
          attemptPlay();
          video.addEventListener('loadedmetadata',attemptPlay,{once:true});
          document.addEventListener('visibilitychange',()=>{if(document.hidden)video.pause();else attemptPlay()});
          reduced.addEventListener?.('change',attemptPlay);
        }
      }
    }
  })();
</script>
