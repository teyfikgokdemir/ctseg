---
import BaseLayout from '../layouts/BaseLayout.astro';
const {lang='tr',title,description,canonical,alternate,eyebrow,h1,lead,productName,origin='İran',applications=[],formats=[],quality=[],logistics=[],faqs=[],cta='Teklif ve numune talep edin',ctaText='Tedarik ihtiyacınızı, hedef ülkeyi, tahmini miktarı ve teslim noktasını paylaşın.',related=[]}=Astro.props;
const productSchema={'@context':'https://schema.org','@type':'Product','@id':canonical+'#product',name:productName,description,category:'Nuts and dried fruits',countryOfOrigin:{'@type':'Country',name:origin},brand:{'@type':'Brand',name:'CTSEG Sourcing'},manufacturer:{'@type':'Organization','@id':'https://ctseg.com.tr/#organization'}};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage','@id':canonical+'#faq',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const webSchema={'@context':'https://schema.org','@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,inLanguage:lang,about:{'@id':canonical+'#product'},isPartOf:{'@id':'https://ctseg.com.tr/#website'}};
---
<BaseLayout {lang} {title} {description} {canonical} {alternate} schema={[webSchema,productSchema,faqSchema]}>
<header class="trade-nav"><a href={lang==='tr'?'/':'/'+lang+'/'} class="trade-brand">CTSEG</a><nav><a href="#urun">{lang==='it'?'Prodotto':lang==='de'?'Produkt':lang==='en'?'Product':'Ürün'}</a><a href="#kalite">{lang==='it'?'Qualità':lang==='de'?'Qualität':lang==='en'?'Quality':'Kalite'}</a><a href="#sss">FAQ</a><a class="trade-button" href="mailto:info@ctseg.com.tr">{lang==='it'?'Richiedi offerta':lang==='de'?'Angebot anfordern':lang==='en'?'Request quote':'Teklif iste'}</a></nav></header>
<main>
<section class="trade-hero"><div class="trade-wrap"><p class="trade-eyebrow">{eyebrow}</p><h1>{h1}</h1><p class="trade-lead">{lead}</p><div class="trade-actions"><a class="trade-button" href="mailto:info@ctseg.com.tr">{cta}</a><a class="trade-link" href="#urun">{lang==='it'?'Dettagli prodotto':lang==='de'?'Produktdetails':lang==='en'?'Product details':'Ürün detayları'} ↓</a></div><div class="trade-signals"><span>B2B</span><span>{origin}</span><span>Türkiye & Europe</span><span>Batch-based verification</span></div></div></section>
<section id="urun" class="trade-section"><div class="trade-wrap"><div class="trade-heading"><p class="trade-eyebrow">{productName}</p><h2>{lang==='it'?'Applicazioni e formati':lang==='de'?'Anwendungen und Formate':lang==='en'?'Applications and formats':'Kullanım alanları ve ürün formları'}</h2></div><div class="trade-grid"><article><h3>{lang==='it'?'Applicazioni':lang==='de'?'Anwendungen':lang==='en'?'Applications':'Kullanım alanları'}</h3><ul>{applications.map(x=><li>{x}</li>)}</ul></article><article><h3>{lang==='it'?'Formati disponibili':lang==='de'?'Verfügbare Formen':lang==='en'?'Available formats':'Mevcut ürün formları'}</h3><ul>{formats.map(x=><li>{x}</li>)}</ul></article></div></div></section>
<section id="kalite" class="trade-section trade-dark"><div class="trade-wrap"><div class="trade-heading"><p class="trade-eyebrow">Quality & Compliance</p><h2>{lang==='it'?'Qualità verificabile, lotto per lotto.':lang==='de'?'Prüfbare Qualität, Charge für Charge.':lang==='en'?'Verifiable quality, batch by batch.':'Parti bazında doğrulanabilir kalite.'}</h2></div><div class="trade-grid"><article><h3>{lang==='it'?'Criteri di qualità':lang==='de'?'Qualitätskriterien':lang==='en'?'Quality criteria':'Kalite kriterleri'}</h3><ul>{quality.map(x=><li>{x}</li>)}</ul></article><article><h3>{lang==='it'?'Consegna e logistica':lang==='de'?'Lieferung und Logistik':lang==='en'?'Delivery and logistics':'Teslimat ve lojistik'}</h3><ul>{logistics.map(x=><li>{x}</li>)}</ul></article></div><div class="trade-note">{lang==='it'?'Specifiche, disponibilità, raccolto, confezione e condizioni di consegna vengono confermate per produttore e lotto.':lang==='de'?'Spezifikationen, Verfügbarkeit, Erntejahr, Verpackung und Lieferbedingungen werden je Hersteller und Charge bestätigt.':lang==='en'?'Specifications, availability, crop year, packaging and delivery terms are confirmed by producer and batch.':'Spesifikasyon, bulunabilirlik, hasat yılı, ambalaj ve teslim koşulları üretici ve parti bazında teyit edilir.'}</div></div></section>
<section id="sss" class="trade-section"><div class="trade-wrap"><div class="trade-heading"><p class="trade-eyebrow">FAQ</p><h2>{lang==='it'?'Domande frequenti':lang==='de'?'Häufige Fragen':lang==='en'?'Frequently asked questions':'Sık sorulan sorular'}</h2></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
{related.length>0&&<section class="trade-section trade-related"><div class="trade-wrap"><div class="trade-heading"><p class="trade-eyebrow">CTSEG Trade Intelligence</p><h2>{lang==='it'?'Contenuti correlati':lang==='de'?'Verwandte Inhalte':lang==='en'?'Related pages':'İlgili içerikler'}</h2></div><div class="related-grid">{related.map(([label,url])=><a href={url}>{label}<span>↗</span></a>)}</div></div></section>}
<section class="trade-cta"><div class="trade-wrap"><p class="trade-eyebrow">B2B Sourcing</p><h2>{cta}</h2><p>{ctaText}</p><a class="trade-button" href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div></section>
</main>
<style>
:global(body){background:#070b11;color:#f5f7fa}.trade-wrap{width:min(1160px,calc(100% - 40px));margin:auto}.trade-nav{position:sticky;top:0;z-index:30;display:flex;justify-content:space-between;align-items:center;padding:15px max(20px,calc((100vw - 1160px)/2));border-bottom:1px solid #252d38;background:rgba(7,11,17,.92);backdrop-filter:blur(18px)}.trade-brand{font-weight:900;letter-spacing:.18em}.trade-nav nav{display:flex;align-items:center;gap:22px;font-size:14px}.trade-button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 22px;border-radius:999px;background:#ff3b30;color:#fff!important;font-weight:800}.trade-hero{min-height:78svh;display:grid;align-items:center;padding:110px 0;background:radial-gradient(circle at 82% 12%,rgba(255,59,48,.16),transparent 27rem),linear-gradient(145deg,#070b11,#101923)}.trade-eyebrow{margin:0 0 18px;color:#ff8f86;font-size:12px;font-weight:850;letter-spacing:.16em;text-transform:uppercase}.trade-hero h1,.trade-heading h2,.trade-cta h2{margin:0;max-width:1000px;font-size:clamp(46px,7vw,92px);line-height:.98;letter-spacing:-.055em}.trade-lead{max-width:820px;margin:30px 0 0;color:#bac4d0;font-size:clamp(18px,2vw,25px);line-height:1.65}.trade-actions{display:flex;gap:18px;align-items:center;margin-top:34px}.trade-link{color:#dbe2ea;font-weight:750}.trade-signals{display:flex;flex-wrap:wrap;gap:10px;margin-top:45px}.trade-signals span{padding:8px 12px;border:1px solid #313b49;border-radius:999px;color:#aeb8c5;font-size:12px}.trade-section{padding:100px 0;border-top:1px solid #222a34}.trade-dark{background:#0b121b}.trade-heading{max-width:930px;margin-bottom:38px}.trade-heading h2,.trade-cta h2{font-size:clamp(38px,5vw,68px)}.trade-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.trade-grid article{padding:30px;border:1px solid #2c3541;border-radius:24px;background:linear-gradient(145deg,rgba(255,255,255,.04),rgba(255,255,255,.015))}.trade-grid h3{margin:0 0 18px;font-size:25px}.trade-grid ul{margin:0;padding:0;list-style:none;display:grid;gap:10px}.trade-grid li{padding:14px 16px;border:1px solid #29323e;border-radius:14px;color:#d8dee6;background:#0d141d}.trade-note{margin-top:22px;padding:20px 22px;border-left:3px solid #ff3b30;background:rgba(255,59,48,.06);color:#c7d0db}.faq-list{display:grid;gap:12px}.faq-list details{padding:20px 22px;border:1px solid #2c3541;border-radius:18px;background:#0d141d}.faq-list summary{cursor:pointer;font-weight:800}.faq-list p{color:#b8c2ce;line-height:1.7}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.related-grid a{display:flex;justify-content:space-between;padding:22px;border:1px solid #2c3541;border-radius:18px;background:#0d141d;font-weight:800}.trade-cta{padding:110px 0;text-align:center;background:radial-gradient(circle at 50% 10%,rgba(255,59,48,.16),transparent 28rem)}.trade-cta h2,.trade-cta p{margin-inline:auto}.trade-cta p{max-width:700px;color:#bac4d0;font-size:18px}.trade-cta .trade-button{margin-top:22px}@media(max-width:800px){.trade-nav nav a:not(.trade-button){display:none}.trade-hero{min-height:auto;padding:90px 0}.trade-grid,.related-grid{grid-template-columns:1fr}.trade-section{padding:72px 0}.trade-actions{align-items:flex-start;flex-direction:column}.trade-wrap{width:min(1160px,calc(100% - 24px))}}
</style>
</BaseLayout>