---
import BaseLayout from '../layouts/BaseLayout.astro';
const {lang='tr',title,description,canonical,alternate,eyebrow,h1,lead,productName,origin,applications=[],formats=[],quality=[],logistics=[],faqs=[],cta='Teklif ve numune talep edin',ctaText='Tedarik ihtiyacınızı, hedef ülkeyi, tahmini miktarı ve teslim noktasını paylaşın.',related=[]}=Astro.props;
const originName=origin ?? (lang==='tr'?'İran':'Iran');
const productSchema={'@context':'https://schema.org','@type':'Product','@id':canonical+'#product',name:productName,description,category:'Nuts and dried fruits',countryOfOrigin:{'@type':'Country',name:originName},brand:{'@type':'Brand',name:'CTSEG Sourcing'},manufacturer:{'@type':'Organization','@id':'https://ctseg.com.tr/#organization'}};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage','@id':canonical+'#faq',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const webSchema={'@context':'https://schema.org','@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,inLanguage:lang,about:{'@id':canonical+'#product'},isPartOf:{'@id':'https://ctseg.com.tr/#website'}};
const labels={tr:{product:'Ürün',quality:'Kalite',quote:'Teklif iste',details:'Ürün detayları',applications:'Kullanım alanları ve ürün formları',uses:'Kullanım alanları',forms:'Mevcut ürün formları',qualityTitle:'Parti bazında doğrulanabilir kalite.',criteria:'Kalite kriterleri',delivery:'Teslimat ve lojistik',faq:'Sık sorulan sorular',related:'İlgili içerikler',market:'Türkiye & Avrupa',verification:'Parti bazlı doğrulama',compliance:'Kalite ve Uygunluk',sourcing:'B2B Tedarik'},en:{product:'Product',quality:'Quality',quote:'Request quote',details:'Product details',applications:'Applications and formats',uses:'Applications',forms:'Available formats',qualityTitle:'Verifiable quality, batch by batch.',criteria:'Quality criteria',delivery:'Delivery and logistics',faq:'Frequently asked questions',related:'Related pages',market:'Türkiye & Europe',verification:'Batch-based verification',compliance:'Quality & Compliance',sourcing:'B2B Sourcing'},it:{product:'Prodotto',quality:'Qualità',quote:'Richiedi offerta',details:'Dettagli prodotto',applications:'Applicazioni e formati',uses:'Applicazioni',forms:'Formati disponibili',qualityTitle:'Qualità verificabile, lotto per lotto.',criteria:'Criteri di qualità',delivery:'Consegna e logistica',faq:'Domande frequenti',related:'Contenuti correlati',market:'Turchia & Europa',verification:'Verifica per lotto',compliance:'Qualità e conformità',sourcing:'Approvvigionamento B2B'},de:{product:'Produkt',quality:'Qualität',quote:'Angebot anfordern',details:'Produktdetails',applications:'Anwendungen und Formate',uses:'Anwendungen',forms:'Verfügbare Formen',qualityTitle:'Prüfbare Qualität, Charge für Charge.',criteria:'Qualitätskriterien',delivery:'Lieferung und Logistik',faq:'Häufige Fragen',related:'Verwandte Inhalte',market:'Türkei & Europa',verification:'Chargenbasierte Prüfung',compliance:'Qualität & Konformität',sourcing:'B2B-Beschaffung'}};
const l=labels[lang] ?? labels.en;
const note=lang==='it'?'Specifiche, disponibilità, raccolto, confezione e condizioni di consegna vengono confermate per produttore e lotto.':lang==='de'?'Spezifikationen, Verfügbarkeit, Erntejahr, Verpackung und Lieferbedingungen werden je Hersteller und Charge bestätigt.':lang==='en'?'Specifications, availability, crop year, packaging and delivery terms are confirmed by producer and batch.':'Spesifikasyon, bulunabilirlik, hasat yılı, ambalaj ve teslim koşulları üretici ve parti bazında teyit edilir.';
---
<BaseLayout {lang} {title} {description} {canonical} {alternate} schema={[webSchema,productSchema,faqSchema]}>
<div class:list={['trade-page',`theme-${lang}`]}>
<header class="trade-nav"><a href={lang==='tr'?'/':'/'+lang+'/'} class="trade-brand">CTSEG</a><nav><a href="#urun">{l.product}</a><a href="#kalite">{l.quality}</a><a href="#sss">FAQ</a><a class="trade-button" href="mailto:info@ctseg.com.tr">{l.quote}</a></nav></header>
<main>
<section class="trade-hero"><div class="flag-line" aria-hidden="true"><span></span><span></span><span></span></div><div class="trade-wrap"><p class="trade-eyebrow">{eyebrow}</p><h1>{h1}</h1><p class="trade-lead">{lead}</p><div class="trade-actions"><a class="trade-button" href="mailto:info@ctseg.com.tr">{cta}</a><a class="trade-link" href="#urun">{l.details} ↓</a></div><div class="trade-signals"><span>B2B</span><span>{originName}</span><span>{l.market}</span><span>{l.verification}</span></div></div></section>
<section id="urun" class="trade-section"><div class="trade-wrap"><div class="trade-heading"><p class="trade-eyebrow">{productName}</p><h2>{l.applications}</h2></div><div class="trade-grid"><article><h3>{l.uses}</h3><ul>{applications.map(x=><li>{x}</li>)}</ul></article><article><h3>{l.forms}</h3><ul>{formats.map(x=><li>{x}</li>)}</ul></article></div></div></section>
<section id="kalite" class="trade-section trade-dark"><div class="trade-wrap"><div class="trade-heading"><p class="trade-eyebrow">{l.compliance}</p><h2>{l.qualityTitle}</h2></div><div class="trade-grid"><article><h3>{l.criteria}</h3><ul>{quality.map(x=><li>{x}</li>)}</ul></article><article><h3>{l.delivery}</h3><ul>{logistics.map(x=><li>{x}</li>)}</ul></article></div><div class="trade-note">{note}</div></div></section>
<section id="sss" class="trade-section"><div class="trade-wrap"><div class="trade-heading"><p class="trade-eyebrow">FAQ</p><h2>{l.faq}</h2></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
{related.length>0&&<section class="trade-section trade-related"><div class="trade-wrap"><div class="trade-heading"><p class="trade-eyebrow">CTSEG Trade Intelligence</p><h2>{l.related}</h2></div><div class="related-grid">{related.map(([label,url])=><a href={url}>{label}<span>↗</span></a>)}</div></div></section>}
<section class="trade-cta"><div class="trade-wrap"><p class="trade-eyebrow">{l.sourcing}</p><h2>{cta}</h2><p>{ctaText}</p><a class="trade-button" href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div></section>
</main>
</div>
<style>
.trade-page{--accent:#ef3b32;--accent2:#ff968f;--heroGlow:rgba(239,59,50,.18);--surface:#0d141d;--surface2:#0a1119;--line:#2b3541;--flag1:#e30a17;--flag2:#fff;--flag3:#e30a17;background:#070b11;color:#f5f7fa}.theme-it{--accent:#1f9d68;--accent2:#8fe0bc;--heroGlow:rgba(31,157,104,.22);--flag1:#169b62;--flag2:#f7f3ea;--flag3:#ce2b37}.theme-de{--accent:#d5a928;--accent2:#f5d76d;--heroGlow:rgba(213,169,40,.2);--flag1:#151515;--flag2:#d71920;--flag3:#ffce00}.theme-en{--accent:#d7b56d;--accent2:#f3d99a;--heroGlow:rgba(215,181,109,.2);--flag1:#163c73;--flag2:#f7f7f7;--flag3:#b31942}.trade-wrap{width:min(1160px,calc(100% - 40px));margin:auto}.trade-nav{position:sticky;top:0;z-index:30;display:flex;justify-content:space-between;align-items:center;padding:15px max(20px,calc((100vw - 1160px)/2));border-bottom:1px solid var(--line);background:rgba(7,11,17,.92);backdrop-filter:blur(18px)}.trade-brand{font-weight:900;letter-spacing:.18em}.trade-nav nav{display:flex;align-items:center;gap:22px;font-size:14px}.trade-button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 22px;border-radius:999px;background:var(--accent);color:#fff!important;font-weight:800}.theme-de .trade-button{color:#111!important}.trade-hero{position:relative;min-height:76svh;display:grid;align-items:center;padding:110px 0;background:radial-gradient(circle at 82% 12%,var(--heroGlow),transparent 28rem),linear-gradient(145deg,#070b11,#101923)}.flag-line{position:absolute;inset:0 0 auto;height:4px;display:grid;grid-template-columns:repeat(3,1fr)}.flag-line span:nth-child(1){background:var(--flag1)}.flag-line span:nth-child(2){background:var(--flag2)}.flag-line span:nth-child(3){background:var(--flag3)}.trade-eyebrow{margin:0 0 18px;color:var(--accent2);font-size:12px;font-weight:850;letter-spacing:.16em;text-transform:uppercase}.trade-hero h1,.trade-heading h2,.trade-cta h2{margin:0;max-width:1000px;font-size:clamp(46px,7vw,92px);line-height:.98;letter-spacing:-.055em}.trade-lead{max-width:820px;margin:30px 0 0;color:#bac4d0;font-size:clamp(18px,2vw,25px);line-height:1.65}.trade-actions{display:flex;gap:18px;align-items:center;margin-top:34px}.trade-link{color:#dbe2ea;font-weight:750}.trade-signals{display:flex;flex-wrap:wrap;gap:10px;margin-top:45px}.trade-signals span{padding:8px 12px;border:1px solid var(--line);border-radius:999px;color:#aeb8c5;font-size:12px}.trade-section{padding:100px 0;border-top:1px solid #222a34}.trade-dark{background:var(--surface2)}.trade-heading{max-width:930px;margin-bottom:38px}.trade-heading h2,.trade-cta h2{font-size:clamp(38px,5vw,68px)}.trade-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.trade-grid article{padding:30px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(145deg,rgba(255,255,255,.04),rgba(255,255,255,.015))}.trade-grid h3{margin:0 0 18px;font-size:25px}.trade-grid ul{margin:0;padding:0;list-style:none;display:grid;gap:10px}.trade-grid li{padding:14px 16px;border:1px solid var(--line);border-radius:14px;color:#d8dee6;background:var(--surface)}.trade-note{margin-top:22px;padding:20px 22px;border-left:3px solid var(--accent);background:color-mix(in srgb,var(--accent) 8%,transparent);color:#c7d0db}.faq-list{display:grid;gap:12px}.faq-list details{padding:20px 22px;border:1px solid var(--line);border-radius:18px;background:var(--surface)}.faq-list summary{cursor:pointer;font-weight:800}.faq-list p{color:#b8c2ce;line-height:1.7}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.related-grid a{display:flex;justify-content:space-between;padding:22px;border:1px solid var(--line);border-radius:18px;background:var(--surface);font-weight:800}.trade-cta{padding:110px 0;text-align:center;background:radial-gradient(circle at 50% 10%,var(--heroGlow),transparent 28rem)}.trade-cta h2,.trade-cta p{margin-inline:auto}.trade-cta p{max-width:700px;color:#bac4d0;font-size:18px}.trade-cta .trade-button{margin-top:22px}@media(max-width:800px){.trade-nav nav a:not(.trade-button){display:none}.trade-hero{min-height:auto;padding:90px 0}.trade-grid,.related-grid{grid-template-columns:1fr}.trade-section{padding:72px 0}.trade-actions{align-items:flex-start;flex-direction:column}.trade-wrap{width:min(1160px,calc(100% - 24px))}}
</style>
</BaseLayout>
