---
const { title, steps } = Astro.props as { title?:string; steps:string[] };
const segment = Astro.url.pathname.split('/').filter(Boolean)[0] || 'tr';
const locale = ['tr','en','de','it','ru','fa','zh','vi'].includes(segment) ? segment : 'tr';
const kicker = ({tr:'CTSEG · TİCARİ AKIŞ',en:'CTSEG · TRADE FLOW',de:'CTSEG · HANDELSABLAUF',it:'CTSEG · FLUSSO COMMERCIALE',ru:'CTSEG · ТОРГОВЫЙ ПРОЦЕСС',fa:'CTSEG · جریان تجاری',zh:'CTSEG · 商务执行',vi:'CTSEG · LUỒNG THƯƠNG MẠI'} as Record<string,string>)[locale];
const sequenceLabel = ({tr:'Talebin doğrulanmasından ticari koordinasyona uzanan uygulama hattı',en:'The execution path from requirement validation to commercial coordination',de:'Der Ausführungspfad von der Bedarfsprüfung bis zur kommerziellen Koordination',it:'Il percorso operativo dalla validazione del requisito al coordinamento commerciale',ru:'Путь от проверки запроса до коммерческой координации',fa:'مسیر اجرا از اعتبارسنجی نیاز تا هماهنگی تجاری',zh:'从需求核验到商务协同的标准执行路径',vi:'Lộ trình từ xác thực yêu cầu đến điều phối thương mại'} as Record<string,string>)[locale];
const statusLabel = ({tr:'Kontrollü ilerleme',en:'Controlled progression',de:'Kontrollierter Ablauf',it:'Avanzamento controllato',ru:'Контролируемое выполнение',fa:'پیشروی کنترل‌شده',zh:'全流程节点管控',vi:'Tiến trình có kiểm soát'} as Record<string,string>)[locale];
---
<section class="process-section section" data-process-locale={locale}>
  <div class="container process-shell">
    <div class="process-heading">
      <span class="process-kicker">{kicker}</span>
      {title && <h2 class="section-title">{title}</h2>}
      <p class="process-caption">{sequenceLabel}</p>
      <div class="process-status" aria-hidden="true">
        <span></span>
        <small>{statusLabel}</small>
      </div>
    </div>
    <ol class="process-rail" aria-label={sequenceLabel}>
      {steps.map((step) => (
        <li>
          <strong>{step}</strong>
          <span class="process-arrow" aria-hidden="true">↗</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-section{position:relative;overflow:hidden;background:#111!important;color:#fff!important;border-block:1px solid rgba(255,255,255,.09)}
  .process-section::before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(118deg,rgba(196,240,0,.035),transparent 34%),radial-gradient(circle at 84% 16%,rgba(255,255,255,.045),transparent 24%)}
  .process-shell{position:relative;z-index:1;display:grid;grid-template-columns:minmax(300px,.72fr) minmax(560px,1.28fr);gap:clamp(52px,7vw,120px);align-items:start}
  .process-heading{position:sticky;top:118px;max-width:520px;padding-top:4px}
  .process-kicker{display:inline-flex;align-items:center;gap:10px;margin-bottom:24px;color:#c4f000;font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
  .process-kicker::before{content:"";width:32px;height:2px;background:#c4f000}
  .process-heading .section-title{margin:0;max-width:10ch;color:#fff!important;font-family:'DM Sans',system-ui,sans-serif!important;font-size:clamp(44px,4.25vw,70px)!important;font-weight:760!important;line-height:.94!important;letter-spacing:-.055em!important;text-wrap:balance}
  .process-caption{max-width:31em;margin:26px 0 0;padding-top:18px;border-top:1px solid rgba(255,255,255,.14);color:#b8b8b1!important;font-size:13px;line-height:1.65;font-weight:540}
  .process-status{display:flex;align-items:center;gap:12px;margin-top:24px;color:#85857d}
  .process-status span{position:relative;width:58px;height:1px;background:rgba(255,255,255,.17)}
  .process-status span::after{content:"";position:absolute;inset-inline-start:0;top:-2px;width:22px;height:5px;border-radius:99px;background:#c4f000}
  .process-status small{font-size:10px;font-weight:760;letter-spacing:.12em;text-transform:uppercase}
  .process-rail{position:relative;margin:0;padding:0;list-style:none;border-top:1px solid rgba(255,255,255,.18)}
    .process-rail li{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 30px;gap:22px;align-items:center;min-height:112px;padding:22px 4px 22px 26px;border-bottom:1px solid rgba(255,255,255,.16);overflow:hidden;transition:padding .28s ease,border-color .28s ease,background .28s ease}
  .process-rail li::before{content:"";position:absolute;left:0;top:50%;width:8px;height:2px;background:#c4f000;transform:translateY(-50%);opacity:.9}.process-rail li:hover,.process-rail li:focus-within{padding-left:32px;padding-right:12px;border-color:rgba(196,240,0,.5);background:linear-gradient(90deg,rgba(196,240,0,.045),transparent 72%)}
  .process-arrow{justify-self:end;color:rgba(255,255,255,.32);font-size:21px;line-height:1;transition:color .25s ease,transform .25s ease}
  .process-rail strong{max-width:31ch;color:#fff!important;font-family:'DM Sans',system-ui,sans-serif;font-size:clamp(21px,1.65vw,29px);font-weight:690;line-height:1.08;letter-spacing:-.035em;text-wrap:balance}
  .process-rail li:hover .process-arrow{color:#c4f000;transform:translate(3px,-3px)}
  :global(html[dir="rtl"]) .process-kicker{letter-spacing:0;text-transform:none}
  :global(html[dir="rtl"]) .process-status small{letter-spacing:0;text-transform:none}
  :global(html[dir="rtl"]) .process-rail strong{text-align:right;max-width:32ch}
  :global(html[dir="rtl"]) .process-rail li:hover .process-arrow{transform:translate(-3px,-3px)}
  @media(max-width:1100px){.process-shell{grid-template-columns:1fr;gap:38px}.process-heading{position:static;max-width:760px}.process-heading .section-title{max-width:15ch}.process-caption{max-width:48em}.process-rail li{min-height:104px}}
  @media(max-width:720px){.process-section{padding-block:60px}.process-heading .section-title{max-width:100%;font-size:clamp(34px,9vw,46px)!important}.process-caption{margin-top:20px}.process-status{margin-top:18px}.process-rail li{grid-template-columns:minmax(0,1fr) 24px;gap:14px;min-height:92px;padding:19px 0 19px 22px}.process-rail li:hover{padding-left:26px;padding-right:7px}.process-rail strong{max-width:100%;font-size:clamp(19px,5.7vw,25px)}.process-arrow{font-size:18px}}
  @media(prefers-reduced-motion:reduce){.process-rail li,.process-arrow{transition:none}}
</style>