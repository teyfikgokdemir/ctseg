---
import { localizedPath, ui, type Locale } from '../data/site';
import { activeLocaleRegistry } from '../data/locales';
import { duzceGlassPath, type DuzceGlassLocale } from '../data/duzce-glass';
import { generatedImageSrc, LOGO_IMAGE } from '../lib/responsive-images';
import { tradePlatformCopy } from '../data/trade-platform';
import { searchLandingPath, type SearchLandingId } from '../data/search-landings';

const { lang, pageKey='home', pageId } = Astro.props as { lang: Locale; pageKey?: string; pageId?: string };
const t = ui[lang] || ui.en;
const home = localizedPath(lang, 'home');
const p = tradePlatformCopy[lang] || tradePlatformCopy.en;
const methodLabel = {tr:'Yöntem',en:'Method',de:'Arbeitsweise',it:'Metodo',fa:'روش کار',ru:'Метод',zh:'运作模式',vi:'Phương thức hoạt động'}[lang] || 'Method';
const glassNavLabels: Record<string, string> = {
  tr:'Düzce Cam', en:'Düzce Float Glass', de:'Düzce Float Glass', it:'Düzce Float Glass',
  fa:'شیشه Düzce', ru:'Düzce Float Glass', zh:'Düzce 浮法玻璃', vi:'Düzce Float Glass'
};
const navigationCopy = {
  tr:{globalTrade:'Küresel Ticaret',industries:'Sektörler',portfolio:'Ticaret Portföyü',intelligence:'Ticaret İçgörüleri',company:'Şirket',main:'ANA MENÜ',quick:'HIZLI ERİŞİM',trade:'TİCARET',intro:'İki yönlü ticaret, stratejik tedarik ve pazara giriş yolları'},
  en:{globalTrade:'Global Trade',industries:'Industries',portfolio:'Trade Portfolio',intelligence:'Trade Intelligence',company:'Company',main:'MAIN MENU',quick:'NAVIGATION',trade:'TRADE',intro:'Two-way trade, strategic sourcing and market-entry paths'},
  de:{globalTrade:'Globaler Handel',industries:'Branchen',portfolio:'Handelsportfolio',intelligence:'Handelswissen',company:'Unternehmen',main:'HAUPTMENÜ',quick:'NAVIGATION',trade:'HANDEL',intro:'Bidirektionaler Handel, strategische Beschaffung und Markteintritt'},
  it:{globalTrade:'Commercio Globale',industries:'Settori',portfolio:'Portafoglio',intelligence:'Intelligence Commerciale',company:'Azienda',main:'MENU PRINCIPALE',quick:'NAVIGAZIONE',trade:'COMMERCIO',intro:'Commercio bidirezionale, sourcing strategico e ingresso nei mercati'},
  ru:{globalTrade:'Глобальная торговля',industries:'Отрасли',portfolio:'Торговый портфель',intelligence:'Торговая аналитика',company:'Компания',main:'ГЛАВНОЕ МЕНЮ',quick:'НАВИГАЦИЯ',trade:'ТОРГОВЛЯ',intro:'Двусторонняя торговля, стратегический сорсинг и выход на рынки'},
  fa:{globalTrade:'تجارت جهانی',industries:'صنایع',portfolio:'سبد تجاری',intelligence:'بینش تجاری',company:'شرکت',main:'منوی اصلی',quick:'دسترسی سریع',trade:'تجارت',intro:'تجارت دوطرفه، تأمین استراتژیک و ورود به بازار'},
  zh:{globalTrade:'全球贸易',industries:'行业',portfolio:'贸易组合',intelligence:'贸易洞察',company:'公司',main:'主菜单',quick:'导航',trade:'贸易',intro:'双向国际贸易、战略采购与市场进入路径'},
  vi:{globalTrade:'Thương mại toàn cầu',industries:'Ngành',portfolio:'Danh mục thương mại',intelligence:'Thông tin thương mại',company:'Công ty',main:'MENU CHÍNH',quick:'ĐIỀU HƯỚNG',trade:'THƯƠNG MẠI',intro:'Thương mại hai chiều, sourcing chiến lược và thâm nhập thị trường'}
}[lang] || {globalTrade:'Global Trade',industries:'Industries',portfolio:'Trade Portfolio',intelligence:'Trade Intelligence',company:'Company',main:'MAIN MENU',quick:'NAVIGATION',trade:'TRADE',intro:'Two-way trade, strategic sourcing and market-entry paths'};

const safeGlassLang = (['en','tr','de','it','ru','fa','zh','vi'].includes(lang) ? lang : 'en') as DuzceGlassLocale;
const glassUrl = duzceGlassPath(safeGlassLang);
const glassLabel = glassNavLabels[lang] || 'Düzce Float Glass';

const focusedCountryLp = pageKey === 'home' && ['de','it','ru','fa','zh','vi'].includes(lang);
const solutionLinks = [
  [t.services, localizedPath(lang,'services')],
  [p.buyerTitle, `${home}#sectors`],
  [p.producerTitle, `${home}#sectors`],
  [methodLabel, localizedPath(lang,'how-we-work')],
  [glassLabel, glassUrl]
];

const nav = [
  ['services', navigationCopy.globalTrade, localizedPath(lang,'services')],
  ['sectors', navigationCopy.industries, `${home}#sectors`],
  ...(!focusedCountryLp ? [['products', navigationCopy.portfolio, localizedPath(lang,'products')]] : []),
  ['insights', navigationCopy.intelligence, localizedPath(lang,'insights')],
  ['about', navigationCopy.company, localizedPath(lang,'about')],
  ['contact', t.contact, localizedPath(lang,'contact')]
];

const globalLocales = [...activeLocaleRegistry.map((entry) => entry.code), 'uk'] as string[];
const globalLocaleNames: Record<string,string> = {...Object.fromEntries(activeLocaleRegistry.map((entry) => [entry.code, entry.label])), uk:'Українська'};
const globalLocaleFlags: Record<string,string> = {tr:'/images/flags/tr.svg',en:'/images/flags/gb.svg',de:'/images/flags/de.svg',it:'/images/flags/it.svg',fa:'/images/flags/ir.svg',ru:'/images/flags/ru.svg',zh:'/images/flags/cn.svg',vi:'/images/flags/vn.svg',uk:'/images/flags/ua.svg'};

const globalSwitchPath = (target: string): string => {
  if (target === 'uk') return '/uk/';
  if (pageKey === 'search-landing' && pageId) return searchLandingPath(target as Locale,pageId as SearchLandingId);
  if (pageKey === 'iran-trade') {
    if (target === 'tr') return '/tr/iran-turkiye-ticaret/';
    if (target === 'en') return '/en/iran-turkiye-europe-trade/';
    if (target === 'fa') return '/fa/';
    return `/${target}/`;
  }
  if (['vietnam-turkiye','china-turkiye','ukraine-turkiye'].includes(pageKey)) return target === 'tr' ? '/' : `/${target}/`;
  if (target === 'fa') return '/fa/';
  if (pageKey === 'glass') {
    const glassLocales = ['en','tr','de','it','ru','fa','zh','vi'] as const;
    if ((glassLocales as readonly string[]).includes(target)) return duzceGlassPath(target as DuzceGlassLocale);
    return `/${target}/`;
  }
  const resolved = localizedPath(target as Locale, pageKey, pageId);
  return resolved?.includes('undefined') ? `/${target}/` : resolved;
};
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={home} aria-label={`CTSEG · ${t.home}`}>
      <img src={generatedImageSrc(LOGO_IMAGE,320)} width="320" height="103" alt="CTSEG" decoding="async" />
    </a>
    <span class="header-house-label" aria-hidden="true">GLOBAL TRADE HOUSE</span>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={t.menu || 'Menu'} data-menu-toggle>
      <span class="sr-only">{t.menu}</span><span></span><span></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary" data-primary-nav>
      <div class="mobile-only-panel">
        <div class="mobile-nav-head">
          <div class="mobile-nav-brand">
            <span class="mobile-nav-title">CTSEG</span>
            <span class="mobile-nav-subtitle">{navigationCopy.main}</span>
          </div>
          <button class="mobile-nav-close" type="button" aria-label="Close menu" data-mobile-close>
            <span aria-hidden="true">✕</span>
          </button>
        </div>

        <div class="mobile-myth-card mobile-myth-card--lang">
          <div class="myth-card-head">
            <span class="myth-card-title">{t.language || 'Language'}</span>
            <span class="myth-card-badge">GLOBAL</span>
          </div>
          <div class="mobile-lang-grid">
            {globalLocales.map((code) => (
              <a
                lang={code}
                hreflang={code}
                class:list={['mobile-lang-item', { active: code === lang }]}
                href={globalSwitchPath(code)}
                aria-current={code === lang ? 'true' : undefined}
                data-locale-option
              >
                <img class="lang-flag" src={globalLocaleFlags[code]} width="28" height="19" alt="" aria-hidden="true" />
                <span class="lang-name">{globalLocaleNames[code]}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="mobile-myth-card mobile-myth-card--trade">
          <div class="myth-card-head">
            <span class="myth-card-title">{navigationCopy.globalTrade}</span>
            <span class="myth-card-badge">{navigationCopy.trade}</span>
          </div>
          <div class="mobile-solutions-grid">
            {solutionLinks.map(([solutionLabel, solutionHref]) => (
              <a href={solutionHref} class="mobile-solution-item">
                <strong class="sol-title">{solutionLabel}</strong><span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>

        <div class="mobile-myth-card">
          <div class="myth-card-head">
            <span class="myth-card-title">{navigationCopy.quick}</span>
            <span class="myth-card-badge">NAV</span>
          </div>
          <div class="mobile-nav-grid">
            {nav.filter(([key]) => key !== 'services').map(([key, label, href]) => (
              <a href={href} class:list={['mobile-nav-item', { active: pageKey === key }]}>
                <strong>{label}</strong><span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="desktop-only-nav">
        <div class="nav-solutions-group" data-solutions-nav-group>
          <button class:list={['nav-solutions-parent',{ active: pageKey === 'services' }]} type="button" aria-expanded="false" aria-controls="solutions-panel" data-solutions-toggle>
            <span>{navigationCopy.globalTrade}</span>
            <span class="desktop-chevron" aria-hidden="true">▾</span>
          </button>
          <div id="solutions-panel" class="nav-solutions-menu" aria-label={navigationCopy.globalTrade} data-solutions-menu>
            <div class="nav-solutions-intro"><strong>CTSEG · {navigationCopy.globalTrade}</strong><span>{navigationCopy.intro}</span></div>
            <div class="desktop-solutions-grid">
              {solutionLinks.map(([solutionLabel, solutionHref]) => <a href={solutionHref} class="desktop-solution-item"><span>{solutionLabel}</span><i aria-hidden="true">↗</i></a>)}
            </div>
          </div>
        </div>

        {nav.filter(([key]) => key !== 'services').map(([key, label, href]) => (
          <a class:list={['desktop-nav-link', { active: pageKey === key }]} href={href}>{label}</a>
        ))}

        <div class="language-switcher language-switcher-desktop">
          <button type="button" aria-expanded="false" aria-controls="language-panel" aria-label={t.language} data-language-toggle>
            <img class="locale-flag" src={globalLocaleFlags[lang] || globalLocaleFlags.en} width="26" height="17" alt="" aria-hidden="true" /><span class="sr-only locale-code">{lang.toUpperCase()}</span>
            <span class="locale-chevron" aria-hidden="true"></span>
          </button>
          <div id="language-panel" class="language-menu" data-language-menu>
            {globalLocales.map((code) => <a
              lang={code}
              hreflang={code}
              class:list={{ active: code === lang }}
              href={globalSwitchPath(code)}
              aria-current={code === lang ? 'true' : undefined}
              data-locale-option
            ><img class="language-menu-flag" src={globalLocaleFlags[code]} width="26" height="17" alt="" aria-hidden="true" /><strong>{globalLocaleNames[code]}</strong><i aria-hidden="true"></i></a>)}
          </div>
        </div>

        <a class="button button-small nav-cta" href={localizedPath(lang, 'contact')}>{t.quote}</a>
      </div>
      {(lang === 'en' || lang === 'fa') && (
        <a class="fa-market-nav-link fa-nav-promo" href="/fa/" data-fa-nav-link data-fa-landing-link>
          <strong>{lang === 'fa' ? 'برای کسب‌وکارهای ایرانی' : 'For Iranian Businesses'}</strong>
          <span>{lang === 'fa' ? 'پشتیبانی تجارت بین‌المللی' : 'Persian landing page'}</span>
        </a>
      )}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const nav = document.querySelector('[data-primary-nav]');
  const closeButton = document.querySelector('[data-mobile-close]');
  const languageToggle = document.querySelector('[data-language-toggle]');
  const languageMenu = document.querySelector('[data-language-menu]');
  const solutionsToggle = document.querySelector('[data-solutions-toggle]');
  const solutionsGroup = document.querySelector('[data-solutions-nav-group]');

  let previousScroll = 0;
  let previousFocus: HTMLElement | null = null;
  const mobileBreakpoint = window.matchMedia('(max-width: 1050px)');

  const syncNavigationAccessibility = () => {
    if (!nav) return;
    const isMobile = mobileBreakpoint.matches;
    const isOpen = nav.classList.contains('open');
    if (isMobile) {
      nav.toggleAttribute('inert', !isOpen);
      nav.setAttribute('aria-hidden', String(!isOpen));
    } else {
      nav.removeAttribute('inert');
      nav.removeAttribute('aria-hidden');
    }
  };

  const focusable = () => nav ? [...nav.querySelectorAll('a[href], button:not([disabled])')].filter(el => !el.closest('[hidden]')) : [];

  syncNavigationAccessibility();

  const closeSolutions = (restoreFocus = false) => {
    solutionsToggle?.setAttribute('aria-expanded', 'false');
    solutionsGroup?.classList.remove('is-open');
    if (restoreFocus) (solutionsToggle as HTMLElement)?.focus();
  };

  const closeNavigation = () => {
    if (!nav || !nav.classList.contains('open')) return;
    toggle?.setAttribute('aria-expanded', 'false');
    nav.classList.remove('open');
    syncNavigationAccessibility();
    closeSolutions();
    setTimeout(() => {
      document.body.classList.remove('menu-open');
      window.scrollTo({ top: previousScroll, behavior: 'instant' });
      if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
    }, 150);
  };

  const openNavigation = () => {
    if (!nav || nav.classList.contains('open')) return;
    previousScroll = window.scrollY;
    previousFocus = document.activeElement as HTMLElement;
    toggle?.setAttribute('aria-expanded', 'true');
    nav.classList.add('open');
    syncNavigationAccessibility();
    document.body.classList.add('menu-open');
    (closeButton as HTMLElement)?.focus();
  };

  const closeLanguageMenu = () => {
    languageToggle?.setAttribute('aria-expanded', 'false');
    languageMenu?.classList.remove('open');
  };

  mobileBreakpoint.addEventListener('change', syncNavigationAccessibility);
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    if (open) closeNavigation();
    else openNavigation();
  });
  closeButton?.addEventListener('click', closeNavigation);
  solutionsToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = solutionsToggle.getAttribute('aria-expanded') === 'true';
    solutionsToggle.setAttribute('aria-expanded', String(!open));
    solutionsGroup?.classList.toggle('is-open', !open);
  });
  languageToggle?.addEventListener('click', () => {
    const open = languageToggle.getAttribute('aria-expanded') === 'true';
    languageToggle.setAttribute('aria-expanded', String(!open));
    languageMenu?.classList.toggle('open', !open);
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNavigation));
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (!document.querySelector('.language-switcher')?.contains(event.target)) closeLanguageMenu();
    if (!document.querySelector('.nav-solutions-group')?.contains(event.target)) closeSolutions();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav?.classList.contains('open')) {
      closeLanguageMenu();
      closeSolutions(true);
      closeNavigation();
    }
    if (event.key === 'Tab' && nav?.classList.contains('open')) {
      const items = focusable();
      if (items.length > 0) {
        const first = items[0] as HTMLElement;
        const last = items[items.length - 1] as HTMLElement;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    }
  });
</script>

<style is:global>
  .header-house-label{display:none;color:#9f9f9a;font-size:9px;font-weight:850;line-height:1;letter-spacing:.15em;white-space:nowrap}
  @media (min-width: 1280px){.header-house-label{display:block;margin-left:10px}}

  @media (min-width: 1051px) {
    .mobile-only-panel,.mobile-nav-head,.mobile-myth-card,.mobile-cta-btn{display:none!important}
    .desktop-only-nav{display:flex!important;align-items:center!important;gap:clamp(12px,1.15vw,20px)!important}
    .desktop-only-nav a,.desktop-nav-link,.nav-solutions-parent,.nav-market-parent{
      color:#fff!important;font-size:clamp(.69rem,.72vw,.78rem)!important;font-weight:750!important;letter-spacing:.035em!important;text-transform:uppercase!important;opacity:.94!important;transition:color .2s ease,opacity .2s ease!important
    }
    .desktop-only-nav a:hover,.desktop-nav-link:hover,.nav-solutions-parent:hover,.nav-market-parent:hover,
    .desktop-nav-link.active,.nav-solutions-parent.active{color:#c4f000!important;opacity:1!important}
    .desktop-chevron{display:inline-block!important;font-style:normal!important;font-size:.68rem!important;margin-left:5px!important;transition:transform .2s ease!important;color:#c4f000!important}
    .nav-solutions-parent[aria-expanded="true"] .desktop-chevron{transform:rotate(180deg)!important}
    .nav-solutions-menu{
      width:420px!important;min-width:420px!important;display:flex!important;flex-direction:column!important;gap:0!important;
      background:rgba(15,16,14,.985)!important;border:1px solid rgba(196,240,0,.22)!important;border-radius:22px!important;
      box-shadow:0 28px 80px rgba(0,0,0,.48)!important;padding:18px!important;backdrop-filter:blur(20px)!important;-webkit-backdrop-filter:blur(20px)!important
    }
    .nav-solutions-intro{display:grid!important;gap:8px!important;padding:4px 4px 18px!important;border-bottom:1px solid rgba(255,255,255,.12)!important;margin-bottom:4px!important}
    .nav-solutions-intro strong{color:#c4f000!important;font-size:.68rem!important;font-weight:900!important;letter-spacing:.12em!important;text-transform:uppercase!important}
    .nav-solutions-intro span{color:#d8d8d2!important;font-size:.84rem!important;line-height:1.45!important;max-width:34em}
    .desktop-solutions-grid{display:flex!important;flex-direction:column!important;gap:0!important}
    .desktop-solutions-grid .desktop-solution-item{
      display:flex!important;align-items:center!important;justify-content:space-between!important;min-height:54px!important;padding:13px 4px!important;border-radius:0!important;
      background:transparent!important;border:0!important;border-bottom:1px solid rgba(255,255,255,.09)!important;color:#fff!important;
      font-weight:700!important;font-size:.88rem!important;letter-spacing:-.01em!important;text-transform:none!important;white-space:normal!important;transition:color .2s ease,padding .25s ease,border-color .25s ease!important
    }
    .desktop-solutions-grid .desktop-solution-item:last-child{border-bottom:0!important}
    .desktop-solutions-grid .desktop-solution-item span{white-space:normal!important;max-width:29ch}
    .desktop-solutions-grid .desktop-solution-item i{display:grid;width:28px;height:28px;place-items:center;border-radius:50%;background:rgba(196,240,0,.1);color:#c4f000;font-style:normal;transition:background .2s ease,color .2s ease,transform .25s ease}
    .desktop-solutions-grid .desktop-solution-item:hover{padding-left:10px!important;background:transparent!important;border-color:rgba(196,240,0,.4)!important;color:#c4f000!important;transform:none!important}
    .desktop-solutions-grid .desktop-solution-item:hover i{background:#c4f000;color:#0a0a0a;transform:translate(2px,-2px)}
    .language-switcher-desktop button{border-color:rgba(255,255,255,.18)!important;background:rgba(255,255,255,.04)!important}
    .nav-cta{padding-inline:16px!important;white-space:nowrap!important}
    .fa-nav-promo{display:grid!important;gap:2px!important;min-width:134px!important;padding:7px 10px!important;border-left:1px solid rgba(196,240,0,.35)!important;color:#fff!important;line-height:1.2!important}
    .fa-nav-promo strong{font-size:10px!important;color:#c4f000!important}
    .fa-nav-promo span{font-size:9px!important;color:#d5d5d0!important}
  }

  @media (max-width: 1050px) {
    .desktop-only-nav,.header-house-label{display:none!important}
    .mobile-only-panel{display:flex!important;flex-direction:column!important;gap:12px!important;width:100%!important}
    .mobile-nav-head{padding-bottom:18px!important;border-bottom:1px solid rgba(255,255,255,.1)!important}
    .mobile-nav-subtitle{color:#c4f000!important;font-size:10px!important;font-weight:850!important;letter-spacing:.14em!important}
    .mobile-nav-close{background:rgba(255,255,255,.04)!important;border:1px solid rgba(255,255,255,.14)!important;color:#fff!important}
    .mobile-myth-card{background:#151614!important;border:1px solid rgba(255,255,255,.11)!important;border-radius:20px!important;overflow:hidden!important;box-shadow:none!important}
    .mobile-myth-card--trade{border-color:rgba(196,240,0,.22)!important}
    .myth-card-head{min-height:52px!important;padding:14px 16px!important;border-bottom:1px solid rgba(255,255,255,.1)!important;background:transparent!important}
    .myth-card-title{color:#fff!important;font-size:11px!important;font-weight:850!important;letter-spacing:.09em!important;text-transform:uppercase!important}
    .myth-card-badge{padding:6px 9px!important;border-radius:999px!important;background:#c4f000!important;color:#0a0a0a!important;font-size:9px!important;font-weight:900!important;letter-spacing:.08em!important}
    .mobile-lang-grid,.mobile-solutions-grid,.mobile-nav-grid{gap:0!important;padding:0 16px 8px!important}
    .mobile-lang-item,.mobile-solution-item,.mobile-nav-item{min-height:48px!important;border:0!important;border-bottom:1px solid rgba(255,255,255,.09)!important;border-radius:0!important;background:transparent!important;color:#eee!important;padding:12px 0!important}
    .mobile-lang-item:last-child,.mobile-solution-item:last-child,.mobile-nav-item:last-child{border-bottom:0!important}
    .mobile-lang-item.active,.mobile-nav-item.active{color:#c4f000!important;background:transparent!important}
    .mobile-lang-item.active .lang-code{background:#c4f000!important;color:#0a0a0a!important}
    .mobile-solution-item,.mobile-nav-item{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:16px!important}
    .mobile-solution-item strong,.mobile-nav-item strong{color:inherit!important;font-size:13px!important;line-height:1.25!important;letter-spacing:-.01em!important;text-transform:none!important}
    .mobile-solution-item>span,.mobile-nav-item>span{color:#c4f000!important;font-size:16px!important}
    .lang-code{color:#c4f000!important;font-weight:900!important}
    .lang-name{color:inherit!important}
    .fa-nav-promo{display:grid!important;gap:3px!important;margin-top:0!important;padding:14px 16px!important;border:1px solid rgba(196,240,0,.24)!important;border-radius:18px!important;background:rgba(196,240,0,.07)!important;color:#fff!important;text-decoration:none!important}
    .fa-nav-promo strong{color:#c4f000!important;font-size:12px!important;line-height:1.2!important}
    .fa-nav-promo span{color:#cfcfc8!important;font-size:11px!important}
  }
</style>
