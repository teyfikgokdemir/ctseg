---
import {activeLocaleRegistry} from '../data/locales';
import {globalCopy} from '../data/global-sourcing-locales';
import {globalHome,globalPath} from '../data/global-sourcing';
import {localizedPath,ui} from '../data/site';
const {lang,pageKey='home',pageId,alternates={}}=Astro.props;
const c=globalCopy[lang];
const menuLabel=({tr:'Menü',en:'Menu',de:'Menü',it:'Menu',fa:'فهرست',ru:'Меню',zh:'菜单',vi:'Menu',uk:'Меню',ro:'Meniu',bg:'Меню',he:'תפריט',ar:'القائمة'} as Record<string,string>)[lang];
const hePaths=['/he/','/he/אודות/','/he/שירותים/','/he/מוצרים-מסחריים/','/he/שווקים/','/he/איך-אנחנו-עובדים/','/he/יצירת-קשר/'];
const links=[globalHome(lang),lang==='he'?hePaths[1]:localizedPath(lang,'about'),globalPath(lang,'solutions'),globalPath(lang,'industries'),globalPath(lang,'global-markets'),lang==='he'?hePaths[5]:localizedPath(lang,'how-we-work'),lang==='he'?hePaths[6]:localizedPath(lang,'contact')];
const languageLabel=ui[lang]?.language || ({he:'בחירת שפה'}[lang]);
const switchPath=(code:string)=>{
  // Reuse the page's intent-aware counterpart map for both legacy and new pages.
  if(alternates[code]) return new URL(alternates[code],'https://ctseg.com.tr').pathname;
  if(pageKey==='insights'||pageKey==='he-insight'||pageKey==='guides')return code==='he'?'/he/תובנות/':localizedPath(code,'insights');
  if(pageKey==='products')return globalPath(code,'industries','food');
  if(pageKey==='services'||pageKey==='search-landing')return globalPath(code,'solutions');
  return globalHome(code);
};
---
<header class="gs-header" data-global-header>
 <div class="gs-header-inner">
  <a class="gs-brand" href={globalHome(lang)} aria-label="CTSEG"><img src="/images/ctseg-brand-header.svg" width="190" height="42" alt="CTSEG" decoding="async" /></a>
  <nav class="gs-desktop-nav" aria-label={c.nav[0]}>{[1,2,3,4,5,6].map(i=><a href={links[i]}>{c.nav[i]}</a>)}</nav>
  <details class="gs-language" id="language-panel"><summary data-language-toggle>{lang.toUpperCase()} <span aria-hidden="true">⌄</span></summary><nav aria-label={languageLabel} class="gs-languages">{activeLocaleRegistry.map(locale=><a data-locale-option data-locale={locale.code} href={switchPath(locale.code)} hreflang={locale.code} lang={locale.code} aria-current={locale.code===lang?'true':undefined}>{locale.label}</a>)}</nav></details>
  <button class="gs-menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="global-mobile-nav">{menuLabel} <svg width="20" height="16" viewBox="0 0 20 16" fill="none" aria-hidden="true"><path d="M1 2h18M1 8h18M1 14h18" stroke="currentColor" stroke-width="1.5" /></svg></button>
 </div>
 <nav id="global-mobile-nav" class="gs-mobile-nav" aria-label={c.nav[0]} hidden>{c.nav.map((label,i)=><a href={links[i]}>{label}</a>)}<div class="gs-mobile-languages mobile-lang-grid" aria-label={languageLabel}>{activeLocaleRegistry.map(locale=><a data-locale-option data-locale={locale.code} href={switchPath(locale.code)} hreflang={locale.code} lang={locale.code}>{locale.label}</a>)}</div></nav>
</header>
<script>
const button=document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
const menu=document.querySelector<HTMLElement>('#global-mobile-nav');
button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));menu!.hidden=open;});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(menu&&!menu.hidden){menu.hidden=true;button?.setAttribute('aria-expanded','false');button?.focus();}document.querySelectorAll<HTMLDetailsElement>('.gs-language[open]').forEach(el=>el.open=false);}});
document.addEventListener('click',e=>{document.querySelectorAll<HTMLDetailsElement>('.gs-language[open]').forEach(el=>{if(!el.contains(e.target as Node))el.open=false;});});
</script>
<style is:global>
header.gs-header{position:relative;top:0;z-index:100;background:#202a23;color:#f5f3eb;font-family:'DM Sans',sans-serif}.gs-header-inner{width:min(1320px,calc(100% - 80px));min-height:88px;margin-inline:auto;display:flex;gap:28px;align-items:center;justify-content:space-between}.gs-header .gs-brand{display:block;flex-shrink:0}.gs-header .gs-brand img{display:block;width:170px;height:auto;max-height:46px;object-fit:contain}.gs-desktop-nav{display:flex;gap:24px;align-items:center;margin-inline-start:auto}.gs-header a{color:inherit;text-decoration:none}.gs-header a:hover{text-decoration:underline;text-underline-offset:5px}.gs-desktop-nav a{font-size:14px;min-height:44px;display:flex;align-items:center}.gs-language{position:relative;flex-shrink:0}.gs-language summary{list-style:none;cursor:pointer;min-height:44px;display:flex;gap:12px;align-items:center;font-size:14px}.gs-languages{position:absolute;inset-inline-end:0;top:55px;background:#202a23;border:1px solid #717b69;padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:4px 18px;min-width:310px;max-height:70vh;overflow:auto}.gs-languages a{padding:10px;min-height:44px;font-size:15px}.gs-menu-toggle{display:none;border:0;background:none;color:inherit;font:inherit;min-height:44px}.gs-mobile-nav[hidden]{display:none!important}.gs-header a:focus-visible,.gs-header summary:focus-visible,.gs-header button:focus-visible{outline:2px solid #c4f000;outline-offset:4px}.gs-mobile-nav{padding:20px 24px;max-height:calc(100dvh - 80px);overflow:auto}.gs-mobile-nav>a{display:block;padding:13px 0;font-size:19px}.gs-mobile-languages{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:22px}.gs-mobile-languages a{padding:12px 2px;min-height:44px;font-size:14px;overflow-wrap:anywhere}
@media(max-width:1100px){.gs-header-inner{width:calc(100% - 48px)}.gs-desktop-nav{gap:14px}.gs-desktop-nav a{font-size:14px}.gs-header .gs-brand img{width:140px}}
@media(max-width:900px){.gs-header-inner{width:calc(100% - 36px);min-height:76px;gap:20px}.gs-desktop-nav{display:none}.gs-menu-toggle{display:flex;gap:10px;align-items:center}.gs-language{margin-inline-start:auto}.gs-languages{min-width:280px;inset-inline-end:-70px}}
</style>
