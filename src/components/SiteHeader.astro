---
import { localizedPath, ui, type Locale } from '../data/site';
import { activeLocaleRegistry } from '../data/locales';
import { duzceGlassPath, type DuzceGlassLocale } from '../data/duzce-glass';
import { generatedImageSrc, LOGO_IMAGE } from '../lib/responsive-images';
import { tradePlatformCopy } from '../data/trade-platform';
import { searchLandingPath, type SearchLandingId } from '../data/search-landings';
import { getGlassSeoPage } from '../data/glass-seo';
import { localizedGlassProductCopy, localizedGlassSlugs, type LocalizedGlassLocale } from '../data/glass-product-locales';

const { lang, pageKey='home', pageId } = Astro.props as { lang: Locale; pageKey?: string; pageId?: string };
const t = lang === 'he' ? {
  ...ui.en, home:'בית', services:'סחר גלובלי', products:'תחומי סחר', markets:'שווקים',
  insights:'תובנות', about:'אודות', contact:'יצירת קשר', quote:'שליחת בקשה',
  menu:'פתיחת תפריט', close:'סגירת תפריט', language:'בחירת שפה'
} : (ui[lang] || ui.en);
const home = lang === 'he' ? '/he/' : localizedPath(lang, 'home');
const p = tradePlatformCopy[lang] || tradePlatformCopy.en;
const methodLabel = {tr:'Yöntem',en:'Method',de:'Arbeitsweise',it:'Metodo',fa:'روش کار',ru:'Метод',zh:'运作模式',vi:'Phương thức hoạt động',uk:'Метод роботи',ro:'Metodă',bg:'Метод',sr:'Metod',he:'שיטת עבודה',ar:'طريقة العمل'}[lang] || 'Method';
const glassNavLabels: Record<string, string> = {
  tr:'Cam Tedariki', en:'Glass Sourcing', de:'Glasbeschaffung', it:'Sourcing Vetro',
  fa:'تأمین شیشه', ru:'Поставка стекла', zh:'玻璃采购', vi:'Tìm nguồn cung kính',
  uk:'Постачання скла',
  ro:'Aprovizionare cu sticlă', bg:'Снабдяване със стъкло', sr:'Nabavka stakla',
  he:'איתור ואספקת זכוכית',
  ar:'توريد الزجاج'
};
const navigationCopy = {
  tr:{globalTrade:'Küresel Ticaret',industries:'Sektörler',portfolio:'Ticaret Portföyü',intelligence:'Ticaret İçgörüleri',company:'Şirket',main:'ANA MENÜ',quick:'HIZLI ERİŞİM',trade:'TİCARET',intro:'İki yönlü ticaret, stratejik tedarik ve pazara giriş yolları'},
  en:{globalTrade:'Global Trade',industries:'Industries',portfolio:'Trade Portfolio',intelligence:'Trade Intelligence',company:'Company',main:'MAIN MENU',quick:'NAVIGATION',trade:'TRADE',intro:'Two-way trade, strategic sourcing and market-entry paths'},
  de:{globalTrade:'Globaler Handel',industries:'Branchen',portfolio:'Handelsportfolio',intelligence:'Handelswissen',company:'Unternehmen',main:'HAUPTMENÜ',quick:'NAVIGATION',trade:'HANDEL',intro:'Bidirektionaler Handel, strategische Beschaffung und Markteintritt'},
  it:{globalTrade:'Commercio Globale',industries:'Settori',portfolio:'Portafoglio',intelligence:'Intelligence Commerciale',company:'Azienda',main:'MENU PRINCIPALE',quick:'NAVIGAZIONE',trade:'COMMERCIO',intro:'Commercio bidirezionale, sourcing strategico e ingresso nei mercati'},
  ru:{globalTrade:'Глобальная торговля',industries:'Отрасли',portfolio:'Торговый портфель',intelligence:'Торговая аналитика',company:'Компания',main:'ГЛАВНОЕ МЕНЮ',quick:'НАВИГАЦИЯ',trade:'ТОРГОВЛЯ',intro:'Двусторонняя торговля, стратегический сорсинг и выход на рынки'},
  fa:{globalTrade:'تجارت جهانی',industries:'صنایع',portfolio:'سبد تجاری',intelligence:'بینش تجاری',company:'شرکت',main:'منوی اصلی',quick:'دسترسی سریع',trade:'تجارت',intro:'تجارت دوطرفه، تأمین استراتژیک و ورود به بازار'},
  zh:{globalTrade:'全球贸易',industries:'行业',portfolio:'贸易组合',intelligence:'贸易洞察',company:'公司',main:'主菜单',quick:'导航',trade:'贸易',intro:'双向国际贸易、战略采购与市场进入路径'},
  vi:{globalTrade:'Thương mại toàn cầu',industries:'Ngành',portfolio:'Danh mục thương mại',intelligence:'Thông tin thương mại',company:'Công ty',main:'MENU CHÍNH',quick:'ĐIỀU HƯỚNG',trade:'THƯƠNG MẠI',intro:'Thương mại hai chiều, sourcing chiến lược và thâm nhập thị trường'},
  uk:{globalTrade:'Міжнародна торгівля',industries:'Галузі',portfolio:'Торговельний портфель',intelligence:'Торговельна аналітика',company:'Компанія',main:'ГОЛОВНЕ МЕНЮ',quick:'НАВІГАЦІЯ',trade:'ТОРГІВЛЯ',intro:'Двостороння торгівля, стратегічне постачання та вихід на ринки'},
  ro:{globalTrade:'Comerț Global',industries:'Industrii',portfolio:'Portofoliu Comercial',intelligence:'Analize Comerciale',company:'Companie',main:'MENIU PRINCIPAL',quick:'NAVIGARE',trade:'COMERȚ',intro:'Comerț bidirecțional, sourcing strategic și acces pe piețe'},
  bg:{globalTrade:'Глобална търговия',industries:'Сектори',portfolio:'Търговско портфолио',intelligence:'Търговски анализи',company:'Компания',main:'ГЛАВНО МЕНЮ',quick:'НАВИГАЦИЯ',trade:'ТЪРГОВИЯ',intro:'Двупосочна търговия, стратегическо снабдяване и навлизане на пазари'},
  sr:{globalTrade:'Globalna trgovina',industries:'Sektori',portfolio:'Trgovinski portfolio',intelligence:'Trgovinski uvidi',company:'Kompanija',main:'GLAVNI MENI',quick:'NAVIGACIJA',trade:'TRGOVINA',intro:'Dvosmerna trgovina, strateški sourcing i ulazak na tržište'},
  he:{globalTrade:'סחר גלובלי',industries:'שווקים',portfolio:'תחומי סחר',intelligence:'תובנות מסחריות',company:'CTSEG',main:'תפריט ראשי',quick:'ניווט',trade:'סחר',intro:'סחר דו־כיווני, איתור ספקים וכניסה לשוק בין ישראל לטורקיה'},
  ar:{globalTrade:'التجارة العالمية',industries:'القطاعات',portfolio:'المحفظة التجارية',intelligence:'الرؤى التجارية',company:'الشركة',main:'القائمة الرئيسية',quick:'تنقل سريع',trade:'التجارة',intro:'تجارة ثنائية الاتجاه، توريد استراتيجي ودخول الأسواق'}
}[lang] || {globalTrade:'Global Trade',industries:'Industries',portfolio:'Trade Portfolio',intelligence:'Trade Intelligence',company:'Company',main:'MAIN MENU',quick:'NAVIGATION',trade:'TRADE',intro:'Two-way trade, strategic sourcing and market-entry paths'};

const safeGlassLang = (['en','tr','de','it','ru','fa','zh','vi','uk','ro','bg','sr'].includes(lang) ? lang : 'en') as DuzceGlassLocale;
const glassUrl = lang === 'tr' ? '/glass/' : `/${lang}/glass/`;
const glassLabel = glassNavLabels[lang] || 'Düzce Float Glass';
const glassMenuCoreSlugs=['float-glass','tempered-glass','laminated-glass','low-e-coated-glass','insulated-glass-igu','architectural-project-glass'] as const;
const glassMenuLinks = (lang === 'tr' || lang === 'en') ? [
  [glassLabel, glassUrl],
  ...['float-glass','tempered-glass','laminated-glass','low-e-coated-glass','insulated-glass-igu','architectural-project-glass']
    .map((slug) => {
      const page = getGlassSeoPage(slug);
      if (!page) return null;
      return [page[lang].title.replace(' Tedariki','').replace(' Sourcing',''), `${lang === 'tr' ? '/glass' : '/en/glass'}/${slug}/`];
    })
    .filter(Boolean)
] as [string,string][] : (lang !== 'sr' && localizedGlassProductCopy[lang as LocalizedGlassLocale]) ? [
  [glassLabel, glassUrl],
  ...glassMenuCoreSlugs.map((slug)=>[localizedGlassProductCopy[lang as LocalizedGlassLocale].products[slug].name, `/${lang}/glass/${slug}/`] as [string,string])
] : [[glassLabel, glassUrl]] as [string,string][];

const focusedCountryLp = pageKey === 'home' && ['de','it','ru','fa','zh','vi'].includes(lang);
const solutionLinks = lang === 'he' ? [
  ['איתור ואימות ספקים','/he/שירותים/איתור-ואימות-ספקים/'],
  ['רכש אסטרטגי','/he/שירותים/רכש-אסטרטגי/'],
  ['כניסה לשוק','/he/שירותים/כניסה-לשוק/'],
  [methodLabel,'/he/איך-אנחנו-עובדים/']
] : lang === 'ar' ? [
  [t.services, localizedPath(lang,'services')],
  ['التوريد الاستراتيجي', localizedPath(lang,'services','strategic-sourcing')],
  ['البحث عن الموردين والتحقق منهم', localizedPath(lang,'services','supplier-verification')],
  ['استشارات التجارة الدولية', localizedPath(lang,'services','trade-advisory')],
  ['تحليل وتحسين التكلفة الكلية TCO', localizedPath(lang,'services','tco')],
  ['دخول الأسواق', localizedPath(lang,'services','market-entry')],
  [methodLabel, localizedPath(lang,'how-we-work')],
  ['سيناريوهات عمل تمثيلية', localizedPath(lang,'scenarios')]
] : [
  [t.services, localizedPath(lang,'services')],
  [p.buyerTitle, localizedPath(lang,'services','strategic-sourcing')],
  [p.producerTitle, localizedPath(lang,'services','market-entry')],
  [methodLabel, localizedPath(lang,'how-we-work')]
];

const nav = lang === 'he' ? [
  ['services', navigationCopy.globalTrade, '/he/שירותים/'],
  ['sectors', navigationCopy.industries, '/he/שווקים/'],
  ['products', navigationCopy.portfolio, '/he/מוצרים-מסחריים/'],
  ['insights', navigationCopy.intelligence, '/he/תובנות/'],
  ['about', navigationCopy.company, '/he/אודות/'],
  ['contact', t.contact, '/he/יצירת-קשר/']
] : [
  ['services', navigationCopy.globalTrade, localizedPath(lang,'services')],
  ['sectors', navigationCopy.industries, localizedPath(lang,'markets')],
  ...(!focusedCountryLp ? [['products', navigationCopy.portfolio, localizedPath(lang,'products')]] : []),
  ['insights', navigationCopy.intelligence, localizedPath(lang,'insights')],
  ['about', navigationCopy.company, localizedPath(lang,'about')],
  ['contact', t.contact, localizedPath(lang,'contact')]
];

const globalLocales = activeLocaleRegistry.map((entry) => entry.code) as string[];
const globalLocaleNames: Record<string,string> = Object.fromEntries(activeLocaleRegistry.map((entry) => [entry.code, entry.label]));
const globalLocaleFlags: Record<string,string> = {tr:'/images/flags/tr.svg',en:'/images/flags/gb.svg',de:'/images/flags/de.svg',it:'/images/flags/it.svg',fa:'/images/flags/ir.svg',ru:'/images/flags/ru.svg',zh:'/images/flags/cn.svg',vi:'/images/flags/vn.svg',ro:'/images/flags/ro.svg',bg:'/images/flags/bg.svg',he:'/images/flags/il.svg',uk:'/images/flags/ua.svg',ar:'/images/flags/sa.svg'};

const heVisibleProductIds = new Set(['almonds','walnuts','mixed-nuts','raisins','dried-apricots-kernels','pumpkin-seeds','sunflower-seeds']);
const heServicePaths:Record<string,string> = {
  'strategic-sourcing':'/he/שירותים/רכש-אסטרטגי/',
  'supplier-verification':'/he/שירותים/איתור-ואימות-ספקים/',
  'trade-advisory':'/he/שירותים/ייעוץ-סחר-בינלאומי/',
  'tco':'/he/שירותים/אופטימיזציית-עלות-tco/',
  'market-entry':'/he/שירותים/כניסה-לשוק/'
};
const hePagePaths:Record<string,string> = {
  home:'/he/',services:'/he/שירותים/',products:'/he/מוצרים-מסחריים/',markets:'/he/שווקים/',
  insights:'/he/תובנות/',about:'/he/אודות/',contact:'/he/יצירת-קשר/','how-we-work':'/he/איך-אנחנו-עובדים/',
  scenarios:'/he/תרחישים-מסחריים/',legal:'/he/'
};
const currentPath = Astro.url.pathname;
const globalSwitchPath = (target: string): string => {
  if (pageKey === 'he-insight') {
    if (target === 'he') return currentPath;
    return localizedPath(target as Locale,'insights');
  }
  if (pageKey === 'search-landing' && pageId) return searchLandingPath(target as Locale,pageId as SearchLandingId);
  if (pageKey === 'glass-industry') {
    if (target === 'tr') return '/glass/';
    return `/${target}/glass/`;
  }
  if (pageKey === 'glass-product' && pageId) {
    const hasLocalizedProduct=(localizedGlassSlugs as readonly string[]).includes(pageId);
    if (target === 'tr') return `/glass/${pageId}/`;
    if (target === 'en') return `/en/glass/${pageId}/`;
    return hasLocalizedProduct ? `/${target}/glass/${pageId}/` : `/${target}/glass/`;
  }
  if (pageKey === 'glass-market' && pageId) {
    if (target === 'tr') return `/glass/markets/${pageId}/`;
    return `/${target}/glass/markets/${pageId}/`;
  }
  if (target === 'he') {
    if (pageKey === 'services' && pageId && heServicePaths[pageId]) return heServicePaths[pageId];
    if (pageKey === 'products' && pageId) return heVisibleProductIds.has(pageId) ? `/he/מוצרים-מסחריים/${pageId}/` : '/he/מוצרים-מסחריים/';
    if (pageKey === 'legal') {
      const heLegal:Record<string,string> = {privacy:'/he/מדיניות-פרטיות/',cookies:'/he/מדיניות-עוגיות/',terms:'/he/תנאי-שימוש/','data-protection':'/he/הודעת-הגנת-מידע/'};
      return pageId && heLegal[pageId] ? heLegal[pageId] : '/he/';
    }
    return hePagePaths[pageKey] || '/he/';
  }
  if (pageKey === 'insights' && pageId && ['ro','bg'].includes(target)) return localizedPath(target as Locale,'insights');
  if (pageKey === 'iran-trade') {
    if (target === 'tr') return '/tr/iran-turkiye-ticaret/';
    if (target === 'en') return '/en/iran-turkiye-europe-trade/';
    if (target === 'fa') return '/fa/';
    return `/${target}/`;
  }
  if (['vietnam-turkiye','china-turkiye','ukraine-turkiye'].includes(pageKey)) return target === 'tr' ? '/' : `/${target}/`;
  if (target === 'fa') return '/fa/';
  if (pageKey === 'glass-industry') {
    if (target === 'tr') return '/glass/';
    return `/${target}/glass/`;
  }
  if (pageKey === 'glass-product' && pageId) {
    const hasLocalizedProduct=(localizedGlassSlugs as readonly string[]).includes(pageId);
    if (target === 'tr') return `/glass/${pageId}/`;
    if (target === 'en') return `/en/glass/${pageId}/`;
    return hasLocalizedProduct ? `/${target}/glass/${pageId}/` : `/${target}/glass/`;
  }
  if (pageKey === 'glass-market' && pageId) {
    if (target === 'tr') return `/glass/markets/${pageId}/`;
    return `/${target}/glass/markets/${pageId}/`;
  }
  if (pageKey === 'glass') {
    const glassLocales = ['en','tr','de','it','ru','fa','zh','vi','ro','bg'] as const;
    if ((glassLocales as readonly string[]).includes(target)) return duzceGlassPath(target as DuzceGlassLocale);
    return `/${target}/`;
  }
  const resolved = localizedPath(target as Locale, pageKey, pageId);
  return resolved?.includes('undefined') ? `/${target}/` : resolved;
};
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand brand-stack" href={home} aria-label={`CTSEG · ${t.home}`}>
      <img src={generatedImageSrc(LOGO_IMAGE,320)} width="320" height="103" alt="CTSEG" decoding="async" />
      <span class="header-house-label" aria-hidden="true">{lang === 'he' ? 'בית סחר בינלאומי' : 'GLOBAL TRADE HOUSE'}</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={t.menu || 'Menu'} data-menu-toggle>
      <span class="sr-only">{t.menu}</span><span></span><span></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label={lang === 'uk' ? 'Основна навігація' : lang === 'ar' ? 'التنقل الرئيسي' : 'Primary'} data-primary-nav>
      <div class="mobile-only-panel">
        <div class="mobile-nav-head">
          <div class="mobile-nav-brand">
            <span class="mobile-nav-title">CTSEG</span>
            <span class="mobile-nav-subtitle">{navigationCopy.main}</span>
          </div>
          <button class="mobile-nav-close" type="button" aria-label={t.close || 'Close menu'} data-mobile-close>
            <span aria-hidden="true">✕</span>
          </button>
        </div>

        <details class="mobile-accordion mobile-accordion--lang">
          <summary>
            <span class="mobile-accordion-title">{t.language || 'Language'}</span>
            <span class="mobile-current-locale">
              <img class="lang-flag" src={globalLocaleFlags[lang]} width="24" height="16" alt="" aria-hidden="true" />
              <strong>{globalLocaleNames[lang]}</strong>
            </span>
            <span class="mobile-accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="mobile-lang-grid">
            {globalLocales.map((code) => (
              <a
                lang={code}
                hreflang={code}
                class:list={['mobile-lang-item', { active: code === lang }]}
                href={globalSwitchPath(code)}
                aria-current={code === lang ? 'page' : undefined}
                data-locale-option
              >
                <img class="lang-flag" src={globalLocaleFlags[code]} width="28" height="19" alt="" aria-hidden="true" />
                <span class="lang-name">{globalLocaleNames[code]}</span>
              </a>
            ))}
          </div>
        </details>

        <details class="mobile-accordion mobile-accordion--glass" open={['glass-industry','glass-product','glass-market','glass'].includes(pageKey)}>
          <summary>
            <span class="mobile-accordion-title">{lang==='he'?'זכוכית':lang==='tr'?'CAM':glassLabel}</span>
            <span class="mobile-accordion-badge">{lang==='he'?'זכוכית':lang==='tr'?'CAM':'GLASS'}</span>
            <span class="mobile-accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="mobile-accordion-links">
            {glassMenuLinks.map(([label,href]) => (
              <a href={href}>
                <strong>{label}</strong><span aria-hidden="true">{['he','fa','ar'].includes(lang) ? '↖' : '↗'}</span>
              </a>
            ))}
          </div>
        </details>

        <details class="mobile-accordion mobile-accordion--trade">
          <summary>
            <span class="mobile-accordion-title">{navigationCopy.globalTrade}</span>
            <span class="mobile-accordion-badge">{navigationCopy.trade}</span>
            <span class="mobile-accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="mobile-accordion-links">
            {solutionLinks.map(([solutionLabel, solutionHref]) => (
              <a href={solutionHref}>
                <strong>{solutionLabel}</strong><span aria-hidden="true">{['he','fa','ar'].includes(lang) ? '↖' : '↗'}</span>
              </a>
            ))}
          </div>
        </details>

        <details class="mobile-accordion mobile-accordion--quick">
          <summary>
            <span class="mobile-accordion-title">{navigationCopy.quick}</span>
            <span class="mobile-accordion-badge">NAV</span>
            <span class="mobile-accordion-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="mobile-accordion-links">
            {nav.filter(([key]) => key !== 'services').map(([key, label, href]) => (
              <a href={href} class:list={{ active: pageKey === key }}>
                <strong>{label}</strong><span aria-hidden="true">{['he','fa','ar'].includes(lang) ? '↖' : '↗'}</span>
              </a>
            ))}
          </div>
        </details>
      </div>

      <div class="desktop-only-nav">
        <div class="nav-solutions-group" data-solutions-nav-group>
          <button class:list={['nav-solutions-parent',{ active: pageKey === 'services' }]} type="button" aria-expanded="false" aria-controls="solutions-panel" data-solutions-toggle>
            <span>{navigationCopy.globalTrade}</span>
            <span class="desktop-chevron" aria-hidden="true">▾</span>
          </button>
          <div id="solutions-panel" class="nav-solutions-menu" aria-label={navigationCopy.globalTrade} data-solutions-menu>
            <div class="nav-solutions-intro"><strong>CTSEG · {navigationCopy.globalTrade}</strong><span>{navigationCopy.intro}</span></div>
            <div class="desktop-solutions-grid">
              {solutionLinks.map(([solutionLabel, solutionHref]) => <a href={solutionHref} class="desktop-solution-item"><span>{solutionLabel}</span><i aria-hidden="true">{['he','fa','ar'].includes(lang) ? '↖' : '↗'}</i></a>)}
            </div>
          </div>
        </div>

        <div class="nav-glass-group" data-glass-nav-group>
          <button class:list={['nav-glass-parent',{ active: ['glass-industry','glass-product','glass-market','glass'].includes(pageKey) }]} type="button" aria-expanded="false" aria-controls="glass-panel" data-glass-toggle>
            <span>{lang==='tr'?'Cam':lang==='en'?'Glass':glassLabel}</span>
            <span class="desktop-chevron" aria-hidden="true">▾</span>
          </button>
          <div id="glass-panel" class="nav-glass-menu" data-glass-menu>
            <div class="nav-glass-intro">
              <strong>{lang==='tr'?'CTSEG · CAM TEDARİKİ':lang==='en'?'CTSEG · GLASS SOURCING':lang==='he'?'CTSEG · איתור ואספקת זכוכית':glassLabel}</strong>
              <span>{lang==='tr'?'Ürün, işleme ve proje bazlı cam tedariki':lang==='en'?'Product, processing and project glass sourcing':lang==='he'?'אספקת זכוכית לפי מוצר, עיבוד ופרויקט':lang==='ar'?'توريد الزجاج حسب المنتج والمعالجة ومتطلبات المشروع':''}</span>
            </div>
            <div class="nav-glass-links">
              {glassMenuLinks.map(([label,href]) => <a href={href}><span>{label}</span><i aria-hidden="true">↗</i></a>)}
            </div>
          </div>
        </div>

        {nav.filter(([key]) => key !== 'services').map(([key, label, href]) => (
          <a class:list={['desktop-nav-link', { active: pageKey === key }]} href={href}>{label}</a>
        ))}

        <div class="language-switcher language-switcher-desktop">
          <button type="button" aria-expanded="false" aria-controls="language-panel" aria-label={t.language} data-language-toggle>
            <img class="locale-flag" src={globalLocaleFlags[lang] || globalLocaleFlags.en} width="26" height="17" alt="" aria-hidden="true" /><span class="sr-only locale-code">{lang.toUpperCase()}</span>
            <span class="locale-chevron" aria-hidden="true"></span>
          </button>
          <div id="language-panel" class="language-menu" data-language-menu>
            {globalLocales.map((code) => <a
              lang={code}
              hreflang={code}
              class:list={{ active: code === lang }}
              href={globalSwitchPath(code)}
              aria-current={code === lang ? 'page' : undefined}
              data-locale-option
            ><img class="language-menu-flag" src={globalLocaleFlags[code]} width="26" height="17" alt="" aria-hidden="true" /><strong>{globalLocaleNames[code]}</strong><i aria-hidden="true"></i></a>)}
          </div>
        </div>

        <a class="button button-small nav-cta" href={lang === 'he' ? '/he/יצירת-קשר/' : localizedPath(lang, 'contact')}>{t.quote}</a>
      </div>
      {(lang === 'en' || lang === 'fa') && (
        <a class="fa-market-nav-link fa-nav-promo" href="/fa/" data-fa-nav-link data-fa-landing-link>
          <strong>{lang === 'fa' ? 'برای کسب‌وکارهای ایرانی' : 'For Iranian Businesses'}</strong>
          <span>{lang === 'fa' ? 'پشتیبانی تجارت بین‌المللی' : 'Persian landing page'}</span>
        </a>
      )}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const nav = document.querySelector('[data-primary-nav]');
  const closeButton = document.querySelector('[data-mobile-close]');
  const languageToggle = document.querySelector('[data-language-toggle]');
  const languageMenu = document.querySelector('[data-language-menu]');
  const solutionsToggle = document.querySelector('[data-solutions-toggle]');
  const solutionsGroup = document.querySelector('[data-solutions-nav-group]');
  const glassToggle = document.querySelector('[data-glass-toggle]');
  const glassGroup = document.querySelector('[data-glass-nav-group]');

  let previousScroll = 0;
  let previousFocus: HTMLElement | null = null;
  const mobileBreakpoint = window.matchMedia('(max-width: 1050px)');

  const syncNavigationAccessibility = () => {
    if (!nav) return;
    const isMobile = mobileBreakpoint.matches;
    const isOpen = nav.classList.contains('open');
    if (isMobile) {
      nav.toggleAttribute('inert', !isOpen);
      nav.setAttribute('aria-hidden', String(!isOpen));
    } else {
      nav.removeAttribute('inert');
      nav.removeAttribute('aria-hidden');
    }
  };

  const focusable = () => nav ? [...nav.querySelectorAll('a[href], button:not([disabled])')].filter(el => !el.closest('[hidden]')) : [];

  syncNavigationAccessibility();

  const closeSolutions = (restoreFocus = false) => {
    solutionsToggle?.setAttribute('aria-expanded', 'false');
    solutionsGroup?.classList.remove('is-open');
    if (restoreFocus) (solutionsToggle as HTMLElement)?.focus();
  };

  const closeGlass = () => {
    glassToggle?.setAttribute('aria-expanded', 'false');
    glassGroup?.classList.remove('is-open');
  };

  const closeNavigation = () => {
    if (!nav || !nav.classList.contains('open')) return;
    toggle?.setAttribute('aria-expanded', 'false');
    nav.classList.remove('open');
    syncNavigationAccessibility();
    closeSolutions();
    closeGlass();
    setTimeout(() => {
      document.body.classList.remove('menu-open');
      window.scrollTo({ top: previousScroll, behavior: 'instant' });
      if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
    }, 150);
  };

  const openNavigation = () => {
    if (!nav || nav.classList.contains('open')) return;
    previousScroll = window.scrollY;
    previousFocus = document.activeElement as HTMLElement;
    toggle?.setAttribute('aria-expanded', 'true');
    nav.classList.add('open');
    syncNavigationAccessibility();
    document.body.classList.add('menu-open');
    (closeButton as HTMLElement)?.focus();
  };

  const closeLanguageMenu = () => {
    languageToggle?.setAttribute('aria-expanded', 'false');
    languageMenu?.classList.remove('open');
  };
  const languageScrollKey = 'ctseg:language-scroll';
  const restoreLanguageScroll = () => {
    try {
      const raw = sessionStorage.getItem(languageScrollKey);
      if (!raw) return;
      const saved = JSON.parse(raw) as { path?:string; ratio?:number };
      if (saved.path !== window.location.pathname || typeof saved.ratio !== 'number') return;
      sessionStorage.removeItem(languageScrollKey);
      const apply = () => {
        const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        window.scrollTo({ top: Math.round(maxScroll * Math.min(1, Math.max(0, saved.ratio!))), behavior: 'instant' });
      };
      requestAnimationFrame(() => requestAnimationFrame(apply));
      window.addEventListener('load', apply, { once:true });
    } catch {
      sessionStorage.removeItem(languageScrollKey);
    }
  };

  restoreLanguageScroll();

  document.querySelectorAll<HTMLAnchorElement>('[data-locale-option]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const ratio = Math.min(1, Math.max(0, window.scrollY / maxScroll));
        const target = new URL(link.href, window.location.href);
        sessionStorage.setItem(languageScrollKey, JSON.stringify({ path:target.pathname, ratio }));
      } catch {}
    });
  });

  mobileBreakpoint.addEventListener('change', syncNavigationAccessibility);
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    if (open) closeNavigation();
    else openNavigation();
  });
  closeButton?.addEventListener('click', closeNavigation);
  solutionsToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = solutionsToggle.getAttribute('aria-expanded') === 'true';
    solutionsToggle.setAttribute('aria-expanded', String(!open));
    solutionsGroup?.classList.toggle('is-open', !open);
  });
  glassToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = glassToggle.getAttribute('aria-expanded') === 'true';
    closeSolutions();
    glassToggle.setAttribute('aria-expanded', String(!open));
    glassGroup?.classList.toggle('is-open', !open);
  });
  languageToggle?.addEventListener('click', () => {
    const open = languageToggle.getAttribute('aria-expanded') === 'true';
    languageToggle.setAttribute('aria-expanded', String(!open));
    languageMenu?.classList.toggle('open', !open);
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNavigation));
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (!document.querySelector('.language-switcher')?.contains(event.target)) closeLanguageMenu();
    if (!document.querySelector('.nav-solutions-group')?.contains(event.target)) closeSolutions();
    if (!document.querySelector('.nav-glass-group')?.contains(event.target)) closeGlass();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav?.classList.contains('open')) {
      closeLanguageMenu();
      closeSolutions(true);
      closeGlass();
      closeNavigation();
    }
    if (event.key === 'Tab' && nav?.classList.contains('open')) {
      const items = focusable();
      if (items.length > 0) {
        const first = items[0] as HTMLElement;
        const last = items[items.length - 1] as HTMLElement;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    }
  });
</script>

