---
import { localizedPath, ui, type Locale } from '../data/site';
import { activeLocaleRegistry, type ActiveLocale } from '../data/locales';
import { reflexPath, type ReflexLocale } from '../data/reflex-data';
import { generatedImageSrc, LOGO_IMAGE } from '../lib/responsive-images';
import { tradePlatformCopy } from '../data/trade-platform';
import { searchLandingPath, type SearchLandingId } from '../data/search-landings';

const { lang, pageKey='home', pageId } = Astro.props as { lang: Locale; pageKey?: string; pageId?: string };
const t = ui[lang] || ui.en;
const home = localizedPath(lang, 'home');
const p = tradePlatformCopy[lang] || tradePlatformCopy.en;
const processLabel = {tr:'Yöntem',en:'Method',de:'Methode',it:'Metodo',fa:'روش کار',ru:'Метод'}[lang] || 'Method';
const medicalNavLabels: Record<string, string> = {
  tr: 'REFLEX Medikal',
  en: 'REFLEX Medical',
  de: 'REFLEX Medizin',
  it: 'REFLEX Medicale',
  fa: 'دستکش پزشکی REFLEX',
  ru: 'REFLEX Медицина',
  sq: 'REFLEX Medikal',
  mk: 'REFLEX Medikal',
  sr: 'REFLEX Medikal'
};

const safeReflexLang = (['en','tr','de','it','ru','fa','sq','mk','sr'].includes(lang) ? lang : 'en') as ReflexLocale;
const reflexUrl = reflexPath(safeReflexLang);
const medicalLabel = medicalNavLabels[lang] || 'REFLEX Medical';
const methodLabel: Record<Locale,string> = {
  tr:'Yöntem', en:'Method', de:'Arbeitsweise', it:'Metodo', ru:'Метод', fa:'روش کار'
};

const solutionLinks = [
  [t.services, localizedPath(lang,'services')],
  [p.buyerTitle, `${home}#for-buyers`],
  [p.producerTitle, `${home}#for-producers`],
  [methodLabel[lang] || 'Method', localizedPath(lang,'how-we-work')],
  [medicalLabel, reflexUrl]
];

const nav = lang === 'ru' ? [
  ['services', t.services, `${home}#trade-paths`],
  ['sectors', t.products, `${home}#sectors`],
  ['method', processLabel, localizedPath(lang,'how-we-work')],
  ['markets', t.markets, `${home}#markets`],
  ['about', t.about, `${home}#company`],
  ['contact', t.contact, `${home}#contact`]
] : [
  ['services', t.services, localizedPath(lang,'services')],
  ['products', t.products, localizedPath(lang,'products')],
  ['method', processLabel, localizedPath(lang,'how-we-work')],
  ['insights', t.insights, localizedPath(lang,'insights')],
  ['about', t.about, localizedPath(lang,'about')],
  ['contact', t.contact, localizedPath(lang,'contact')]
];

const globalLocales = activeLocaleRegistry.map((entry) => entry.code);
const globalLocaleNames = Object.fromEntries(activeLocaleRegistry.map((entry) => [entry.code, entry.label])) as Record<ActiveLocale,string>;

const globalSwitchPath = (target: string): string => {
  if (pageKey === 'search-landing' && pageId) return searchLandingPath(target as Locale,pageId as SearchLandingId);
  if (target === 'fa') return '/fa/';
  if (pageKey === 'medical') {
    const reflexLocales = ['en','tr','de','it','ru','fa'] as const;
    if ((reflexLocales as readonly string[]).includes(target)) return reflexPath(target as ReflexLocale);
    return '/';
  }
  return localizedPath(target, pageKey, pageId);
};
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={home} aria-label={`CTSEG · ${t.home}`}>
      <img src={generatedImageSrc(LOGO_IMAGE,320)} width="320" height="103" alt="CTSEG" decoding="async" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={t.menu || "Menu"} data-menu-toggle>
      <span class="sr-only">{t.menu}</span><span></span><span></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary" data-primary-nav aria-hidden="true">
      <!-- MOBILE ONLY PANEL (86272194 Standard - Pure Mythborn Card Grid - UNTOUCHED) -->
      <div class="mobile-only-panel">
        <div class="mobile-nav-head">
          <div class="mobile-nav-brand">
            <span class="mobile-nav-title">CTSEG</span>
            <span class="mobile-nav-subtitle">{lang === 'en' ? 'MAIN MENU' : 'ANA MENÜ'}</span>
          </div>
          <button class="mobile-nav-close" type="button" aria-label="Close menu" data-mobile-close>
            <span aria-hidden="true">✕</span>
          </button>
        </div>

        <!-- Card 1: Language Switcher -->
        <div class="mobile-myth-card mobile-myth-card--lang">
          <div class="myth-card-head">
            <span class="myth-card-title">🌐 {t.language || 'DİL SEÇİMİ'}</span>
            <span class="myth-card-badge">GLOBAL</span>
          </div>
          <div class="mobile-lang-grid">
            {globalLocales.map((code) => (
              <a
                lang={code}
                hreflang={code}
                class:list={['mobile-lang-item', { active: code === lang }]}
                href={globalSwitchPath(code)}
                aria-current={code === lang ? 'true' : undefined}
                data-locale-option
              >
                <span class="lang-code">{code.toUpperCase()}</span>
                <span class="lang-name">{globalLocaleNames[code]}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Card 2: Hizmetler (Mythborn Open 2-Column Grid) -->
        <div class="mobile-myth-card">
          <div class="myth-card-head">
            <span class="myth-card-title">🏢 {t.services ? t.services.toUpperCase() : 'HİZMETLER'}</span>
            <span class="myth-card-badge">OPERASYON</span>
          </div>
          <div class="mobile-solutions-grid">
            {solutionLinks.map(([solutionLabel, solutionHref]) => (
              <a href={solutionHref} class="mobile-solution-item">
                <strong class="sol-title">{solutionLabel.toUpperCase()}</strong>
              </a>
            ))}
          </div>
        </div>

        <!-- Card 3: Hızlı Erişim / Navigasyon -->
        <div class="mobile-myth-card">
          <div class="myth-card-head">
            <span class="myth-card-title">📌 {lang === 'tr' ? 'HIZLI ERİŞİM' : 'NAVIGATION'}</span>
            <span class="myth-card-badge">MENÜ</span>
          </div>
          <div class="mobile-nav-grid">
            {nav.filter(([key]) => key !== 'services').map(([key, label, href]) => (
              <a href={href} class:list={['mobile-nav-item', { active: pageKey === key }]}>
                <strong>{label.toUpperCase()}</strong>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- DESKTOP ONLY NAVIGATION (High Contrast & Clean Chevron) -->
      <div class="desktop-only-nav">
        <div class="nav-solutions-group" data-solutions-nav-group>
          <button class:list={['nav-solutions-parent',{ active: pageKey === 'services' }]} type="button" aria-expanded="false" aria-controls="solutions-panel" data-solutions-toggle>
            <span>{t.services}</span>
            <span class="desktop-chevron" aria-hidden="true">▾</span>
          </button>
          <div id="solutions-panel" class="nav-solutions-menu" aria-label={t.services} data-solutions-menu>
            <div class="nav-solutions-intro"><strong>{t.services}</strong><span>{lang === 'tr' ? 'Ticari kararınızı netleştiren yollar' : lang === 'en' ? 'Commercial paths built around your requirement' : 'Structured commercial paths for your requirement'}</span></div>
            <div class="desktop-solutions-grid">
              {solutionLinks.map(([solutionLabel, solutionHref]) => <a href={solutionHref} class="desktop-solution-item"><span>{solutionLabel}</span><i aria-hidden="true">↗</i></a>)}
            </div>
          </div>
        </div>

        {nav.filter(([key]) => key !== 'services').map(([key, label, href]) => key === 'markets' && (lang === 'en' || lang === 'fa') ? (
          <div class="nav-market-group" data-markets-nav-group>
            <a class:list={['nav-market-parent',{ active: pageKey === key }]} href={href} data-markets-nav-link>{label}</a>
            <div class="nav-market-menu" aria-label="Special market resources">
              <a
                class:list={['fa-market-nav-link',{ active: pageKey === 'iran-sourcing' }]}
                href="/fa/"
                data-fa-nav-link
                data-fa-landing-link
              >
                <strong>{lang === 'fa' ? 'برای کسب‌وکارهای ایرانی' : 'For Iranian Businesses'}</strong>
                <span>{lang === 'fa' ? 'پشتیبانی تجارت بین‌المللی' : 'Persian landing page'}</span>
              </a>
            </div>
          </div>
        ) : (
          <a class:list={['desktop-nav-link', { active: pageKey === key }]} href={href}>{label}</a>
        ))}

        <div class="language-switcher language-switcher-desktop">
          <button type="button" aria-expanded="false" aria-controls="language-panel" aria-label={t.language} data-language-toggle>
            <span class="locale-code">{(['tr','en','de','it','fa','ru'].includes(lang) ? lang : 'en').toUpperCase()}</span>
            <span class="locale-chevron" aria-hidden="true"></span>
          </button>
          <div id="language-panel" class="language-menu" data-language-menu>
            {globalLocales.map((code) => <a
              lang={code}
              hreflang={code}
              class:list={{ active: code === lang }}
              href={globalSwitchPath(code)}
              aria-current={code === lang ? 'true' : undefined}
              data-locale-option
            ><span>{code.toUpperCase()}</span><strong>{globalLocaleNames[code]}</strong><i aria-hidden="true"></i></a>)}
          </div>
        </div>

        <a class="button button-small nav-cta" href={localizedPath(lang, 'contact')}>{t.quote}</a>
      </div>
      {(lang === 'en' || lang === 'fa') && (
        <a class="fa-market-nav-link fa-nav-promo" href="/fa/" data-fa-nav-link data-fa-landing-link>
          <strong>{lang === 'fa' ? 'برای کسب‌وکارهای ایرانی' : 'For Iranian Businesses'}</strong>
          <span>{lang === 'fa' ? 'پشتیبانی تجارت بین‌المللی' : 'Persian landing page'}</span>
        </a>
      )}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const nav = document.querySelector('[data-primary-nav]');
  const closeButton = document.querySelector('[data-mobile-close]');
  const languageToggle = document.querySelector('[data-language-toggle]');
  const languageMenu = document.querySelector('[data-language-menu]');
  const solutionsToggle = document.querySelector('[data-solutions-toggle]');
  const solutionsGroup = document.querySelector('[data-solutions-nav-group]');

  let previousScroll = 0;
  let previousFocus: HTMLElement | null = null;

  const focusable = () => nav ? [...nav.querySelectorAll('a[href], button:not([disabled])')].filter(el => !el.closest('[hidden]')) : [];

  const closeSolutions = (restoreFocus = false) => {
    solutionsToggle?.setAttribute('aria-expanded', 'false');
    solutionsGroup?.classList.remove('is-open');
    if (restoreFocus) (solutionsToggle as HTMLElement)?.focus();
  };

  const closeNavigation = () => {
    if (!nav || !nav.classList.contains('open')) return;
    toggle?.setAttribute('aria-expanded', 'false');
    nav.classList.remove('open');
    nav.setAttribute('aria-hidden', 'true');
    closeSolutions();
    
    setTimeout(() => {
      document.body.classList.remove('menu-open');
      window.scrollTo({ top: previousScroll, behavior: 'instant' });
      if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
    }, 150);
  };

  const openNavigation = () => {
    if (!nav || nav.classList.contains('open')) return;
    previousScroll = window.scrollY;
    previousFocus = document.activeElement as HTMLElement;
    toggle?.setAttribute('aria-expanded', 'true');
    nav.classList.add('open');
    nav.setAttribute('aria-hidden', 'false');
    document.body.classList.add('menu-open');
    (closeButton as HTMLElement)?.focus();
  };

  const closeLanguageMenu = () => {
    languageToggle?.setAttribute('aria-expanded', 'false');
    languageMenu?.classList.remove('open');
  };

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    if (open) closeNavigation();
    else openNavigation();
  });

  closeButton?.addEventListener('click', closeNavigation);

  solutionsToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = solutionsToggle.getAttribute('aria-expanded') === 'true';
    solutionsToggle.setAttribute('aria-expanded', String(!open));
    solutionsGroup?.classList.toggle('is-open', !open);
  });

  languageToggle?.addEventListener('click', () => {
    const open = languageToggle.getAttribute('aria-expanded') === 'true';
    languageToggle.setAttribute('aria-expanded', String(!open));
    languageMenu?.classList.toggle('open', !open);
  });

  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNavigation));

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (!document.querySelector('.language-switcher')?.contains(event.target)) {
      closeLanguageMenu();
    }
    if (!document.querySelector('.nav-solutions-group')?.contains(event.target)) {
      closeSolutions();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav?.classList.contains('open')) {
      closeLanguageMenu();
      closeSolutions(true);
      closeNavigation();
    }
    if (event.key === 'Tab' && nav?.classList.contains('open')) {
      const items = focusable();
      if (items.length > 0) {
        const first = items[0] as HTMLElement;
        const last = items[items.length - 1] as HTMLElement;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    }
  });

  const isTouchDevice = () => 'ontouchstart' in window || navigator.maxTouchPoints > 0;
  const marketParent = document.querySelector('.nav-market-parent');
  const marketGroup = document.querySelector('.nav-market-group');
  if (marketParent && marketGroup) {
    marketParent.addEventListener('click', (e) => {
      if (isTouchDevice() && window.innerWidth > 1050) {
        if (!marketGroup.classList.contains('touch-open')) {
          e.preventDefault();
          marketGroup.classList.add('touch-open');
        }
      }
    });
    document.addEventListener('click', (e) => {
      if (marketGroup.classList.contains('touch-open') && !marketGroup.contains(e.target as Node)) {
        marketGroup.classList.remove('touch-open');
      }
    });
  }
</script>

<style is:global>
  @media (min-width: 1051px) {
    .mobile-only-panel,
    .mobile-nav-head,
    .mobile-myth-card,
    .mobile-cta-btn {
      display: none !important;
    }

    .desktop-only-nav {
      display: flex !important;
      align-items: center !important;
      gap: 24px !important;
    }

    .desktop-only-nav a,
    .desktop-nav-link,
    .nav-solutions-parent,
    .nav-market-parent {
      color: #ffffff !important;
      font-size: 0.83rem !important;
      font-weight: 700 !important;
      letter-spacing: 0.05em !important;
      text-transform: uppercase !important;
      opacity: 0.95 !important;
      transition: color 0.2s ease, opacity 0.2s ease !important;
    }

    .desktop-only-nav a:hover,
    .desktop-nav-link:hover,
    .nav-solutions-parent:hover,
    .nav-market-parent:hover {
      color: var(--accent-soft, #e2ca91) !important;
      opacity: 1 !important;
    }

    .desktop-chevron {
      display: inline-block !important;
      font-style: normal !important;
      font-size: 0.75rem !important;
      margin-left: 4px !important;
      transition: transform 0.2s ease !important;
      color: #ffffff !important;
    }

    .nav-solutions-parent[aria-expanded="true"] .desktop-chevron {
      transform: rotate(180deg) !important;
    }

    .nav-solutions-menu {
      width: 320px !important;
      min-width: 320px !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 6px !important;
      background: #141820 !important;
      border: 1.5px solid #363e4d !important;
      border-radius: 14px !important;
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.65) !important;
      padding: 12px !important;
    }

    .nav-solutions-intro {
      grid-column: auto !important;
      display: grid !important;
      gap: 3px !important;
      padding: 4px 6px 10px !important;
      border-bottom: 1px solid #28303f !important;
      margin-bottom: 4px !important;
    }

    .nav-solutions-intro strong {
      color: #ffffff !important;
      font-size: 0.88rem !important;
      font-weight: 800 !important;
    }

    .nav-solutions-intro span {
      color: #a4abb8 !important;
      font-size: 0.75rem !important;
    }

    .desktop-solutions-grid {
      display: flex !important;
      flex-direction: column !important;
      gap: 4px !important;
    }

    .desktop-solutions-grid .desktop-solution-item {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      padding: 10px 12px !important;
      border-radius: 8px !important;
      background: rgba(255, 255, 255, 0.03) !important;
      border: 1px solid rgba(255, 255, 255, 0.05) !important;
      color: #ffffff !important;
      font-weight: 700 !important;
      font-size: 0.84rem !important;
      white-space: nowrap !important;
      transition: all 0.18s ease !important;
    }

    .desktop-solutions-grid .desktop-solution-item span {
      white-space: nowrap !important;
    }

    .desktop-solutions-grid .desktop-solution-item:hover {
      background: #252d3a !important;
      border-color: var(--accent, #91452f) !important;
      color: var(--accent-soft, #e5a17b) !important;
      transform: translateX(4px) !important;
    }
  }

  @media (max-width: 1050px) {
    .desktop-only-nav {
      display: none !important;
    }

    .mobile-only-panel {
      display: flex !important;
      flex-direction: column !important;
      gap: 12px !important;
      width: 100% !important;
    }
  }
</style>
