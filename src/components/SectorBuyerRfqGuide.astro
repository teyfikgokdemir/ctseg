      "זן וגודל, גולמי/קלוי, לחות, אפלטוקסינים ואריזת יצוא.",
      "סוג עופות ושלב גידול (starter/grower/layer), ערכים תזונתיים, כופתיות/פירורים ומפרט.",
      "מספר חלק/שרטוט, חומר וסבולות, תאימות, כמות ובדיקות.",
      "חומר אריזה, נפח, סגירה ומחסום, הדפסה, התאמה למגע עם מזון ודוגמה.",
      "הרכב בד/GSM, מידות, צבע, תפירה, תווית, OEM/מותג פרטי ודוגמאות."
    ]
  },
  "ar": {
    "kicker": "إعداد طلب الشراء",
    "title": "ما المعلومات اللازمة لمقارنة عروض الأسعار في كل قطاع؟",
    "lead": "يساعد تحديد المواصفات الفنية وشروط التسليم على مقارنة عروض RFQ. هذه المتطلبات ليست ضمانًا للمخزون أو الطاقة أو السعر.",
    "fieldLabel": "مواصفات المنتج المطلوبة",
    "common": [
      "الكمية التقريبية ومرونة الحد الأدنى للطلب والطلبات المتكررة",
      "بلد الوجهة والموعد وشروط Incoterms",
      "التحاليل والشهادات والمنشأ ومستندات الدفعة"
    ],
    "explore": "استكشف القطاع والمنتجات",
    "rfq": "إرسال RFQ للقطاع",
    "specs": [
      "نوع الزجاج وسماكته (مم) وأبعاد اللوح: عائم/مقسى/مصفح/Low-E/IGU والمعالجة.",
      "النوع النباتي وINCI، زيت عطري/هيدروسول/زيت حامل، النقاوة وGC-MS/COA/SDS والتعبئة.",
      "السلعة والمنشأ والدرجة وتحاليل المطابقة والتعبئة وتتبع الدفعات.",
      "الصنف والعيار، خام/محمص، الرطوبة والأفلاتوكسين وتعبئة التصدير.",
      "نوع الدواجن ومرحلة التغذية (starter/grower/layer) والقيم الغذائية وحبيبات/فتات والنشرة الفنية.",
      "رقم القطعة/الرسم الهندسي والمادة والتفاوتات والتوافق والكمية والاختبارات.",
      "مادة العبوة وحجمها والإغلاق والحاجز والطباعة وملاءمة ملامسة الأغذية والعينة.",
      "تركيب القماش وGSM والمقاسات واللون والخياطة والملصقات وOEM/العلامة الخاصة والعينات."
    ]
  }
};
const entry = localized[lang] ?? localized.en;
const sectors = getPortfolioSectors(lang);
---
<section class="section buyer-rfq-guide" id="buyer-rfq-guide" data-buyer-rfq-guide>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{entry.kicker}</p>
      <h2>{entry.title}</h2>
      <p>{entry.lead}</p>
    </div>
    <div class="buyer-rfq-grid">
      {ids.map((id,index) => {
        const sector=sectors.find((item)=>item.id===id);
        if(!sector)return null;
        return <article class="buyer-rfq-card" data-buyer-sector={id}>
          <h3>{sector.title}</h3>
          <p class="buyer-rfq-label">{entry.fieldLabel}</p>
          <p class="buyer-rfq-spec">{entry.specs[index]}</p>
          <ul class="buyer-rfq-common">{entry.common.map((item)=><li>{item}</li>)}</ul>
          <div class="buyer-rfq-actions">
            <a href={sector.href} class="text-link">{entry.explore} →</a>
            <a href={sector.rfqHref} class="text-link">{entry.rfq} ↗</a>
          </div>
        </article>;
      })}
    </div>
  </div>
</section>
<style>
  .buyer-rfq-guide{background:#f5f6f2;color:#151915}
  .buyer-rfq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .buyer-rfq-card{display:flex;flex-direction:column;gap:12px;min-width:0;border:1px solid #dbe0d7;background:#fff;border-radius:18px;padding:clamp(18px,2vw,28px)}
  .buyer-rfq-card h3{margin:0;color:#17221b;font-size:clamp(20px,2vw,25px);line-height:1.25}
  .buyer-rfq-label{font-size:12px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:#475348;margin:0}
  .buyer-rfq-spec{color:#28352b;line-height:1.6;margin:0}
  .buyer-rfq-common{display:grid;gap:7px;padding-inline-start:20px;margin:0;color:#435046;line-height:1.5}
  .buyer-rfq-actions{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:auto;padding-top:14px;border-top:1px solid #e3e8e0}
  .buyer-rfq-actions a{color:#204c28;font-weight:700;text-decoration:underline;text-underline-offset:4px}
  .buyer-rfq-actions a:focus-visible{outline:2px solid #17221b;outline-offset:4px}
  @media(max-width:700px){.buyer-rfq-grid{grid-template-columns:1fr}.buyer-rfq-card{padding:20px}}
</style>
