---
import { editorialCopy, type Locale } from '../data/site';
import ResponsiveImage from './ResponsiveImage.astro';
import { FEATURE_IMAGE_WIDTHS, PORTFOLIO_IMAGE } from '../lib/responsive-images';
const { lang } = Astro.props as { lang:Locale };
const copy = editorialCopy[lang];
const label = ({
  tr:'Ticari portföy ve seçili çalışma alanları',
  en:'Trade portfolio and selected mandates',
  de:'Handelsportfolio und ausgewählte Mandate',
  it:'Portfolio commerciale e mandati selezionati',
  ru:'Торговое портфолио и выбранные направления',
  fa:'پرتفوی تجاری و حوزه‌های منتخب',
  zh:'贸易组合与精选业务领域',
  vi:'Danh mục thương mại và các lĩnh vực trọng điểm'
} as Record<string,string>)[lang] || 'Trade portfolio and selected mandates';
---
<section class="portfolio-banner section" aria-label={label}>
  <div class="container portfolio-shell">
    <figure class="portfolio-visual">
      <ResponsiveImage
        src={PORTFOLIO_IMAGE}
        widths={FEATURE_IMAGE_WIDTHS}
        sizes="(max-width:860px) calc(100vw - 36px), min(57vw,820px)"
        width={1536}
        height={1024}
        loading="lazy"
        decoding="async"
        alt=""
      />
      <span class="portfolio-visual-tag">CTSEG · TRADE HOUSE</span>
    </figure>

    <div class="portfolio-copy">
      <p class="eyebrow">CTSEG · Portfolio</p>
      <h2>{copy.portfolioTitle}</h2>
      <p class="portfolio-lead">{copy.portfolioText}</p>
      <div class="portfolio-rule" aria-hidden="true"><span></span></div>
      <p class="portfolio-note">{label}</p>
    </div>
  </div>
</section>

<style is:global>
  .portfolio-banner{
    position:relative;
    overflow:hidden;
    background:#111!important;
    color:#fff;
    border-top:1px solid rgba(255,255,255,.08);
    border-bottom:1px solid rgba(255,255,255,.08)
  }
  .portfolio-banner::before{
    content:"CTSEG";
    position:absolute;
    right:-.04em;
    bottom:-.22em;
    font-family:var(--font-sans,Arial,sans-serif);
    font-size:clamp(150px,25vw,390px);
    line-height:.8;
    font-weight:900;
    letter-spacing:-.09em;
    color:rgba(255,255,255,.025);
    pointer-events:none;
    user-select:none
  }
  .portfolio-shell{
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:minmax(0,1.18fr) minmax(330px,.82fr);
    gap:clamp(40px,6vw,96px);
    align-items:center
  }
  .portfolio-visual{
    position:relative;
    margin:0;
    min-height:clamp(500px,44vw,680px);
    overflow:hidden;
    border-radius:28px;
    background:#1a1a1a;
    box-shadow:0 34px 90px rgba(0,0,0,.32)
  }
  .portfolio-visual::after{
    content:"";
    position:absolute;
    inset:0;
    pointer-events:none;
    background:linear-gradient(180deg,transparent 52%,rgba(0,0,0,.46) 100%);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.1)
  }
  .portfolio-visual picture,.portfolio-visual img{
    display:block;
    width:100%;
    height:100%;
    min-height:clamp(500px,44vw,680px);
    object-fit:cover
  }
  .portfolio-visual img{transition:transform .65s cubic-bezier(.2,.7,.2,1)}
  .portfolio-visual:hover img{transform:scale(1.025)}
  .portfolio-visual-tag{
    position:absolute;
    z-index:2;
    left:22px;
    bottom:20px;
    display:inline-flex;
    align-items:center;
    min-height:34px;
    padding:0 13px;
    border-radius:999px;
    background:#c4f000;
    color:#0a0a0a!important;
    font-size:11px;
    line-height:1;
    font-weight:850;
    letter-spacing:.09em;
    text-transform:uppercase
  }
  .portfolio-copy{max-width:620px}
  .portfolio-copy .eyebrow{
    margin:0 0 22px;
    color:#c4f000!important;
    font-size:12px;
    font-weight:850;
    letter-spacing:.12em;
    text-transform:uppercase
  }
  .portfolio-copy h2{
    margin:0;
    max-width:11ch;
    color:#fff!important;
    font-family:var(--font-sans,Arial,sans-serif);
    font-size:clamp(46px,5.1vw,82px)!important;
    line-height:.96!important;
    font-weight:760;
    letter-spacing:-.055em;
    text-wrap:balance
  }
  .portfolio-lead{
    margin:30px 0 0!important;
    max-width:38em;
    color:#e7e7e7!important;
    font-size:18px!important;
    line-height:1.65!important;
    font-weight:500!important
  }
  .portfolio-rule{
    margin:34px 0 20px;
    width:100%;
    height:1px;
    background:rgba(255,255,255,.12)
  }
  .portfolio-rule span{display:block;width:76px;height:1px;background:#c4f000}
  .portfolio-note{
    margin:0!important;
    color:#c4f000!important;
    font-size:12px!important;
    line-height:1.4!important;
    font-weight:800!important;
    letter-spacing:.08em;
    text-transform:uppercase
  }
  @media(max-width:980px){
    .portfolio-shell{grid-template-columns:1fr;gap:36px}
    .portfolio-copy{max-width:760px}
    .portfolio-copy h2{max-width:15ch}
    .portfolio-visual{min-height:500px}
    .portfolio-visual picture,.portfolio-visual img{min-height:500px}
  }
  @media(max-width:620px){
    .portfolio-banner{padding-block:64px!important}
    .portfolio-shell{gap:28px}
    .portfolio-visual{min-height:390px;border-radius:20px}
    .portfolio-visual picture,.portfolio-visual img{min-height:390px}
    .portfolio-visual-tag{left:16px;bottom:15px;font-size:10px}
    .portfolio-copy h2{font-size:clamp(34px,9.4vw,48px)!important;line-height:1!important;max-width:100%}
    .portfolio-lead{font-size:16px!important;line-height:1.6!important;margin-top:22px!important}
    .portfolio-rule{margin:26px 0 17px}
  }
</style>
