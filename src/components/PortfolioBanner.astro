---
import { editorialCopy, type Locale } from '../data/site';
import ResponsiveImage from './ResponsiveImage.astro';
import { FEATURE_IMAGE_WIDTHS, PORTFOLIO_IMAGE } from '../lib/responsive-images';
const { lang } = Astro.props as { lang:Locale };
const copy = editorialCopy[lang];
const content = ({
  tr:{label:'Ticari portföy ve seçili çalışma alanları',eyebrow:'CTSEG · Seçili çalışma alanları',tag:'CTSEG / TRADE HOUSE',sectors:['Gıda & Tarım','Endüstriyel Tedarik','Medikal','Tekstil & Ev Yaşam']},
  en:{label:'Trade portfolio and selected mandates',eyebrow:'CTSEG · Selected mandates',tag:'CTSEG / TRADE HOUSE',sectors:['Food & Agriculture','Industrial Sourcing','Medical','Textiles & Home']},
  de:{label:'Handelsportfolio und ausgewählte Mandate',eyebrow:'CTSEG · Ausgewählte Mandate',tag:'CTSEG / TRADE HOUSE',sectors:['Lebensmittel & Agrar','Industriebeschaffung','Medizin','Textilien & Wohnen']},
  it:{label:'Portfolio commerciale e mandati selezionati',eyebrow:'CTSEG · Mandati selezionati',tag:'CTSEG / TRADE HOUSE',sectors:['Food & Agricoltura','Sourcing industriale','Medicale','Tessile & Casa']},
  ru:{label:'Торговое портфолио и выбранные направления',eyebrow:'CTSEG · Выбранные направления',tag:'CTSEG / TRADE HOUSE',sectors:['Продукты и агро','Промышленный сорсинг','Медицина','Текстиль и дом']},
  fa:{label:'پرتفوی تجاری و حوزه‌های منتخب',eyebrow:'CTSEG · حوزه‌های منتخب',tag:'CTSEG / TRADE HOUSE',sectors:['غذا و کشاورزی','تأمین صنعتی','پزشکی','نساجی و خانه']},
  zh:{label:'贸易组合与精选业务领域',eyebrow:'CTSEG · 精选业务领域',tag:'CTSEG / TRADE HOUSE',sectors:['食品与农业','工业采购','医疗','纺织与家居']},
  vi:{label:'Danh mục thương mại và các lĩnh vực trọng điểm',eyebrow:'CTSEG · Lĩnh vực trọng điểm',tag:'CTSEG / TRADE HOUSE',sectors:['Thực phẩm & Nông nghiệp','Sourcing công nghiệp','Y tế','Dệt may & Gia dụng']}
} as Record<string,{label:string;eyebrow:string;tag:string;sectors:string[]}>)[lang] || {
  label:'Trade portfolio and selected mandates',eyebrow:'CTSEG · Selected mandates',tag:'CTSEG / TRADE HOUSE',sectors:['Food & Agriculture','Industrial Sourcing','Medical','Textiles & Home']
};
---
<section class="portfolio-banner section" aria-label={content.label}>
  <div class="container portfolio-shell">
    <figure class="portfolio-visual">
      <ResponsiveImage
        src={PORTFOLIO_IMAGE}
        widths={FEATURE_IMAGE_WIDTHS}
        sizes="(max-width:860px) calc(100vw - 36px), min(57vw,820px)"
        width={1536}
        height={1024}
        loading="lazy"
        decoding="async"
        alt=""
      />
      <div class="portfolio-visual-frame" aria-hidden="true"></div>
      <span class="portfolio-visual-tag">{content.tag}</span>
    </figure>

    <div class="portfolio-copy">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2>{copy.portfolioTitle}</h2>
      <p class="portfolio-lead">{copy.portfolioText}</p>
      <div class="portfolio-sector-list" aria-label={content.label}>
        {content.sectors.map((sector) => <span>{sector}</span>)}
      </div>
      <p class="portfolio-note">{content.label}</p>
    </div>
  </div>
</section>

<style is:global>
  .portfolio-banner{position:relative;overflow:hidden;background:#111!important;color:#fff;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08)}
  .portfolio-banner::before{content:"MANDATES";position:absolute;right:-.04em;bottom:-.2em;font-family:var(--font-sans,Arial,sans-serif);font-size:clamp(120px,20vw,340px);line-height:.8;font-weight:900;letter-spacing:-.08em;color:rgba(255,255,255,.022);pointer-events:none;user-select:none}
  .portfolio-shell{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.12fr) minmax(350px,.88fr);gap:clamp(42px,6vw,98px);align-items:center}
  .portfolio-visual{position:relative;margin:0;min-height:clamp(500px,44vw,680px);overflow:hidden;border-radius:30px;background:#1a1a1a;box-shadow:0 34px 90px rgba(0,0,0,.32)}
  .portfolio-visual::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,transparent 42%,rgba(0,0,0,.52) 100%);box-shadow:inset 0 0 0 1px rgba(255,255,255,.1)}
  .portfolio-visual-frame{position:absolute;inset:15px;z-index:2;border:1px solid rgba(255,255,255,.11);border-radius:20px;pointer-events:none}
  .portfolio-visual picture,.portfolio-visual img{display:block;width:100%;height:100%;min-height:clamp(500px,44vw,680px);object-fit:cover}
  .portfolio-visual img{transition:transform .75s cubic-bezier(.2,.7,.2,1),filter .75s ease}
  .portfolio-visual:hover img{transform:scale(1.035);filter:saturate(1.04)}
  .portfolio-visual-tag{position:absolute;z-index:3;left:28px;bottom:25px;display:inline-flex;align-items:center;min-height:36px;padding:0 14px;border-radius:999px;background:#c4f000;color:#0a0a0a!important;font-size:10px;line-height:1;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
  .portfolio-copy{max-width:650px}
  .portfolio-copy .eyebrow{margin:0 0 22px;color:#c4f000!important;font-size:12px;font-weight:850;letter-spacing:.12em;text-transform:uppercase}
  .portfolio-copy h2{margin:0;max-width:11ch;color:#fff!important;font-family:var(--font-sans,Arial,sans-serif);font-size:clamp(46px,5vw,80px)!important;line-height:.96!important;font-weight:760;letter-spacing:-.055em;text-wrap:balance}
  .portfolio-lead{margin:30px 0 0!important;max-width:38em;color:#e7e7e7!important;font-size:18px!important;line-height:1.65!important;font-weight:500!important}
  .portfolio-sector-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:34px}
  .portfolio-sector-list span{position:relative;display:flex;align-items:center;min-height:54px;padding:13px 16px 13px 38px;border:1px solid rgba(255,255,255,.13);border-radius:14px;background:rgba(255,255,255,.025);color:#efefeb;font-size:13px;font-weight:700;line-height:1.3}
  .portfolio-sector-list span::before{content:"";position:absolute;left:16px;width:8px;height:8px;border-radius:50%;background:#c4f000;box-shadow:0 0 0 5px rgba(196,240,0,.07)}
  .portfolio-note{margin:24px 0 0!important;padding-top:20px;border-top:1px solid rgba(255,255,255,.12);color:#9d9d97!important;font-size:11px!important;line-height:1.5!important;font-weight:750!important;letter-spacing:.08em;text-transform:uppercase}
  :global(html[dir="rtl"]) .portfolio-banner::before{right:auto;left:-.04em}
  :global(html[dir="rtl"]) .portfolio-visual-tag{left:auto;right:28px}
  :global(html[dir="rtl"]) .portfolio-sector-list span{padding:13px 38px 13px 16px}
  :global(html[dir="rtl"]) .portfolio-sector-list span::before{left:auto;right:16px}
  @media(max-width:980px){.portfolio-shell{grid-template-columns:1fr;gap:38px}.portfolio-copy{max-width:780px}.portfolio-copy h2{max-width:15ch}.portfolio-visual{min-height:500px}.portfolio-visual picture,.portfolio-visual img{min-height:500px}}
  @media(max-width:620px){.portfolio-banner{padding-block:64px!important}.portfolio-shell{gap:28px}.portfolio-visual{min-height:390px;border-radius:20px}.portfolio-visual picture,.portfolio-visual img{min-height:390px}.portfolio-visual-frame{inset:10px;border-radius:13px}.portfolio-visual-tag{left:18px;bottom:17px;font-size:9px}.portfolio-copy h2{font-size:clamp(34px,9.4vw,48px)!important;line-height:1!important;max-width:100%}.portfolio-lead{font-size:16px!important;line-height:1.6!important;margin-top:22px!important}.portfolio-sector-list{grid-template-columns:1fr;margin-top:28px}.portfolio-sector-list span{min-height:50px}.portfolio-note{margin-top:20px!important}:global(html[dir="rtl"]) .portfolio-visual-tag{right:18px}}
</style>
