---
import BaseLayout from '../../layouts/BaseLayout.astro';
const services=[['Stratejik Tedarik','Doğru üretici, doğru maliyet ve sürdürülebilir tedarik yapısı.'],['Uluslararası Ticaret','Pazar, tedarikçi ve operasyon arasında uçtan uca koordinasyon.'],['Tedarikçi Geliştirme','Kalite, kapasite, termin ve ticari performansı birlikte iyileştirme.'],['Maliyet Optimizasyonu','Toplam sahip olma maliyetini görünür ve yönetilebilir hale getirme.'],['Pazar Girişi','Yeni pazarlara kontrollü, veriye dayalı ve uygulanabilir giriş planı.'],['Operasyonel Danışmanlık','Satın alma ve ticaret süreçlerini ölçeklenebilir sisteme dönüştürme.']];
const process=[['01','İhtiyacı netleştir'],['02','Pazarı ve tedarikçileri tara'],['03','Doğrula ve karşılaştır'],['04','Müzakere et ve uygula']];
---
<BaseLayout lang="tr" title="CTSEG | Stratejik Tedarik ve Uluslararası Ticaret" description="CTSEG; stratejik tedarik, satın alma, tedarikçi geliştirme ve uluslararası ticaret çözümleri sunar." canonical="https://ctseg.com.tr/tr/" alternate="https://ctseg.com.tr/en/">
<header class="site-header"><div class="wrap nav"><a class="brand" href="/tr/" aria-label="CTSEG ana sayfa"><img src="/images/ctseg-logo-transparent.png" width="1063" height="342" alt="CTSEG" /></a><nav class="nav-links"><a href="#hizmetler">Hizmetler</a><a href="#yaklasim">Yaklaşım</a><a href="#surec">Süreç</a><a href="#iletisim">İletişim</a><a class="lang" href="/en/">EN</a></nav></div></header>
<main>
<section class="hero"><div class="hero-orbit hero-orbit--one"></div><div class="hero-orbit hero-orbit--two"></div><div class="wrap hero-grid"><div><p class="eyebrow">Strategic sourcing · Procurement · International trade</p><h1>Tedariki, ticareti ve büyümeyi <span>tek sistemde</span> yönetin.</h1><p class="lead">CTSEG, şirketlerin doğru tedarikçilere ulaşmasını, maliyetlerini kontrol etmesini ve uluslararası ticaret operasyonlarını daha güvenli ve ölçeklenebilir hale getirmesini sağlar.</p><div class="actions"><a class="btn" href="mailto:info@ctseg.com.tr">Görüşme planla</a><a class="btn secondary" href="#hizmetler">Hizmetleri incele</a></div><div class="trust-row"><span>Türkiye merkezli</span><span>B2B odaklı</span><span>Uluslararası erişim</span></div></div><aside class="signal-panel"><div class="signal-panel__top"><span>CTSEG Signal Room</span><span class="live-dot">Canlı</span></div><div class="signal-item"><small>Tedarikçi ağı</small><strong>Doğrulama</strong><span>Aktif</span></div><div class="signal-item"><small>Maliyet görünürlüğü</small><strong>Karşılaştırma</strong><span>İzleniyor</span></div><div class="signal-item"><small>Ticari risk</small><strong>Kontrol</strong><span>Yönetiliyor</span></div><div class="signal-line"></div><p>Veri, müzakere ve uygulama aynı karar sistemi içinde ilerler.</p></aside></div></section>
<section class="brand-strip"><div class="strip-track"><span>STRATEGIC SOURCING</span><span>PROCUREMENT</span><span>SUPPLIER DEVELOPMENT</span><span>INTERNATIONAL TRADE</span><span>COST OPTIMISATION</span><span>MARKET ENTRY</span></div></section>
<section id="hizmetler"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Uzmanlık alanları</p><h2>Tedarikten pazara kadar.</h2></div><p class="section-intro">Parçalı hizmetler yerine, karar kalitesini ve ticari sonucu birlikte güçlendiren bütüncül bir yapı.</p></div><div class="grid">{services.map(([h,p],i)=><article class="card"><span class="card-index">0{i+1}</span><h3>{h}</h3><p>{p}</p><span class="card-arrow">↗</span></article>)}</div></div></section>
<section id="yaklasim" class="dark-panel"><div class="wrap split"><div><p class="eyebrow">Yaklaşım</p><h2>Sadece tedarikçi bulmak değil, çalışan bir ticaret sistemi kurmak.</h2><p class="section-intro">İhtiyaç analizi, pazar taraması, tedarikçi doğrulama, teklif karşılaştırma, müzakere, risk yönetimi ve performans takibi aynı çerçevede ilerler.</p></div><div class="facts"><div class="fact"><span>01</span><div><strong>Net kapsam</strong><p>Hedef, kriter ve karar mekanizması baştan tanımlanır.</p></div></div><div class="fact"><span>02</span><div><strong>Doğrulanabilir veri</strong><p>Öneriler varsayıma değil, ticari kanıta dayanır.</p></div></div><div class="fact"><span>03</span><div><strong>Uygulanabilir sonuç</strong><p>Rapor değil, hayata geçirilebilir yol haritası üretilir.</p></div></div></div></div></section>
<section id="surec"><div class="wrap"><p class="eyebrow">Çalışma modeli</p><h2>Dört adımda daha güçlü ticari karar.</h2><div class="process-grid">{process.map(([n,t])=><article><span>{n}</span><h3>{t}</h3></article>)}</div></div></section>
<section class="cta-section" id="iletisim"><div class="wrap cta-card"><div><p class="eyebrow">İletişim</p><h2>Bir sonraki ticari kararınızı daha güçlü verin.</h2><p class="section-intro">Tedarik, satın alma veya uluslararası ticaret ihtiyacınızı paylaşın.</p></div><a class="btn btn-large" href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div></section>
</main><footer><div class="wrap footer-grid"><img src="/images/ctseg-logo-transparent.png" alt="CTSEG" width="1063" height="342"/><p>© 2026 CTSEG. Tüm hakları saklıdır.</p><a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div></footer>
</BaseLayout>
