import BaseLayout from '../../layouts/BaseLayout.astro';
const services=[['Stratejik Tedarik','Doğru üretici, doğru maliyet ve sürdürülebilir tedarik yapısı.'],['Uluslararası Ticaret','Pazar, tedarikçi ve operasyon arasında uçtan uca koordinasyon.'],['Tedarikçi Geliştirme','Kalite, kapasite, termin ve ticari performansı birlikte iyileştirme.'],['Maliyet Optimizasyonu','Toplam sahip olma maliyetini görünür ve yönetilebilir hale getirme.'],['Pazar Girişi','Yeni pazarlara kontrollü, veriye dayalı ve uygulanabilir giriş planı.'],['Operasyonel Danışmanlık','Satın alma ve ticaret süreçlerini ölçeklenebilir sisteme dönüştürme.']];
---
<BaseLayout lang="tr" title="CTSEG | Stratejik Tedarik ve Uluslararası Ticaret" description="CTSEG; stratejik tedarik, satın alma, tedarikçi geliştirme ve uluslararası ticaret çözümleri sunar." canonical="https://ctseg.com.tr/tr/" alternate="https://ctseg.com.tr/en/">
<header class="site-header"><div class="wrap nav"><a class="brand" href="/tr/" aria-label="CTSEG ana sayfa"><img src="/images/ctseg-logo-transparent.png" width="1063" height="342" alt="CTSEG" /></a><nav class="nav-links"><a href="#hizmetler">Hizmetler</a><a href="#yaklasim">Yaklaşım</a><a href="#iletisim">İletişim</a><a class="lang" href="/en/">EN</a></nav></div></header>
<main><section class="hero"><div class="wrap"><p class="eyebrow">Strategic sourcing · Procurement · International trade</p><h1>Tedariki, ticareti ve büyümeyi tek sistemde yönetin.</h1><p class="lead">CTSEG, şirketlerin doğru tedarikçilere ulaşmasını, maliyetlerini kontrol etmesini ve uluslararası ticaret operasyonlarını daha güvenli ve ölçeklenebilir hale getirmesini sağlar.</p><div class="actions"><a class="btn" href="mailto:info@ctseg.com.tr">Görüşme planla</a><a class="btn secondary" href="#hizmetler">Hizmetleri incele</a></div></div></section>
<section id="hizmetler"><div class="wrap"><p class="eyebrow">Uzmanlık alanları</p><h2>Tedarikten pazara kadar.</h2><p class="section-intro">Parçalı hizmetler yerine, karar kalitesini ve ticari sonucu birlikte güçlendiren bütüncül bir yapı.</p><div class="grid">{services.map(([h,p])=><article class="card"><h3>{h}</h3><p>{p}</p></article>)}</div></div></section>
<section id="yaklasim"><div class="wrap split"><div><p class="eyebrow">Yaklaşım</p><h2>Sadece tedarikçi bulmak değil, çalışan bir ticaret sistemi kurmak.</h2><p class="section-intro">İhtiyaç analizi, pazar taraması, tedarikçi doğrulama, teklif karşılaştırma, müzakere, risk yönetimi ve performans takibi aynı çerçevede ilerler.</p></div><div class="facts"><div class="fact"><strong>Net kapsam</strong><br/>Hedef, kriter ve karar mekanizması baştan tanımlanır.</div><div class="fact"><strong>Doğrulanabilir veri</strong><br/>Öneriler varsayıma değil, ticari kanıta dayanır.</div><div class="fact"><strong>Uygulanabilir sonuç</strong><br/>Rapor değil, hayata geçirilebilir yol haritası üretilir.</div></div></div></section>
<section id="iletisim"><div class="wrap"><p class="eyebrow">İletişim</p><h2>Bir sonraki ticari kararınızı daha güçlü verin.</h2><p class="section-intro">Tedarik, satın alma veya uluslararası ticaret ihtiyacınızı paylaşın.</p><div class="actions"><a class="btn" href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div></div></section></main><footer><div class="wrap">© 2026 CTSEG. Tüm hakları saklıdır.</div></footer>
</BaseLayout>
