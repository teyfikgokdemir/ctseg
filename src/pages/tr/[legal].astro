---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return ['gizlilik-politikasi', 'cerez-politikasi', 'kullanim-kosullari', 'kvkk'].map((legal) => ({ params: { legal } }));
}

const pages = {
  'gizlilik-politikasi': {
    title: 'Gizlilik Politikası',
    description: 'CTSEG web sitesi gizlilik ve kişisel veri işleme politikası.',
    sections: [
      ['Kapsam ve veri sorumlusu', 'Bu politika, ctseg.com.tr alan adlı web sitesinin kullanımı sırasında işlenen kişisel verilere ilişkindir. Veri sorumlusu, CTSEG markası kapsamında web sitesini işleten gerçek veya tüzel kişidir. Veri koruma ve başvuru iletişim adresi info@ctseg.com.tr’dir.'],
      ['İşlenen veri kategorileri', 'İletişim kurulması halinde ad, soyad, e-posta adresi, telefon, şirket, unvan, talep ve mesaj bilgileri; site kullanımı sırasında IP adresi, tarih-saat, cihaz, tarayıcı, yönlendiren sayfa ve güvenlik günlükleri gibi teknik işlem verileri işlenebilir.'],
      ['İşleme amaçları ve hukuki sebepler', 'Veriler; iletişim taleplerini yanıtlamak, teklif ve iş ilişkisi süreçlerini yürütmek, hizmet sunmak, bilgi güvenliğini sağlamak, hukuki yükümlülükleri yerine getirmek ve hakları tesis, kullanma veya korumak amacıyla işlenir. İşleme faaliyetleri 6698 sayılı Kanun’un 5. maddesindeki sözleşmenin kurulması veya ifası, hukuki yükümlülük, bir hakkın tesisi veya korunması ve meşru menfaat şartlarına; gerektiğinde açık rızaya dayanır.'],
      ['Aktarım ve yurt dışı hizmet sağlayıcılar', 'Veriler, yalnızca gerekli olduğu ölçüde barındırma, e-posta, güvenlik, teknik destek ve danışmanlık hizmeti sağlayan taraflarla, yetkili kamu kurumlarıyla ve hukuken yetkili kişilerle paylaşılabilir. Kullanılan bulut veya altyapı hizmetleri nedeniyle yurt dışına aktarım söz konusu olursa yürürlükteki mevzuatta öngörülen uygun güvenceler uygulanır.'],
      ['Saklama ve güvenlik', 'Veriler, işleme amacının gerektirdiği süre ve ilgili mevzuatta öngörülen zamanaşımı veya saklama süreleri boyunca tutulur; süre sonunda silinir, yok edilir veya anonim hale getirilir. Yetkisiz erişimi önlemek amacıyla makul teknik ve idari tedbirler uygulanır.'],
      ['Haklar ve başvuru', 'İlgili kişiler 6698 sayılı Kanun’un 11. maddesi kapsamındaki bilgi alma, düzeltme, silme, yok etme, aktarılan üçüncü kişileri öğrenme, itiraz ve zarar halinde tazminat talep etme haklarını info@ctseg.com.tr adresine kimlik ve talep kapsamını doğrulayacak bilgilerle iletebilir.']
    ]
  },
  'cerez-politikasi': {
    title: 'Çerez Politikası',
    description: 'CTSEG web sitesinde kullanılan çerezler ve tercih yönetimi hakkında bilgi.',
    sections: [
      ['Çerez nedir?', 'Çerezler, bir web sitesi ziyaret edildiğinde tarayıcı veya cihaz üzerinde saklanabilen küçük metin dosyalarıdır. Benzer teknolojiler yerel depolama, piksel ve güvenlik tanımlayıcılarını içerebilir.'],
      ['Zorunlu çerezler', 'Site güvenliği, ağ yönetimi, dil veya oturum tercihi ve temel işlevlerin çalışması için kesinlikle gerekli çerezler kullanılabilir. Bu çerezler hizmetin sunulması için gerekli olduğundan ayrıca açık rızaya dayanmaz.'],
      ['Analitik ve pazarlama çerezleri', 'Analitik, kişiselleştirme veya pazarlama çerezleri ancak kullanılmaya başlanmaları halinde ve gerekli olduğu ölçüde kullanıcının önceden verdiği açık rıza sonrasında etkinleştirilir. Kabul etme, reddetme ve tercihleri yönetme seçenekleri eşit ve erişilebilir biçimde sunulur.'],
      ['Çerez bilgileri ve süreler', 'Kullanılan çerezlerin adı, sağlayıcısı, amacı, türü ve saklama süresi çerez tercih panelinde veya bu politika güncellendiğinde ayrıca gösterilir. Şu anda site temel işlev ve güvenlik amacı dışındaki çerezleri kullanmıyorsa analitik veya reklam takibi yapılmaz.'],
      ['Tercihlerin yönetimi', 'Kullanıcılar tarayıcı ayarlarından çerezleri silebilir veya engelleyebilir. Zorunlu olmayan çerezler için verilen rıza her zaman geri alınabilir. Zorunlu çerezlerin engellenmesi sitenin bazı bölümlerinin çalışmasını etkileyebilir.']
    ]
  },
  'kullanim-kosullari': {
    title: 'Kullanım Koşulları',
    description: 'CTSEG web sitesi kullanım koşulları ve hukuki bildirimler.',
    sections: [
      ['Kabul ve kapsam', 'Bu web sitesini kullanarak yürürlükteki mevzuata ve bu koşullara uygun hareket etmeyi kabul edersiniz. Site içeriği genel bilgilendirme amaçlıdır; tek başına hukuki, mali, teknik veya ticari danışmanlık, teklif ya da bağlayıcı taahhüt oluşturmaz.'],
      ['Hizmet ve sözleşme ilişkisi', 'CTSEG hizmetlerinin kapsamı, süresi, ücreti, teslimatı ve tarafların sorumlulukları yalnızca ayrıca imzalanan teklif, sipariş, sözleşme veya yazılı teyit ile belirlenir. Web sitesindeki açıklamalar belirli bir sonucun garanti edildiği anlamına gelmez.'],
      ['Fikri mülkiyet', 'CTSEG adı, logosu, marka unsurları, tasarım, yazılım, metin, grafik ve diğer içerikler aksi açıkça belirtilmedikçe CTSEG’e veya ilgili hak sahiplerine aittir. Yazılı izin olmaksızın ticari amaçla çoğaltılamaz, değiştirilemez veya dağıtılamaz.'],
      ['Kullanıcı yükümlülükleri', 'Siteye zarar verecek, güvenliği ihlal edecek, yetkisiz erişim sağlayacak, yanıltıcı veri gönderecek veya üçüncü kişilerin haklarını ihlal edecek faaliyetlerde bulunulamaz.'],
      ['Sorumluluğun sınırı ve dış bağlantılar', 'Bilgilerin doğru ve güncel tutulması için makul çaba gösterilir; ancak kesintisizlik, eksiksizlik veya belirli bir amaca uygunluk garantisi verilmez. Üçüncü taraf sitelerin içerik, güvenlik ve uygulamalarından ilgili taraflar sorumludur.'],
      ['Değişiklik ve uygulanacak hukuk', 'Koşullar gerektiğinde güncellenebilir ve yayımlandığı tarihte yürürlüğe girer. Emredici hukuk kuralları saklı kalmak üzere Türkiye Cumhuriyeti hukuku uygulanır.']
    ]
  },
  kvkk: {
    title: 'KVKK Aydınlatma Metni',
    description: '6698 sayılı Kanun kapsamında CTSEG kişisel veri işleme aydınlatma metni.',
    sections: [
      ['1. Veri sorumlusunun kimliği', '6698 sayılı Kişisel Verilerin Korunması Kanunu kapsamında veri sorumlusu, CTSEG markası kapsamında ctseg.com.tr web sitesini işleten gerçek veya tüzel kişidir. İletişim ve başvuru adresi info@ctseg.com.tr’dir.'],
      ['2. İşlenen kişisel veriler', 'Kimlik, iletişim, şirket ve mesleki bilgi, talep ve mesaj içeriği, teklif veya iş ilişkisi bilgileri ile IP adresi, cihaz, tarayıcı, tarih-saat, yönlendiren sayfa ve güvenlik kaydı gibi işlem güvenliği verileri işlenebilir.'],
      ['3. İşleme amaçları', 'Kişisel veriler iletişim taleplerinin yanıtlanması, teklif ve sözleşme süreçlerinin yürütülmesi, hizmetlerin planlanması ve sunulması, tedarikçi veya iş ortağı ilişkilerinin yönetilmesi, bilgi güvenliği, hukuki yükümlülükler ve uyuşmazlık süreçleri amaçlarıyla işlenir.'],
      ['4. Toplama yöntemi ve hukuki sebep', 'Veriler web sitesi, e-posta, telefon, çevrim içi görüşme, formlar ve teknik günlükler üzerinden otomatik veya kısmen otomatik yollarla toplanabilir. Hukuki sebepler; sözleşmenin kurulması veya ifası, hukuki yükümlülük, bir hakkın tesisi, kullanılması veya korunması, temel haklara zarar vermemek kaydıyla meşru menfaat ve gerekli hallerde açık rızadır. Aydınlatma ile açık rıza ayrı süreçlerdir.'],
      ['5. Aktarım', 'Veriler, işleme amaçlarıyla sınırlı olmak üzere altyapı, barındırma, e-posta, güvenlik, muhasebe, hukuk ve teknik destek sağlayıcılarına, sözleşme taraflarına ve yetkili kamu kurumlarına aktarılabilir. Yurt dışı aktarımında Kanun’un ilgili hükümleri ve uygun güvence mekanizmaları uygulanır.'],
      ['6. İlgili kişinin hakları', 'Kanun’un 11. maddesi uyarınca verilerinizin işlenip işlenmediğini öğrenme, bilgi talep etme, amacı ve amaca uygun kullanımı öğrenme, aktarılan kişileri bilme, düzeltme, silme veya yok etme, bu işlemlerin üçüncü kişilere bildirilmesini isteme, otomatik sonuçlara itiraz etme ve zarar halinde tazminat talep etme haklarına sahipsiniz.'],
      ['7. Başvuru yöntemi', 'Başvurularınızı ad-soyad, iletişim bilgisi, talebin konusu ve kimliği doğrulamaya elverişli bilgilerle info@ctseg.com.tr adresine iletebilirsiniz. Başvurular mevzuatta öngörülen süre içinde ücretsiz olarak sonuçlandırılır; ayrıca maliyet doğması halinde yetkili tarife uygulanabilir.']
    ]
  }
} as const;

const key = Astro.params.legal as keyof typeof pages;
const page = pages[key];
if (!page) return Astro.redirect('/tr/', 302);
---
<BaseLayout lang="tr" title={`${page.title} | CTSEG`} description={page.description} canonical={`https://ctseg.com.tr/tr/${key}/`} alternate={`https://ctseg.com.tr/en/${key === 'gizlilik-politikasi' ? 'privacy-policy' : key === 'cerez-politikasi' ? 'cookie-policy' : key === 'kullanim-kosullari' ? 'terms' : 'data-protection-notice'}/`}>
<header class="site-header"><div class="wrap nav"><a class="brand" href="/tr/"><img src="/images/ctseg-logo-transparent.png" width="1063" height="342" alt="CTSEG" /></a><nav class="nav-links"><div class="nav-menu"><a href="/tr/#hizmetler">Hizmetler</a><div class="nav-dropdown"><a href="/tr/hizmetler/stratejik-tedarik/">Stratejik Tedarik</a><a href="/tr/hizmetler/tedarikci-bulma-ve-dogrulama/">Tedarikçi Bulma ve Doğrulama</a><a href="/tr/hizmetler/uluslararasi-ticaret-danismanligi/">Uluslararası Ticaret Danışmanlığı</a></div></div><a href="/tr/blog/">Blog</a><a class="lang" href="/en/">EN</a></nav></div></header>
<main class="legal-page"><div class="wrap legal-wrap"><p class="eyebrow">Yasal bilgiler</p><h1>{page.title}</h1><p class="legal-updated">Son güncelleme: 25 Temmuz 2026</p>{page.sections.map(([heading, body]) => <section class="legal-section"><h2>{heading}</h2><p>{body}</p></section>)}<p class="legal-contact">Başvuru ve sorular: <a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></p></div></main>
<footer><div class="wrap footer-grid"><img src="/images/ctseg-logo-transparent.png" alt="CTSEG" width="1063" height="342"/><p>© 2026 CTSEG. Tüm hakları saklıdır.</p><a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div><nav class="wrap footer-legal" aria-label="Yasal bağlantılar"><a href="/tr/gizlilik-politikasi/">Gizlilik Politikası</a><a href="/tr/cerez-politikasi/">Çerez Politikası</a><a href="/tr/kullanim-kosullari/">Kullanım Koşulları</a><a href="/tr/kvkk/">KVKK</a><a href="/tr/blog/">Blog</a></nav></footer>
</BaseLayout>