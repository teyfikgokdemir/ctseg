---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const products=[['İran Yeşil Soyulmuş İç Fıstık','Gelato, pastacılık, çikolata ve premium gıda üretimi için.','/tr/ticari-urunler/iran-yesil-soyulmus-ic-fistik/'],['İran Kırık İç Fıstık','Endüstriyel kullanım, krema, çikolata ve pastacılık için.','/tr/ticari-urunler/iran-kirik-ic-fistik/'],['Mazafati Hurması','Perakende, HORECA ve gıda işleme için premium İran hurması.','/tr/ticari-urunler/mazafati-hurmasi/']];
const schema={'@context':'https://schema.org','@type':'CollectionPage','name':'CTSEG Ticari Ürünler','url':'https://ctseg.com.tr/tr/ticari-urunler/','description':'İran ve bölgesel pazarlardan doğrulanabilir B2B kuruyemiş, kuru meyve ve gıda ürünü tedariki.'};
---
<BaseLayout lang="tr" title="Ticari Ürünler ve B2B Gıda Tedariği | CTSEG" description="İran menşeli Antep fıstığı, Mazafati hurması ve seçili gıda ürünleri için B2B tedarik, kalite doğrulama ve lojistik koordinasyonu." canonical="https://ctseg.com.tr/tr/ticari-urunler/" alternate="https://ctseg.com.tr/en/trade-products/" schema={[schema]}>
<main class="catalog"><section class="hero"><div class="wrap"><p>CTSEG Trade Products</p><h1>Doğrulanabilir ürün. Kontrollü tedarik. Uluslararası teslimat.</h1><span>Stok iddiası yerine üretici, parti, kalite, belge ve teslim koşullarını ticari talebe göre doğruluyoruz.</span></div></section><section class="section"><div class="wrap"><div class="head"><p>B2B ürün portföyü</p><h2>Seçili kuruyemiş ve kuru meyve ürünleri.</h2></div><div class="grid">{products.map(([name,copy,url],i)=><a href={url}><small>0{i+1}</small><h3>{name}</h3><p>{copy}</p><strong>Ürünü incele ↗</strong></a>)}</div></div></section><section class="cta"><div class="wrap"><h2>Listede olmayan bir ürün mü arıyorsunuz?</h2><p>Ürün, teknik özellik, miktar ve teslim ülkesini paylaşın; uygun üretici ve tedarik modelini araştıralım.</p><a href="mailto:info@ctseg.com.tr">Tedarik talebi oluştur</a></div></section></main>
<style>.catalog{background:#070b11;color:#f5f7fa;min-height:100vh}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}.hero{padding:130px 0 110px;background:radial-gradient(circle at 80% 10%,rgba(227,10,23,.2),transparent 30rem),linear-gradient(145deg,#070b11,#111a25)}.hero p,.head p{color:#ff8b91;font-size:12px;font-weight:850;letter-spacing:.16em;text-transform:uppercase}.hero h1,.head h2,.cta h2{max-width:1000px;margin:16px 0 24px;font-size:clamp(46px,7vw,92px);line-height:.98;letter-spacing:-.055em}.hero span{display:block;max-width:760px;color:#b9c3cf;font-size:21px;line-height:1.65}.section{padding:100px 0}.head h2,.cta h2{font-size:clamp(38px,5vw,66px)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.grid a{padding:30px;border:1px solid #2b3541;border-radius:24px;background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.015))}.grid small{color:#ff8b91}.grid h3{font-size:25px}.grid p{color:#b7c1cd;line-height:1.7}.grid strong{display:block;margin-top:28px}.cta{padding:100px 0;text-align:center;border-top:1px solid #252e39;background:#0b121b}.cta h2,.cta p{margin-inline:auto}.cta p{max-width:700px;color:#b7c1cd;font-size:18px}.cta a{display:inline-flex;margin-top:22px;padding:14px 24px;border-radius:999px;background:#e30a17;color:#fff;font-weight:850}@media(max-width:800px){.grid{grid-template-columns:1fr}.wrap{width:min(1160px,calc(100% - 24px))}.hero{padding:90px 0}.section,.cta{padding:72px 0}}</style>
</BaseLayout>
