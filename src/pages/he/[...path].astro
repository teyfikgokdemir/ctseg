---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommercialRequestForm from '../../components/CommercialRequestForm.astro';
import {
  serviceMap, productMap, productProfiles, productGroups, israelProductIds, legalMap, staticPages,
  marketCorridors, howWeWork, scenarios, aboutData, contactData, insightThemes
} from '../../data/hebrew';

export function getStaticPaths(){
  const paths = staticPages.map(p=>({params:{path:p.path},props:{type:'static',data:p}}));
  for(const [id,s] of Object.entries(serviceMap)) paths.push({params:{path:`שירותים/${s.slug}`},props:{type:'service',data:{...s,id}}});
  for(const [id,p] of Object.entries(productMap)) if(israelProductIds.includes(id)) paths.push({params:{path:`מוצרים-מסחריים/${id}`},props:{type:'product',data:{id,name:p[0],desc:p[1]}}});
  for(const [id,l] of Object.entries(legalMap)) paths.push({params:{path:l.slug},props:{type:'legal',data:{...l,id}}});
  return paths;
}
const {type,data}=Astro.props;
const canonical=`https://ctseg.com.tr/he/${Astro.params.path}/`;
const pageKey = type === 'service' ? 'services' : type === 'product' ? 'products' : type === 'legal' ? 'legal' : data.key;
const pageId = type === 'service' || type === 'product' || type === 'legal' ? data.id : undefined;
const title=`${data.title || data.name} | CTSEG`;
const legalDescriptions:Record<string,string> = {
  privacy:'מדיניות הפרטיות של CTSEG מסבירה כיצד מידע אישי ופניות מסחריות נאספים, משמשים ונשמרים באתר.',
  cookies:'מדיניות העוגיות של CTSEG מסבירה שימוש בעוגיות חיוניות, מדידה והעדפות משתמש באתר.',
  terms:'תנאי השימוש באתר CTSEG מגדירים את אופי המידע המסחרי, מגבלות השימוש והאחריות.',
  'data-protection':'הודעת הגנת המידע של CTSEG מפרטת עיבוד מידע, אבטחה, שמירה וזכויות משתמשים.'
};
const description=type === 'legal' ? legalDescriptions[data.id] : (data.lead || data.desc || 'CTSEG · סחר B2B בין ישראל לטורקיה, איתור ורכש, אימות ספקים וכניסה לשוק.');
const services=Object.entries(serviceMap);
const products=Object.entries(productMap).filter(([id])=>israelProductIds.includes(id));
const productProfile = type === 'product' ? productProfiles[data.id] : null;
const legalSections = type === 'legal' ? legalMap[data.id].sections : [];
---
<BaseLayout lang="he" title={title} description={description} pageKey={pageKey} pageId={pageId} canonical={canonical}>
<section class="page-hero he-standard-page"><div class="container">
  <p class="eyebrow">CTSEG · ישראל ⇄ טורקיה</p>
  <h1>{data.title || data.name}</h1>
  <p class="lead">{data.lead || data.desc}</p>
</div></section>

{type === 'static' && data.key === 'services' && <>
  <section class="section he-section-dark"><div class="container">
    <div class="section-head"><p class="eyebrow">שירותי סחר B2B</p><h2>שירותים שנבנו סביב החלטה מסחרית.</h2><p>כל שירות מתחיל בדרישה ברורה ומסתיים בתוצר שניתן להשתמש בו: רשימת מועמדים מסוננת, הערות אימות, השוואת RFQ, ניתוח TCO או תהליך כניסה לשוק.</p></div>
    <div class="he-service-directory">{services.map(([id,s])=><a class="he-rich-card" href={`/he/שירותים/${s.slug}/`}><h2>{s.name}</h2><p>{s.desc}</p><span>לפרטי השירות →</span></a>)}</div>
  </div></section>
  <section class="section he-section-light"><div class="container content-grid">
    <div class="prose"><p class="eyebrow">אפיון דרישה</p><h2>מה צריך כדי להתחיל נכון?</h2><ul class="check-list"><li>מוצר או שירות ומפרט</li><li>כמות משוערת / MOQ יעד</li><li>מדינת מקור ושוק יעד</li><li>אריזה, מותג פרטי או דרישות תווית</li><li>מסמכים, COA, כשרות או תקנים כאשר נדרשים</li><li>Incoterm, נקודת מסירה ולוח זמנים</li></ul></div>
    <aside class="side-panel"><p class="eyebrow">CTSEG · שיטת עבודה</p><h3>לא מתחילים מרשימת שמות.</h3><p>קודם בונים את מסגרת ההחלטה, ורק לאחר מכן מחפשים ומסננים את הגורמים המתאימים.</p><a class="button" href="/he/איך-אנחנו-עובדים/">איך אנחנו עובדים</a></aside>
  </div></section>
  <section class="section he-section-dark"><div class="container"><div class="cta-statement"><p class="eyebrow">בקשה מסחרית</p><h2>יש לכם מוצר, שוק יעד או ספק שצריך לבדוק?</h2><div class="actions"><a class="button" href="/he/יצירת-קשר/">שליחת בקשה</a><a class="button button-secondary" href="/he/תרחישים-מסחריים/">תרחישים מסחריים</a></div></div></div></section>
</>}

{type === 'service' && <>
  <section class="section he-section-light"><div class="container content-grid">
    <article class="prose">
      <div class="content-block"><h2>{data.scopeTitle}</h2><p>{data.scope}</p></div>
      <div class="content-block"><h2>{data.problemTitle}</h2><p>{data.problem}</p></div>
      <div class="content-block"><h2>{data.audienceTitle}</h2><p>{data.audience}</p></div>
      <div class="content-block"><h2>{data.processTitle}</h2><ol class="check-list">{data.process.map(item=><li>{item}</li>)}</ol></div>
      <div class="content-block"><h2>{data.outcomesTitle}</h2><ul class="check-list">{data.outcomes.map(item=><li>{item}</li>)}</ul></div>
      <div class="content-block faq"><h2>שאלות נפוצות</h2>{data.faq.map((item,index)=><details open={index===0}><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
      <div class="content-block"><h2>משאבים קשורים</h2><p><a class="text-link" href="/he/שירותים/">כל השירותים →</a></p><p><a class="text-link" href="/he/תובנות/">תובנות מסחריות →</a></p><p><a class="text-link" href="/he/איך-אנחנו-עובדים/">שיטת העבודה →</a></p></div>
    </article>
    <aside class="side-panel he-sticky-panel"><p class="eyebrow">CTSEG · צוות מסחרי</p><h3>יש לכם דרישה ספציפית?</h3><p>שלחו מוצר, כמות, יעד ודרישות מסמכים. נבדוק איזה מסלול שירות מתאים לפני פתיחת עבודה.</p><a class="button" href="/he/יצירת-קשר/">שליחת בקשה</a></aside>
  </div></section>
</>}

{type === 'static' && data.key === 'products' && <>
  <section class="section he-section-dark"><div class="container">
    <div class="section-head"><p class="eyebrow">פורטפוליו מוצרים מסחריים</p><h2>פורטפוליו שנבחן לפי מפרט ועסקה — לא רק לפי שם מוצר.</h2><p>מקור, דרגת איכות, אריזה, MOQ, מסמכים, שימוש מיועד ותנאי Incoterms מאומתים מחדש בכל RFQ.</p></div>
    <nav class="he-group-nav" aria-label="קטגוריות">{productGroups.map(g=><a href={`#${g.ids[0]}`}>{g.title}</a>)}</nav>
  </div></section>
  {productGroups.map(group=><section class="section he-section-light" id={group.ids[0]}><div class="container">
    <div class="section-head"><h2>{group.title}</h2><p>{group.lead}</p></div>
    <div class="he-product-grid">{group.ids.map(id=>{const p=productMap[id]; return <a class="he-product-card" href={`/he/מוצרים-מסחריים/${id}/`}><span>{productProfiles[id].group}</span><h3>{p[0]}</h3><p>{p[1]}</p><strong>פרטי מוצר ורכש →</strong></a>})}</div>
  </div></section>)}
  <section class="section he-section-dark"><div class="container content-grid">
    <div class="prose"><p class="eyebrow">צוות איתור ורכש</p><h2>לא מצאתם את המוצר המדויק?</h2><p>הפורטפוליו מציג קטגוריות פעילות, אך שירות האיתור והרכש אינו מוגבל לרשימה. ניתן לשלוח מפרט, תמונה, מחיר יעד או דרישת מותג פרטי ונבחן את שוק האספקה המתאים.</p></div>
    <aside class="side-panel"><h3>פתיחת RFQ חדש</h3><p>צרפו מוצר, כמות, אריזה, יעד ומסמכים נדרשים.</p><a class="button" href="/he/יצירת-קשר/">שליחת דרישה</a></aside>
  </div></section>
</>}

{type === 'product' && productProfile && <>
  <section class="section he-section-light"><div class="container content-grid">
    <article class="prose">
      <div class="content-block"><h2>מסגרת מסחרית</h2><p>{data.desc}</p><p>כל נתון מסחרי מאומת מחדש מול הספק והאצווה הרלוונטיים; אין להסתמך על נתוני קטלוג כעל התחייבות להזמנה ספציפית.</p></div>
      <div class="content-block he-facts"><h2>מידע להערכת RFQ</h2><dl>
        <div><dt>קטגוריה</dt><dd>{productProfile.group}</dd></div>
        <div><dt>פורמטים / דרגות</dt><dd>{productProfile.formats}</dd></div>
        <div><dt>מקור</dt><dd>מאומת לפי הספק, האצווה וההצעה המסחרית.</dd></div>
        <div><dt>MOQ</dt><dd>מאומת מול היצרן ובהתאם למוצר, לאריזה ולמותג הפרטי.</dd></div>
        <div><dt>אריזה</dt><dd>אריזה סיטונאית או קמעונאית בהתאם למוצר, שוק יעד ויכולת היצרן.</dd></div>
        <div><dt>מותג פרטי</dt><dd>נבדק לפי יצרן, MOQ לאריזה, תווית ולוחות זמנים.</dd></div>
        <div><dt>מסמכי איכות</dt><dd>מפרט, COA, עקיבות (traceability) ואישורים רלוונטיים בהתאם למוצר ולשוק.</dd></div>
        <div><dt>דוגמאות</dt><dd>זמינות, עלות ומשלוח דוגמה מאומתים מול הספק לפני התחייבות.</dd></div>
        <div><dt>Incoterms</dt><dd>EXW / FOB / CIF או בסיס אחר לפי הצעה ויעד.</dd></div>
        <div><dt>זמן אספקה</dt><dd>מאושר לאחר סגירת מפרט, כמות, אריזה ומסמכים.</dd></div>
        <div><dt>מוקדי איכות</dt><dd>{productProfile.quality}</dd></div>
        <div><dt>שימושים מסחריים</dt><dd>{productProfile.uses}</dd></div>
      </dl></div>
      <div class="content-block"><h2>מה נדרש להצעת מחיר מדויקת?</h2><ul class="check-list"><li>מפרט / דרגת איכות / מידה</li><li>כמות להזמנה ונפח שנתי אם קיים</li><li>אריזה ומשקל יחידה</li><li>מדינת יעד ונקודת מסירה</li><li>מותג פרטי / שפת תווית כאשר נדרש</li><li>כשרות, COA, חיי מדף או אישורים מיוחדים כאשר רלוונטי</li></ul></div>
      <div class="content-block"><h2>בקרת סיכון לפני הזמנה</h2><p>בהתאם למוצר ולסיכון ניתן לשלב דוגמה, בדיקת מסמכים, בדיקת מעבדה, ביקורת או אימות צד שלישי. ההיקף נקבע לפני הזמנה ולא מוצג כהבטחה אוטומטית.</p></div>
    </article>
    <aside class="side-panel he-sticky-panel"><p class="eyebrow">RFQ · {productProfile.group}</p><h3>{data.name}</h3><p>שלחו כמות, אריזה, יעד ומסמכים כדי לקבל הערכה מסחרית על בסיס דרישה אמיתית.</p><a class="button" href="/he/יצירת-קשר/">פתיחת RFQ</a><a class="text-link" href="/he/מוצרים-מסחריים/">כל המוצרים →</a></aside>
  </div></section>
</>}

{type === 'static' && data.key === 'markets' && <>
  <section class="section he-section-dark"><div class="container">
    <div class="section-head"><p class="eyebrow">מסדרונות סחר</p><h2>אותו תהליך, מסלול מסחרי שונה לכל שוק.</h2><p>אנחנו מפרידים בין איתור ורכש, תיאום יבוא וכניסה לשוק, ובוחנים לכל מסלול את הקונה, הספק, המסמכים, הלוגיסטיקה והסיכון.</p></div>
    <div class="he-market-grid">{marketCorridors.map(c=><article class="he-rich-card"><h2>{c.title}</h2><p>{c.text}</p><ul>{c.points.map(p=><li>{p}</li>)}</ul></article>)}</div>
  </div></section>
  <section class="section he-section-light"><div class="container">
    <div class="section-head"><h2>מה נבדק לפני פתיחת מסלול חדש?</h2><p>לא כל מוצר מתאים לכל שוק באותו מבנה.</p></div>
    <div class="he-four-grid"><article><h3>התאמת מוצר</h3><p>מפרט, מיצוב, אריזה, חיי מדף ודרישות קונה.</p></article><article><h3>התאמה מסחרית</h3><p>מחיר, MOQ, מבנה מרווח, תשלום ויכולת אספקה.</p></article><article><h3>התאמת מסמכים</h3><p>מקור, COA, תעודות, תווית ודרישות שוק רלוונטיות.</p></article><article><h3>התאמת אספקה</h3><p>תנאי Incoterms, הובלה, זמן אספקה, מסלול ונקודת מסירה.</p></article></div>
  </div></section>
  <section class="section he-section-dark"><div class="container cta-statement"><h2>יש לכם מסלול ישראל ⇄ טורקיה או שוק אחר לבדיקה?</h2><a class="button" href="/he/יצירת-קשר/">שליחת דרישה</a></div></section>
</>}

{type === 'static' && data.key === 'insights' && <>
  <section class="section he-section-light"><div class="container">
    <div class="section-head"><p class="eyebrow">נושאי החלטה</p><h2>תוכן שנועד לשפר החלטה, לא למלא בלוג.</h2><p>המאמרים מתמקדים בנקודות שבהן עסקאות איתור ורכש וכניסה לשוק בדרך כלל מאבדות בהירות.</p></div>
    <div class="he-four-grid">{insightThemes.map(x=><article><h3>{x.title}</h3><p>{x.text}</p></article>)}</div>
  </div></section>
  <section class="section he-section-dark"><div class="container"><div class="he-insight-grid">
    <a class="he-rich-card" href="/he/insights/private-label-food-turkiye-israel/"><p class="eyebrow">מותג פרטי</p><h2>ייצור מותג פרטי בטורקיה ליבואנים מישראל</h2><p>יצרן, MOQ, אריזה, כשרות, דוגמאות ו-RFQ.</p><span>לקריאה →</span></a>
    <a class="he-rich-card" href="/he/insights/kosher-supplier-verification-turkiye/"><p class="eyebrow">אימות ספקים</p><h2>כשרות ואימות ספקים בטורקיה</h2><p>מה לבדוק במפעל, במסמכים ובמוצר לפני החלטת רכש.</p><span>לקריאה →</span></a>
    <a class="he-rich-card" href="/he/insights/rfq-moq-fob-cif-turkiye-israel/"><p class="eyebrow">RFQ · INCOTERMS</p><h2>RFQ, MOQ, FOB ו-CIF</h2><p>איך להשוות הצעות על בסיס מסחרי אחיד.</p><span>לקריאה →</span></a>
  </div></div></section>
</>}

{type === 'static' && data.key === 'about' && <>
  <section class="section he-section-light"><div class="container content-grid">
    <article class="prose"><p class="eyebrow">בית מסחר עצמאי</p><h2>{aboutData.introTitle}</h2><p>{aboutData.intro}</p><h2>{aboutData.mandateTitle}</h2><p>{aboutData.mandate}</p></article>
    <aside class="side-panel he-company-facts"><p class="eyebrow">CTSEG · 2022</p><dl>{aboutData.facts.map(f=><div><dt>{f[0]}</dt><dd>{f[1]}</dd></div>)}</dl></aside>
  </div></section>
  <section class="section he-section-dark"><div class="container">
    <div class="section-head"><p class="eyebrow">עקרונות עבודה</p><h2>עקרונות עבודה שמגנים על איכות ההחלטה.</h2></div>
    <div class="he-four-grid he-four-grid-dark">{aboutData.principles.map(p=><article><h3>{p.title}</h3><p>{p.text}</p></article>)}</div>
  </div></section>
  <section class="section he-section-light"><div class="container content-grid">
    <div class="prose"><h2>{aboutData.boundariesTitle}</h2><ul class="check-list">{aboutData.boundaries.map(x=><li>{x}</li>)}</ul></div>
    <aside class="side-panel"><p class="eyebrow">בקרה ושקיפות</p><h3>ראיות, שקיפות ותיעוד.</h3><p>היקף הבדיקה נקבע לפי סוג העסקה והסיכון. אם נתון אינו מאומת — הוא מסומן ככזה ולא מוצג כעובדה.</p><a class="button" href="/he/איך-אנחנו-עובדים/">שיטת העבודה</a></aside>
  </div></section>
  <section class="section he-section-dark"><div class="container cta-statement"><h2>רוצים לבחון דרישה מסחרית עם CTSEG?</h2><a class="button" href="/he/יצירת-קשר/">יצירת קשר</a></div></section>
</>}

{type === 'static' && data.key === 'how-we-work' && <>
  <section class="section he-section-dark"><div class="container">
    <div class="section-head"><p class="eyebrow">שיטת עבודה</p><h2>מתחילים בהגדרת החלטה — לא בחיפוש אקראי.</h2><p>התהליך משתנה לפי איתור ורכש, אימות או כניסה לשוק, אך שלד הבקרה נשאר קבוע.</p></div>
    <div class="he-process-stack">{howWeWork.map((s)=><article><div><h3>{s.title}</h3><p>{s.text}</p></div></article>)}</div>
  </div></section>
  <section class="section he-section-light"><div class="container">
    <div class="section-head"><h2>מה נשאר מתועד לאורך התהליך?</h2></div>
    <div class="he-four-grid"><article><h3>דרישה</h3><p>מפרט, כמות, יעד, מסמכים ולוח זמנים.</p></article><article><h3>ראיות</h3><p>מה אומת, מה לא אומת ומה דורש צד שלישי.</p></article><article><h3>בסיס מסחרי</h3><p>מחיר, MOQ, תשלום, תנאי Incoterms וזמן אספקה.</p></article><article><h3>יומן החלטה</h3><p>פערים, חלופות, שאלות פתוחות והצעד הבא.</p></article></div>
  </div></section>
  <section class="section he-section-dark"><div class="container content-grid"><div class="prose"><h2>אימות אינו הבטחת ביצוע.</h2><p>אימות מפחית אי-ודאות, אבל אינו יכול להבטיח איכות או התנהגות עתידית. כאשר רמת הסיכון דורשת, משלבים דוגמה, ביקורת, בדיקת מעבדה או בדיקה משפטית או מומחה מורשה.</p></div><aside class="side-panel"><h3>יש לכם תרחיש מורכב?</h3><p>ראו כיצד התהליך משתנה בין איתור ורכש, מותג פרטי וכניסה לשוק.</p><a class="button" href="/he/תרחישים-מסחריים/">תרחישים מסחריים</a></aside></div></section>
</>}

{type === 'static' && data.key === 'scenarios' && <>
  <section class="section he-section-light"><div class="container">
    <div class="section-head"><p class="eyebrow">תרחישים מסחריים</p><h2>אותו כלי אינו מתאים לכל מצב.</h2><p>כל תרחיש מתחיל בשאלה מסחרית אחרת ולכן דורש סדר בדיקות שונה.</p></div>
    <div class="he-scenario-grid">{scenarios.map(s=><article class="he-scenario-card"><h2>{s.title}</h2><p><strong>המצב:</strong> {s.situation}</p><h3>מה עושים</h3><ul>{s.work.map(x=><li>{x}</li>)}</ul><p class="he-outcome"><strong>תוצר:</strong> {s.outcome}</p></article>)}</div>
  </div></section>
  <section class="section he-section-dark"><div class="container cta-statement"><h2>יש לכם תרחיש אחר?</h2><p>שלחו את הדרישה כפי שהיא — נבנה את מסלול הבדיקה המתאים.</p><a class="button" href="/he/יצירת-קשר/">שליחת בקשה</a></div></section>
</>}

{type === 'static' && data.key === 'contact' && <>
  <section class="section he-section-light"><div class="container content-grid">
    <div class="prose"><p class="eyebrow">לפני שליחת בקשה</p><h2>{contactData.qualifierTitle}</h2><ul class="check-list">{contactData.qualifier.map(x=><li>{x}</li>)}</ul></div>
    <aside class="side-panel"><p class="eyebrow">{contactData.responseBadge}</p><h3>בדיקה ראשונית מובנית</h3><p>{contactData.responseText}</p><p dir="ltr"><a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></p><p dir="ltr"><a href="https://wa.me/905456782655">WhatsApp · +90 545 678 26 55</a></p></aside>
  </div></section>
  <section class="section he-section-dark"><div class="container">
    <div class="section-head"><h2>{contactData.afterTitle}</h2><p>הבקשה אינה נשלחת מיד לשוק לפני שהדרישה ברורה מספיק.</p></div>
    <div class="he-process-stack">{contactData.after.map((x)=><article><div><h3>{x}</h3></div></article>)}</div>
  </div></section>
  <section class="section he-standard-form-section"><div class="container"><CommercialRequestForm lang="he" /></div></section>
  <section class="section he-section-light"><div class="container"><div class="section-head"><h2>שאלות לפני יצירת קשר</h2></div><div class="he-faq-grid">{contactData.faq.map((x,i)=><details open={i===0}><summary>{x.q}</summary><p>{x.a}</p></details>)}</div></div></section>
</>}

{type === 'legal' && <section class="section he-section-light"><div class="container"><article class="prose he-legal">
  {legalSections.map(([heading,text])=><section class="content-block"><h2>{heading}</h2><p>{text}</p></section>)}
  <section class="content-block"><h2>יצירת קשר</h2><p>לשאלות בנוגע למסמך זה ניתן לפנות ל-<span dir="ltr">info@ctseg.com.tr</span>.</p></section>
</article></div></section>}


</BaseLayout>

<style is:global>
html[data-locale="he"] .he-standard-page{text-align:center}
html[data-locale="he"] .he-standard-page h1{max-width:980px;font-size:clamp(40px,5vw,72px);line-height:1.02;letter-spacing:-.03em}
html[data-locale="he"] .he-standard-page .lead{max-width:820px}
.he-section-dark{background:#121513;color:#f4f1e8}.he-section-light{background:#f2eee5;color:#20231f}
.he-section-light .section-head p,.he-section-light .prose p{color:#575952}
.he-service-directory,.he-product-grid,.he-market-grid,.he-insight-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.he-rich-card{display:flex;min-height:240px;flex-direction:column;padding:28px;border:1px solid #343a36;background:#171a18;color:#f4f1e8;text-decoration:none}
.he-rich-card h2{margin:0 0 12px;color:#fff}.he-rich-card p{color:#d7d7d0}.he-rich-card span{margin-top:auto;color:#c4f000;font-weight:700}
.he-product-card{display:flex;min-height:230px;flex-direction:column;padding:26px;border:1px solid #d8d1c4;border-radius:16px;background:#fff;color:#1d211d;text-decoration:none}.he-product-card>span{font-size:.75rem;font-weight:800;letter-spacing:.06em;color:#69706a}.he-product-card h3{font-size:1.4rem;margin:16px 0 10px}.he-product-card p{color:#575952}.he-product-card strong{margin-top:auto}
.he-group-nav{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:28px}.he-group-nav a{padding:10px 14px;border:1px solid #3d443f;border-radius:999px;color:#e7e9e3}
.he-four-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.he-four-grid>article{padding:24px;border:1px solid #d8d1c4;background:#fff}.he-four-grid p{color:#575952}.he-four-grid-dark>article{border-color:#343a36;background:#171a18}.he-four-grid-dark h3{color:#fff}.he-four-grid-dark p{color:#d7d7d0}
.he-facts dl{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #d9d2c6;border-inline-start:1px solid #d9d2c6}.he-facts dl>div{padding:16px;border-inline-end:1px solid #d9d2c6;border-bottom:1px solid #d9d2c6}.he-facts dt{font-size:.78rem;font-weight:800;color:#6b706b}.he-facts dd{margin:7px 0 0}
.he-process-stack{display:grid;gap:1px;background:#343a36;border:1px solid #343a36}.he-process-stack article{display:grid;grid-template-columns:1fr;gap:8px;padding:24px;background:#171a18}.he-process-stack h3{margin:0;color:#fff}.he-process-stack p{margin:7px 0 0;color:#d7d7d0}
.he-scenario-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.he-scenario-card{padding:28px;border:1px solid #d8d1c4;border-radius:16px;background:#fff}.he-scenario-card p,.he-scenario-card li{color:#575952}.he-scenario-card .he-outcome{margin-top:22px;padding-top:18px;border-top:1px solid #ded8cd}
.he-company-facts dl{display:grid;gap:0}.he-company-facts dl>div{padding:14px 0;border-bottom:1px solid rgba(255,255,255,.12)}.he-company-facts dt{font-size:.75rem;opacity:.65}.he-company-facts dd{margin:6px 0 0}
.he-sticky-panel{position:sticky;top:110px;align-self:start}
.he-contact-form-section{background:#0a0d0c;color:#f4f1e8}.he-contact-layout{display:grid;grid-template-columns:minmax(260px,.65fr) minmax(0,1.35fr);gap:32px;align-items:start}.he-contact-intro{padding:28px;border:1px solid #343a36;background:#111513}.he-contact-intro h2{color:#fff}
.he-commercial-form{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px!important}.he-commercial-form label{display:grid;gap:8px;color:#e7e8e2}.he-commercial-form input,.he-commercial-form select,.he-commercial-form textarea{background:#111513!important;color:#fff!important;border:1px solid #3b423d!important}.he-commercial-form .he-full,.he-commercial-form .he-consent,.he-commercial-form .he-submit,.he-commercial-form .he-form-status{grid-column:1/-1}.he-commercial-form .he-consent{display:flex;align-items:flex-start;gap:10px}.he-commercial-form .he-consent input{width:auto}.he-honeypot{position:absolute!important;left:-9999px!important}
.he-faq-grid{max-width:900px;margin-inline:auto}.he-faq-grid details{padding:20px 0;border-bottom:1px solid #d8d1c4}.he-faq-grid summary{font-weight:800;cursor:pointer}.he-faq-grid p{color:#575952}
.he-legal{max-width:900px;margin-inline:auto}.he-legal .content-block{padding:10px 0 28px;border-bottom:1px solid #d8d1c4}.he-legal h2{margin-top:28px}
@media(max-width:980px){.he-service-directory,.he-product-grid,.he-market-grid,.he-insight-grid{grid-template-columns:1fr 1fr}.he-four-grid{grid-template-columns:1fr 1fr}.he-sticky-panel{position:static}}
@media(max-width:760px){.he-service-directory,.he-product-grid,.he-market-grid,.he-insight-grid,.he-four-grid,.he-scenario-grid,.he-contact-layout{grid-template-columns:1fr}.he-facts dl{grid-template-columns:1fr}.he-commercial-form{grid-template-columns:1fr!important}.he-commercial-form .he-full,.he-commercial-form .he-consent,.he-commercial-form .he-submit,.he-commercial-form .he-form-status{grid-column:1}.he-process-stack article{grid-template-columns:1fr}}
</style>