---
import HebrewLayout from '../../../layouts/HebrewLayout.astro';
export function getStaticPaths(){
  const articles = {
  'private-label-food-turkiye-israel': {
    title:'ייצור מותג פרטי בטורקיה ליבואנים מישראל | CTSEG',
    description:'מדריך מסחרי לבניית פרויקט private label בטורקיה: יצרן, MOQ, אריזה, כשרות, RFQ, דוגמאות, COA ותנאי אספקה.',
    h1:'ייצור מותג פרטי בטורקיה ליבואנים מישראל',
    dek:'פרויקט private label טוב מתחיל במפרט מסחרי מדויק — לא בחיפוש אקראי אחר מפעלים.',
    sections:[
      ['מגדירים את המוצר לפני שמבקשים מחיר','יש להגדיר הרכב, משקל יחידה, אריזה, קרטון, חיי מדף, שפת תווית, כמות התחלתית ושוק יעד. בלי נתונים אלה, הצעות המחיר אינן ניתנות להשוואה.'],
      ['MOQ וקיבולת ייצור','MOQ צריך להיבדק גם למוצר וגם לאריזה. ייתכן שמפעל יסכים לכמות מוצר נמוכה אך ספק האריזה ידרוש מינימום גבוה יותר.'],
      ['כשרות ומסמכים','כאשר נדרשת כשרות, חשוב לבדוק את ההתאמה הספציפית למוצר, לקו ולמפעל ולא להסתפק באמירה כללית. בנוסף יש לבחון מפרט, COA, עקיבות ואישורי איכות רלוונטיים.'],
      ['RFQ אחיד','CTSEG מבנה RFQ אחיד כדי להשוות מחיר, MOQ, lead time, תנאי תשלום, private label, דוגמאות ותנאי EXW/FOB/CIF על בסיס זהה.']
    ]
  },
  'kosher-supplier-verification-turkiye': {
    title:'כשרות ואימות ספקים בטורקיה | CTSEG',
    description:'מה יבואנים מישראל צריכים לבדוק אצל ספק או יצרן בטורקיה: זהות חברה, יכולת, מסמכים, כשרות, מפרט, COA ועקיבות.',
    h1:'כשרות ואימות ספקים בטורקיה: מה לבדוק לפני RFQ',
    dek:'אימות ספק אינו רק בדיקת אתר אינטרנט. ההחלטה צריכה להישען על חברה, מפעל, מוצר, מסמכים ויכולת ביצוע.',
    sections:[
      ['זהות ויכולת','מאמתים את הישות המשפטית, כתובת המפעל, תחום הפעילות, קיבולת רלוונטית וניסיון יצוא כאשר הוא קיים.'],
      ['התאמת מסמכים למוצר','תעודות איכות, מפרטים ו-COA צריכים להתאים למוצר ולהיקף העסקה. מסמך כללי של החברה אינו תמיד הוכחה מספקת.'],
      ['דרישות כשרות','יש להגדיר מראש איזה אישור נדרש ומי הגוף המאשר המקובל על היבואן. CTSEG מרכזת את הדרישה המסחרית והמסמכים; אימות רגולטורי או הלכתי סופי נעשה מול הגורמים המוסמכים הרלוונטיים.'],
      ['דוגמאות ובדיקות','לפני הזמנה משמעותית ניתן לדרוש דוגמה, בדיקות מעבדה, תמונות קו, מסמכי אצווה או בדיקת צד שלישי לפי רמת הסיכון.']
    ]
  },
  'rfq-moq-fob-cif-turkiye-israel': {
    title:'RFQ, MOQ, FOB ו-CIF בין ישראל לטורקיה | CTSEG',
    description:'מדריך להשוואת הצעות ספקים מטורקיה: RFQ, MOQ, EXW, FOB, CIF, אריזה, תשלום וזמן אספקה.',
    h1:'RFQ, MOQ, FOB ו־CIF: איך להשוות הצעות בין ישראל לטורקיה',
    dek:'מחיר יחידה לבדו כמעט אף פעם לא מספיק. צריך להשוות את אותה חבילת תנאים.',
    sections:[
      ['RFQ ברור','RFQ צריך לכלול מפרט, כמות, אריזה, יעד, מסמכים, מועד רצוי ובסיס מחיר נדרש.'],
      ['MOQ','יש להבחין בין MOQ להזמנה, MOQ ל-SKU, MOQ לאריזה ומינימום כלכלי של משלוח.'],
      ['EXW / FOB / CIF','EXW אינו כולל את אותה מעטפת עלויות כמו FOB או CIF. לכן חשוב להשוות הצעות על בסיס Incoterm זהה ובאותו נמל או יעד.'],
      ['תנאי תשלום ולוחות זמנים','מקדמה, יתרה, אמצעי תשלום, lead time, זמינות חומרי גלם ואריזה יכולים לשנות את הסיכון ואת העלות הכוללת גם כאשר מחיר היחידה דומה.']
    ]
  }
};
  return Object.entries(articles).map(([slug,data])=>({params:{slug},props:{data,slug}}));
}
const {data,slug}=Astro.props;
const canonical=`https://ctseg.com.tr/he/insights/${slug}/`;
---
<HebrewLayout title={data.title} description={data.description} canonical={canonical} article={true}>
<article class="he-article">
<p class="he-eyebrow">CTSEG · TRADE INSIGHT</p><h1>{data.h1}</h1><p class="dek">{data.dek}</p>
{data.sections.map(([heading,text]) => <section><h2>{heading}</h2><p>{text}</p></section>)}
<div class="he-actions" style="justify-content:flex-start"><a class="he-button" href="/he/#contact">שליחת בקשה מסחרית</a><a class="he-button alt" href="/he/#insights">חזרה לתובנות</a></div>
</article>
</HebrewLayout>