---
import BaseLayout from '../../../layouts/BaseLayout.astro';
export function getStaticPaths(){
  const articles = {
  'private-label-food-turkiye-israel': {
    title:'ייצור מותג פרטי בטורקיה ליבואנים מישראל | CTSEG',
    description:'מדריך מסחרי לבניית פרויקט Private Label בטורקיה: יצרן, MOQ, אריזה, כשרות, RFQ, דוגמאות, COA ותנאי אספקה.',
    eyebrow:'PRIVATE LABEL · TÜRKİYE → ISRAEL',
    h1:'ייצור מותג פרטי בטורקיה ליבואנים מישראל',
    dek:'פרויקט Private Label טוב מתחיל במפרט מסחרי מדויק — לא בחיפוש אקראי אחר מפעלים.',
    sections:[
      ['מגדירים את המוצר לפני שמבקשים מחיר','יש להגדיר הרכב, משקל יחידה, אריזה, קרטון, חיי מדף, שפת תווית, כמות התחלתית ושוק יעד. בלי הנתונים האלה, הצעות המחיר אינן באמת ניתנות להשוואה.'],
      ['MOQ וקיבולת ייצור','MOQ צריך להיבדק גם למוצר וגם לאריזה. לעיתים היצרן גמיש בכמות המוצר אך ספק האריזה דורש מינימום גבוה יותר.'],
      ['כשרות ומסמכים','כאשר נדרשת כשרות, חשוב לבדוק התאמה ספציפית למוצר, לקו ולמפעל. בנוסף יש לבחון מפרט, COA, עקיבות ואישורי איכות רלוונטיים.'],
      ['RFQ אחיד','CTSEG בונה RFQ אחיד כדי להשוות מחיר, MOQ, lead time, תנאי תשלום, Private Label, דוגמאות ותנאי EXW/FOB/CIF על בסיס זהה.']
    ]
  },
  'kosher-supplier-verification-turkiye': {
    title:'כשרות ואימות ספקים בטורקיה | CTSEG',
    description:'מה יבואנים מישראל צריכים לבדוק אצל ספק או יצרן בטורקיה: זהות חברה, יכולת, מסמכים, כשרות, מפרט, COA ועקיבות.',
    eyebrow:'SUPPLIER VERIFICATION · KOSHER',
    h1:'כשרות ואימות ספקים בטורקיה',
    dek:'אימות ספק אינו רק בדיקת אתר אינטרנט. ההחלטה צריכה להישען על חברה, מפעל, מוצר, מסמכים ויכולת ביצוע.',
    sections:[
      ['זהות ויכולת','מאמתים את הישות המשפטית, כתובת המפעל, תחום הפעילות, קיבולת רלוונטית וניסיון יצוא כאשר הוא קיים.'],
      ['התאמת מסמכים למוצר','תעודות איכות, מפרטים ו־COA צריכים להתאים למוצר ולהיקף העסקה. מסמך כללי של החברה אינו תמיד הוכחה מספקת.'],
      ['דרישות כשרות','יש להגדיר מראש איזה אישור נדרש ומי הגוף המאשר המקובל על היבואן. CTSEG מרכזת את הדרישה המסחרית והמסמכים; האימות הסופי נעשה מול הגורמים המוסמכים הרלוונטיים.'],
      ['דוגמאות ובדיקות','לפני הזמנה משמעותית ניתן לדרוש דוגמה, בדיקות מעבדה, תמונות קו, מסמכי אצווה או בדיקת צד שלישי לפי רמת הסיכון.']
    ]
  },
  'rfq-moq-fob-cif-turkiye-israel': {
    title:'RFQ, MOQ, FOB ו-CIF בין ישראל לטורקיה | CTSEG',
    description:'מדריך להשוואת הצעות ספקים מטורקיה: RFQ, MOQ, EXW, FOB, CIF, אריזה, תשלום וזמן אספקה.',
    eyebrow:'RFQ · MOQ · INCOTERMS',
    h1:'RFQ, MOQ, FOB ו־CIF: איך להשוות הצעות נכון',
    dek:'מחיר יחידה לבדו כמעט אף פעם לא מספיק. צריך להשוות את אותה חבילת תנאים.',
    sections:[
      ['RFQ ברור','RFQ צריך לכלול מפרט, כמות, אריזה, יעד, מסמכים, מועד רצוי ובסיס מחיר נדרש.'],
      ['MOQ','יש להבחין בין MOQ להזמנה, MOQ ל־SKU, MOQ לאריזה ומינימום כלכלי של משלוח.'],
      ['EXW / FOB / CIF','EXW אינו כולל את אותה מעטפת עלויות כמו FOB או CIF. לכן חשוב להשוות הצעות על בסיס Incoterm זהה ובאותו נמל או יעד.'],
      ['תנאי תשלום ולוחות זמנים','מקדמה, יתרה, אמצעי תשלום, lead time וזמינות חומרי גלם ואריזה יכולים לשנות את הסיכון ואת העלות הכוללת גם כאשר מחיר היחידה דומה.']
    ]
  }
};
  return Object.entries(articles).map(([slug,data])=>({params:{slug},props:{data,slug}}));
}
const {data,slug}=Astro.props;
const canonical=`https://ctseg.com.tr/he/insights/${slug}/`;
const schema={
  '@context':'https://schema.org','@type':'Article','@id':canonical+'#article',headline:data.h1,description:data.description,inLanguage:'he-IL',
  mainEntityOfPage:canonical,author:{'@type':'Person',name:'Teyfik Gökdemir'},publisher:{'@id':'https://ctseg.com.tr/#organization'}
};
---
<BaseLayout lang="he" title={data.title} description={data.description} pageKey="he-insight" canonical={canonical} schema={schema}>
  <section class="section he-article-hero">
    <div class="container">
      <p class="eyebrow">{data.eyebrow}</p>
      <h1>{data.h1}</h1>
      <p class="lead">{data.dek}</p>
    </div>
  </section>
  <section class="section he-article-body">
    <div class="container content-grid">
      <article class="prose">
        {data.sections.map(([heading,text]) => <section class="content-block"><h2>{heading}</h2><p>{text}</p></section>)}
      </article>
      <aside class="side-panel">
        <p class="eyebrow">CTSEG · ISRAEL ⇄ TÜRKİYE</p>
        <h3>יש לכם דרישה מסחרית?</h3>
        <p>שלחו מוצר, כמות, יעד, אריזה ודרישות מסמכים. נבחן את המסלול המתאים לפני פתיחת RFQ.</p>
        <a class="button" href="/he/#contact">שליחת בקשה</a>
        <a class="text-link" href="/he/#insights">כל התובנות →</a>
      </aside>
    </div>
  </section>
</BaseLayout>
<style is:global>
html[data-locale="he"] body{direction:rtl}
html[data-locale="he"] .he-article-hero{text-align:right;padding-top:clamp(70px,8vw,110px);padding-bottom:48px}
html[data-locale="he"] .he-article-hero h1{max-width:980px;font-size:clamp(38px,5vw,68px);line-height:1.03;letter-spacing:-.03em;margin:14px 0 18px}
html[data-locale="he"] .he-article-hero .lead{max-width:820px;font-size:clamp(18px,2vw,23px)}
html[data-locale="he"] .he-article-body .content-block{padding-block:6px 30px;border-bottom:1px solid rgba(255,255,255,.1)}
html[data-locale="he"] .he-article-body .content-block:last-child{border-bottom:0}
html[data-locale="he"] .he-article-body .content-block h2{font-size:clamp(24px,3vw,34px)}
html[data-locale="he"] .side-panel{direction:rtl}
@media(max-width:720px){html[data-locale="he"] .he-article-hero{padding-top:52px}.he-article-body .content-grid{grid-template-columns:1fr}}
</style>