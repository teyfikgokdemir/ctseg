---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return ['privacy-policy', 'cookie-policy', 'terms', 'data-protection-notice'].map((legal) => ({ params: { legal } }));
}

const pages = {
  'privacy-policy': {
    title: 'Privacy Policy',
    description: 'CTSEG website privacy and personal data processing policy.',
    sections: [
      ['Scope and controller', 'This policy applies to personal data processed through ctseg.com.tr. The controller is the individual or legal entity operating the website under the CTSEG brand. The contact address for privacy requests is info@ctseg.com.tr.'],
      ['Data categories', 'When you contact us, we may process your name, email address, telephone number, company, title, request and message. Technical data may include IP address, date and time, device, browser, referring page and security logs.'],
      ['Purposes and legal grounds', 'Data is processed to answer enquiries, manage quotations and business relationships, deliver services, maintain information security, comply with legal duties and establish or protect legal rights. Processing may rely on contract formation or performance, legal obligations, legitimate interests, legal claims and, where required, consent.'],
      ['Sharing and international providers', 'Data may be shared only where necessary with hosting, email, security, technical support and professional service providers, contracting parties and authorised public bodies. Where infrastructure involves an international transfer, the safeguards required by applicable law are used.'],
      ['Retention and security', 'Data is retained only for the period required by the processing purpose and applicable limitation or statutory retention periods, then deleted, destroyed or anonymised. Reasonable technical and organisational safeguards are applied.'],
      ['Rights and requests', 'You may request information, access, correction, deletion, restriction, objection and information about recipients, and may exercise other rights available under applicable data-protection law by emailing info@ctseg.com.tr with sufficient information to verify your identity and request.']
    ]
  },
  'cookie-policy': {
    title: 'Cookie Policy',
    description: 'Information about cookies and preference management on the CTSEG website.',
    sections: [
      ['What cookies are', 'Cookies are small text files that may be stored in a browser or device when a website is visited. Similar technologies may include local storage, pixels and security identifiers.'],
      ['Strictly necessary cookies', 'Cookies may be used where strictly necessary for website security, network management, language or session preferences and essential functionality. These cookies are required to provide the requested service.'],
      ['Analytics and marketing cookies', 'Analytics, personalisation or marketing cookies are enabled only if introduced and, where legally required, after the user has provided prior consent. Accept, reject and preference-management choices are presented in an accessible and balanced way.'],
      ['Cookie details and duration', 'The name, provider, purpose, category and retention period of active cookies are shown in the preference panel or added to this policy when such cookies are introduced. Where the site uses only essential functionality and security technologies, no analytics or advertising tracking is performed.'],
      ['Managing preferences', 'Cookies may be deleted or blocked in browser settings. Consent for non-essential cookies may be withdrawn at any time. Blocking essential cookies may affect website functionality.']
    ]
  },
  terms: {
    title: 'Terms of Use',
    description: 'CTSEG website terms of use and legal notices.',
    sections: [
      ['Acceptance and scope', 'By using this website, you agree to use it lawfully and in accordance with these terms. Content is provided for general information and does not by itself constitute legal, financial, technical or commercial advice, an offer or a binding commitment.'],
      ['Services and contracts', 'The scope, duration, fees, deliverables and responsibilities for CTSEG services are determined only by a separately accepted quotation, order, contract or written confirmation. Website descriptions do not guarantee a particular result.'],
      ['Intellectual property', 'The CTSEG name, logo, brand elements, design, software, text, graphics and other content belong to CTSEG or their respective rights holders unless expressly stated otherwise. Commercial reproduction, modification or distribution requires written permission.'],
      ['User conduct', 'Users must not damage the website, compromise security, attempt unauthorised access, submit misleading data or infringe third-party rights.'],
      ['Liability and external links', 'Reasonable efforts are made to keep information accurate and current, but uninterrupted availability, completeness or fitness for a particular purpose is not guaranteed. Third parties remain responsible for external websites and services.'],
      ['Changes and governing law', 'These terms may be updated and apply from publication. Subject to mandatory rules, the laws of the Republic of Türkiye govern these terms.']
    ]
  },
  'data-protection-notice': {
    title: 'Data Protection Notice',
    description: 'CTSEG notice concerning the processing of personal data.',
    sections: [
      ['1. Controller identity', 'The controller is the individual or legal entity operating ctseg.com.tr under the CTSEG brand. Privacy enquiries and requests may be sent to info@ctseg.com.tr.'],
      ['2. Personal data processed', 'Data may include identity and contact details, company and professional information, enquiry and message content, quotation or business relationship information, and technical security data such as IP address, browser, device and access logs.'],
      ['3. Processing purposes', 'Data is processed to respond to enquiries, manage quotation and contract processes, plan and deliver services, manage supplier or business-partner relationships, maintain information security, comply with legal duties and handle disputes.'],
      ['4. Collection methods and legal grounds', 'Data may be collected through the website, email, telephone, online meetings, forms and technical logs by automated or partly automated means. Legal grounds may include contract formation or performance, legal obligations, legal claims, legitimate interests that do not override fundamental rights and, where necessary, consent. Privacy information and consent are separate processes.'],
      ['5. Recipients and transfers', 'Data may be transferred, only as necessary, to hosting, email, security, accounting, legal and technical service providers, contracting parties and authorised public bodies. International transfers are handled using safeguards required by applicable law.'],
      ['6. Individual rights', 'Depending on applicable law, you may request confirmation of processing, access, purpose and recipient information, correction, deletion, restriction, objection to automated outcomes and compensation where legally available.'],
      ['7. How to apply', 'Send requests to info@ctseg.com.tr with your name, contact information, request details and sufficient information to verify identity. Requests are handled within the period required by applicable law.']
    ]
  }
} as const;

const key = Astro.params.legal as keyof typeof pages;
const page = pages[key];
if (!page) return Astro.redirect('/en/', 302);
---
<BaseLayout lang="en" title={`${page.title} | CTSEG`} description={page.description} canonical={`https://ctseg.com.tr/en/${key}/`} alternate={`https://ctseg.com.tr/tr/${key === 'privacy-policy' ? 'gizlilik-politikasi' : key === 'cookie-policy' ? 'cerez-politikasi' : key === 'terms' ? 'kullanim-kosullari' : 'kvkk'}/`}>
<header class="site-header"><div class="wrap nav"><a class="brand" href="/en/"><img src="/images/ctseg-logo-transparent.png" width="1063" height="342" alt="CTSEG" /></a><nav class="nav-links"><div class="nav-menu"><a href="/en/#services">Services</a><div class="nav-dropdown"><a href="/en/services/strategic-sourcing/">Strategic Sourcing</a><a href="/en/services/supplier-sourcing-verification/">Supplier Sourcing and Verification</a><a href="/en/services/international-trade-advisory/">International Trade Advisory</a></div></div><a href="/en/blog/">Blog</a><a class="lang" href="/tr/">TR</a></nav></div></header>
<main class="legal-page"><div class="wrap legal-wrap"><p class="eyebrow">Legal information</p><h1>{page.title}</h1><p class="legal-updated">Last updated: 25 July 2026</p>{page.sections.map(([heading, body]) => <section class="legal-section"><h2>{heading}</h2><p>{body}</p></section>)}<p class="legal-contact">Requests and questions: <a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></p></div></main>
<footer><div class="wrap footer-grid"><img src="/images/ctseg-logo-transparent.png" alt="CTSEG" width="1063" height="342"/><p>© 2026 CTSEG. All rights reserved.</p><a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div><nav class="wrap footer-legal" aria-label="Legal links"><a href="/en/privacy-policy/">Privacy Policy</a><a href="/en/cookie-policy/">Cookie Policy</a><a href="/en/terms/">Terms of Use</a><a href="/en/data-protection-notice/">Data Protection</a><a href="/en/blog/">Blog</a></nav></footer>
</BaseLayout>