---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPosts } from '../../../data/blog';
const posts = getPosts('en');
---
<BaseLayout lang="en" title="CTSEG Blog | Strategic Sourcing and International Trade" description="Practical guidance on strategic sourcing, procurement, supplier selection, total cost and international trade." canonical="https://ctseg.com.tr/en/blog/" alternate="https://ctseg.com.tr/tr/blog/">
<header class="site-header"><div class="wrap nav"><a class="brand" href="/en/"><img src="/images/ctseg-logo-transparent.png" width="1063" height="342" alt="CTSEG" /></a><nav class="nav-links"><a href="/en/">Home</a><a href="/en/blog/">Blog</a><a class="lang" href="/tr/blog/">TR</a></nav></div></header>
<main class="blog-index"><section class="blog-hero"><div class="wrap"><p class="eyebrow">CTSEG Insights</p><h1>Strategic sourcing and trade guidance.</h1><p class="lead">Clear, verifiable and actionable content for commercial decision-makers.</p></div></section><section><div class="wrap blog-grid">{posts.map(post=><a class="blog-card" href={`/en/blog/${post.slug}/`}><span>{post.readingTime}</span><h2>{post.title}</h2><p>{post.description}</p><strong>Read article →</strong></a>)}</div></section></main>
<footer><div class="wrap footer-grid"><img src="/images/ctseg-logo-transparent.png" alt="CTSEG" width="1063" height="342"/><p>© 2026 CTSEG.</p><a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div><nav class="wrap footer-legal"><a href="/en/privacy-policy/">Privacy</a><a href="/en/cookie-policy/">Cookies</a><a href="/en/terms/">Terms</a><a href="/en/data-protection-notice/">Data protection</a></nav></footer>
</BaseLayout>
