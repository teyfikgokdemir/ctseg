---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { posts } from '../../../data/blog';
export function getStaticPaths(){return posts.filter(p=>p.lang==='en').map(post=>({params:{slug:post.slug},props:{post}}));}
const { post } = Astro.props;
const canonical=`https://ctseg.com.tr/en/blog/${post.slug}/`;
const schema={ '@context':'https://schema.org','@type':'BlogPosting',headline:post.title,description:post.description,datePublished:post.date,dateModified:post.updated,inLanguage:'en',mainEntityOfPage:canonical,author:{'@type':'Organization',name:'CTSEG',url:'https://ctseg.com.tr'},publisher:{'@type':'Organization',name:'CTSEG',url:'https://ctseg.com.tr'},about:['Strategic sourcing','Procurement','International trade'] };
---
<BaseLayout lang="en" title={`${post.title} | CTSEG`} description={post.description} canonical={canonical} alternate="https://ctseg.com.tr/tr/blog/">
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
<header class="site-header"><div class="wrap nav"><a class="brand" href="/en/"><img src="/images/ctseg-logo-transparent.png" width="1063" height="342" alt="CTSEG" /></a><nav class="nav-links"><a href="/en/">Home</a><a href="/en/blog/">Blog</a><a class="lang" href="/tr/blog/">TR</a></nav></div></header>
<main class="article-page"><article class="wrap article-wrap"><nav class="breadcrumb"><a href="/en/">Home</a><span>›</span><a href="/en/blog/">Blog</a></nav><p class="eyebrow">CTSEG Insights · {post.readingTime}</p><h1>{post.title}</h1><p class="article-lead">{post.description}</p><div class="answer-box"><strong>Direct answer</strong><p>{post.answer}</p></div>{post.sections.map(section=><section class="article-section"><h2>{section.heading}</h2>{section.body.map(p=><p>{p}</p>)}</section>)}<aside class="article-cta"><h2>Let’s review your sourcing decision.</h2><p>Share your requirement, supplier structure or market objective.</p><a class="btn" href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></aside></article></main>
<footer><div class="wrap footer-grid"><img src="/images/ctseg-logo-transparent.png" alt="CTSEG" width="1063" height="342"/><p>© 2026 CTSEG.</p><a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div><nav class="wrap footer-legal"><a href="/en/privacy-policy/">Privacy</a><a href="/en/cookie-policy/">Cookies</a><a href="/en/terms/">Terms</a><a href="/en/data-protection-notice/">Data protection</a></nav></footer>
</BaseLayout>
