---
import GlassMarketLanding from '../../../../components/GlassMarketLanding.astro';
import { glassMarketSlugs, type GlassMarketSlug } from '../../../../data/glass-market-seo';
export function getStaticPaths(){ return glassMarketSlugs.map((slug)=>({params:{slug}})); }
const {slug}=Astro.params as {slug:GlassMarketSlug};
---
<GlassMarketLanding lang="en" slug={slug}/>