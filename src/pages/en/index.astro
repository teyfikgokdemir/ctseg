---
import BaseLayout from '../../layouts/BaseLayout.astro';
const services=[['Strategic Sourcing','Build a resilient supplier base with the right cost, capacity and quality.','/en/services/strategic-sourcing/'],['International Trade','Coordinate markets, suppliers and operations end to end.','/en/services/international-trade-advisory/'],['Supplier Sourcing and Verification','Verify capacity, quality, records and commercial fit before commitment.','/en/services/supplier-sourcing-verification/'],['Cost Optimisation','Make total cost of ownership visible and manageable.','/en/blog/total-cost-of-ownership-procurement/'],['Market Entry','Enter new markets with a controlled, evidence-based plan.','/en/services/international-trade-advisory/'],['Operational Advisory','Turn procurement and trade processes into scalable systems.','mailto:info@ctseg.com.tr']];
const process=[['01','Clarify the requirement'],['02','Scan markets and suppliers'],['03','Verify and compare'],['04','Negotiate and execute']];
const strip=['STRATEGIC SOURCING','PROCUREMENT','SUPPLIER DEVELOPMENT','INTERNATIONAL TRADE','COST OPTIMISATION','MARKET ENTRY'];
---
<BaseLayout lang="en" title="CTSEG | Strategic Sourcing and International Trade" description="CTSEG provides strategic sourcing, procurement, supplier development and international trade solutions." canonical="https://ctseg.com.tr/en/" alternate="https://ctseg.com.tr/tr/">
<header class="site-header"><div class="wrap nav"><a class="brand" href="/en/" aria-label="CTSEG home"><img src="/images/ctseg-logo-transparent.png" width="1063" height="342" alt="CTSEG" /></a><nav class="nav-links"><a href="#services">Services</a><a href="#approach">Approach</a><a href="#process">Process</a><a href="/en/blog/">Blog</a><a href="#contact">Contact</a><a class="lang" href="/tr/">TR</a></nav></div></header>
<main>
<section class="hero"><div class="hero-orbit hero-orbit--one"></div><div class="hero-orbit hero-orbit--two"></div><div class="wrap hero-grid"><div><p class="eyebrow">Strategic sourcing · Procurement · International trade</p><h1>Manage sourcing, trade and growth as <span>one system.</span></h1><p class="lead">CTSEG helps companies identify the right suppliers, control cost and build safer, more scalable international trade operations.</p><div class="actions"><a class="btn" href="mailto:info@ctseg.com.tr">Book a conversation</a><a class="btn secondary" href="#services">Explore services</a></div><div class="trust-row"><span>Based in Türkiye</span><span>B2B focused</span><span>International reach</span></div></div><aside class="signal-panel"><div class="signal-panel__top"><span>CTSEG Signal Room</span><span class="live-dot">Live</span></div><div class="signal-item"><small>Supplier network</small><strong>Verification</strong><span>Active</span></div><div class="signal-item"><small>Cost visibility</small><strong>Comparison</strong><span>Tracking</span></div><div class="signal-item"><small>Commercial risk</small><strong>Control</strong><span>Managed</span></div><div class="signal-line"></div><p>Data, negotiation and execution move inside one decision system.</p></aside></div></section>
<section class="brand-strip" aria-label="CTSEG capabilities"><div class="strip-track"><div class="strip-group">{strip.map((item)=><span>{item}</span>)}</div><div class="strip-group" aria-hidden="true">{strip.map((item)=><span>{item}</span>)}</div></div></section>
<section id="services"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Capabilities</p><h2>From source to market.</h2></div><p class="section-intro">An integrated structure that strengthens decision quality and commercial outcomes.</p></div><div class="grid">{services.map(([h,p,url],i)=><a class="card" href={url}><span class="card-index">0{i+1}</span><h3>{h}</h3><p>{p}</p><span class="card-arrow">↗</span></a>)}</div></div></section>
<section id="approach" class="dark-panel"><div class="wrap split"><div><p class="eyebrow">Approach</p><h2>Not just finding suppliers. Building a trade system that works.</h2><p class="section-intro">Needs analysis, market scanning, supplier verification, bid comparison, negotiation, risk management and performance tracking move within one framework.</p></div><div class="facts"><div class="fact"><span>01</span><div><strong>Clear scope</strong><p>Objectives, criteria and decisions are defined upfront.</p></div></div><div class="fact"><span>02</span><div><strong>Verifiable evidence</strong><p>Recommendations are grounded in commercial proof.</p></div></div><div class="fact"><span>03</span><div><strong>Executable outcomes</strong><p>The result is an actionable roadmap, not only a report.</p></div></div></div></div></section>
<section id="process"><div class="wrap"><p class="eyebrow">Operating model</p><h2>Stronger commercial decisions in four steps.</h2><div class="process-grid">{process.map(([n,t])=><article><span>{n}</span><h3>{t}</h3></article>)}</div></div></section>
<section class="cta-section" id="contact"><div class="wrap cta-card"><div><p class="eyebrow">Contact</p><h2>Make your next commercial decision stronger.</h2><p class="section-intro">Share your sourcing, procurement or international trade requirement.</p></div><a class="btn btn-large" href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div></section>
</main><footer><div class="wrap footer-grid"><img src="/images/ctseg-logo-transparent.png" alt="CTSEG" width="1063" height="342"/><p>© 2026 CTSEG. All rights reserved.</p><a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div><nav class="wrap footer-legal" aria-label="Legal links"><a href="/en/privacy-policy/">Privacy Policy</a><a href="/en/cookie-policy/">Cookie Policy</a><a href="/en/terms/">Terms of Use</a><a href="/en/data-protection-notice/">Data Protection</a><a href="/en/blog/">Blog</a></nav></footer>
</BaseLayout>