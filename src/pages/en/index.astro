---
import BaseLayout from '../../layouts/BaseLayout.astro';
const services=[['Strategic Sourcing','Build a resilient supplier base with the right cost, capacity and quality.'],['International Trade','Coordinate markets, suppliers and operations end to end.'],['Supplier Development','Improve quality, lead time, capacity and commercial performance.'],['Cost Optimisation','Make total cost of ownership visible and manageable.'],['Market Entry','Enter new markets with a controlled, evidence-based plan.'],['Operational Advisory','Turn procurement and trade processes into scalable systems.']];
---
<BaseLayout lang="en" title="CTSEG | Strategic Sourcing and International Trade" description="CTSEG provides strategic sourcing, procurement, supplier development and international trade solutions." canonical="https://ctseg.com.tr/en/" alternate="https://ctseg.com.tr/tr/">
<header class="site-header"><div class="wrap nav"><a class="brand" href="/en/" aria-label="CTSEG home"><img src="/images/ctseg-logo-transparent.png" width="1063" height="342" alt="CTSEG" /></a><nav class="nav-links"><a href="#services">Services</a><a href="#approach">Approach</a><a href="#contact">Contact</a><a class="lang" href="/tr/">TR</a></nav></div></header>
<main><section class="hero"><div class="wrap"><p class="eyebrow">Strategic sourcing · Procurement · International trade</p><h1>Manage sourcing, trade and growth as one system.</h1><p class="lead">CTSEG helps companies identify the right suppliers, control cost and build safer, more scalable international trade operations.</p><div class="actions"><a class="btn" href="mailto:info@ctseg.com.tr">Book a conversation</a><a class="btn secondary" href="#services">Explore services</a></div></div></section>
<section id="services"><div class="wrap"><p class="eyebrow">Capabilities</p><h2>From source to market.</h2><p class="section-intro">An integrated structure that strengthens decision quality and commercial outcomes.</p><div class="grid">{services.map(([h,p])=><article class="card"><h3>{h}</h3><p>{p}</p></article>)}</div></div></section>
<section id="approach"><div class="wrap split"><div><p class="eyebrow">Approach</p><h2>Not just finding suppliers. Building a trade system that works.</h2><p class="section-intro">Needs analysis, market scanning, supplier verification, bid comparison, negotiation, risk management and performance tracking move within one framework.</p></div><div class="facts"><div class="fact"><strong>Clear scope</strong><br/>Objectives, criteria and decisions are defined upfront.</div><div class="fact"><strong>Verifiable evidence</strong><br/>Recommendations are grounded in commercial proof.</div><div class="fact"><strong>Executable outcomes</strong><br/>The result is an actionable roadmap, not only a report.</div></div></div></section>
<section id="contact"><div class="wrap"><p class="eyebrow">Contact</p><h2>Make your next commercial decision stronger.</h2><p class="section-intro">Share your sourcing, procurement or international trade requirement.</p><div class="actions"><a class="btn" href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div></div></section></main><footer><div class="wrap">© 2026 CTSEG. All rights reserved.</div></footer>
</BaseLayout>
