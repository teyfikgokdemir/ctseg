---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GlobalSourcing from '../../../components/GlobalSourcing.astro';
import {activeLocales} from '../../../data/locales';
import {globalPath,globalAlternates,globalTitle,globalDescription} from '../../../data/global-sourcing';
export function getStaticPaths(){return activeLocales.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props;
---
<BaseLayout lang={lang} title={globalTitle(lang,'markets')+' | CTSEG'} description={globalDescription(lang,'markets')} pageKey="global-markets" canonical={'https://ctseg.com.tr'+globalPath(lang,'global-markets')} alternates={globalAlternates('global-markets')}><GlobalSourcing lang={lang} mode="markets" /></BaseLayout>
