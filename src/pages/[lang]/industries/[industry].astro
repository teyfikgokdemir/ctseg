---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GlobalSourcing from '../../../components/GlobalSourcing.astro';
import {activeLocales,schemaLanguage} from '../../../data/locales';
import {industryIds,globalPath,globalAlternates,globalTitle,globalDescription} from '../../../data/global-sourcing';
export function getStaticPaths(){return activeLocales.flatMap(lang=>industryIds.map(id=>({params:{lang,industry:id},props:{lang,id}})));}
const {lang,id}=Astro.props;
const title=globalTitle(lang,'industry',id)+' | CTSEG';
const description=globalDescription(lang,'industry',id);
const canonical='https://ctseg.com.tr'+globalPath(lang,'industries',id);
const schema={'@context':'https://schema.org','@type':'Service',name:title,description,url:canonical,inLanguage:schemaLanguage(lang),provider:{'@id':'https://ctseg.com.tr/#organization'}};
---
<BaseLayout lang={lang} title={title} description={description} pageKey="global-industry" pageId={id} canonical={canonical} alternates={globalAlternates('industries',id)} schema={[schema]}><GlobalSourcing lang={lang} mode="industry" id={id} /></BaseLayout>
