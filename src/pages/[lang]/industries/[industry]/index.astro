---
import { specializationUi } from '../../../../data/specialization-ui';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import GlobalSourcing from '../../../../components/GlobalSourcing.astro';
import { activeLocales, schemaLanguage } from '../../../../data/locales';
import { industryIds, globalPath, globalAlternates, globalTitle, globalDescription } from '../../../../data/global-sourcing';
import { industrySpecializations } from '../../../../data/industry-specializations';
import { globalCopy } from '../../../../data/global-sourcing-locales';
import { localizedPath, type Locale } from '../../../../data/site';

export function getStaticPaths() {
  return activeLocales.flatMap((lang) =>
    industryIds.map((id) => ({
      params: { lang, industry: id },
      props: { lang, id }
    }))
  );
}

const { lang, id } = Astro.props as { lang: Locale; id: string };
const title = globalTitle(lang, 'industry', id) + ' | CTSEG';
const description = globalDescription(lang, 'industry', id);
const canonical = 'https://ctseg.com.tr' + globalPath(lang, 'industries', id);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: title,
  description,
  url: canonical,
  inLanguage: schemaLanguage(lang),
  provider: { '@id': 'https://ctseg.com.tr/#organization' }
};

const c = globalCopy[lang] || globalCopy.en;
const labels = specializationUi[lang];
const specs = industrySpecializations.filter((s) => s.industryId === id);
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  pageKey="global-industry"
  pageId={id}
  canonical={canonical}
  alternates={globalAlternates('industries', id)}
  schema={[schema]}
>
  <GlobalSourcing lang={lang} mode="industry" id={id}>

  {specs.length > 0 && (
    <section class="industry-specializations-section" aria-labelledby="industry-specializations-title">
      <div class="container">
        <div class="industry-specializations-header">
          <div>
            <p class="industry-specializations-eyebrow">{labels.areas}</p>
            <h2 id="industry-specializations-title">{labels.topics}</h2>
          </div>
          <p class="industry-specializations-intro">{c.sectors[industryIds.indexOf(id as any)]}</p>
        </div>
        <div class="industry-specializations-grid">
          {specs.map((spec) => {
            const specContent = spec.content[lang] || spec.content.en;
            return (
              <a class="industry-specialization" href={`/${lang}/industries/${id}/${spec.id}/`}>
                <div class="industry-specialization-body">
                  <h3>{specContent.h1}</h3>
                  <p>{specContent.lead}</p>
                </div>
                <span class="industry-specialization-action" aria-hidden="true">↗</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</GlobalSourcing>
</BaseLayout>
<style>
  .industry-specializations-section{padding:clamp(72px,8vw,122px) 0;background:#15231b;color:#f2f4ed}
  .industry-specializations-header{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(28px,7vw,110px);align-items:end;margin-bottom:clamp(36px,5vw,70px)}
  .industry-specializations-eyebrow{font-size:12px;letter-spacing:.16em;font-weight:700;text-transform:uppercase;color:#c4f000;margin:0 0 18px}
  .industry-specializations-header h2{font-size:clamp(32px,3.4vw,52px);font-weight:500;letter-spacing:-.045em;line-height:1.12;color:#f2f4ed;margin:0}
  .industry-specializations-intro{font-size:clamp(16px,1.25vw,19px);line-height:1.62;color:#c4d1c5;margin:0;max-width:47ch}
  .industry-specializations-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(26px,6vw,92px)}
  .industry-specialization{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:clamp(25px,3vw,40px) 0;border-top:1px solid rgba(244,247,238,.3);color:#f2f4ed;text-decoration:none;min-width:0}
  .industry-specialization:hover{border-top-color:#c4f000}
  .industry-specialization h3{font-size:clamp(21px,2.05vw,30px);line-height:1.24;letter-spacing:-.035em;font-weight:500;color:inherit;margin:0 0 12px;overflow-wrap:anywhere}
  .industry-specialization p{font-size:15px;line-height:1.65;color:#c6d1c5;margin:0;max-width:54ch}
  .industry-specialization-action{flex:0 0 auto;font-size:23px;line-height:1;color:#c4f000;transition:transform .2s ease}
  .industry-specialization:hover .industry-specialization-action{transform:translate(3px,-3px)}
  .industry-specialization:focus-visible{outline:3px solid #c4f000;outline-offset:4px}
  @media(max-width:760px){
    .industry-specializations-header,.industry-specializations-grid{grid-template-columns:1fr}
    .industry-specializations-header{gap:22px}
    .industry-specialization{padding:27px 0}
    .industry-specialization h3{font-size:23px}
  }
  @media(prefers-reduced-motion:reduce){.industry-specialization-action{transition:none}.industry-specialization:hover .industry-specialization-action{transform:none}}
</style>
