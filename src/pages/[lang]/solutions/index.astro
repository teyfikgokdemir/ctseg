---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GlobalSourcing from '../../../components/GlobalSourcing.astro';
import {activeLocales} from '../../../data/locales';
import {globalPath,globalAlternates,globalTitle,globalDescription} from '../../../data/global-sourcing';
export function getStaticPaths(){return activeLocales.map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props;
---
<BaseLayout lang={lang} title={globalTitle(lang,'solutions')+' | CTSEG'} description={globalDescription(lang,'solutions')} pageKey="global-solutions" canonical={'https://ctseg.com.tr'+globalPath(lang,'solutions')} alternates={globalAlternates('solutions')}><GlobalSourcing lang={lang} mode="solutions" /></BaseLayout>
