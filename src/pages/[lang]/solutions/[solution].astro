---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GlobalSourcing from '../../../components/GlobalSourcing.astro';
import {activeLocales,schemaLanguage} from '../../../data/locales';
import {capabilityIds,globalPath,globalAlternates,globalTitle,globalDescription} from '../../../data/global-sourcing';
export function getStaticPaths(){return activeLocales.flatMap(lang=>capabilityIds.map(id=>({params:{lang,solution:id},props:{lang,id}})));}
const {lang,id}=Astro.props;
const title=globalTitle(lang,'solution',id)+' | CTSEG';
const description=globalDescription(lang,'solution',id);
const canonical='https://ctseg.com.tr'+globalPath(lang,'solutions',id);
const schema={'@context':'https://schema.org','@type':'Service',name:title,description,url:canonical,inLanguage:schemaLanguage(lang),provider:{'@id':'https://ctseg.com.tr/#organization'}};
---
<BaseLayout lang={lang} title={title} description={description} pageKey="global-solution" pageId={id} canonical={canonical} alternates={globalAlternates('solutions',id)} schema={[schema]}><GlobalSourcing lang={lang} mode="solution" id={id} /></BaseLayout>
