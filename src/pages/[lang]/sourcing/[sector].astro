---
import '../../../styles/site.css';
import { pathForSector, tradeCopy, tradeLocales, tradeSectorIds, tradeUi, type TradeLocale, type TradeSectorId } from '../../../data/trade-sectors';
export function getStaticPaths(){return tradeLocales.flatMap(lang=>tradeSectorIds.map(id=>({params:{lang,sector:tradeCopy[lang][id].slug},props:{lang,id}})))}
const {lang,id}=Astro.props as {lang:TradeLocale;id:TradeSectorId};
const copy=tradeCopy[lang][id],ui=tradeUi[lang];
const canonical=`https://ctseg.com.tr${pathForSector(lang,id)}`;
const image=id==='wholesale-textiles'?'/images/ctseg-wholesale-textiles-editorial.webp':'/images/ctseg-iranian-carpets-editorial.webp';
const contact={tr:'/tr/iletisim/',en:'/en/contact/',de:'/de/kontakt/',it:'/it/contatti/',fr:'/fr/contact/',fa:'/fa/tamin-beynolmelali-iran/#contact'}[lang];
const home=lang==='tr'?'/':lang==='fa'?'/fa/tamin-beynolmelali-iran/':`/${lang}/`;
const schema=[
 {'@context':'https://schema.org','@type':'Organization','@id':'https://ctseg.com.tr/#organization',name:'CTSEG Sanayi ve Ticaret Limited Şirketi',alternateName:'CTSEG',foundingDate:'2022',founder:{'@type':'Person',name:'Teyfik Gökdemir'},address:{'@type':'PostalAddress',streetAddress:'Fevzipaşa Caddesi',addressLocality:'Fatih',addressRegion:'İstanbul',addressCountry:'TR'},url:'https://ctseg.com.tr/'},
 {'@type':'WebPage','@id':`${canonical}#webpage`,url:canonical,name:copy.title,description:copy.description,inLanguage:lang,isPartOf:{'@id':'https://ctseg.com.tr/#website'},about:{'@id':'https://ctseg.com.tr/#organization'}},
 {'@type':'Service','@id':`${canonical}#service`,name:copy.title,description:copy.description,serviceType:copy.eyebrow,provider:{'@id':'https://ctseg.com.tr/#organization'},areaServed:['Türkiye','Europe','International'],inLanguage:lang},
 {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'CTSEG',item:`https://ctseg.com.tr${home}`},{'@type':'ListItem',position:2,name:copy.title,item:canonical}]}
];
---
<!doctype html><html lang={lang} dir={lang==='fa'?'rtl':'ltr'}><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{copy.title} | CTSEG</title><meta name="description" content={copy.description}/><meta name="robots" content="index,follow,max-image-preview:large"/><link rel="canonical" href={canonical}/>
{tradeLocales.map(code=><link rel="alternate" hreflang={code} href={`https://ctseg.com.tr${pathForSector(code,id)}`}/>)}<link rel="alternate" hreflang="x-default" href={`https://ctseg.com.tr${pathForSector('en',id)}`}/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="preload" href="/fonts/dm-sans-latin-ext-variable.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/source-serif-4-latin-ext-variable.woff2" as="font" type="font/woff2" crossorigin/><meta property="og:type" content="website"/><meta property="og:title" content={copy.title}/><meta property="og:description" content={copy.description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={`https://ctseg.com.tr${image}`}/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
</head><body><a class="skip-link" href="#main">Skip to content</a>
<header class="trade-header"><div class="container trade-header__inner"><a class="trade-brand" href={home}><img src="/images/ctseg-logo-transparent.png" width="190" height="61" alt="CTSEG"/></a><nav aria-label="Language selection">{tradeLocales.map(code=><a class:list={{active:code===lang}} lang={code} hreflang={code} href={pathForSector(code,id)}>{code.toUpperCase()}</a>)}</nav><a class="button button-small" href={contact}>{ui.contact}</a></div></header>
<main id="main"><section class="trade-hero"><img src={image} width="1536" height="1024" alt="" fetchpriority="high"/><div class="container trade-hero__content"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.lead}</p><div class="actions"><a class="button" href={contact}>{copy.cta}</a><a class="button button-secondary" href={home}>{ui.home}</a></div></div></section>
<section class="section"><div class="container"><div class="section-head"><h2>{copy.scopeTitle}</h2><p>{copy.description}</p></div><div class="trade-grid">{copy.items.map((item,index)=><article><span>{String(index+1).padStart(2,'0')}</span><h3>{item}</h3></article>)}</div></div></section>
<section class="section trade-assurance"><div class="container trade-split"><div><p class="eyebrow">CTSEG</p><h2>{ui.assurance}</h2><p>{copy.lead}</p></div><div><p class="eyebrow">{ui.process}</p><ol>{ui.checks.map((step,index)=><li><span>{String(index+1).padStart(2,'0')}</span>{step}</li>)}</ol></div></div></section>
<section class="section related"><div class="container"><h2>{ui.related}</h2><div>{tradeSectorIds.filter(x=>x!==id).map(x=><a href={pathForSector(lang,x)}>{tradeCopy[lang][x].title}<span aria-hidden="true">→</span></a>)}</div></div></section>
<section class="section trade-cta"><div class="container"><p class="eyebrow">RFQ · CTSEG</p><h2>{copy.cta}</h2><a class="button" href={contact}>{ui.contact}</a></div></section></main>
<footer class="trade-footer"><div class="container"><div><strong>CTSEG Sanayi ve Ticaret Limited Şirketi</strong>{lang==='tr'&&<p>Türkiye merkezli stratejik tedarik, doğrulanmış ticari ürünler ve uluslararası ticari karar desteği.</p>}</div><span>{lang==='tr'?'© 2026 CTSEG. Tüm hakları saklıdır.':'© 2026 CTSEG'}</span><a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a></div></footer></body></html>
<style>
body{background:#f1ece3;color:#1d1b18}.trade-header{position:sticky;top:0;z-index:20;border-bottom:1px solid #ffffff1f;background:#232520f2;backdrop-filter:blur(16px)}.trade-header__inner{min-height:78px;display:flex;align-items:center;gap:1.3rem}.trade-brand{margin-inline-end:auto}.trade-brand img{display:block;width:155px;height:auto;filter:brightness(0) invert(1)}.trade-header nav{display:flex}.trade-header nav a{min-width:42px;min-height:42px;display:grid;place-items:center;color:#c9c4b9;font-size:.72rem;font-weight:800}.trade-header nav a.active{color:#fff;background:#9d5435}.trade-hero{position:relative;min-height:720px;display:grid;align-items:end;isolation:isolate;background:#252820;color:#fff}.trade-hero>img{position:absolute;z-index:-2;inset:0;width:100%;height:100%;object-fit:cover}.trade-hero:after{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,#161714ed 0%,#161714bd 42%,#1617141a 75%)}html[dir="rtl"] .trade-hero:after{background:linear-gradient(270deg,#161714ed 0%,#161714bd 42%,#1617141a 75%)}.trade-hero__content{padding-block:clamp(6rem,12vw,10rem)}.trade-hero h1{max-width:920px;font-size:clamp(3rem,6vw,6.6rem);line-height:.94;letter-spacing:-.045em}.trade-hero__content>p:not(.eyebrow){max-width:720px;font-size:clamp(1rem,1.5vw,1.25rem);line-height:1.75;color:#e2ded5}.actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.7rem}.trade-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #bdb4a7}.trade-grid article{min-height:170px;padding:1.5rem;border-bottom:1px solid #bdb4a7;border-inline-end:1px solid #bdb4a7}.trade-grid span,.trade-split li span{display:block;margin-bottom:1.8rem;color:#9d5435;font-size:.72rem;font-weight:800}.trade-grid h3{font-size:1.22rem}.trade-assurance{background:#293029;color:#f3eee6}.trade-split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,8vw,8rem)}.trade-split h2{font-size:clamp(2.4rem,4vw,4.5rem)}.trade-split p:not(.eyebrow){color:#d2cdc4;line-height:1.8}.trade-split ol{margin:0;padding:0;list-style:none;border-top:1px solid #586157}.trade-split li{display:grid;grid-template-columns:55px 1fr;gap:1rem;padding:1.1rem 0;border-bottom:1px solid #586157;color:#d2cdc4}.trade-split li span{margin:0}.related h2{margin-bottom:2rem}.related>div>div{display:grid}.related a{display:flex;justify-content:space-between;gap:1rem;padding:1.4rem 0;border-top:1px solid #bdb4a7;font-size:clamp(1.1rem,2vw,1.5rem)}.trade-cta{text-align:center;background:#ddd5c8}.trade-cta h2{max-width:850px;margin-inline:auto}.trade-footer{padding:1.5rem 0;background:#211c18;color:#d5cec3}.trade-footer .container{display:flex;justify-content:space-between;gap:1rem}html[lang="fa"] body{font-family:Tahoma,"Segoe UI",Arial,sans-serif}@media(max-width:900px){.trade-header nav{display:none}.trade-grid{grid-template-columns:repeat(2,1fr)}.trade-split{grid-template-columns:1fr}}@media(max-width:560px){.trade-header__inner>.button{display:none}.trade-hero{min-height:610px}.trade-hero h1{font-size:clamp(2.6rem,12vw,4rem)}.trade-grid{grid-template-columns:1fr}.trade-footer .container{flex-direction:column;align-items:center}.trade-hero:after{background:linear-gradient(180deg,#16171447,#161714f0 70%)!important}}
</style>
