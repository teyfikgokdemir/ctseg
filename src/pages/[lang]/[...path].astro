---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContent from '../../components/PageContent.astro';
import { insights, products, services, ui } from '../../data/site';
import { guides, processPages } from '../../data/completion';
import { getPosts } from '../../data/blog';
import { breadcrumbSchema, canonicalFor, getMeta, getRouteRecords, tradeMatchingServiceSchema, type RouteRecord } from '../../lib/routes';

export function getStaticPaths() {
  return getRouteRecords().map((record) => ({
    params:{ lang:record.lang, path:record.path },
    props:{ record }
  }));
}

const { record } = Astro.props as { record: RouteRecord };
const meta = getMeta(record);
const schemas:any[] = [breadcrumbSchema(record, meta.title)];
if (record.key === 'home') schemas.push(tradeMatchingServiceSchema(record,meta.title,meta.description));
if (record.key === 'services' && record.id) {
  const service = services[record.id as keyof typeof services];
  schemas.push({
    '@context':'https://schema.org','@type':'Service',
    '@id':`${canonicalFor(record)}#service`,url:canonicalFor(record),
    name:service.names[record.lang],description:service.descriptions[record.lang],
    serviceType:service.names[record.lang],inLanguage:record.lang,
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Türkiye','Europe','International']
  });
}
if (record.key === 'insights' && !record.id) {
  schemas.push({
    '@context':'https://schema.org','@type':'Blog',
    '@id':`${canonicalFor(record)}#blog`,url:canonicalFor(record),
    name:meta.title,description:meta.description,inLanguage:record.lang,
    publisher:{'@id':'https://ctseg.com.tr/#organization'}
  });
}
if (record.key === 'products' && record.id) {
  const product = products[record.id as keyof typeof products];
  schemas.push({
    '@context':'https://schema.org','@type':'Service',
    '@id':`${canonicalFor(record)}#product-sourcing-service`,name:`${product.names[record.lang]} sourcing assessment`,
    description:product.descriptions[record.lang],serviceType:'Specification-led B2B sourcing assessment',
    image:`https://ctseg.com.tr${product.media.src}`,
    provider:{'@id':'https://ctseg.com.tr/#organization'},areaServed:['Türkiye','Europe','International'],
    additionalProperty:[
      {'@type':'PropertyValue',name:ui[record.lang].origin,value:product.origin},
      {'@type':'PropertyValue',name:'Commercial model',value:'Qualification and specification-led B2B assessment'}
    ]
  });
  schemas.push({
    '@context':'https://schema.org','@type':'FAQPage',
    mainEntity:[
      {'@type':'Question',name:ui[record.lang].origin,acceptedAnswer:{'@type':'Answer',text:ui[record.lang].complianceText}},
      {'@type':'Question',name:ui[record.lang].samplePolicy,acceptedAnswer:{'@type':'Answer',text:ui[record.lang].sampleText}}
    ]
  });
}
if (record.key === 'insights' && record.id) {
  const insight = insights[record.id as keyof typeof insights];
  const postIndex:Record<string,number> = {'strategic-vs-procurement':0,'supplier-selection':1,'total-cost':2,'supplier-risk':3,rfq:4,'supply-chain-risk':5};
  const originalPost = (record.lang === 'tr' || record.lang === 'en') && record.id in postIndex
    ? getPosts(record.lang).at(postIndex[record.id])
    : null;
  schemas.push({
    '@context':'https://schema.org','@type':'BlogPosting',
    '@id':`${canonicalFor(record)}#article`,url:canonicalFor(record),headline:insight.titles[record.lang],
    description:insight.descriptions[record.lang],
    datePublished:originalPost?.date ?? '2026-07-27',dateModified:originalPost?.updated ?? '2026-07-27',
    inLanguage:record.lang,mainEntityOfPage:{'@id':`${canonicalFor(record)}#webpage`},
    author:{'@type':'Person',name:'Teyfik Gökdemir'},
    publisher:{'@id':'https://ctseg.com.tr/#organization'}
  });
}
if (record.key === 'how-we-work' && (record.lang === 'tr' || record.lang === 'en')) {
  const process=processPages[record.lang];
  schemas.push({
    '@context':'https://schema.org','@type':'HowTo',name:process.title,description:process.description,
    step:process.steps.map((name,index)=>({'@type':'HowToStep',position:index+1,name}))
  });
  schemas.push({
    '@context':'https://schema.org','@type':'FAQPage',
    mainEntity:process.faq.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))
  });
}
if (record.key === 'guides' && record.id) {
  const guideLang = (record.lang === 'tr' || record.lang === 'en') ? record.lang : 'en';
  const guide = guides[record.id as keyof typeof guides]?.[guideLang] || { title: 'Guide', description: 'Commercial guide' };
  schemas.push({
    '@context':'https://schema.org','@type':'Article',headline:guide.title,description:guide.description,
    datePublished:'2026-07-27',dateModified:'2026-07-27',inLanguage:record.lang,
    mainEntityOfPage:canonicalFor(record),author:{'@type':'Person',name:'Teyfik Gökdemir'},
    publisher:{'@id':'https://ctseg.com.tr/#organization'}
  });
}
---
<BaseLayout lang={record.lang} title={meta.title} description={meta.description} pageKey={record.key} pageId={record.id} canonical={canonicalFor(record)} schema={schemas}>
  <PageContent record={record} />
</BaseLayout>
