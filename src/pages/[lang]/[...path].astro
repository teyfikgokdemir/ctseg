---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContent from '../../components/PageContent.astro';
import { schemaLanguage } from '../../data/locales';
import { insights, products, services, ui } from '../../data/site';
import { guides, processPages } from '../../data/completion';
import { getPosts, getPostForInsight } from '../../data/blog';
import { searchLandings } from '../../data/search-landings';
import { iranTradeContent } from '../../data/iran-trade';
import { vietnamMarketEntryContent } from '../../data/vietnam-market-entry';
import { vietnamTurkiyeContent } from '../../data/vietnam-turkiye';
import { chinaMarketEntryContent } from '../../data/china-market-entry';
import { chinaTurkiyeContent } from '../../data/china-turkiye';
import { ukraineTurkiyeContent } from '../../data/ukraine-market';
import { regionalIntentHomes } from '../../data/regional-intent-homes';
import { tradeDeskCopy } from '../../data/trade-desk';
import { syriaMarketContent } from '../../data/syria-market';
import { breadcrumbSchema, canonicalFor, getMeta, getRouteRecords, tradeMatchingServiceSchema, type RouteRecord } from '../../lib/routes';

export function getStaticPaths() {
  return getRouteRecords().map((record) => ({
    params:{ lang:record.lang, path:record.path },
    props:{ record }
  }));
}

const { record } = Astro.props as { record: RouteRecord };
const meta = getMeta(record);
const schemas:any[] = [breadcrumbSchema(record, meta.title)];
if (record.key === 'home') {
  if (record.lang === 'fa') {
    const page=iranTradeContent.fa;
    schemas.push({
      '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#iran-trade-service`,
      url:canonicalFor(record),name:page.title,description:page.description,inLanguage:'fa',
      serviceType:'Iran Türkiye B2B sourcing and market-entry coordination',
      provider:{'@id':'https://ctseg.com.tr/#organization'},
      areaServed:['Iran','Türkiye','Europe'],
      audience:{'@type':'BusinessAudience',name:'Iranian buyers, producers and exporters'}
    });
    schemas.push({
      '@context':'https://schema.org','@type':'FAQPage',
      mainEntity:page.faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))
    });
  } else if (['de','it','ru'].includes(record.lang)) {
    const page=regionalIntentHomes[record.lang as 'de'|'it'|'ru'];
    schemas.push({
      '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#regional-sourcing-service`,
      url:canonicalFor(record),name:page.title,description:page.description,inLanguage:schemaLanguage(record.lang),
      serviceType:record.lang === 'de'
        ? 'Two-way DACH Türkiye B2B sourcing, nearshoring and market entry'
        : record.lang === 'it'
        ? 'Two-way Italy Türkiye B2B sourcing, OEM manufacturing and market entry'
        : 'Compliance-led Türkiye sourcing for Russian-speaking B2B companies',
      provider:{'@id':'https://ctseg.com.tr/#organization'},
      areaServed:record.lang === 'de' ? ['Germany','Austria','Switzerland','Türkiye'] : record.lang === 'it' ? ['Italy','Türkiye'] : ['Türkiye','International'],
      audience:record.lang === 'de' ? [
        {'@type':'BusinessAudience',name:'DACH B2B buyers and procurement teams sourcing from Türkiye'},
        {'@type':'BusinessAudience',name:'DACH manufacturers and exporters seeking buyers or distributors in Türkiye'}
      ] : record.lang === 'it' ? [
        {'@type':'BusinessAudience',name:'Italian brands, importers and industrial buyers sourcing from Türkiye'},
        {'@type':'BusinessAudience',name:'Italian manufacturers and exporters seeking buyers or distributors in Türkiye'}
      ] : {'@type':'BusinessAudience',name:'Russian-speaking B2B buyers seeking compliant sourcing in Türkiye'}
    });
    schemas.push({
      '@context':'https://schema.org','@type':'ItemList',
      name:page.sectorsTitle,itemListElement:page.sectors.map((name,index)=>({'@type':'ListItem',position:index+1,name}))
    });
    schemas.push({
      '@context':'https://schema.org','@type':'FAQPage',
      mainEntity:page.faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))
    });
  } else if (record.lang === 'zh' && chinaMarketEntryContent.zh) {
    const page=chinaMarketEntryContent.zh;
    schemas.push({
      '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#china-market-entry-service`,
      url:canonicalFor(record),name:page.title,description:page.description,inLanguage:'zh-CN',
      serviceType:'China manufacturer export market entry and B2B buyer development',
      provider:{'@id':'https://ctseg.com.tr/#organization'},
      areaServed:['Türkiye','Europe'],
      audience:{'@type':'BusinessAudience',name:'Chinese manufacturers, OEM/ODM factories and exporters'}
    });
    schemas.push({
      '@context':'https://schema.org','@type':'ItemList',
      name:page.sectorsTitle,itemListElement:page.sectors.map((name,index)=>({'@type':'ListItem',position:index+1,name}))
    });
    schemas.push({
      '@context':'https://schema.org','@type':'FAQPage',
      mainEntity:page.faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))
    });
  } else if (record.lang === 'vi' && vietnamMarketEntryContent.vi) {
    const page=vietnamMarketEntryContent.vi;
    schemas.push({
      '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#vietnam-market-entry-service`,
      url:canonicalFor(record),name:page.title,description:page.description,inLanguage:'vi-VN',
      serviceType:'Vietnam exporter market entry and B2B buyer development',
      provider:{'@id':'https://ctseg.com.tr/#organization'},
      areaServed:['Türkiye','Europe'],
      audience:{'@type':'BusinessAudience',name:'Vietnamese manufacturers and exporters'}
    });
    schemas.push({
      '@context':'https://schema.org','@type':'ItemList',
      name:page.sectorsTitle,itemListElement:page.sectors.map((name,index)=>({'@type':'ListItem',position:index+1,name}))
    });
    schemas.push({
      '@context':'https://schema.org','@type':'FAQPage',
      mainEntity:page.faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))
    });
  } else {
    schemas.push(tradeMatchingServiceSchema(record,meta.title,meta.description));
  }
}
if (record.key === 'home' && tradeDeskCopy[record.lang as keyof typeof tradeDeskCopy]) {
  const desk=tradeDeskCopy[record.lang as keyof typeof tradeDeskCopy];
  schemas.push({
    '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#external-trade-desk`,
    url:canonicalFor(record),name:desk.title,description:desk.text,inLanguage:schemaLanguage(record.lang),
    serviceType:'Outsourced international trade desk, sourcing and export development',
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Türkiye','Europe','Middle East','Asia','International'],
    audience:{'@type':'BusinessAudience',name:'Companies outsourcing ongoing international trade, sourcing and export development operations'}
  });
}
if (record.key === 'syria-market' && (record.lang === 'tr' || record.lang === 'en')) {
  const page=syriaMarketContent[record.lang];
  schemas.push({
    '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#syria-trade-service`,
    url:canonicalFor(record),name:page.title,description:page.description,inLanguage:schemaLanguage(record.lang),
    serviceType:'Türkiye Syria B2B sourcing, supplier verification and market-entry coordination',
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Türkiye','Syria'],
    audience:[
      {'@type':'BusinessAudience',name:'Syrian business buyers sourcing products and manufacturers from Türkiye'},
      {'@type':'BusinessAudience',name:'Turkish manufacturers seeking buyers, importers and distributors in Syria'}
    ]
  });
  schemas.push({
    '@context':'https://schema.org','@type':'ItemList',
    name:page.sectorsTitle,
    itemListElement:page.sectors.map((name,index)=>({'@type':'ListItem',position:index+1,name}))
  });
  schemas.push({
    '@context':'https://schema.org','@type':'FAQPage',
    mainEntity:page.faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))
  });
}
if (record.key === 'services' && record.id) {
  const service = services[record.id as keyof typeof services];
  schemas.push({
    '@context':'https://schema.org','@type':'Service',
    '@id':`${canonicalFor(record)}#service`,url:canonicalFor(record),
    name:service.names[record.lang],description:service.descriptions[record.lang],
    serviceType:service.names[record.lang],inLanguage:schemaLanguage(record.lang),
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Türkiye','Europe','International']
  });
}
if (record.key === 'insights' && !record.id) {
  schemas.push({
    '@context':'https://schema.org','@type':'Blog',
    '@id':`${canonicalFor(record)}#blog`,url:canonicalFor(record),
    name:meta.title,description:meta.description,inLanguage:schemaLanguage(record.lang),
    publisher:{'@id':'https://ctseg.com.tr/#organization'}
  });
}
if (record.key === 'products' && record.id) {
  const product = products[record.id as keyof typeof products];
  schemas.push({
    '@context':'https://schema.org','@type':'Product',
    '@id':`${canonicalFor(record)}#product`,url:canonicalFor(record),
    name:product.names[record.lang],description:product.descriptions[record.lang],image:`https://ctseg.com.tr${product.media.src}`,
    category:'B2B trade product',inLanguage:schemaLanguage(record.lang),
    additionalProperty:[
      {'@type':'PropertyValue',name:ui[record.lang].origin,value:product.origin},
      {'@type':'PropertyValue',name:'Assessment status',value:'Specification, availability, MOQ, documents and commercial terms verified on request'}
    ]
  });
  schemas.push({
    '@context':'https://schema.org','@type':'Service',
    '@id':`${canonicalFor(record)}#product-sourcing-service`,name:`${product.names[record.lang]} sourcing assessment`,
    description:product.descriptions[record.lang],serviceType:'Specification-led B2B sourcing assessment',
    image:`https://ctseg.com.tr${product.media.src}`,
    provider:{'@id':'https://ctseg.com.tr/#organization'},areaServed:['Türkiye','Europe','International'],
    additionalProperty:[
      {'@type':'PropertyValue',name:ui[record.lang].origin,value:product.origin},
      {'@type':'PropertyValue',name:'Commercial model',value:'Qualification and specification-led B2B assessment'}
    ]
  });
  schemas.push({
    '@context':'https://schema.org','@type':'FAQPage',
    mainEntity:[
      {'@type':'Question',name:ui[record.lang].origin,acceptedAnswer:{'@type':'Answer',text:ui[record.lang].complianceText}},
      {'@type':'Question',name:ui[record.lang].samplePolicy,acceptedAnswer:{'@type':'Answer',text:ui[record.lang].sampleText}}
    ]
  });
}
if (record.key === 'insights' && record.id) {
  const insight = insights[record.id as keyof typeof insights];
  const originalPost = record.id ? getPostForInsight(record.lang, record.id) : null;
  schemas.push({
    '@context':'https://schema.org','@type':'BlogPosting',
    '@id':`${canonicalFor(record)}#article`,url:canonicalFor(record),headline:insight.titles[record.lang],
    description:insight.descriptions[record.lang],
    datePublished:originalPost?.date ?? '2026-07-27',dateModified:originalPost?.updated ?? '2026-07-27',
    inLanguage:schemaLanguage(record.lang),mainEntityOfPage:{'@id':`${canonicalFor(record)}#webpage`},
    author:{'@type':'Person',name:'Teyfik Gökdemir'},
    publisher:{'@id':'https://ctseg.com.tr/#organization'}
  });
  if (originalPost?.faq) {
    schemas.push({
      '@context':'https://schema.org','@type':'FAQPage',
      mainEntity:originalPost.faq.map((item) => ({
        '@type':'Question',name:item.question,
        acceptedAnswer:{'@type':'Answer',text:item.answer}
      }))
    });
  }
}
if (record.key === 'how-we-work') {
  const process=processPages[record.lang];
  schemas.push({
    '@context':'https://schema.org','@type':'HowTo',name:process.title,description:process.description,
    step:process.steps.map((name,index)=>({'@type':'HowToStep',position:index+1,name}))
  });
  schemas.push({
    '@context':'https://schema.org','@type':'FAQPage',
    mainEntity:process.faq.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))
  });
}
if (record.key === 'china-market-entry' && chinaMarketEntryContent.zh) {
  const page=chinaMarketEntryContent.zh;
  schemas.push({
    '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#china-market-entry-service`,
    url:canonicalFor(record),name:page.title,description:page.description,inLanguage:'zh',
    serviceType:'China manufacturer export market entry and B2B buyer development',
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Türkiye','Europe'],
    audience:{'@type':'BusinessAudience',name:'Chinese manufacturers, OEM/ODM factories and exporters seeking buyers in Türkiye and Europe'}
  });
  schemas.push({
    '@context':'https://schema.org','@type':'ItemList',
    name:page.sectorsTitle,itemListOrder:'https://schema.org/ItemListOrderAscending',
    itemListElement:page.sectors.map((name,index)=>({'@type':'ListItem',position:index+1,name}))
  });
  schemas.push({
    '@context':'https://schema.org','@type':'FAQPage',
    mainEntity:page.faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))
  });
}
if (record.key === 'ukraine-turkiye') {
  const page=ukraineTurkiyeContent;
  schemas.push({
    '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#ukraine-turkiye-sourcing-service`,
    url:canonicalFor(record),name:page.title,description:page.description,inLanguage:'tr',
    serviceType:'Ukraine to Türkiye B2B sourcing and import coordination',
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Türkiye','Ukraine'],
    audience:{'@type':'BusinessAudience',name:'Türkiye-based importers, food/feed buyers and industrial buyers'}
  });
  schemas.push({
    '@context':'https://schema.org','@type':'ItemList',
    name:page.productsTitle,itemListOrder:'https://schema.org/ItemListOrderAscending',
    itemListElement:page.products.map((name,index)=>({'@type':'ListItem',position:index+1,name}))
  });
  schemas.push({
    '@context':'https://schema.org','@type':'FAQPage',
    mainEntity:page.faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))
  });
}
if (record.key === 'china-turkiye' && chinaTurkiyeContent.tr) {
  const page=chinaTurkiyeContent.tr;
  schemas.push({
    '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#china-turkiye-sourcing-service`,
    url:canonicalFor(record),name:page.title,description:page.description,inLanguage:'tr',
    serviceType:'China to Türkiye B2B sourcing and import coordination',
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Türkiye','China'],
    audience:{'@type':'BusinessAudience',name:'Türkiye-based importers, manufacturers, distributors and project buyers'}
  });
  schemas.push({
    '@context':'https://schema.org','@type':'ItemList',
    name:page.productsTitle,itemListOrder:'https://schema.org/ItemListOrderAscending',
    itemListElement:page.products.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.name,description:item.signal}))
  });
  schemas.push({
    '@context':'https://schema.org','@type':'FAQPage',
    mainEntity:page.faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))
  });
}
if (record.key === 'vietnam-turkiye' && vietnamTurkiyeContent.tr) {
  const page=vietnamTurkiyeContent.tr;
  schemas.push({
    '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#vietnam-turkiye-sourcing-service`,
    url:canonicalFor(record),name:page.title,description:page.description,inLanguage:'tr',
    serviceType:'Vietnam to Türkiye B2B sourcing and import coordination',
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Türkiye','Vietnam'],
    audience:{'@type':'BusinessAudience',name:'Türkiye-based importers, distributors, food businesses and industrial buyers'}
  });
  schemas.push({
    '@context':'https://schema.org','@type':'ItemList',
    name:page.productsTitle,itemListOrder:'https://schema.org/ItemListOrderAscending',
    itemListElement:page.products.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.name,description:item.signal}))
  });
  schemas.push({
    '@context':'https://schema.org','@type':'FAQPage',
    mainEntity:page.faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))
  });
}
if (record.key === 'vietnam-market-entry' && vietnamMarketEntryContent.vi) {
  const page=vietnamMarketEntryContent.vi;
  schemas.push({
    '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#vietnam-market-entry-service`,
    url:canonicalFor(record),name:page.title,description:page.description,inLanguage:'vi',
    serviceType:'Vietnam producer export market entry and B2B buyer development',
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Türkiye','Europe'],
    audience:{'@type':'BusinessAudience',name:'Vietnamese manufacturers and exporters seeking buyers in Türkiye and Europe'}
  });
  schemas.push({
    '@context':'https://schema.org','@type':'ItemList',
    name:page.sectorsTitle,itemListOrder:'https://schema.org/ItemListOrderAscending',
    itemListElement:page.sectors.map((name,index)=>({'@type':'ListItem',position:index+1,name}))
  });
  schemas.push({
    '@context':'https://schema.org','@type':'FAQPage',
    mainEntity:page.faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))
  });
}
if (record.key === 'iran-trade') {
  const page=iranTradeContent[record.lang];
  schemas.push({
    '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#iran-trade-service`,
    url:canonicalFor(record),name:page.title,description:page.description,inLanguage:schemaLanguage(record.lang),
    serviceType:'Türkiye-Iran cross-border B2B sourcing and trade coordination',
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Türkiye','Iran','Europe'],
    audience:{'@type':'BusinessAudience',name:'Importers, distributors, manufacturers and institutional buyers'}
  });
  schemas.push({
    '@context':'https://schema.org','@type':'ItemList',
    name:page.inboundTitle,itemListOrder:'https://schema.org/ItemListOrderAscending',
    itemListElement:page.inboundItems.map((name,index)=>({'@type':'ListItem',position:index+1,name}))
  });
  schemas.push({
    '@context':'https://schema.org','@type':'ItemList',
    name:page.outboundTitle,itemListOrder:'https://schema.org/ItemListOrderAscending',
    itemListElement:page.outboundItems.map((name,index)=>({'@type':'ListItem',position:index+1,name}))
  });
  schemas.push({
    '@context':'https://schema.org','@type':'FAQPage',
    mainEntity:page.faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))
  });
}
if (record.key === 'search-landing' && record.id) {
  const landing=searchLandings[record.id as keyof typeof searchLandings].content[record.lang];
  schemas.push({
    '@context':'https://schema.org','@type':'Service','@id':`${canonicalFor(record)}#service`,
    url:canonicalFor(record),name:landing.title,description:landing.description,inLanguage:schemaLanguage(record.lang),
    serviceType:landing.serviceType,provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Türkiye','Europe','Iran','International'],audience:{'@type':'BusinessAudience',name:landing.audienceTitle}
  });
  schemas.push({
    '@context':'https://schema.org','@type':'FAQPage',
    mainEntity:landing.faq.map((item)=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))
  });
}
if (record.key === 'guides' && record.id) {
  const guideLang = (record.lang === 'tr' || record.lang === 'en') ? record.lang : 'en';
  const guide = guides[record.id as keyof typeof guides]?.[guideLang] || { title: 'Guide', description: 'Commercial guide' };
  schemas.push({
    '@context':'https://schema.org','@type':'Article',headline:guide.title,description:guide.description,
    datePublished:'2026-07-27',dateModified:'2026-07-27',inLanguage:schemaLanguage(record.lang),
    mainEntityOfPage:canonicalFor(record),author:{'@type':'Person',name:'Teyfik Gökdemir'},
    publisher:{'@id':'https://ctseg.com.tr/#organization'}
  });
}
---
<BaseLayout lang={record.lang} title={meta.title} description={meta.description} pageKey={record.key} pageId={record.id} canonical={canonicalFor(record)} schema={schemas}>
  <PageContent record={record} />
</BaseLayout>
<style is:global>
  /* Dark-surface copy must outrank the generic `.section p` light-surface rule. */
  main .hero .trade-funnel-card .trade-funnel-desc,
  main .hero .trade-funnel-card:nth-child(2) .trade-funnel-desc,
  main .section.trade-paths-section .trade-paths-grid p,
  main .section.markets-editorial p,
  main .section.process-section p,
  main .section.duzce-glass-feature p,
  main .section.trade-video-section p,
  main .section .cta-statement p {
    color:#d9d9d3!important;
    opacity:1!important;
  }
  main .section.trade-paths-section .section-head p,
  main .section.markets-editorial .section-head p,
  main .section.process-section .section-head p,
  main .section.duzce-glass-feature .section-head p,
  main .section.trade-video-section .section-head p,
  main .section .cta-statement .eyebrow {
    color:#c4f000!important;
    opacity:1!important;
  }
</style>
