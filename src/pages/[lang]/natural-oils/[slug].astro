---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CommercialRequestForm from '../../../components/CommercialRequestForm.astro';
import {
  oilLanguages,
  oilCopy,
  oilPath,
  oilContact,
  naturalOilUi,
  naturalOilSlugs,
  naturalOilProducts,
  naturalOilProductPath,
  relatedNaturalOilsMap,
  naturalOilVisualMap,
  naturalOilImageSrcset,
  type OilLanguage,
  type NaturalOilSlug
} from '../../../data/natural-oils';

export function getStaticPaths() {
  return oilLanguages.flatMap((lang) =>
    naturalOilSlugs.map((slug) => ({
      params: { lang, slug }
    }))
  );
}

const { lang, slug } = Astro.params as { lang: OilLanguage; slug: NaturalOilSlug };
const c = oilCopy[lang] || oilCopy.en;
const ui = naturalOilUi[lang] || naturalOilUi.en;
const localeProducts = naturalOilProducts[lang] || naturalOilProducts.en;
const product = localeProducts[slug];
const isRtl = ['ar', 'fa', 'he'].includes(lang);
const arrow = isRtl ? '↖' : '↗';

const canonical = `https://ctseg.com.tr${naturalOilProductPath(lang, slug)}`;
const hubUrl = `https://ctseg.com.tr${oilPath(lang)}`;
const homeUrl = lang === 'tr' ? 'https://ctseg.com.tr/' : `https://ctseg.com.tr/${lang}/`;
const contactHref = `${oilContact(lang)}?intent=buyer_request#commercial-form`;

const alternates = Object.fromEntries([
  ...oilLanguages.map((code) => [code, `https://ctseg.com.tr${naturalOilProductPath(code, slug)}`]),
  ['x-default', `https://ctseg.com.tr${naturalOilProductPath('en', slug)}`]
]);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: product.name,
    description: product.description,
    url: canonical,
    areaServed: 'Worldwide',
    provider: {
      '@type': 'Organization',
      name: 'CTSEG',
      url: 'https://ctseg.com.tr/'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: product.faq.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: answer
      }
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'CTSEG', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: ui.hubBreadcrumb, item: hubUrl },
      { '@type': 'ListItem', position: 3, name: product.name, item: canonical }
    ]
  }
];

const heroVisual = naturalOilVisualMap[slug] || naturalOilVisualMap.hero;
const relatedSlugs = relatedNaturalOilsMap[slug] || [];
const relatedCards = relatedSlugs.map((relSlug) => ({
  slug: relSlug,
  name: localeProducts[relSlug].name,
  summary: localeProducts[relSlug].cardSummary,
  image: naturalOilVisualMap[relSlug],
  href: naturalOilProductPath(lang, relSlug)
}));
---
<BaseLayout
  lang={lang as any}
  title={product.metaTitle}
  description={product.description}
  canonical={canonical}
  alternates={alternates}
  schema={schema}
  pageKey="natural-oils-product"
  pageId={slug}
>
  <div class="oil-product" dir={isRtl ? 'rtl' : 'ltr'}>
    <section class="oil-hero">
      <div class="oil-hero__media">
        <img
          src={heroVisual}
          srcset={naturalOilImageSrcset(heroVisual)}
          sizes="(max-width: 1050px) 100vw, 58vw"
          width="1200"
          height="900"
          alt={product.name}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="oil-hero__shade"></div>
      <div class="container oil-hero__grid">
        <div class="oil-hero__copy">
          <nav class="oil-breadcrumb" aria-label="Breadcrumb">
            <a href={oilPath(lang)}>{ui.hubBreadcrumb}</a>
            <span aria-hidden="true">/</span>
            <span>{product.name}</span>
          </nav>
          <span class="eyebrow">{product.eyebrow}</span>
          <h1>{product.name}</h1>
          <p class="oil-botanical-tag">{product.botanicalName}</p>
          <p class="oil-hero__lead">{product.lead}</p>
          <p class="oil-partner-note">{ui.partnerBannerText}</p>
          <div class="oil-hero__actions">
            <a class="button primary" href="#rfq">{ui.rfqCta}</a>
            <a class="button ghost" href={oilPath(lang)}>{ui.allOilsCta}</a>
          </div>
        </div>
        <aside class="oil-trust-panel" aria-label={ui.partnerBannerKicker}>
          <span class="oil-trust-kicker">{ui.partnerBannerKicker}</span>
          {ui.trustBadges.map((title, idx) => (
            <div class="oil-trust-item">
              <span class="oil-trust-dot" aria-hidden="true"></span>
              <div>
                <strong>{title}</strong>
                <p>{product.applications[idx] || product.applications[0]}</p>
              </div>
            </div>
          ))}
        </aside>
      </div>
    </section>

    <section class="oil-feature-strip">
      <div class="container oil-feature-grid">
        {ui.featureStrip.map((title, idx) => (
          <div class="oil-feature-item">
            <strong>{title}</strong>
            <span>{idx < 4 ? product.rfqChecklist[idx] : c.steps[3]}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="oil-section oil-specs-section">
      <div class="container">
        <div class="oil-section-intro">
          <div>
            <span class="eyebrow dark">{product.eyebrow}</span>
            <h2>{ui.specsHeading}</h2>
          </div>
          <p>{product.description}</p>
        </div>
        <div class="oil-specs-grid">
          {product.specs.map(([specTitle, specValue]) => (
            <article class="oil-spec-card">
              <h3>{specTitle}</h3>
              <p>{specValue}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="oil-section oil-applications-section">
      <div class="container">
        <div class="oil-two-col">
          <div class="oil-app-box">
            <span class="eyebrow dark">{c.scope}</span>
            <h2>{ui.applicationsHeading}</h2>
            <ul class="oil-app-list">
              {product.applications.map((app) => (
                <li>{app}</li>
              ))}
            </ul>
            <p class="oil-note-box">{c.note}</p>
            <div class="oil-app-actions">
              <a class="button dark-btn" href="#rfq">{ui.rfqCta}</a>
              <a class="button outline-btn" href={contactHref}>{ui.contactCta}</a>
            </div>
          </div>
          <div class="oil-app-visuals">
            <figure class="oil-app-figure">
              <img
                src={heroVisual}
                srcset={naturalOilImageSrcset(heroVisual)}
                sizes="(max-width: 720px) 100vw, 44vw"
                width="1200"
                height="900"
                alt={product.name}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{product.botanicalName}</figcaption>
            </figure>
            <figure class="oil-app-figure">
              <img
                src={naturalOilVisualMap.hero}
                srcset={naturalOilImageSrcset(naturalOilVisualMap.hero)}
                sizes="(max-width: 720px) 100vw, 44vw"
                width="1200"
                height="900"
                alt={ui.documentationHeading}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{c.proof}</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="oil-section oil-rfq-brief">
      <div class="container">
        <div class="oil-head-center">
          <span class="eyebrow dark">{c.process}</span>
          <h2>{ui.rfqBriefHeading}</h2>
        </div>
        <div class="oil-brief-grid">
          {product.rfqChecklist.map((item, idx) => (
            <article class="oil-brief-card">
              <span class="oil-brief-num">0{idx + 1}</span>
              <h3>{item}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="oil-section oil-related-section">
      <div class="container">
        <div class="oil-head-center">
          <span class="eyebrow dark">{ui.hubBreadcrumb}</span>
          <h2>{ui.relatedHeading}</h2>
        </div>
        <div class="oil-related-cards">
          {relatedCards.map((card) => (
            <a class="oil-related-card" href={card.href}>
              <img
                src={card.image}
                srcset={naturalOilImageSrcset(card.image)}
                sizes="(max-width: 720px) 100vw, (max-width: 1080px) 50vw, 25vw"
                width="1200"
                height="900"
                alt={card.name}
                loading="lazy"
                decoding="async"
              />
              <span class="oil-related-shade"></span>
              <div class="oil-related-copy">
                <strong>{card.name}</strong>
                <span aria-hidden="true">{arrow}</span>
              </div>
            </a>
          ))}
        </div>

        <div class="oil-directory-links">
          <a class="oil-directory-hub" href={oilPath(lang)}>
            <strong>{ui.allOilsCta}</strong>
            <span aria-hidden="true">{arrow}</span>
          </a>
          {naturalOilSlugs.filter((s) => s !== slug).map((otherSlug) => (
            <a href={naturalOilProductPath(lang, otherSlug)}>
              <strong>{localeProducts[otherSlug].name}</strong>
              <span aria-hidden="true">{arrow}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="oil-section oil-faq-section">
      <div class="container">
        <div class="oil-head-center">
          <h2>{ui.faqHeading}</h2>
        </div>
        <div class="oil-faqs">
          {product.faq.map(([q, a], index) => (
            <details open={index === 0}>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="oil-section oil-form-section" id="rfq">
      <div class="container">
        <CommercialRequestForm lang={lang as any} />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .oil-product {
    background: #f4f1e9;
    color: #171914;
  }
  .oil-hero {
    position: relative;
    min-height: clamp(520px, calc(100svh - 110px), 640px);
    background: #0d110e;
    color: #f4f5ef;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: clamp(2.4rem, 4.8vw, 4.2rem) 0;
  }
  .oil-hero__media {
    position: absolute;
    inset: 0 0 0 40%;
    z-index: 0;
    overflow: hidden;
  }
  [dir="rtl"] .oil-hero__media {
    inset: 0 40% 0 0;
  }
  .oil-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .oil-hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      #0b0e0c 0%,
      #0b0e0c 38%,
      rgba(11, 14, 12, 0.92) 52%,
      rgba(11, 14, 12, 0.34) 78%,
      rgba(11, 14, 12, 0.14) 100%
    );
  }
  [dir="rtl"] .oil-hero__shade {
    background: linear-gradient(
      270deg,
      #0b0e0c 0%,
      #0b0e0c 38%,
      rgba(11, 14, 12, 0.92) 52%,
      rgba(11, 14, 12, 0.34) 78%,
      rgba(11, 14, 12, 0.14) 100%
    );
  }
  .oil-hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(300px, 0.56fr);
    gap: clamp(1.4rem, 2.8vw, 2.8rem);
    align-items: center;
  }
  .oil-hero__copy {
    max-width: 760px;
    min-width: 0;
    text-align: start;
  }
  .oil-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: #b7c2ba;
    margin-bottom: 0.65rem;
  }
  .oil-breadcrumb a {
    color: #c7ff38;
    text-decoration: none;
    font-weight: 700;
  }
  .oil-breadcrumb a:hover {
    text-decoration: underline;
  }
  .oil-hero__copy h1 {
    color: #f4f5ef !important;
    font-size: clamp(2rem, 3.1vw, 3.45rem);
    line-height: 1.02;
    margin: 0.35rem 0 0.6rem;
    letter-spacing: -0.035em;
    max-width: 20ch;
    text-wrap: balance;
  }
  .oil-botanical-tag {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: rgba(199, 255, 56, 0.14);
    border: 1px solid rgba(199, 255, 56, 0.36);
    color: #dcff85 !important;
    font-size: 0.76rem;
    font-weight: 700;
  }
  .oil-hero__lead {
    font-size: clamp(0.92rem, 1vw, 1.06rem);
    line-height: 1.52;
    color: #eef1eb !important;
    max-width: 64ch;
    margin: 0 0 0.75rem;
  }
  .oil-partner-note {
    font-size: 0.78rem;
    line-height: 1.44;
    color: #bfc8c0 !important;
    border-inline-start: 2px solid #c7ff38;
    padding-inline-start: 0.8rem;
    max-width: 62ch;
    margin: 0 0 1.15rem;
  }
  .oil-hero__actions {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .button.ghost {
    background: #f3f4ef !important;
    color: #101410 !important;
    border-color: #f3f4ef !important;
  }
  .oil-trust-panel {
    background: rgba(8, 22, 18, 0.88);
    border: 1px solid rgba(199, 255, 56, 0.2);
    backdrop-filter: blur(14px);
    padding: 1.1rem 1.2rem;
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
  }
  .oil-trust-kicker {
    display: block;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c7ff38;
    margin-bottom: 0.45rem;
  }
  .oil-trust-item {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 0.65rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .oil-trust-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .oil-trust-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #c7ff38;
    box-shadow: 0 0 0 4px rgba(199, 255, 56, 0.12);
    margin-top: 0.3rem;
  }
  .oil-trust-item strong {
    display: block;
    color: #fff;
    font-size: 0.84rem;
    line-height: 1.25;
  }
  .oil-trust-item p {
    margin: 0.18rem 0 0;
    color: #b4bfb7;
    font-size: 0.72rem;
    line-height: 1.35;
  }
  .oil-feature-strip {
    background: #fff;
    border-bottom: 1px solid #dddcd5;
  }
  .oil-feature-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .oil-feature-item {
    padding: 1rem;
    border-inline-end: 1px solid #e5e4df;
  }
  .oil-feature-item:last-child {
    border-inline-end: 0;
  }
  .oil-feature-item strong {
    display: block;
    font-size: 0.84rem;
    color: #141814;
  }
  .oil-feature-item span {
    display: block;
    margin-top: 0.28rem;
    color: #5a625c;
    font-size: 0.72rem;
    line-height: 1.4;
  }
  .oil-section {
    padding: clamp(3.5rem, 6vw, 5.8rem) 0;
  }
  .eyebrow.dark {
    color: #4f5851 !important;
  }
  .oil-section-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(300px, 0.72fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: end;
    margin-bottom: 2.2rem;
  }
  .oil-section-intro h2,
  .oil-app-box h2,
  .oil-head-center h2 {
    font-size: clamp(1.9rem, 2.8vw, 3.1rem);
    line-height: 1.06;
    margin: 0.45rem 0 0;
    letter-spacing: -0.03em;
    color: #141814;
  }
  .oil-section-intro p {
    margin: 0;
    color: #4f5751;
    line-height: 1.68;
  }
  .oil-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .oil-spec-card {
    background: #fff;
    border: 1px solid #dcd9d0;
    border-radius: 18px;
    padding: 1.65rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.04);
  }
  .oil-spec-card h3 {
    margin: 0 0 0.6rem;
    font-size: 1.12rem;
    color: #141814;
  }
  .oil-spec-card p {
    margin: 0;
    color: #4d554f;
    line-height: 1.6;
  }
  .oil-applications-section {
    background: #e7ede9;
  }
  .oil-two-col {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 1fr);
    gap: clamp(2rem, 4.5vw, 4.5rem);
    align-items: center;
  }
  .oil-app-list {
    margin: 1.4rem 0;
    padding: 0;
    list-style: none;
  }
  .oil-app-list li {
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
    font-weight: 650;
    color: #1b211c;
  }
  .oil-note-box {
    padding: 0.95rem 1.1rem;
    border-inline-start: 3px solid #162119;
    background: rgba(255, 255, 255, 0.65);
    border-radius: 8px;
    font-size: 0.86rem;
    line-height: 1.55;
    color: #3a423c;
    margin: 0 0 1.35rem;
  }
  .oil-app-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .dark-btn {
    background: #121814 !important;
    color: #fff !important;
  }
  .outline-btn {
    background: transparent !important;
    color: #121814 !important;
    border: 1px solid #121814 !important;
  }
  .oil-app-visuals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .oil-app-figure {
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #131814;
    color: #f3f4ef;
  }
  .oil-app-figure img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .oil-app-figure figcaption {
    padding: 0.75rem 0.95rem;
    font-size: 0.76rem;
    color: #d2d9d2;
  }
  .oil-rfq-brief {
    background: #dfdbd0;
  }
  .oil-head-center {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 2.2rem;
  }
  .oil-brief-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .oil-brief-card {
    background: linear-gradient(145deg, #121712 0%, #182019 100%);
    color: #f4f5ef;
    padding: 1.6rem 1.4rem;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .oil-brief-num {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 800;
    color: #111612;
    background: #c7ff38;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
  }
  .oil-brief-card h3 {
    margin: 0;
    color: #f4f5ef !important;
    font-size: 0.98rem;
    line-height: 1.48;
  }
  .oil-related-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 2.4rem;
  }
  .oil-related-card {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: #111;
  }
  .oil-related-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .oil-related-card:hover img {
    transform: scale(1.04);
  }
  .oil-related-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 36%, rgba(6, 12, 8, 0.88) 100%);
  }
  .oil-related-copy {
    position: absolute;
    inset-inline: 1rem;
    bottom: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.75rem;
  }
  .oil-related-copy strong {
    font-size: 0.96rem;
    line-height: 1.25;
    color: #fff;
  }
  .oil-related-copy span {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.65);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .oil-directory-links {
    max-width: 960px;
    margin: 0 auto;
    border-top: 1px solid rgba(0, 0, 0, 0.14);
  }
  .oil-directory-links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.14);
    color: #161a16;
    text-decoration: none;
  }
  .oil-directory-links a:hover {
    color: #2c4a1e;
  }
  .oil-directory-hub {
    font-weight: 800;
  }
  .oil-faqs {
    max-width: 900px;
    margin: 0 auto;
  }
  .oil-faqs details {
    background: #fff;
    border: 1px solid #dcd9d0;
    border-radius: 14px;
    padding: 1.1rem 1.35rem;
    margin-bottom: 12px;
  }
  .oil-faqs summary {
    cursor: pointer;
    font-weight: 750;
    font-size: 1.02rem;
    color: #141814;
  }
  .oil-faqs p {
    margin: 0.75rem 0 0;
    color: #4c534d;
    line-height: 1.65;
