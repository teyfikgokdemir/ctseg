---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReflexPageContent from '../../components/ReflexPageContent.astro';
import { reflexData, reflexAlternates } from '../../data/reflex-data';

const lang = 'tr';
const data = reflexData[lang];
const alternates = reflexAlternates();
const canonical = 'https://ctseg.com.tr/medical/reflex-disposable-gloves/';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://ctseg.com.tr/' },
      { '@type': 'ListItem', position: 2, name: 'Medikal & Hijyen', item: canonical }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    '@id': `${canonical}#medical-page`,
    name: 'REFLEX Tek Kullanımlık Eldiven Portföyü',
    description: data.metaDescription,
    aspect: 'Medical & Protective Gloves Portfolio',
    image: 'https://ctseg.com.tr/images/reflex-tpe-gloves-hero.webp'
  }
];
---

<BaseLayout
  lang={lang}
  title={data.metaTitle}
  description={data.metaDescription}
  pageKey="medical"
  canonical={canonical}
  schema={schema}
>
  <ReflexPageContent lang={lang} />
</BaseLayout>
