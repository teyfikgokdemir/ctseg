---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContent from '../components/PageContent.astro';
import { breadcrumbSchema, getMeta, tradeMatchingServiceSchema } from '../lib/routes';
const record = { lang:'tr' as const, key:'home' };
const meta = getMeta(record);
const schema = [breadcrumbSchema(record,meta.title),tradeMatchingServiceSchema(record,meta.title,meta.description)];
---
<BaseLayout lang="tr" title={meta.title} description={meta.description} pageKey="home" canonical="https://ctseg.com.tr/" schema={schema}>
  <PageContent record={record} />
</BaseLayout>
<style is:global>
  /* Dark-surface copy must outrank the generic `.section p` light-surface rule. */
  main .hero .trade-funnel-card .trade-funnel-desc,
  main .hero .trade-funnel-card:nth-child(2) .trade-funnel-desc,
  main .section.trade-paths-section .trade-paths-grid p,
  main .section.markets-editorial p,
  main .section.process-section p,
  main .section.reflex-featured-section p,
  main .section.trade-video-section p,
  main .section .cta-statement p {
    color:#d9d9d3!important;
    opacity:1!important;
  }
  main .section.trade-paths-section .section-head p,
  main .section.markets-editorial .section-head p,
  main .section.process-section .section-head p,
  main .section.reflex-featured-section .section-head p,
  main .section.trade-video-section .section-head p,
  main .section .cta-statement .eyebrow {
    color:#c4f000!important;
    opacity:1!important;
  }
</style>