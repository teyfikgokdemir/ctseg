---
import '../../styles/site.css';
import { ukraineMarketEntry as page } from '../../data/ukraine-market';

const canonical = 'https://ctseg.com.tr/uk/';
const schema = [
  {
    '@context':'https://schema.org',
    '@type':'Organization',
    '@id':'https://ctseg.com.tr/#organization',
    name:'CTSEG Sanayi ve Ticaret Limited Şirketi',
    alternateName:'CTSEG',
    foundingDate:'2022',
    founder:{'@type':'Person',name:'Teyfik Gökdemir'},
    url:'https://ctseg.com.tr/',
    logo:'https://ctseg.com.tr/images/ctseg-logo-transparent.png',
    address:{'@type':'PostalAddress',addressLocality:'Tuzla',addressRegion:'İstanbul',addressCountry:'TR'},
    areaServed:['Türkiye','Ukraine','Europe'],
    knowsLanguage:['tr','en','uk']
  },
  {
    '@context':'https://schema.org',
    '@type':'WebSite',
    '@id':'https://ctseg.com.tr/#website',
    url:'https://ctseg.com.tr/',
    name:'CTSEG',
    publisher:{'@id':'https://ctseg.com.tr/#organization'},
    inLanguage:['tr','en','uk']
  },
  {
    '@context':'https://schema.org',
    '@type':'WebPage',
    '@id':`${canonical}#webpage`,
    url:canonical,
    name:page.title,
    description:page.description,
    inLanguage:'uk-UA',
    isPartOf:{'@id':'https://ctseg.com.tr/#website'},
    about:{'@id':'https://ctseg.com.tr/#organization'}
  },
  {
    '@context':'https://schema.org',
    '@type':'Service',
    '@id':`${canonical}#ukraine-turkiye-sourcing`,
    url:canonical,
    name:page.title,
    description:page.description,
    inLanguage:'uk-UA',
    serviceType:'Türkiye supplier sourcing and reconstruction procurement coordination for Ukrainian businesses',
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Ukraine','Türkiye'],
    audience:{'@type':'BusinessAudience',name:'Ukrainian importers, contractors, manufacturers and project companies'}
  },
  {
    '@context':'https://schema.org',
    '@type':'ItemList',
    name:page.sectorsTitle,
    itemListOrder:'https://schema.org/ItemListOrderAscending',
    itemListElement:page.sectors.map((name,index)=>({'@type':'ListItem',position:index+1,name}))
  },
  {
    '@context':'https://schema.org',
    '@type':'Service',
    '@id':`${canonical}#duzce-glass-export`,
    url:canonical,
    name:'Düzce Float Glass — B2B постачання скла для України',
    description:'CTSEG координує B2B запити українських імпортерів, дистриб’юторів, склопереробних підприємств, фасадних компаній і проєктних закупівель на продукцію Düzce Float Glass.',
    inLanguage:'uk-UA',
    serviceType:'Architectural and industrial glass export coordination',
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Ukraine','Türkiye'],
    audience:{'@type':'BusinessAudience',name:'Ukrainian glass importers, distributors, processors and project buyers'}
  },
  {
    '@context':'https://schema.org',
    '@type':'Service',
    '@id':`${canonical}#external-trade-desk`,
    url:canonical,
    name:'Зовнішній відділ міжнародної торгівлі CTSEG',
    description:'CTSEG може постійно координувати sourcing, розвиток експорту, пошук покупців і дистриб’юторів, RFQ, комерційне листування та звітність як зовнішня функція міжнародної торгівлі.',
    inLanguage:'uk-UA',
    serviceType:'Outsourced international trade desk, sourcing and export development',
    provider:{'@id':'https://ctseg.com.tr/#organization'},
    areaServed:['Ukraine','Türkiye','Europe'],
    audience:{'@type':'BusinessAudience',name:'Ukrainian companies outsourcing ongoing international trade operations'}
  },
  {
    '@context':'https://schema.org',
    '@type':'FAQPage',
    mainEntity:page.faq.map((item)=>({
      '@type':'Question',
      name:item.question,
      acceptedAnswer:{'@type':'Answer',text:item.answer}
    }))
  }
];
---
<!doctype html>
<html lang="uk-UA" dir="ltr" data-locale="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title} | CTSEG</title>
    <meta name="description" content={page.description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="uk" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/dm-sans-latin-ext-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin-ext-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="CTSEG" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/uk/" aria-label="CTSEG Україна">
          <img src="/images/ctseg-logo-transparent.png" width="320" height="103" alt="CTSEG" decoding="async" />
        </a>
        <div style="margin-left:auto;display:flex;gap:14px;align-items:center">
          <a class="text-link" href="/">TR</a>
          <a class="text-link" href="/en/">EN</a>
          <a class="button button-small" href="/en/contact/?intent=buyer_request#commercial-form">Надіслати RFQ</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">{page.eyebrow}</p>
            <h1>{page.title}</h1>
            <p class="lead">{page.description}</p>
            <div class="actions">
              <a class="button" href="/en/contact/?intent=buyer_request#commercial-form">{page.ctaLabel}</a>
              <a class="button button-secondary" href="#sectors">Категорії постачання</a>
            </div>
          </div>
          <figure class="hero-visual">
            <img src="/images/ctseg-global-trade-hero-premium.webp" width="1536" height="1024" alt="B2B постачання між Україною та Туреччиною" loading="eager" decoding="async" style="width:100%;height:auto;display:block" />
          </figure>
        </div>
      </section>

      <section class="section">
        <div class="container content-grid">
          <div class="prose">
            <div class="content-block direct-answer">
              <h2>{page.directAnswerTitle}</h2>
              <p>{page.directAnswer}</p>
            </div>

            <div class="content-block" id="sectors">
              <h2>{page.sectorsTitle}</h2>
              <ol class="check-list">
                {page.sectors.map((item,index)=><li><strong>{String(index+1).padStart(2,'0')}</strong> · {item}</li>)}
              </ol>
            </div>

            <div class="content-block origin-note">
              <h2>{page.reconstructionTitle}</h2>
              <p>{page.reconstructionText}</p>
            </div>

            <div class="content-block">
              <h2>{page.supportTitle}</h2>
              <ul class="check-list">{page.support.map((item)=><li>{item}</li>)}</ul>
            </div>

            <div class="content-block">
              <h2>{page.processTitle}</h2>
              <ol class="check-list">{page.process.map((item)=><li>{item}</li>)}</ol>
            </div>

            <div class="content-block faq">
              <h2>Поширені запитання</h2>
              {page.faq.map((item,index)=><details open={index===0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}
            </div>
          </div>

          <aside class="side-panel">
            <p class="eyebrow">CTSEG · Україна ⇄ Türkiye</p>
            <h2>{page.ctaTitle}</h2>
            <p>{page.ctaText}</p>
            <a class="button" href="/en/contact/?intent=buyer_request#commercial-form">{page.ctaLabel}</a>
            <p style="margin-top:18px;font-size:.84rem;opacity:.78">CTSEG Sanayi ve Ticaret Limited Şirketi · İstanbul, Türkiye</p>
          </aside>
        </div>
      </section>
      <section class="section">
        <div class="container content-grid">
          <div class="prose">
            <p class="eyebrow">CTSEG · ЗОВНІШНІЙ TRADE DESK</p>
            <h2>Зовнішня функція міжнародної торгівлі для української компанії</h2>
            <p>CTSEG може постійно вести пошук постачальників, розвиток експорту, пошук покупців і дистриб’юторів, RFQ, комерційне листування та follow-up як зовнішній відділ міжнародної торгівлі. За погодженням робота може вестися через корпоративну електронну пошту клієнта з прозорим зазначенням ролі CTSEG.</p>
            <ul class="check-list">
              <li>Щомісячний retainer за постійну операційну підтримку</li>
              <li>Sourcing, export development та buyer/distributor follow-up</li>
              <li>Корпоративна пошта, CRM-пайплайн і регулярна звітність</li>
            </ul>
          </div>
          <aside class="side-panel">
            <p class="eyebrow">CTSEG · External Trade Desk</p>
            <h3>Передати міжнародну торгівлю в зовнішнє управління</h3>
            <a class="button" href="/en/contact/?intent=external_trade_desk&direction=other&category=other#commercial-form">Обговорити Trade Desk</a>
          </aside>
        </div>
      </section>

      <section class="section uk-glass-section" id="duzce-glass">
        <div class="container uk-glass-grid">
          <div>
            <p class="eyebrow">CTSEG × DÜZCE FLOAT GLASS · УКРАЇНА</p>
            <h2>Турецьке архітектурне та промислове скло для B2B-закупівель в Україні</h2>
            <p class="lead">CTSEG координує комерційні запити на прозоре та кольорове float glass, coated / Low-E glass, laminated glass, mirror, solar glass, satin та lacquered glass. Запити структуруються за типом скла, товщиною, розміром листа, обсягом, пунктом призначення та Incoterm.</p>
            <div class="actions">
              <a class="button" href="/en/glass/duzce-float-glass/#rfq">Запросити експортну пропозицію</a>
              <a class="button button-secondary" href="/en/glass/duzce-float-glass/">Переглянути портфель скла</a>
            </div>
          </div>
          <aside class="side-panel">
            <p class="eyebrow">ЦІЛЬОВІ ПОКУПЦІ</p>
            <ul class="check-list">
              <li>Імпортери та дистриб’ютори скла</li>
              <li>Виробники склопакетів / IGU</li>
              <li>Підприємства різання, гартування та обробки скла</li>
              <li>Фасадні та алюмінієві системні компанії</li>
              <li>Будівельні та проєктні закупівельні команди</li>
            </ul>
          </aside>
        </div>
      </section>
    </main>

    <footer class="uk-site-footer">
      <div class="container uk-footer-top">
        <div class="uk-footer-brand">
          <a href="/uk/" aria-label="CTSEG Україна">
            <img src="/images/ctseg-logo-transparent.png" width="240" height="78" alt="CTSEG" loading="lazy" decoding="async" />
          </a>
          <p>Турецькі виробники · стратегічне постачання · B2B координація · підтримка закупівель для відбудови.</p>
          <strong>CTSEG Sanayi ve Ticaret Limited Şirketi</strong>
          <span>İstanbul, Türkiye · 2022</span>
        </div>
        <nav aria-label="Навігація Україна">
          <strong>Україна ⇄ Türkiye</strong>
          <a href="#sectors">Категорії постачання</a>
          <a href="#duzce-glass">Düzce Float Glass</a>
          <a href="/en/contact/?intent=buyer_request#commercial-form">Надіслати RFQ</a>
          <a href="/en/how-we-work/">Як працює CTSEG</a>
        </nav>
        <nav aria-label="CTSEG global">
          <strong>CTSEG</strong>
          <a href="/en/">Global site</a>
          <a href="/">Türkçe</a>
          <a href="/en/contact/">Контакти</a>
          <a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a>
        </nav>
      </div>
      <div class="container uk-footer-bottom">
        <span>© 2026 CTSEG. Усі права захищені.</span>
        <span>Türkiye ↔ Ukraine ↔ Europe</span>
      </div>
    </footer>
    <style>
      .uk-glass-section{background:#151515;border-block:1px solid rgba(255,255,255,.09)}
      .uk-glass-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.9fr);gap:clamp(2rem,5vw,5rem);align-items:center}
      .uk-glass-grid h2{max-width:18ch}
      .uk-glass-visual{margin:0;overflow:hidden;border:1px solid rgba(255,255,255,.12);background:#0d0d0d}
      .uk-glass-visual img{display:block;width:100%;height:auto;aspect-ratio:1200/850;object-fit:cover}
      .uk-site-footer{margin-top:0;background:#0f100f;color:#f2f2ed;border-top:1px solid rgba(196,240,0,.22);padding-top:52px}
      .uk-footer-top{display:grid;grid-template-columns:minmax(0,1.4fr) repeat(2,minmax(180px,.75fr));gap:clamp(2rem,5vw,5rem);padding-bottom:42px}
      .uk-footer-brand{display:grid;gap:12px;max-width:560px}
      .uk-footer-brand img{display:block;width:180px;height:auto}
      .uk-footer-brand p{margin:0;color:#c8c8c2;line-height:1.65}
      .uk-footer-brand strong{color:#fff}
      .uk-footer-brand span{color:#8d8d87;font-size:.86rem}
      .uk-site-footer nav{display:flex;flex-direction:column;gap:10px}
      .uk-site-footer nav strong{color:#c4f000;margin-bottom:5px;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}
      .uk-site-footer a{color:#d9d9d3;text-decoration:none}
      .uk-site-footer a:hover{color:#c4f000}
      .uk-footer-bottom{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-block:20px;border-top:1px solid rgba(255,255,255,.1);color:#878781;font-size:.8rem}
      @media(max-width:820px){.uk-glass-grid,.uk-footer-top{grid-template-columns:1fr}.uk-glass-grid h2{max-width:none}.uk-site-footer{padding-top:38px}}
    </style>
  </body>
</html>
