---
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { company, locales, localizedPath, products, routeAlternates, ui, type Locale } from '../data/site';
import { FEATURE_IMAGE_WIDTHS, HERO_IMAGE, generatedImageSrc, generatedImageSrcset } from '../lib/responsive-images';

const {
  lang='tr', title, description, pageKey='home', pageId, canonical,
  schema=[], noindex=false
} = Astro.props as {
  lang: Locale; title: string; description: string; pageKey?: string; pageId?: string;
  canonical?: string; schema?: any[] | any; noindex?: boolean;
};
const canonicalUrl = canonical ?? `https://ctseg.com.tr${localizedPath(lang, pageKey, pageId)}`;
const alternates = routeAlternates(pageKey, pageId);
if (pageKey === 'home') alternates.tr = 'https://ctseg.com.tr/';
const alternateCodes = ['how-we-work','scenarios','guides'].includes(pageKey) ? ['tr','en'] : locales;
const organization = {
  '@context':'https://schema.org','@type':'Organization','@id':'https://ctseg.com.tr/#organization',
  name:company.name,alternateName:company.alternateName,foundingDate:company.foundingYear,
  founder:{'@type':'Person',name:company.founder},
  address:{
    '@type':'PostalAddress',
    streetAddress:company.streetAddress,
    addressLocality:company.addressLocality,
    addressRegion:company.addressRegion,
    addressCountry:company.addressCountry
  },
  url:'https://ctseg.com.tr/',logo:'https://ctseg.com.tr/images/ctseg-logo-transparent.png',
  email:'info@ctseg.com.tr',areaServed:['Türkiye','Europe','International'],
  knowsAbout:['Strategic sourcing','Supplier verification','International trade','Food product sourcing']
};
const website = {
  '@context':'https://schema.org','@type':'WebSite','@id':'https://ctseg.com.tr/#website',
  url:'https://ctseg.com.tr/',name:'CTSEG',publisher:{'@id':'https://ctseg.com.tr/#organization'},
  inLanguage:locales
};
const webpage = {
  '@context':'https://schema.org','@type':'WebPage','@id':`${canonicalUrl}#webpage`,
  url:canonicalUrl,name:title,description,inLanguage:lang,
  isPartOf:{'@id':'https://ctseg.com.tr/#website'},about:{'@id':'https://ctseg.com.tr/#organization'}
};
const extra = Array.isArray(schema) ? schema : [schema];
const schemas = [organization, website, webpage, ...extra.filter(Boolean)];
const cookieHref = localizedPath(lang, 'legal', 'cookies');
const socialImage = pageKey === 'products' && pageId && products[pageId as keyof typeof products]
  ? products[pageId as keyof typeof products].media.src
  : '/images/ctseg-global-trade-hero-premium.webp';
const heroSizes = '(max-width:620px) calc(100vw - 26px), (max-width:860px) calc(100vw - 36px), min(53vw,700px)';
const heroSrcset = generatedImageSrcset(HERO_IMAGE,FEATURE_IMAGE_WIDTHS);
---
<!doctype html>
<html lang={lang} data-locale={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateCodes.map((code) => <link rel="alternate" hreflang={code} href={alternates[code as Locale]} />)}
    <link rel="alternate" hreflang="x-default" href={alternates.en} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/dm-sans-latin-ext-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin-ext-variable.woff2" as="font" type="font/woff2" crossorigin />
    {pageKey === 'home' && !noindex && <link
      rel="preload"
      as="image"
      href={generatedImageSrc(HERO_IMAGE,1280)}
      imagesrcset={heroSrcset}
      imagesizes={heroSizes}
      fetchpriority="high"
    />}
    <meta name="theme-color" content="#272923" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="CTSEG" />
    <meta property="og:locale" content={lang} />
    <meta property="og:image" content={`https://ctseg.com.tr${socialImage}`} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schemas)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader lang={lang} pageKey={pageKey} pageId={pageId} />
    <main id="main"><slot /></main>
    <SiteFooter lang={lang} />
    <aside class="cookie-consent" data-cookie-consent hidden aria-label={ui[lang].cookieTitle}>
      <div><strong>{ui[lang].cookieTitle}</strong><p>{ui[lang].cookieCopy}</p><a href={cookieHref}>{ui[lang].details}</a></div>
      <div class="cookie-actions"><button type="button" data-cookie-reject>{ui[lang].reject}</button><button type="button" class="accept" data-cookie-accept>{ui[lang].accept}</button></div>
    </aside>
    <script is:inline>
      (() => {
        const key='ctseg-consent-v2';
        const box=document.querySelector('[data-cookie-consent]');
        if(!box)return;
        const load=()=>{
          if(window.__ctsegAnalyticsLoaded)return;
          window.__ctsegAnalyticsLoaded=true;window.dataLayer=window.dataLayer||[];
          window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','G-B8BLQ7KK2T',{anonymize_ip:true});
          const s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=G-B8BLQ7KK2T';document.head.appendChild(s);
        };
        const apply=(value)=>{localStorage.setItem(key,value);box.hidden=true;if(value==='accepted')load()};
        const saved=localStorage.getItem(key);if(saved==='accepted')load();else if(!saved)box.hidden=false;
        box.querySelector('[data-cookie-accept]')?.addEventListener('click',()=>apply('accepted'));
        box.querySelector('[data-cookie-reject]')?.addEventListener('click',()=>apply('rejected'));
        document.querySelectorAll('[data-fa-landing-link]').forEach((link)=>link.addEventListener('click',()=>{
          if(typeof window.gtag==='function')window.gtag('event','fa_landing_referral_click',{source_language:document.documentElement.lang,page_type:'markets'});
        }));
        document.querySelectorAll('[data-product-quote]').forEach((link)=>link.addEventListener('click',()=>{
          const product=link.getAttribute('data-product-name');if(product)sessionStorage.setItem('ctseg-product-request',product);
          if(typeof window.gtag==='function')window.gtag('event','product_quote_click',{source_language:document.documentElement.lang,page_type:'product'});
        }));
        document.querySelectorAll('[data-catalog-download]').forEach((link)=>link.addEventListener('click',()=>{
          if(typeof window.gtag==='function')window.gtag('event','catalog_download',{source_language:document.documentElement.lang,catalog_language:link.getAttribute('data-catalog-language')});
        }));
        document.querySelectorAll('[data-how-we-work-cta]').forEach((link)=>link.addEventListener('click',()=>{
          if(typeof window.gtag==='function')window.gtag('event','how_we_work_cta_click',{source_language:document.documentElement.lang});
        }));
        document.querySelectorAll('[data-case-scenario-cta]').forEach((link)=>link.addEventListener('click',()=>{
          if(typeof window.gtag==='function')window.gtag('event','case_scenario_cta_click',{source_language:document.documentElement.lang});
        }));
      })();
    </script>
  </body>
</html>
