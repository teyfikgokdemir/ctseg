---
import { analyticsDisclosure } from "../lib/analytics-disclosure";
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingActions from '../components/FloatingActions.astro';
import TradeVideo from '../components/TradeVideo.astro';
import TradeHouseStatement from '../components/TradeHouseStatement.astro';
import { company, locales, localizedPath, products, routeAlternates, ui, type Locale } from '../data/site';
import { duzceGlassAlternates, type DuzceGlassLocale } from '../data/duzce-glass';
import { activeLocales, localeDirection, localeOg, schemaLanguage } from '../data/locales';
import { FEATURE_IMAGE_WIDTHS, generatedImageSrc, generatedImageSrcset } from '../lib/responsive-images';
import { localizedTradeVisual } from '../data/trade-visuals';
import { searchLandingAlternates } from '../data/search-landings';
import { iranTradeContent } from '../data/iran-trade';
import { vietnamMarketEntryContent } from '../data/vietnam-market-entry';
import { vietnamTurkiyeContent } from '../data/vietnam-turkiye';
import { chinaMarketEntryContent } from '../data/china-market-entry';
import { chinaTurkiyeContent } from '../data/china-turkiye';
import { ukraineTurkiyeContent } from '../data/ukraine-market';

const {
  lang='tr', title, description, pageKey='home', pageId, canonical,
  schema=[], noindex=false
} = Astro.props as {
  lang: Locale | DuzceGlassLocale; title: string; description: string; pageKey?: string; pageId?: string;
  canonical?: string; schema?: any[] | any; noindex?: boolean;
};
const canonicalUrl = canonical ?? `https://ctseg.com.tr${localizedPath(lang, pageKey, pageId)}`;
const alternates = pageKey === 'glass' ? duzceGlassAlternates() :
  pageKey === 'search-landing' && pageId ? searchLandingAlternates(pageId) :
  pageKey === 'vietnam-market-entry' && vietnamMarketEntryContent.vi ? {
    vi:`https://ctseg.com.tr/vi/${vietnamMarketEntryContent.vi.slug}/`
  } as Record<string,string> :
  pageKey === 'vietnam-turkiye' && vietnamTurkiyeContent.tr ? {
    tr:`https://ctseg.com.tr/tr/${vietnamTurkiyeContent.tr.slug}/`
  } as Record<string,string> :
  pageKey === 'china-market-entry' && chinaMarketEntryContent.zh ? {
    zh:`https://ctseg.com.tr/zh/${chinaMarketEntryContent.zh.slug}/`
  } as Record<string,string> :
  pageKey === 'china-turkiye' && chinaTurkiyeContent.tr ? {
    tr:`https://ctseg.com.tr/tr/${chinaTurkiyeContent.tr.slug}/`
  } as Record<string,string> :
  pageKey === 'ukraine-turkiye' ? {
    tr:`https://ctseg.com.tr/tr/${ukraineTurkiyeContent.slug}/`
  } as Record<string,string> :
  pageKey === 'iran-trade' ? {
    tr:`https://ctseg.com.tr/tr/${iranTradeContent.tr.slug}/`,
    en:`https://ctseg.com.tr/en/${iranTradeContent.en.slug}/`,
    fa:'https://ctseg.com.tr/fa/'
  } as Record<string,string> : routeAlternates(pageKey, pageId);
if (pageKey === 'home') {
  alternates.ru = 'https://ctseg.com.tr/ru/';
  alternates.he = 'https://ctseg.com.tr/he/';
}
if (String(lang) === 'he') alternates.he = canonicalUrl;
const alternateCodes = pageKey === 'glass'
  ? ['tr','en','de','it','ru','fa','zh','vi','uk','ro','bg','sr']
  : (String(lang) === 'he' && pageKey === 'he-insight'
    ? ['he']
    : pageKey === 'home'
    ? activeLocales
    : pageKey === 'insights' && pageId
    ? ['tr','en','de','it','ru','fa','zh','vi','uk']
    : ['how-we-work','scenarios'].includes(pageKey)
    ? activeLocales
    : pageKey === 'iran-trade' ? ['tr','en','fa']
    : pageKey === 'syria-market' ? ['tr','en']
    : pageKey === 'vietnam-market-entry' ? ['vi']
    : pageKey === 'vietnam-turkiye' ? ['tr']
    : pageKey === 'china-market-entry' ? ['zh']
    : pageKey === 'china-turkiye' ? ['tr']
    : pageKey === 'ukraine-turkiye' ? ['tr']
    : pageKey === 'guides' ? ['tr','en'] : locales);
const organizationDescription = ({
  tr:'CTSEG, Türkiye merkezli iki yönlü küresel ticaret, stratejik tedarik, tedarikçi doğrulama ve pazara giriş çalışmaları yürüten bağımsız bir B2B ticaret evidir.',
  en:'CTSEG is a Türkiye-based independent B2B trade house for two-way global trade, strategic sourcing, supplier verification and market entry.',
  de:'CTSEG ist ein unabhängiges B2B-Handelshaus mit Sitz in der Türkei für bidirektionalen Welthandel, strategische Beschaffung, Lieferantenprüfung und Markteintritt.',
  it:'CTSEG è una trade house B2B indipendente con base in Turchia, focalizzata su commercio globale bidirezionale, sourcing strategico, verifica fornitori e market entry.',
  ru:'CTSEG — независимый B2B торговый дом в Турции, работающий с двусторонней международной торговлей, стратегическим сорсингом, проверкой поставщиков и выходом на рынки.',
  fa:'CTSEG یک خانه تجارت مستقل B2B مستقر در ترکیه برای تجارت دوطرفه جهانی، تأمین استراتژیک، راستی‌آزمایی تأمین‌کنندگان و ورود به بازار است.',
  zh:'CTSEG 是一家立足土耳其的独立 B2B 国际贸易机构，专注双向全球贸易、战略采购、供应商核验与市场进入。',
  vi:'CTSEG là một trade house B2B độc lập có trụ sở tại Thổ Nhĩ Kỳ, tập trung vào thương mại toàn cầu hai chiều, sourcing chiến lược, thẩm định nhà cung cấp và thâm nhập thị trường.',
  uk:'CTSEG — незалежний B2B торговий дім у Туреччині, що координує двосторонню міжнародну торгівлю, стратегічне постачання, перевірку постачальників і вихід на ринки.',
  ro:'CTSEG este o casă de comerț B2B independentă, cu sediul în Türkiye, specializată în comerț global bidirecțional, sourcing strategic, verificarea furnizorilor și intrare pe piață.',
  bg:'CTSEG е независима B2B търговска къща със седалище в Türkiye, фокусирана върху двупосочна глобална търговия, стратегическо снабдяване, проверка на доставчици и пазарен достъп.',
  he:'CTSEG היא חברת B2B עצמאית מטורקיה המתמחה בסחר דו־כיווני, איתור ואימות ספקים, RFQ וכניסה לשווקים.'
} as Record<string,string>)[lang] || 'CTSEG is a Türkiye-based independent B2B trade house for two-way global trade, strategic sourcing, supplier verification and market entry.';
const organization = {
  '@context':'https://schema.org','@type':'Organization','@id':'https://ctseg.com.tr/#organization',
  name:company.name[lang as Locale] || company.name.en,alternateName:company.alternateName,foundingDate:company.foundingYear,
  description:organizationDescription,
  slogan:lang === 'uk' ? 'Двостороння міжнародна торгівля та стратегічне постачання' : 'Two-Way Global Trade & Strategic Sourcing House',
  founder:{'@type':'Person',name:company.founder},
  address:{
    '@type':'PostalAddress',
    ...(company.streetAddress ? {streetAddress:company.streetAddress} : {}),
    addressLocality:company.addressLocality,
    addressRegion:company.addressRegion,
    addressCountry:company.addressCountry
  },
  url:'https://ctseg.com.tr/',logo:'https://ctseg.com.tr/images/ctseg-logo-transparent.png',
  email:company.email,telephone:company.phone,
  areaServed:lang === 'uk' ? ['Україна','Туреччина','Європа','Близький Схід','Азія','Міжнародні ринки'] : ['Türkiye','Europe','Middle East','Asia','International'],
  knowsLanguage:activeLocales,
  knowsAbout:lang === 'uk' ? [
    'Двостороння міжнародна торгівля','Стратегічне постачання','Пошук і перевірка постачальників','Перевірка виробників і контрагентів',
    'Управління міжнародними RFQ','Вихід на експортні ринки','Пошук B2B-покупців','Комерційна координація','Постачання з Туреччини',
    'Торговельна аналітика','Аналіз сукупної вартості','Постачання харчової та аграрної продукції','Текстиль і домашній текстиль',
    'Пакування та промислові матеріали','Україна — Туреччина: торговельний коридор','Постачання для відбудови України'
  ] : [
    'Two-way global trade','Strategic sourcing','Supplier sourcing and verification','Factory and counterparty verification',
    'International RFQ management','Export market entry','B2B buyer research','Commercial coordination','Nearshoring from Türkiye',
    'Trade intelligence','Total cost of ownership analysis','Food and agricultural sourcing','Textiles and home textiles',
    'Packaging and industrial inputs','Iranian carpets','Hand-knotted silk carpets','Türkiye-Iran trade corridor','Iran sourcing','Iranian food exports','Vietnam exporter market entry','Vietnam to Türkiye trade','Vietnam to Europe trade','Vietnam sourcing for Türkiye','Vietnam coffee sourcing','Vietnam food imports','China manufacturer market entry','China to Türkiye sourcing','China to Europe trade','Ukraine to Türkiye sourcing','Türkiye supplier sourcing for Ukraine','Ukraine reconstruction procurement'
  ]
};
const website = {
  '@context':'https://schema.org','@type':'WebSite','@id':'https://ctseg.com.tr/#website',
  url:'https://ctseg.com.tr/',name:'CTSEG',publisher:{'@id':'https://ctseg.com.tr/#organization'},
  inLanguage:activeLocales
};
const webpage = {
  '@context':'https://schema.org','@type':'WebPage','@id':`${canonicalUrl}#webpage`,
  url:canonicalUrl,name:title,description,inLanguage:schemaLanguage(lang),
  isPartOf:{'@id':'https://ctseg.com.tr/#website'},about:{'@id':'https://ctseg.com.tr/#organization'}
};
const extra = Array.isArray(schema) ? schema : [schema];
const schemas = [organization, website, webpage, ...extra.filter(Boolean)];
const t = ui[lang] || ui.en;
const cookieHref = localizedPath(lang in ui ? lang : 'en', 'legal', 'cookies');
const homeHero = localizedTradeVisual('global-trade-hero',lang);
const socialImage = pageKey === 'products' && pageId && products[pageId as keyof typeof products]
  ? products[pageId as keyof typeof products].media.src
  : homeHero.source;
const heroSizes = '(max-width:620px) calc(100vw - 26px), (max-width:860px) calc(100vw - 36px), min(53vw,700px)';
const heroSrcset = generatedImageSrcset(homeHero.source,FEATURE_IMAGE_WIDTHS);
---
<!doctype html>
<html lang={schemaLanguage(lang)} dir={localeDirection(lang)} data-locale={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateCodes.map((code) => alternates[code as Locale] && <link rel="alternate" hreflang={code} href={alternates[code as Locale]} />)}
    {alternateCodes.includes('en') && alternates.en && <link rel="alternate" hreflang="x-default" href={alternates.en} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/dm-sans-latin-ext-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin-ext-variable.woff2" as="font" type="font/woff2" crossorigin />
    {pageKey === 'home' && ['tr','en'].includes(String(lang)) && !noindex && <link
      rel="preload"
      as="image"
      imagesrcset={heroSrcset}
      imagesizes={heroSizes}
      fetchpriority="high"
    />}
    <link rel="stylesheet" href="/premium-trade-house-base.css" />
    <link rel="stylesheet" href="/premium-trade-house.css" />
    <link rel="stylesheet" href="/premium-responsive-fixes.css" />
    <meta name="theme-color" content="#272923" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="CTSEG" />
    <meta property="og:locale" content={localeOg(lang)} />
    <meta property="og:image" content={`https://ctseg.com.tr${socialImage}`} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    {pageKey !== 'products' && <meta property="og:image:alt" content={homeHero.altText} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schemas)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'uk' ? 'Перейти до основного вмісту' : lang === 'ru' ? 'Перейти к содержанию' : lang === 'tr' ? 'Ana içeriğe geç' : lang === 'de' ? 'Zum Hauptinhalt' : lang === 'it' ? 'Vai al contenuto principale' : lang === 'ro' ? 'Sari la conținutul principal' : lang === 'bg' ? 'Към основното съдържание' : lang === 'sr' ? 'Pređi na glavni sadržaj' : lang === 'he' ? 'דלג לתוכן הראשי' : 'Skip to content'}</a>
    <SiteHeader lang={lang} pageKey={pageKey} pageId={pageId} />
    <main id="main">
      <slot />
      {pageKey === 'home' && !['de','it','ru','fa','zh','vi','he'].includes(String(lang)) && <TradeHouseStatement lang={lang as Locale} />}
      {pageKey === 'home' && !['de','it','ru','fa','zh','vi'].includes(String(lang)) && <TradeVideo lang={lang} />}
    </main>
    <SiteFooter lang={lang} pageKey={pageKey} />
    {pageKey === 'home' && String(lang) !== 'he' && <FloatingActions lang={lang} />}
    <aside class="cookie-consent" data-cookie-consent hidden aria-label={t.cookieTitle}>
      <div class="cookie-copy-inline"><strong>{t.cookieTitle}</strong><span>{t.cookieCopy}</span><a href={cookieHref}>{t.details}</a></div>
      <div class="cookie-actions"><button type="button" data-cookie-reject>{t.reject}</button><button type="button" class="accept" data-cookie-accept>{t.accept}</button></div>
    </aside>
    <script>
      import { createAnalytics } from '../lib/analytics-stack';
      import { analyticsConfig } from '../lib/analytics-config';
      (() => {
        const analytics = createAnalytics(analyticsConfig);
        const w = window as any;
        w.ctsegTrack = analytics.track;
        const key = 'ctseg-consent-v2';
        const box = document.querySelector<HTMLElement>('[data-cookie-consent]');
        if (!box) return;
        let saved: string | null = null;
        try { saved = localStorage.getItem(key); } catch {}
        let recording = false;
        try { recording = localStorage.getItem('qct-recording-consent-v1') === 'granted'; } catch {}
        analytics.setConsent({ analytics: saved === 'accepted', recording });
        box.hidden = saved === 'rejected' || (saved === 'accepted' && (!analyticsConfig.clarity || recording));
        const apply = (value: string) => {
          try { localStorage.setItem(key, value); localStorage.setItem('qct-recording-consent-v1', value === 'accepted' ? 'granted' : 'denied'); } catch {}
          box.hidden = true;
          analytics.setConsent({ analytics: value === 'accepted', recording: value === 'accepted' });
        };
        box.querySelector('[data-cookie-accept]')?.addEventListener('click', () => apply('accepted'));
        box.querySelector('[data-cookie-reject]')?.addEventListener('click', () => apply('rejected'));
        document.querySelector('[data-cookie-settings]')?.addEventListener('click', () => { box.hidden = false; });
        document.querySelectorAll('[data-fa-landing-link]').forEach((link)=>link.addEventListener('click',()=>{
          window.ctsegTrack('fa_landing_referral_click',{page_type:'markets'});
        }));
        document.querySelectorAll('[data-product-quote]').forEach((link)=>link.addEventListener('click',()=>{
          const product=link.getAttribute('data-product-name');if(product)sessionStorage.setItem('ctseg-product-request',product);
          window.ctsegTrack('product_quote_click',{page_type:'product'});
        }));
        document.querySelectorAll('[data-catalog-download]').forEach((link)=>link.addEventListener('click',()=>{
          window.ctsegTrack('catalog_download',{catalog_language:link.getAttribute('data-catalog-language')});
        }));
        document.querySelectorAll('[data-how-we-work-cta]').forEach((link)=>link.addEventListener('click',()=>{
          window.ctsegTrack('how_we_work_cta_click');
        }));
        document.querySelectorAll('[data-case-scenario-cta]').forEach((link)=>link.addEventListener('click',()=>{
          window.ctsegTrack('case_scenario_cta_click');
        }));
        document.querySelectorAll('[data-trade-intent],[data-contact-intent],[data-fa-intent]').forEach((link)=>link.addEventListener('click',()=>{
          window.ctsegTrack('trade_intent_click',{trade_intent:link.getAttribute('data-trade-intent')||link.getAttribute('data-contact-intent')||link.getAttribute('data-fa-intent')||''});
        }));
        document.querySelectorAll('[data-contact-whatsapp]').forEach((link)=>link.addEventListener('click',()=>window.ctsegTrack('direct_contact_click',{contact_channel:'whatsapp'})));
        document.querySelectorAll('[data-contact-email]').forEach((link)=>link.addEventListener('click',()=>window.ctsegTrack('direct_contact_click',{contact_channel:'email'})));

      })();
    </script>
  </body>
</html>

