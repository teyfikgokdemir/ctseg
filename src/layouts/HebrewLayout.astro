---
import '../styles/site.css';
const { title, description, canonical='https://ctseg.com.tr/he/', article=false } = Astro.props;
const alternates = [
  ['tr','Türkçe','https://ctseg.com.tr/'],['en','English','https://ctseg.com.tr/en/'],['de','Deutsch','https://ctseg.com.tr/de/'],
  ['it','Italiano','https://ctseg.com.tr/it/'],['fa','فارسی','https://ctseg.com.tr/fa/'],['ru','Русский','https://ctseg.com.tr/ru/'],
  ['zh','中文','https://ctseg.com.tr/zh/'],['vi','Tiếng Việt','https://ctseg.com.tr/vi/'],['uk','Українська','https://ctseg.com.tr/uk/'],
  ['ro','Română','https://ctseg.com.tr/ro/'],['bg','Български','https://ctseg.com.tr/bg/'],['he','עברית','https://ctseg.com.tr/he/']
];
const organization = {
  '@context':'https://schema.org','@type':'Organization','@id':'https://ctseg.com.tr/#organization',
  name:'CTSEG Sanayi ve Ticaret Limited Şirketi',alternateName:'CTSEG',foundingDate:'2022',
  founder:{'@type':'Person',name:'Teyfik Gökdemir'},
  address:{'@type':'PostalAddress',addressLocality:'Tuzla',addressRegion:'İstanbul',addressCountry:'TR'},
  url:'https://ctseg.com.tr/'
};
const schema = article ? {
  '@context':'https://schema.org','@type':'Article',headline:title,description,inLanguage:'he-IL',mainEntityOfPage:canonical,
  author:{'@type':'Person',name:'Teyfik Gökdemir'},publisher:{'@type':'Organization','@id':'https://ctseg.com.tr/#organization',name:'CTSEG'}
} : {
  '@context':'https://schema.org','@type':'Service','@id':canonical+'#israel-turkiye-trade',name:'Israel ⇄ Türkiye B2B Sourcing & Market Entry',
  description,inLanguage:'he-IL',provider:{'@type':'Organization','@id':'https://ctseg.com.tr/#organization',name:'CTSEG'},
  areaServed:['Israel','Türkiye'],serviceType:'Two-way B2B sourcing, supplier verification, private label, RFQ and market entry'
};
---
<!doctype html>
<html lang="he-IL" dir="rtl" data-locale="he">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title><meta name="description" content={description} />
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
<link rel="canonical" href={canonical} /><link rel="alternate" hreflang="he" href={canonical} />
{!article && alternates.map(([code,,href]) => <link rel="alternate" hreflang={code} href={href} />)}
{!article && <link rel="alternate" hreflang="x-default" href="https://ctseg.com.tr/en/" />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preload" href="/fonts/dm-sans-latin-ext-variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/source-serif-4-latin-ext-variable.woff2" as="font" type="font/woff2" crossorigin />
<meta property="og:type" content={article?'article':'website'} /><meta property="og:title" content={title} />
<meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
<meta property="og:locale" content="he_IL" /><meta property="og:image" content="https://ctseg.com.tr/images/ctseg-logo-transparent.png" />
<script type="application/ld+json" set:html={JSON.stringify([organization,schema])}></script>
</head>
<body class="he-site">
<header class="he-header">
<a class="he-brand" href="/he/" aria-label="CTSEG"><img src="/images/ctseg-logo-transparent.png" alt="CTSEG" width="220" height="71" /></a>
<nav class="he-nav" aria-label="ניווט ראשי"><a href="/he/#sourcing">איתור ספקים</a><a href="/he/#private-label">מותג פרטי</a><a href="/he/#market-entry">כניסה לשוק</a><a href="/he/#insights">תובנות</a><a class="he-nav-cta" href="/he/#contact">שליחת בקשה</a></nav>
<details class="he-lang"><summary aria-label="בחירת שפה"><span class="locale-globe" aria-hidden="true"></span><span>HE</span></summary><div>{alternates.map(([code,label,href]) => <a href={href} lang={code} hreflang={code} data-locale-option>{label}</a>)}</div></details>
</header>
<main><slot /></main>
<footer class="he-footer">
<div><img src="/images/ctseg-logo-transparent.png" alt="CTSEG" width="180" height="58" /><p>סחר B2B דו־כיווני, איתור ספקים, אימות יצרנים וכניסה לשווקים בין ישראל לטורקיה.</p><strong>CTSEG Sanayi ve Ticaret Limited Şirketi</strong><span>Tuzla, İstanbul, Türkiye · 2022</span></div>
<div><strong>CTSEG</strong><a href="mailto:info@ctseg.com.tr">info@ctseg.com.tr</a><a href="https://wa.me/905456782655" rel="noopener">WhatsApp</a></div>
<div><strong>שפות</strong>{alternates.map(([code,label,href]) => <a href={href} lang={code} hreflang={code}>{label}</a>)}</div>
</footer>
<style>
.he-site{background:#07090d;color:#f3f1eb}.he-header{position:sticky;top:0;z-index:50;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:28px;min-height:82px;padding:0 clamp(18px,4vw,58px);border-bottom:1px solid rgba(185,215,204,.22);background:rgba(7,9,13,.93);backdrop-filter:blur(18px)}.he-brand img{display:block;width:150px;height:auto}.he-nav{display:flex;justify-content:center;gap:26px;align-items:center;font-size:.82rem}.he-nav a{color:#d4d1ca;white-space:nowrap}.he-nav a:hover{color:#fff}.he-nav-cta{padding:10px 15px;border:1px solid #6f8f83;color:#fff!important}.he-lang{position:relative}.he-lang summary{display:flex;align-items:center;gap:8px;cursor:pointer;list-style:none}.he-lang summary::-webkit-details-marker{display:none}.he-lang>div{position:absolute;left:0;top:36px;width:190px;padding:8px;border:1px solid rgba(185,215,204,.25);background:#0d1312;box-shadow:0 20px 45px #0008}.he-lang a{display:block;padding:8px 10px;color:#d7d4cd}.he-lang a:hover{background:#14201d;color:#fff}.he-shell{width:min(1220px,calc(100% - 40px));margin-inline:auto}.he-hero{padding:clamp(70px,9vw,130px) 0 72px;background:radial-gradient(circle at 82% 18%,rgba(111,143,131,.24),transparent 35%)}.he-eyebrow{color:#b9d7cc;font-size:.76rem;font-weight:800;letter-spacing:.12em}.he-hero h1{max-width:970px;margin:18px auto 24px;text-align:center;font-size:clamp(2.7rem,6vw,5.8rem);line-height:.98}.he-hero .lead{max-width:860px;margin-inline:auto;text-align:center;font-size:clamp(1.05rem,1.7vw,1.35rem);color:#bbb8b1}.he-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:32px}.he-button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 22px;border:1px solid #6f8f83;background:#6f8f83;color:#07100d;font-weight:800}.he-button.alt{background:transparent;color:#fff}.he-section{padding:78px 0;border-top:1px solid rgba(255,255,255,.11)}.he-section h2{margin:0 0 18px;text-align:center;font-size:clamp(2.1rem,4vw,3.4rem);line-height:1.05}.he-section>.he-shell>p.he-lead{max-width:800px;margin:0 auto 36px;text-align:center;color:#aaa79f}.he-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.he-card{padding:28px;border:1px solid rgba(185,215,204,.2);background:linear-gradient(145deg,rgba(111,143,131,.09),rgba(255,255,255,.015))}.he-card h3{margin:0 0 12px;font-size:1.3rem}.he-card p{margin:0;color:#aaa79f}.he-band{display:grid;grid-template-columns:1fr 1fr;gap:18px}.he-band article{padding:32px;border:1px solid rgba(255,255,255,.12);background:#0b0f13}.he-band h3{font-size:1.55rem;margin:0 0 10px}.he-band p{color:#aaa79f}.he-kpis{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:26px}.he-kpis span{padding:8px 12px;border:1px solid rgba(185,215,204,.22);border-radius:999px;color:#d7e8e1;font-size:.82rem}.he-article{width:min(860px,calc(100% - 40px));margin:0 auto;padding:70px 0}.he-article h1{font-size:clamp(2.4rem,5vw,4.4rem);line-height:1.04;margin:0 0 20px}.he-article .dek{font-size:1.2rem;color:#aaa79f}.he-article h2{margin-top:42px;font-size:1.8rem}.he-article p,.he-article li{color:#cbc8c1}.he-contact-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:28px}.he-contact-copy{padding:28px;border:1px solid rgba(185,215,204,.2)}.he-form{display:grid;grid-template-columns:1fr 1fr;gap:14px}.he-form label{display:grid;gap:7px;font-size:.86rem}.he-form input,.he-form select,.he-form textarea{width:100%;min-height:48px;border:1px solid rgba(255,255,255,.2);background:#0b0e12;color:#fff;padding:12px;font:inherit}.he-form textarea{min-height:132px;resize:vertical}.he-form .full{grid-column:1/-1}.he-form .check{display:flex;grid-column:1/-1;align-items:flex-start;gap:8px}.he-form .check input{width:auto;min-height:auto;margin-top:4px}.he-form button{grid-column:1/-1}.he-form-status{grid-column:1/-1;min-height:1.5em;color:#b9d7cc}.he-footer{display:grid;grid-template-columns:1.4fr .7fr .9fr;gap:34px;padding:54px clamp(20px,5vw,70px);border-top:1px solid rgba(255,255,255,.12);background:#080b0f}.he-footer div{display:grid;align-content:start;gap:9px}.he-footer p,.he-footer a{color:#aaa79f}.he-footer img{width:145px;height:auto}
@media(max-width:900px){.he-header{grid-template-columns:1fr auto}.he-nav{display:none}.he-grid{grid-template-columns:1fr}.he-band,.he-contact-grid,.he-footer{grid-template-columns:1fr}.he-hero{padding-top:70px}.he-hero h1{font-size:clamp(2.5rem,11vw,4.4rem)}}
@media(max-width:620px){.he-shell{width:min(100% - 28px,1220px)}.he-header{padding-inline:14px}.he-section{padding:58px 0}.he-form{grid-template-columns:1fr}.he-form .full,.he-form .check,.he-form button{grid-column:1}.he-card{padding:22px}}
</style></body></html>