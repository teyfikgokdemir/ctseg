generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
}

enum CaseType {
  SOURCING
  BUYER_SEARCH
  LOGISTICS
}

enum CaseStatus {
  NEW
  RESEARCHING
  SHORTLISTED
  CONTACTING
  QUOTED
  NEGOTIATING
  WON
  LOST
  ARCHIVED
}

enum CompanyType {
  MANUFACTURER
  DISTRIBUTOR
  IMPORTER
  WHOLESALER
  DEALER
  TRADER
  BUYER
  LOGISTICS
  OTHER
}

enum EvidenceStatus {
  VERIFIED
  PARTIAL
  HISTORICAL
  UNVERIFIED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases     TradeCase[]
}

model TradeCase {
  id             String     @id @default(cuid())
  reference      String     @unique
  type           CaseType
  status         CaseStatus @default(NEW)
  title          String
  rawRequest     String
  productName    String?
  grade          String?
  quantity       String?
  sourceRegion   String?
  destination    String?
  transportModes String[]
  createdById    String
  createdBy      User       @relation(fields: [createdById], references: [id])
  companies      CaseCompany[]
  researchRuns   ResearchSession[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model ResearchSession {
  id               String            @id @default(cuid())
  caseId           String
  queryCount       Int               @default(0)
  resultCount      Int               @default(0)
  paidFallbackUsed Boolean           @default(false)
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  stopReason       String?
  phase            String?
  maxCandidates    Int?
  maxQueries       Int?
  tradeCase        TradeCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  findings         ResearchFinding[]

  @@index([caseId, startedAt])
}

model ResearchFinding {
  id                String          @id @default(cuid())
  sessionId         String
  title             String
  url               String
  snippet           String?
  domain            String
  adapter           String
  query             String
  language          String
  freshnessScore    Int
  verificationScore Int
  historicalOnly    Boolean         @default(false)
  createdAt         DateTime        @default(now())
  session           ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, freshnessScore])
  @@index([domain])
}

model Company {
  id                String       @id @default(cuid())
  name              String
  website           String?
  country           String?
  city              String?
  type              CompanyType
  active            Boolean?
  lastVerifiedAt    DateTime?
  freshnessScore    Int?
  verificationScore Int?
  contacts          Contact[]
  evidence          Evidence[]
  cases             CaseCompany[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([name, country])
}

model CaseCompany {
  caseId     String
  companyId  String
  matchReason String?
  relevanceScore Int?
  shortlisted Boolean @default(false)
  tradeCase  TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([caseId, companyId])
}

model Contact {
  id        String   @id @default(cuid())
  companyId String
  name      String?
  role      String?
  email     String?
  phone     String?
  whatsapp  String?
  sourceUrl String?
  verifiedAt DateTime?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Evidence {
  id          String         @id @default(cuid())
  companyId   String
  claim       String
  sourceUrl   String
  sourceType  String
  sourceDate  DateTime?
  fetchedAt   DateTime       @default(now())
  status      EvidenceStatus @default(UNVERIFIED)
  excerpt     String?
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, fetchedAt])
}

model PaidAlternative {
  id          String   @id @default(cuid())
  caseId       String?
  providerName String
  reason       String
  url          String?
  discoveredAt DateTime @default(now())
}

