generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
}

enum CaseType {
  SOURCING
  BUYER_SEARCH
  LOGISTICS
}

enum CaseStatus {
  NEW
  RESEARCHING
  SHORTLISTED
  CONTACTING
  QUOTED
  NEGOTIATING
  WON
  LOST
  ARCHIVED
}

enum CompanyType {
  MANUFACTURER
  DISTRIBUTOR
  IMPORTER
  WHOLESALER
  DEALER
  TRADER
  BUYER
  LOGISTICS
  OTHER
}

enum EvidenceStatus {
  VERIFIED
  PARTIAL
  HISTORICAL
  UNVERIFIED
}

enum DealStage {
  NEW_REQUEST
  RESEARCH
  SUPPLIERS_FOUND
  RFQ_SENT
  QUOTATIONS_RECEIVED
  NEGOTIATION
  SAMPLE
  ORDER_PENDING
  ORDER_CONFIRMED
  LOGISTICS
  COMPLETED
  LOST
  ON_HOLD
}

enum TradePriority {
  LOW
  NORMAL
  HIGH
}
enum CompanyRole {
  SUPPLIER
  MANUFACTURER
  DISTRIBUTOR
  BUYER
  IMPORTER
  LOGISTICS
  AGENT
  OTHER
}
enum CaseCompanyRole {
  SUPPLIER
  BUYER
  LOGISTICS
  OTHER
}
enum CaseCompanyStatus {
  DISCOVERED
  CONTACTED
  REPLIED
  QUOTED
  REJECTED
  SHORTLISTED
  SELECTED
}
enum QuotationStatus {
  RECEIVED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  ACCEPTED
  EXPIRED
}
enum TradeTaskStatus {
  OPEN
  DONE
  CANCELLED
}
enum DealActivityType {
  CASE_CREATED
  STAGE_CHANGED
  COMPANY_ADDED
  CONTACT_ADDED
  RFQ_PREPARED
  RFQ_SENT
  REPLY_RECEIVED
  QUOTATION_ADDED
  TASK_CREATED
  TASK_COMPLETED
  DOCUMENT_ADDED
  NOTE_ADDED
}
enum TradeDocumentType {
  COA
  TDS
  MSDS
  CERTIFICATE
  QUOTATION
  PROFORMA
  INVOICE
  PACKING_LIST
  CATALOG
  OTHER
}
enum RfqChannel {
  EMAIL
  WHATSAPP
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases     TradeCase[]
}

model TradeCase {
  id             String     @id @default(cuid())
  reference      String     @unique
  type           CaseType
  status         CaseStatus @default(NEW)
  stage          DealStage @default(NEW_REQUEST)
  productSpecification String?
  quantityUnit   String?
  frequency      String?
  sourceCountry  String?
  destinationCountry String?
  buyerCompanyId String?
  buyerCompany Company? @relation("CaseBuyer", fields: [buyerCompanyId], references: [id], onDelete: SetNull)
  ownerUserEmail String?
  priority       TradePriority @default(NORMAL)
  targetPrice    Decimal? @db.Decimal(18, 4)
  targetCurrency String?
  incoterm       String?
  paymentPreference String?
  nextAction     String?
  nextActionAt   DateTime?
  notes          String?
  closedAt       DateTime?
  title          String
  rawRequest     String
  productName    String?
  grade          String?
  quantity       String?
  sourceRegion   String?
  destination    String?
  transportModes String[]
  createdById    String
  createdBy      User       @relation(fields: [createdById], references: [id])
  companies      CaseCompany[]
  researchRuns   ResearchSession[]
  quotations     Quotation[]
  tasks          TradeTask[]
  activities     DealActivity[]
  documents      TradeDocument[]
  rfqDrafts      RfqDraft[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model ResearchSession {
  id               String            @id @default(cuid())
  caseId           String
  queryCount       Int               @default(0)
  resultCount      Int               @default(0)
  paidFallbackUsed Boolean           @default(false)
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  stopReason       String?
  phase            String?
  maxCandidates    Int?
  maxQueries       Int?
  tradeCase        TradeCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  findings         ResearchFinding[]

  @@index([caseId, startedAt])
}

model ResearchFinding {
  id                String          @id @default(cuid())
  sessionId         String
  title             String
  url               String
  snippet           String?
  domain            String
  adapter           String
  query             String
  language          String
  freshnessScore    Int
  verificationScore Int
  historicalOnly    Boolean         @default(false)
  createdAt         DateTime        @default(now())
  session           ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, freshnessScore])
  @@index([domain])
}

model Company {
  id                String       @id @default(cuid())
  name              String
  website           String?
  country           String?
  city              String?
  type              CompanyType
  roles             CompanyRole[] @default([])
  phone             String?
  whatsapp          String?
  email             String?
  address           String?
  notes             String?
  lastContactAt     DateTime?
  active            Boolean?
  lastVerifiedAt    DateTime?
  freshnessScore    Int?
  verificationScore Int?
  contacts          Contact[]
  evidence          Evidence[]
  cases             CaseCompany[]
  buyerCases        TradeCase[] @relation("CaseBuyer")
  quotations        Quotation[]
  tasks             TradeTask[]
  activities        DealActivity[]
  documents         TradeDocument[]
  rfqDrafts         RfqDraft[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([name, country])
}

model CaseCompany {
  caseId     String
  companyId  String
  matchReason String?
  relevanceScore Int?
  shortlisted Boolean @default(false)
  roleInCase CaseCompanyRole @default(OTHER)
  status CaseCompanyStatus @default(DISCOVERED)
  source String?
  notes String?
  tradeCase  TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([caseId, companyId])
}

model Contact {
  id        String   @id @default(cuid())
  companyId String
  name      String?
  role      String?
  title     String?
  preferredChannel RfqChannel?
  notes     String?
  email     String?
  phone     String?
  whatsapp  String?
  sourceUrl String?
  verifiedAt DateTime?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotations Quotation[]
  tasks TradeTask[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model Quotation {
  id String @id @default(cuid())
  caseId String
  companyId String
  contactId String?
  quotationDate DateTime
  validUntil DateTime?
  currency String
  unitPrice Decimal @db.Decimal(18, 4)
  unit String
  quantity Decimal? @db.Decimal(18, 4)
  quantityUnit String?
  totalPrice Decimal? @db.Decimal(18, 4)
  incoterm String?
  deliveryLocation String?
  moq String?
  leadTimeDays Int?
  paymentTerms String?
  originCountry String?
  productName String
  specification String?
  notes String?
  status QuotationStatus @default(RECEIVED)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tradeCase TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  documents TradeDocument[]
  @@index([caseId, quotationDate])
}

model TradeTask {
  id String @id @default(cuid())
  caseId String?
  companyId String?
  contactId String?
  title String
  description String?
  status TradeTaskStatus @default(OPEN)
  priority TradePriority @default(NORMAL)
  dueAt DateTime?
  completedAt DateTime?
  assignedToEmail String
  createdByEmail String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tradeCase TradeCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  @@index([status, dueAt])
}

model DealActivity {
  id String @id @default(cuid())
  caseId String
  companyId String?
  userEmail String
  type DealActivityType
  summary String
  metadata Json?
  createdAt DateTime @default(now())
  tradeCase TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])
  @@index([caseId, createdAt])
}

model TradeDocument {
  id String @id @default(cuid())
  caseId String?
  companyId String?
  quotationId String?
  type TradeDocumentType
  name String
  sourceUrl String?
  storageRef String?
  notes String?
  uploadedByEmail String
  createdAt DateTime @default(now())
  tradeCase TradeCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])
  @@index([caseId, createdAt])
}

model RfqDraft {
  id String @id @default(cuid())
  caseId String
  companyId String
  language String
  channel RfqChannel
  subject String
  body String
  createdByEmail String
  createdAt DateTime @default(now())
  tradeCase TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])
  @@index([caseId, createdAt])
}

model Evidence {
  id          String         @id @default(cuid())
  companyId   String
  claim       String
  sourceUrl   String
  sourceType  String
  sourceDate  DateTime?
  fetchedAt   DateTime       @default(now())
  status      EvidenceStatus @default(UNVERIFIED)
  excerpt     String?
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, fetchedAt])
}

model PaidAlternative {
  id          String   @id @default(cuid())
  caseId       String?
  providerName String
  reason       String
  url          String?
  discoveredAt DateTime @default(now())
}

